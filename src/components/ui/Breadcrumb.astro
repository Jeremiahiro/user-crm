---
interface Crumb {
  label: string
  href?: string
}

interface Props {
  crumbs: Crumb[]
}

const { crumbs } = Astro.props
---

<nav aria-label="Breadcrumb" class="flex items-center gap-1.5 mb-5 font-body text-[13px]">
  {crumbs.map((crumb, i) => (
    <span class="flex items-center gap-1.5">
      {i > 0 && <span class="text-neutral-300">/</span>}
      {crumb.href && i < crumbs.length - 1
        ? <a href={crumb.href} class="text-neutral-500 no-underline">{crumb.label}</a>
        : <span class={i === crumbs.length - 1 ? 'text-neutral-800 font-medium' : 'text-neutral-500'}>
            {crumb.label}
          </span>
      }
    </span>
  ))}
</nav>
