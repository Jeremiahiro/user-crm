---
interface Crumb {
  label: string
  href?: string
}

interface Props {
  crumbs: Crumb[]
}

const { crumbs } = Astro.props
---

<nav aria-label="Breadcrumb" style="display: flex; align-items: center; gap: 6px; margin-bottom: 20px; font-family: var(--font-body); font-size: 13px;">
  {crumbs.map((crumb, i) => (
    <span style="display: flex; align-items: center; gap: 6px;">
      {i > 0 && <span style="color: var(--color-neutral-300);">/</span>}
      {crumb.href && i < crumbs.length - 1
        ? <a href={crumb.href} style="color: var(--color-neutral-500); text-decoration: none;">{crumb.label}</a>
        : <span style={`color: ${i === crumbs.length - 1 ? 'var(--color-neutral-800)' : 'var(--color-neutral-500)'}; font-weight: ${i === crumbs.length - 1 ? '500' : '400'};`}>{crumb.label}</span>
      }
    </span>
  ))}
</nav>
