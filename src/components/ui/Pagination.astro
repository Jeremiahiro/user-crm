---
/**
 * Pagination
 * Props:
 *   page       — current page (1-based)
 *   totalPages — total number of pages
 *   baseUrl    — URL string with all other query params already set, WITHOUT page=
 *                e.g. "/admin/members?status=active&q=smith"
 */
interface Props {
  page: number
  totalPages: number
  baseUrl: string
}

const { page, totalPages, baseUrl } = Astro.props
if (totalPages <= 1) return

function pageUrl(p: number): string {
  const sep = baseUrl.includes('?') ? '&' : '?'
  return `${baseUrl}${sep}page=${p}`
}

const range: number[] = []
const delta = 2
for (let i = Math.max(1, page - delta); i <= Math.min(totalPages, page + delta); i++) {
  range.push(i)
}

const navLinkBase = 'border border-neutral-200 rounded-md font-body no-underline bg-white'
const navLinkSm = `${navLinkBase} px-2.5 py-1.5 text-xs text-neutral-600`
const navLinkMd = `${navLinkBase} px-3 py-1.5 text-[13px] text-neutral-700`
---

<div class="flex justify-between items-center mt-4 flex-wrap gap-2">
  <span class="font-body text-[13px] text-neutral-500">
    Page {page} of {totalPages}
  </span>
  <div class="flex gap-1.5 items-center">
    {page > 1 && (
      <a href={pageUrl(1)} class={navLinkSm}>«</a>
    )}
    {page > 1 && (
      <a href={pageUrl(page - 1)} class={navLinkMd}>Previous</a>
    )}
    {range.map(p => (
      <a
        href={pageUrl(p)}
        class={p === page
          ? 'px-2.5 py-1.5 rounded-md font-body text-[13px] no-underline border border-brand-navy bg-brand-navy text-white font-semibold'
          : `${navLinkMd}`}
      >
        {p}
      </a>
    ))}
    {page < totalPages && (
      <a href={pageUrl(page + 1)} class={navLinkMd}>Next</a>
    )}
    {page < totalPages && (
      <a href={pageUrl(totalPages)} class={navLinkSm}>»</a>
    )}
  </div>
</div>
