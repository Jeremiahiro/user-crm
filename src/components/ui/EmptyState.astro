---
interface Props {
  heading: string
  subtext?: string
  class?: string
}

const { heading, subtext, class: className = '' } = Astro.props
---

<div class={`flex flex-col items-center justify-center py-16 px-8 text-center ${className}`}>
  <div
    class="w-12 h-12 rounded-full bg-neutral-100 flex items-center justify-center mb-4 text-xl"
    aria-hidden="true"
  >
    ○
  </div>

  <h3 class="font-heading text-lg font-semibold text-neutral-900 mt-0 mb-2">
    {heading}
  </h3>

  {subtext && (
    <p class="text-sm text-neutral-500 mt-0 mb-6 max-w-80 leading-relaxed font-body">
      {subtext}
    </p>
  )}

  <slot name="cta" />
</div>
