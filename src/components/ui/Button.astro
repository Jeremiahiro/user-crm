---
interface Props {
  variant?: 'primary' | 'accent' | 'secondary' | 'ghost' | 'danger'
  size?: 'sm' | 'md' | 'lg'
  disabled?: boolean
  href?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
  [key: string]: unknown
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  href,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props

const variantClasses: Record<string, string> = {
  primary: 'bg-brand-navy text-white border-none',
  accent: 'bg-brand-gold text-neutral-950 border-none',
  secondary: 'bg-white text-neutral-900 border-[1.5px] border-neutral-300',
  ghost: 'bg-transparent text-neutral-700 border-none',
  danger: 'bg-danger-600 text-white border-none',
}

const sizeClasses: Record<string, string> = {
  sm: 'h-8 text-[13px] px-3',
  md: 'h-10 text-sm px-4.5',
  lg: 'h-12 text-base px-6',
}

const classes = [
  'inline-flex items-center justify-center gap-1.5',
  'rounded-md font-body font-semibold',
  'no-underline whitespace-nowrap box-border',
  'transition-[opacity,background-color] duration-150',
  disabled ? 'cursor-not-allowed opacity-40' : 'cursor-pointer',
  variantClasses[variant] ?? variantClasses.primary,
  sizeClasses[size] ?? sizeClasses.md,
  className,
].join(' ')
---

{href ? (
  <a href={disabled ? undefined : href} class={classes} aria-disabled={disabled} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled} {...rest}>
    <slot />
  </button>
)}
