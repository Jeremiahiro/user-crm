---
interface Props {
  label?: string
  name: string
  type?: string
  placeholder?: string
  value?: string
  error?: string
  helperText?: string
  required?: boolean
  disabled?: boolean
  class?: string
}

const {
  label,
  name,
  type = 'text',
  placeholder,
  value,
  error,
  helperText,
  required = false,
  disabled = false,
  class: className = '',
} = Astro.props

const inputId = `input-${name}`
const describedBy = error
  ? `${inputId}-error`
  : helperText
    ? `${inputId}-helper`
    : undefined

const inputStyle = `
  width: 100%;
  height: 40px;
  border-radius: var(--radius-md);
  border: 1.5px solid ${error ? 'var(--color-danger-600)' : 'var(--color-neutral-300)'};
  padding: 0 12px;
  font-size: 14px;
  font-family: var(--font-body);
  color: var(--color-neutral-900);
  background-color: ${disabled ? 'var(--color-neutral-100)' : 'white'};
  box-sizing: border-box;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
  cursor: ${disabled ? 'not-allowed' : 'text'};
  opacity: ${disabled ? '0.7' : '1'};
`
---

<div class={className} style="display: flex; flex-direction: column; gap: 0;">
  {
    label && (
      <label
        for={inputId}
        style="
          font-size: 13px;
          font-weight: 600;
          color: var(--color-neutral-700);
          margin-bottom: 6px;
          font-family: var(--font-body);
          display: block;
        "
      >
        {label}
        {required && (
          <span style="color: var(--color-danger-600); margin-left: 2px;" aria-hidden="true">
            *
          </span>
        )}
      </label>
    )
  }

  <input
    id={inputId}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
    required={required}
    disabled={disabled}
    aria-describedby={describedBy}
    aria-invalid={error ? 'true' : undefined}
    style={inputStyle}
    onfocus="this.style.borderColor='var(--color-brand-gold)'; this.style.boxShadow='0 0 0 2px rgba(201,168,76,0.2)'"
    onblur={`this.style.borderColor='${error ? 'var(--color-danger-600)' : 'var(--color-neutral-300)'}'; this.style.boxShadow='none'`}
  />

  {
    error && (
      <p
        id={`${inputId}-error`}
        role="alert"
        style="
          font-size: 11px;
          font-weight: 500;
          color: var(--color-danger-600);
          margin: 4px 0 0 0;
          font-family: var(--font-body);
        "
      >
        {error}
      </p>
    )
  }

  {
    helperText && !error && (
      <p
        id={`${inputId}-helper`}
        style="
          font-size: 11px;
          font-weight: 500;
          color: var(--color-neutral-500);
          margin: 4px 0 0 0;
          font-family: var(--font-body);
        "
      >
        {helperText}
      </p>
    )
  }
</div>
