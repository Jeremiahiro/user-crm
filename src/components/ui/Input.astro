---
interface Props {
  label?: string
  name: string
  type?: HTMLInputTypeAttribute
  placeholder?: string
  value?: string
  error?: string
  helperText?: string
  required?: boolean
  disabled?: boolean
  class?: string
}

const {
  label,
  name,
  type = 'text',
  placeholder,
  value,
  error,
  helperText,
  required = false,
  disabled = false,
  class: className = '',
} = Astro.props

const inputId = `input-${name}`
const describedBy = error
  ? `${inputId}-error`
  : helperText
    ? `${inputId}-helper`
    : undefined
---

<div class={`flex flex-col ${className}`}>
  {label && (
    <label
      for={inputId}
      class="block text-[13px] font-semibold text-neutral-700 mb-1.5 font-body"
    >
      {label}
      {required && (
        <span class="text-danger-600 ml-0.5" aria-hidden="true">*</span>
      )}
    </label>
  )}

  <input
    id={inputId}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
    required={required}
    disabled={disabled}
    aria-describedby={describedBy}
    aria-invalid={error ? 'true' : undefined}
    class={[
      'w-full h-10 rounded-md px-3 text-sm font-body text-neutral-900 box-border',
      'outline-none transition-[border-color,box-shadow] duration-150',
      'border-[1.5px]',
      error ? 'border-danger-600' : 'border-neutral-300',
      'focus:border-brand-gold focus:shadow-[0_0_0_2px_rgba(201,168,76,0.2)]',
      disabled ? 'bg-neutral-100 cursor-not-allowed opacity-70' : 'bg-white cursor-text',
    ].join(' ')}
  />

  {error && (
    <p
      id={`${inputId}-error`}
      role="alert"
      class="text-[11px] font-medium text-danger-600 mt-1 mb-0 font-body"
    >
      {error}
    </p>
  )}

  {helperText && !error && (
    <p
      id={`${inputId}-helper`}
      class="text-[11px] font-medium text-neutral-500 mt-1 mb-0 font-body"
    >
      {helperText}
    </p>
  )}
</div>
