---
interface Props {
  name: string
  src?: string
  size?: 'sm' | 'md' | 'lg' | 'xl'
  class?: string
}

const { name, src, size = 'md', class: className = '' } = Astro.props

const sizeClasses: Record<string, string> = {
  sm: 'w-6 h-6 text-[10px]',
  md: 'w-10 h-10 text-[14px]',
  lg: 'w-16 h-16 text-[20px]',
  xl: 'w-24 h-24 text-[30px]',
}

const sizePx: Record<string, number> = { sm: 24, md: 40, lg: 64, xl: 96 }
const px = sizePx[size] ?? 40

function getInitials(fullName: string): string {
  const parts = fullName.trim().split(' ')
  const first = parts[0]?.[0] ?? ''
  const last = parts[parts.length - 1]?.[0] ?? ''
  return (first + last).toUpperCase()
}

const initials = getInitials(name)
---

<div
  class={`rounded-full bg-brand-gold text-brand-navy inline-flex items-center justify-center font-semibold font-body overflow-hidden shrink-0 ${sizeClasses[size] ?? sizeClasses.md} ${className}`}
  title={name}
>
  {src ? (
    <img src={src} alt={name} width={px} height={px} class="object-cover w-full h-full" />
  ) : (
    initials
  )}
</div>
