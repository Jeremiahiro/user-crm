---
interface Props {
  stat?: boolean
  leftAccentColor?: string
  class?: string
  heading?: string
  value?: string | number
  label?: string
}

const {
  stat = false,
  leftAccentColor,
  class: className = '',
  heading,
  value,
  label,
} = Astro.props

const baseStyle = `
  background-color: white;
  border: 1.5px solid var(--color-neutral-300);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-sizing: border-box;
  ${leftAccentColor ? `border-left: 4px solid ${leftAccentColor};` : ''}
`
---

<div style={baseStyle} class={className}>
  {
    stat && value !== undefined ? (
      <>
        <p
          style="
            font-size: 11px;
            font-weight: 500;
            color: var(--color-neutral-500);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin: 0 0 8px 0;
            font-family: var(--font-body);
          "
        >
          {label ?? heading}
        </p>
        <p
          style="
            font-size: 28px;
            font-weight: 700;
            color: var(--color-brand-navy);
            margin: 0;
            font-family: var(--font-heading);
            line-height: 1.25;
          "
        >
          {value}
        </p>
      </>
    ) : (
      <slot />
    )
  }
</div>
