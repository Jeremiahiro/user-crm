---
interface Props {
  stat?: boolean
  leftAccentColor?: string
  class?: string
  heading?: string
  value?: string | number
  label?: string
}

const {
  stat = false,
  leftAccentColor,
  class: className = '',
  heading,
  value,
  label,
} = Astro.props
---

<div
  class={`bg-white border-[1.5px] border-neutral-300 rounded-lg p-6 box-border ${className}`}
  style={leftAccentColor ? `border-left: 4px solid ${leftAccentColor};` : undefined}
>
  {stat && value !== undefined ? (
    <>
      <p class="text-[11px] font-medium text-neutral-500 uppercase tracking-[0.06em] mb-2 mt-0 font-body">
        {label ?? heading}
      </p>
      <p class="text-[28px] font-bold text-brand-navy m-0 font-heading leading-tight">
        {value}
      </p>
    </>
  ) : (
    <slot />
  )}
</div>
