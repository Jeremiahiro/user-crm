---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params

const { data: mentee } = await supabaseAdmin
  .from('mentees')
  .select('*')
  .eq('id', id ?? '')
  .eq('is_archived', false)
  .single()

if (!mentee) return Astro.redirect('/admin/mentees')

const { data: members } = await supabaseAdmin
  .from('people')
  .select('id, full_name')
  .eq('is_archived', false)
  .order('full_name', { ascending: true })

const { data: programmeYears } = await supabaseAdmin
  .from('cmp_programme_years')
  .select('id, year_label')
  .order('year_label', { ascending: false })

type MenteeValues = Record<string, string>

let errors: Record<string, string> = {}
let globalError = ''
let values: MenteeValues = {
  full_name: mentee.full_name as string,
  email: mentee.email as string,
  phone: (mentee.phone as string | null) ?? '',
  school: (mentee.school as string | null) ?? '',
  year_group: (mentee.year_group as string | null) ?? '',
  date_of_birth: (mentee.date_of_birth as string | null) ?? '',
  parent_guardian_name: (mentee.parent_guardian_name as string | null) ?? '',
  parent_guardian_email: (mentee.parent_guardian_email as string | null) ?? '',
  parent_guardian_phone: (mentee.parent_guardian_phone as string | null) ?? '',
  mentor_id: (mentee.mentor_id as string | null) ?? '',
  programme_year_id: (mentee.programme_year_id as string | null) ?? '',
  notes: (mentee.notes as string | null) ?? '',
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as MenteeValues

  const res = await fetch(`${Astro.url.origin}/api/mentees/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      full_name: values.full_name,
      email: values.email,
      phone: values.phone || null,
      school: values.school || null,
      year_group: values.year_group || null,
      date_of_birth: values.date_of_birth || null,
      parent_guardian_name: values.parent_guardian_name || null,
      parent_guardian_email: values.parent_guardian_email || null,
      parent_guardian_phone: values.parent_guardian_phone || null,
      mentor_id: values.mentor_id || null,
      programme_year_id: values.programme_year_id || null,
      notes: values.notes || null,
    }),
  })

  if (res.ok) {
    return Astro.redirect(`/admin/mentees/${id}`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to update mentee.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title={`Edit — ${mentee.full_name as string}`}>
  <div class="max-w-170">
    <Breadcrumb crumbs={[{ label: 'Mentees', href: '/admin/mentees' }, { label: mentee.full_name as string, href: `/admin/mentees/${id}` }, { label: 'Edit' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-6">Edit — {mentee.full_name as string}</h1>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="flex flex-col gap-6">

      <!-- Personal details -->
      <div class="bg-white border border-neutral-200 rounded-lg p-7">
        <h2 class="font-heading text-sm font-bold text-neutral-800 mb-5 uppercase tracking-wider">Mentee details</h2>
        <div class="flex flex-col gap-4">
          <div class="grid grid-cols-2 gap-4">
            <Input label="Full name *" name="full_name" value={values.full_name} error={errors.full_name} required />
            <Input label="Email *" name="email" type="email" value={values.email} error={errors.email} required />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <Input label="Phone" name="phone" type="tel" value={values.phone} error={errors.phone} />
            <Input label="Date of birth" name="date_of_birth" type="date" value={values.date_of_birth} error={errors.date_of_birth} />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <Input label="School" name="school" value={values.school} error={errors.school} />
            <Input label="Year group" name="year_group" value={values.year_group} error={errors.year_group} placeholder="e.g. Year 10" />
          </div>
        </div>
      </div>

      <!-- Parent/guardian -->
      <div class="bg-white border border-neutral-200 rounded-lg p-7">
        <h2 class="font-heading text-sm font-bold text-neutral-800 mb-5 uppercase tracking-wider">Parent / Guardian</h2>
        <div class="flex flex-col gap-4">
          <Input label="Name" name="parent_guardian_name" value={values.parent_guardian_name} error={errors.parent_guardian_name} />
          <div class="grid grid-cols-2 gap-4">
            <Input label="Email" name="parent_guardian_email" type="email" value={values.parent_guardian_email} error={errors.parent_guardian_email} />
            <Input label="Phone" name="parent_guardian_phone" type="tel" value={values.parent_guardian_phone} error={errors.parent_guardian_phone} />
          </div>
        </div>
      </div>

      <!-- Programme -->
      <div class="bg-white border border-neutral-200 rounded-lg p-7">
        <h2 class="font-heading text-sm font-bold text-neutral-800 mb-5 uppercase tracking-wider">Programme</h2>
        <div class="flex flex-col gap-4">
          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
              <label class="font-body text-[13px] font-medium text-neutral-700">Mentor</label>
              <select name="mentor_id"
                class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm bg-white">
                <option value="">— Unassigned —</option>
                {(members ?? []).map(m => (
                  <option value={m.id} selected={values.mentor_id === m.id}>{m.full_name}</option>
                ))}
              </select>
            </div>
            <div class="flex flex-col gap-1">
              <label class="font-body text-[13px] font-medium text-neutral-700">Programme year</label>
              <select name="programme_year_id"
                class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm bg-white">
                <option value="">— None —</option>
                {(programmeYears ?? []).map(py => (
                  <option value={py.id} selected={values.programme_year_id === py.id}>{py.name as string}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <label class="font-body text-[13px] font-medium text-neutral-700">Notes</label>
            <textarea name="notes" rows={3}
              class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm resize-y">{values.notes}</textarea>
          </div>
        </div>
      </div>

      <div class="flex gap-3">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Save changes
        </button>
        <a href={`/admin/mentees/${id}`} class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
