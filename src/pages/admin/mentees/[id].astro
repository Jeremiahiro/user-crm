---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params
const activeTab = Astro.url.searchParams.get('tab') ?? 'overview'

const { data: mentee } = await supabaseAdmin
  .from('mentees')
  .select('*, people!mentees_mentor_id_fkey(id, full_name, email), cmp_programme_years(id, name)')
  .eq('id', id ?? '')
  .eq('is_archived', false)
  .single()

if (!mentee) return Astro.redirect('/admin/mentees')

const mentor = (mentee as unknown as { people: { id: string; full_name: string; email: string } | null }).people
const programmeYear = (mentee as unknown as { cmp_programme_years: { id: string; name: string } | null }).cmp_programme_years

// ── Parallel data fetches ─────────────────────────────────────────────────────
const [
  { data: attendance },
  { data: mentorNotes },
  { data: callLogs },
] = await Promise.all([
  supabaseAdmin
    .from('cmp_attendance')
    .select('id, status, role, cmp_sessions(id, title, session_date, session_time)')
    .eq('mentee_id', id ?? '')
    .order('recorded_at', { ascending: false }),
  supabaseAdmin
    .from('cmp_mentor_notes')
    .select('id, note, created_at, people(id, full_name)')
    .eq('mentee_id', id ?? '')
    .order('created_at', { ascending: false }),
  supabaseAdmin
    .from('cmp_call_logs')
    .select('id, called_at, duration_minutes, outcome, summary, people(id, full_name)')
    .eq('mentee_id', id ?? '')
    .order('called_at', { ascending: false }),
])

type AttendRow = { id: string; status: string; role: string; cmp_sessions: { id: string; title: string; session_date: string; session_time: string | null } | null }
type NoteRow   = { id: string; note: string; created_at: string; people: { id: string; full_name: string } | null }
type CallRow   = { id: string; called_at: string; duration_minutes: number | null; outcome: string; summary: string | null; people: { id: string; full_name: string } | null }

const attendRows = (attendance ?? []) as unknown as AttendRow[]
const noteRows   = (mentorNotes ?? []) as unknown as NoteRow[]
const callRows   = (callLogs ?? []) as unknown as CallRow[]

const attendedCount = attendRows.filter(a => a.status === 'present').length
const totalSessions = attendRows.length

function formatDate(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

function formatTime(t: string | null) {
  if (!t) return ''
  const [h, m] = t.split(':')
  const hour = parseInt(h ?? '0')
  return `${hour % 12 || 12}:${m}${hour >= 12 ? 'pm' : 'am'}`
}

const OUTCOME_LABELS: Record<string, string> = {
  reached: 'Reached',
  no_answer: 'No answer',
  left_voicemail: 'Left voicemail',
  rescheduled: 'Rescheduled',
}

const OUTCOME_COLORS: Record<string, string> = {
  reached: 'var(--color-success-100)',
  no_answer: 'var(--color-neutral-100)',
  left_voicemail: 'var(--color-info-100)',
  rescheduled: 'var(--color-warning-100)',
}
const OUTCOME_TEXT_COLORS: Record<string, string> = {
  reached: 'var(--color-success-700)',
  no_answer: 'var(--color-neutral-600)',
  left_voicemail: 'var(--color-info-700)',
  rescheduled: 'var(--color-warning-700)',
}

const STATUS_COLORS: Record<string, string> = {
  present: 'var(--color-success-100)',
  absent: 'var(--color-danger-100)',
  apology: 'var(--color-warning-100)',
}
const STATUS_TEXT: Record<string, string> = {
  present: 'var(--color-success-700)',
  absent: 'var(--color-danger-700)',
  apology: 'var(--color-warning-700)',
}

const tabs = [
  { key: 'overview', label: 'Overview' },
  { key: 'attendance', label: `Attendance (${attendedCount}/${totalSessions})` },
  { key: 'notes', label: `Mentor Notes (${noteRows.length})` },
  { key: 'calls', label: `Call Logs (${callRows.length})` },
]
---

<DashboardLayout title={mentee.full_name as string}>
  <Breadcrumb crumbs={[{ label: 'Mentees', href: '/admin/mentees' }, { label: mentee.full_name as string }]} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-5">
    <div>
      <h1 class="font-heading text-2xl font-bold text-brand-navy m-0 mb-1">{mentee.full_name as string}</h1>
      <p class="font-body text-sm text-neutral-500 m-0">
        {mentee.email as string | null ?? (mentee.guardian_email as string | null) ?? 'No email on file'}
      </p>
    </div>
    <a href={`/admin/mentees/${id}/edit`}
      class="py-2 px-4 bg-white border border-neutral-300 rounded-md font-body text-[13px] font-medium text-neutral-700 no-underline">
      Edit
    </a>
  </div>

  <!-- Status banner -->
  <div id="statusBanner" class="hidden py-3 px-4 rounded-md mb-4 font-body text-sm"></div>

  <!-- Tabs -->
  <div class="flex gap-0.5 border-b-2 border-neutral-200 mb-6">
    {tabs.map(t => (
      <a href={`/admin/mentees/${id}?tab=${t.key}`}
        class={`py-2.5 px-4 font-body text-sm font-medium no-underline border-b-2 -mb-0.5 ${activeTab === t.key ? 'text-brand-navy border-brand-navy' : 'text-neutral-500 border-transparent'}`}>
        {t.label}
      </a>
    ))}
  </div>

  <!-- ── Overview tab ──────────────────────────────────────────────────────── -->
  {activeTab === 'overview' && (
    <div class="grid grid-cols-2 gap-5">
      <!-- Personal details -->
      <div class="bg-white border border-neutral-200 rounded-lg p-6">
        <h2 class="font-heading text-xs font-bold text-neutral-500 uppercase tracking-[0.08em] m-0 mb-4">Personal details</h2>
        <table class="border-collapse w-full">
          {[
            ['Date of birth', formatDate(mentee.date_of_birth as string | null)],
            ['School', (mentee.school as string | null) ?? '—'],
            ['Year group', (mentee.year_group as string | null) ?? '—'],
            ['Phone', (mentee.phone as string | null) ?? '—'],
          ].map(([label, value]) => (
            <tr>
              <td class="font-body text-[13px] text-neutral-400 py-[5px] pr-4 w-[130px] align-top">{label}</td>
              <td class="font-body text-[13px] text-neutral-800 py-[5px]">{value}</td>
            </tr>
          ))}
        </table>
      </div>

      <!-- Programme info -->
      <div class="bg-white border border-neutral-200 rounded-lg p-6">
        <h2 class="font-heading text-xs font-bold text-neutral-500 uppercase tracking-[0.08em] m-0 mb-4">Programme</h2>
        <table class="border-collapse w-full">
          <tr>
            <td class="font-body text-[13px] text-neutral-400 py-[5px] pr-4 w-[130px]">Mentor</td>
            <td class="font-body text-[13px] py-[5px]">
              {mentor ? (
                <a href={`/admin/members/${mentor.id}`} class="text-brand-navy no-underline font-medium">{mentor.full_name}</a>
              ) : <span class="text-warning-600 font-medium">Unassigned</span>}
            </td>
          </tr>
          <tr>
            <td class="font-body text-[13px] text-neutral-400 py-[5px] pr-4">Programme year</td>
            <td class="font-body text-[13px] text-neutral-800 py-[5px]">
              {programmeYear ? (
                <a href={`/admin/cmp/years/${programmeYear.id}`} class="text-brand-navy no-underline">{programmeYear.name}</a>
              ) : '—'}
            </td>
          </tr>
          <tr>
            <td class="font-body text-[13px] text-neutral-400 py-[5px] pr-4">Sessions attended</td>
            <td class="font-body text-[13px] text-neutral-800 py-[5px]">{attendedCount} / {totalSessions}</td>
          </tr>
          <tr>
            <td class="font-body text-[13px] text-neutral-400 py-[5px] pr-4">Mentor notes</td>
            <td class="font-body text-[13px] text-neutral-800 py-[5px]">{noteRows.length}</td>
          </tr>
          <tr>
            <td class="font-body text-[13px] text-neutral-400 py-[5px] pr-4">Call logs</td>
            <td class="font-body text-[13px] text-neutral-800 py-[5px]">{callRows.length}</td>
          </tr>
        </table>
      </div>

      <!-- Guardian -->
      <div class="bg-white border border-neutral-200 rounded-lg p-6 col-span-2">
        <h2 class="font-heading text-xs font-bold text-neutral-500 uppercase tracking-[0.08em] m-0 mb-4">Guardian / Parent</h2>
        <table class="border-collapse w-full">
          {[
            ['Name', (mentee.guardian_name as string | null) ?? '—'],
            ['Email', (mentee.guardian_email as string | null) ?? '—'],
          ].map(([label, value]) => (
            <tr>
              <td class="font-body text-[13px] text-neutral-400 py-[5px] pr-4 w-[130px]">{label}</td>
              <td class="font-body text-[13px] text-neutral-800 py-[5px]">{value}</td>
            </tr>
          ))}
        </table>
      </div>
    </div>
  )}

  <!-- ── Attendance tab ──────────────────────────────────────────────────────── -->
  {activeTab === 'attendance' && (
    <div>
      <!-- Summary bar -->
      <div class="grid grid-cols-3 gap-3 mb-5">
        {[
          { label: 'Present', count: attendRows.filter(a => a.status === 'present').length, bgClass: 'bg-success-50', borderClass: 'border-success-200', textClass: 'text-success-700' },
          { label: 'Absent', count: attendRows.filter(a => a.status === 'absent').length, bgClass: 'bg-danger-50', borderClass: 'border-danger-200', textClass: 'text-danger-700' },
          { label: 'Apology', count: attendRows.filter(a => a.status === 'apology').length, bgClass: 'bg-warning-50', borderClass: 'border-warning-200', textClass: 'text-warning-700' },
        ].map(s => (
          <div class={`border rounded-lg py-4 px-5 ${s.bgClass} ${s.borderClass}`}>
            <p class={`font-heading text-[28px] font-bold m-0 ${s.textClass}`}>{s.count}</p>
            <p class={`font-body text-[13px] mt-[2px] mb-0 ${s.textClass}`}>{s.label}</p>
          </div>
        ))}
      </div>

      <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
        {attendRows.length === 0 ? (
          <div class="p-9 text-center">
            <p class="font-body text-sm text-neutral-400 m-0">No attendance records yet.</p>
          </div>
        ) : (
          <table class="w-full border-collapse">
            <thead class="bg-neutral-50 border-b border-neutral-200">
              <tr>
                <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-[0.05em]">Session</th>
                <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-[0.05em]">Date</th>
                <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-[0.05em]">Status</th>
              </tr>
            </thead>
            <tbody>
              {attendRows.map((a, i) => (
                <tr class={i > 0 ? 'border-t border-neutral-100' : ''}>
                  <td class="py-3 px-4">
                    {a.cmp_sessions ? (
                      <a href={`/admin/cmp/sessions/${a.cmp_sessions.id}`}
                        class="font-body text-sm font-medium text-brand-navy no-underline">
                        {a.cmp_sessions.title}
                      </a>
                    ) : <span class="font-body text-sm text-neutral-400">—</span>}
                  </td>
                  <td class="py-3 px-4 font-body text-[13px] text-neutral-600">
                    {a.cmp_sessions ? formatDate(a.cmp_sessions.session_date) : '—'}
                    {a.cmp_sessions?.session_time && <span class="ml-1 text-neutral-400">{formatTime(a.cmp_sessions.session_time)}</span>}
                  </td>
                  <td class="py-3 px-4">
                    <span class="py-0.5 px-2.5 rounded-full font-body text-xs font-semibold capitalize"
                      style={`background: ${STATUS_COLORS[a.status] ?? 'var(--color-neutral-100)'}; color: ${STATUS_TEXT[a.status] ?? 'var(--color-neutral-600)'};`}>
                      {a.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  )}

  <!-- ── Mentor notes tab ──────────────────────────────────────────────────── -->
  {activeTab === 'notes' && (
    <div>
      <!-- Add note form -->
      <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6 mb-5">
        <h2 class="font-heading text-sm font-bold text-neutral-800 m-0 mb-3">Add note</h2>
        <textarea id="newNote" rows={3} placeholder="Observations about this mentee's progress, engagement, areas to support…"
          class="w-full py-2.5 px-3 border border-neutral-300 rounded-md font-body text-sm resize-y box-border"></textarea>
        <div class="mt-2.5 flex gap-2">
          <button id="btnSaveNote"
            class="py-2 px-[18px] bg-brand-navy text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer">
            Save note
          </button>
        </div>
      </div>

      <!-- Notes list -->
      <div class="flex flex-col gap-3">
        {noteRows.length === 0 ? (
          <div class="bg-white border border-neutral-200 rounded-lg p-9 text-center">
            <p class="font-body text-sm text-neutral-400 m-0">No mentor notes yet.</p>
          </div>
        ) : noteRows.map(n => (
          <div data-note-id={n.id} class="bg-white border border-neutral-200 rounded-lg py-4 px-5">
            <div class="flex items-center justify-between mb-2">
              <div>
                <span class="font-body text-[13px] font-semibold text-neutral-700">
                  {n.people?.full_name ?? 'Unknown'}
                </span>
                <span class="font-body text-xs text-neutral-400 ml-2">
                  {formatDate(n.created_at)}
                </span>
              </div>
              <button class="btn-delete-note py-[3px] px-2.5 bg-neutral-100 border-none rounded-md font-body text-xs text-neutral-500 cursor-pointer" data-id={n.id}>
                Delete
              </button>
            </div>
            <p class="font-body text-sm text-neutral-700 m-0 whitespace-pre-wrap leading-[1.6]">{n.note}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- ── Call logs tab ─────────────────────────────────────────────────────── -->
  {activeTab === 'calls' && (
    <div>
      <!-- Log call form -->
      <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6 mb-5">
        <h2 class="font-heading text-sm font-bold text-neutral-800 m-0 mb-3.5">Log a call</h2>
        <div class="grid grid-cols-3 gap-3 mb-3">
          <div class="flex flex-col gap-1">
            <label class="font-body text-xs font-medium text-neutral-700">Date *</label>
            <input type="date" id="callDate" value={new Date().toISOString().slice(0, 10)}
              class="py-2 px-3 border border-neutral-300 rounded-md font-body text-sm" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="font-body text-xs font-medium text-neutral-700">Duration (mins)</label>
            <input type="number" id="callDuration" min="1" max="120" placeholder="e.g. 15"
              class="py-2 px-3 border border-neutral-300 rounded-md font-body text-sm" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="font-body text-xs font-medium text-neutral-700">Outcome *</label>
            <select id="callOutcome"
              class="py-2 px-3 border border-neutral-300 rounded-md font-body text-sm bg-white h-[38px]">
              <option value="reached">Reached</option>
              <option value="no_answer">No answer</option>
              <option value="left_voicemail">Left voicemail</option>
              <option value="rescheduled">Rescheduled</option>
            </select>
          </div>
        </div>
        <div class="flex flex-col gap-1 mb-3">
          <label class="font-body text-xs font-medium text-neutral-700">Summary</label>
          <textarea id="callSummary" rows={2} placeholder="Key points from the call…"
            class="py-2 px-3 border border-neutral-300 rounded-md font-body text-sm resize-y"></textarea>
        </div>
        <button id="btnSaveCall"
          class="py-2 px-[18px] bg-brand-navy text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer">
          Log call
        </button>
      </div>

      <!-- Call log list -->
      <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
        {callRows.length === 0 ? (
          <div class="p-9 text-center">
            <p class="font-body text-sm text-neutral-400 m-0">No call logs yet.</p>
          </div>
        ) : (
          <table class="w-full border-collapse">
            <thead class="bg-neutral-50 border-b border-neutral-200">
              <tr>
                <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-[0.05em]">Date</th>
                <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-[0.05em]">Caller</th>
                <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-[0.05em]">Outcome</th>
                <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-[0.05em]">Duration</th>
                <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-[0.05em]">Notes</th>
                <th class="py-[9px] px-4"></th>
              </tr>
            </thead>
            <tbody>
              {callRows.map((c, i) => (
                <tr data-call-id={c.id} class={i > 0 ? 'border-t border-neutral-100' : ''}>
                  <td class="py-3 px-4 font-body text-[13px] text-neutral-700 font-medium">{formatDate(c.called_at)}</td>
                  <td class="py-3 px-4 font-body text-[13px] text-neutral-600">{c.people?.full_name ?? '—'}</td>
                  <td class="py-3 px-4">
                    <span class="py-0.5 px-2.5 rounded-full font-body text-xs font-semibold"
                      style={`background: ${OUTCOME_COLORS[c.outcome] ?? 'var(--color-neutral-100)'}; color: ${OUTCOME_TEXT_COLORS[c.outcome] ?? 'var(--color-neutral-600)'};`}>
                      {OUTCOME_LABELS[c.outcome] ?? c.outcome}
                    </span>
                  </td>
                  <td class="py-3 px-4 font-body text-[13px] text-neutral-600">
                    {c.duration_minutes != null ? `${c.duration_minutes} min` : '—'}
                  </td>
                  <td class="py-3 px-4 font-body text-[13px] text-neutral-600 max-w-[280px]">
                    {c.summary ? (
                      <span class="line-clamp-2">{c.summary}</span>
                    ) : <span class="text-neutral-300">—</span>}
                  </td>
                  <td class="py-3 px-4 text-right">
                    <button class="btn-delete-call py-[3px] px-2.5 bg-neutral-100 border-none rounded-md font-body text-xs text-neutral-500 cursor-pointer" data-id={c.id}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  )}
</DashboardLayout>

<script is:inline>
  (function () {
    var menteeId = window.location.pathname.split('/').at(-1)
    // Handle tab from query string
    var params = new URLSearchParams(window.location.search)
    menteeId = params.get('tab') === 'notes' || params.get('tab') === 'calls'
      ? window.location.pathname.split('/').filter(Boolean).at(-1)
      : window.location.pathname.split('/').filter(Boolean).at(-1)

    // Re-derive menteeId cleanly
    var pathParts = window.location.pathname.split('/').filter(Boolean)
    // path: /admin/mentees/<id>
    menteeId = pathParts[pathParts.length - 1]

    var banner = document.getElementById('statusBanner')

    function showBanner(msg, type) {
      if (!banner) return
      banner.textContent = msg
      banner.style.display = 'block'
      banner.style.backgroundColor = type === 'success' ? '#f0fdf4' : '#fef2f2'
      banner.style.border = '1px solid ' + (type === 'success' ? '#86efac' : '#fca5a5')
      banner.style.color = type === 'success' ? '#166534' : '#991b1b'
      setTimeout(function () { banner.style.display = 'none' }, 5000)
    }

    // ── Mentor notes ─────────────────────────────────────────────────────────
    var btnSaveNote = document.getElementById('btnSaveNote')
    if (btnSaveNote) {
      btnSaveNote.addEventListener('click', function () {
        var ta = document.getElementById('newNote')
        var note = ta ? ta.value.trim() : ''
        if (!note) { showBanner('Note cannot be empty.', 'error'); return }
        btnSaveNote.disabled = true
        btnSaveNote.textContent = 'Saving…'
        fetch('/api/cmp/mentor-notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mentee_id: menteeId, note: note }),
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d } }) })
          .then(function (res) {
            if (res.ok) {
              showBanner('Note saved.', 'success')
              setTimeout(function () { window.location.reload() }, 800)
            } else {
              showBanner(res.d.error || 'Failed to save note.', 'error')
              btnSaveNote.disabled = false
              btnSaveNote.textContent = 'Save note'
            }
          })
          .catch(function () { showBanner('Network error.', 'error'); btnSaveNote.disabled = false; btnSaveNote.textContent = 'Save note' })
      })
    }

    document.querySelectorAll('.btn-delete-note').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!confirm('Delete this note?')) return
        var id = btn.getAttribute('data-id')
        fetch('/api/cmp/mentor-notes', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: id }),
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d } }) })
          .then(function (res) {
            if (res.ok) {
              var row = btn.closest('[data-note-id]')
              if (row) row.remove()
              showBanner('Note deleted.', 'success')
            } else {
              showBanner(res.d.error || 'Failed to delete.', 'error')
            }
          })
      })
    })

    // ── Call logs ────────────────────────────────────────────────────────────
    var btnSaveCall = document.getElementById('btnSaveCall')
    if (btnSaveCall) {
      btnSaveCall.addEventListener('click', function () {
        var called_at = document.getElementById('callDate') ? document.getElementById('callDate').value : ''
        var outcome = document.getElementById('callOutcome') ? document.getElementById('callOutcome').value : 'reached'
        var dur = document.getElementById('callDuration') ? document.getElementById('callDuration').value : ''
        var summary = document.getElementById('callSummary') ? document.getElementById('callSummary').value.trim() : ''
        if (!called_at) { showBanner('Date is required.', 'error'); return }
        btnSaveCall.disabled = true
        btnSaveCall.textContent = 'Saving…'
        fetch('/api/cmp/call-logs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mentee_id: menteeId,
            called_at: called_at,
            outcome: outcome,
            duration_minutes: dur ? parseInt(dur) : null,
            summary: summary || null,
          }),
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d } }) })
          .then(function (res) {
            if (res.ok) {
              showBanner('Call logged.', 'success')
              setTimeout(function () { window.location.reload() }, 800)
            } else {
              showBanner(res.d.error || 'Failed to log call.', 'error')
              btnSaveCall.disabled = false
              btnSaveCall.textContent = 'Log call'
            }
          })
          .catch(function () { showBanner('Network error.', 'error'); btnSaveCall.disabled = false; btnSaveCall.textContent = 'Log call' })
      })
    }

    document.querySelectorAll('.btn-delete-call').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!confirm('Delete this call log?')) return
        var id = btn.getAttribute('data-id')
        fetch('/api/cmp/call-logs', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: id }),
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d } }) })
          .then(function (res) {
            if (res.ok) {
              var row = btn.closest('[data-call-id]')
              if (row) row.remove()
              showBanner('Call log deleted.', 'success')
            } else {
              showBanner(res.d.error || 'Failed to delete.', 'error')
            }
          })
      })
    })
  })()
</script>
