---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Pagination from '@/components/ui/Pagination.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const PAGE_SIZE = 25
const url = Astro.url
const q = url.searchParams.get('q') ?? ''
const mentorId = url.searchParams.get('mentor_id') ?? ''
const programmeYearId = url.searchParams.get('programme_year_id') ?? ''
const page = Math.max(1, parseInt(url.searchParams.get('page') ?? '1'))
const offset = (page - 1) * PAGE_SIZE

let query = supabaseAdmin
  .from('mentees')
  .select('*, people!mentees_mentor_id_fkey(id, full_name), cmp_programme_years(id, name)', { count: 'exact' })
  .eq('is_archived', false)
  .order('full_name', { ascending: true })

if (q) query = query.or(`full_name.ilike.%${q}%,email.ilike.%${q}%,school.ilike.%${q}%`)
if (mentorId) query = query.eq('mentor_id', mentorId)
if (programmeYearId) query = query.eq('programme_year_id', programmeYearId)

query = query.range(offset, offset + PAGE_SIZE - 1)

const { data: mentees, count: menteeCount } = await query
const rows = mentees ?? []
const totalPages = Math.ceil((menteeCount ?? 0) / PAGE_SIZE)

const filterParams = new URLSearchParams()
if (q) filterParams.set('q', q)
if (mentorId) filterParams.set('mentor_id', mentorId)
if (programmeYearId) filterParams.set('programme_year_id', programmeYearId)
const paginationBase = `/admin/mentees${filterParams.toString() ? `?${filterParams}` : ''}`

// For filter dropdowns
const { data: members } = await supabaseAdmin
  .from('people')
  .select('id, full_name')
  .eq('is_archived', false)
  .order('full_name', { ascending: true })

const { data: programmeYears } = await supabaseAdmin
  .from('cmp_programme_years')
  .select('id, year_label')
  .order('year_label', { ascending: false })
---

<DashboardLayout title="Mentees">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Mentees</h1>
      <p class="font-body text-sm text-neutral-500 m-0">{rows.length} mentee{rows.length !== 1 ? 's' : ''}</p>
    </div>
    <a href="/admin/mentees/new"
      class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
      + New mentee
    </a>
  </div>

  <!-- Filters -->
  <form method="GET" class="flex gap-2.5 mb-5 flex-wrap items-end">
    <input type="text" name="q" value={q} placeholder="Search name, email, school…"
      class="px-3 py-2 border border-neutral-300 rounded-md font-body text-sm min-w-[220px]" />
    <select name="mentor_id" onchange="this.form.submit()"
      class="px-3 py-2 border border-neutral-300 rounded-md font-body text-sm bg-white">
      <option value="" selected={!mentorId}>All mentors</option>
      {(members ?? []).map(m => (
        <option value={m.id} selected={mentorId === m.id}>{m.full_name}</option>
      ))}
    </select>
    <select name="programme_year_id" onchange="this.form.submit()"
      class="px-3 py-2 border border-neutral-300 rounded-md font-body text-sm bg-white">
      <option value="" selected={!programmeYearId}>All years</option>
      {(programmeYears ?? []).map(py => (
        <option value={py.id} selected={programmeYearId === py.id}>{py.name as string}</option>
      ))}
    </select>
    <button type="submit"
      class="px-3.5 py-2 bg-brand-navy text-white border-none rounded-md font-body text-sm cursor-pointer">
      Search
    </button>
    {(q || mentorId || programmeYearId) && (
      <a href="/admin/mentees"
        class="px-3 py-2 bg-neutral-100 rounded-md font-body text-[13px] text-neutral-600 no-underline">
        Clear
      </a>
    )}
  </form>

  <!-- Mentees table -->
  <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
    {rows.length === 0 ? (
      <div class="p-12 text-center">
        <p class="font-body text-sm text-neutral-400 m-0">No mentees found.</p>
      </div>
    ) : (
      <table class="w-full border-collapse">
        <thead class="bg-neutral-50 border-b border-neutral-200">
          <tr>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Name</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">School</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Year group</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Mentor</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Programme year</th>
            <th class="px-4 py-2.5"></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((mentee, i) => {
            const mentor = (mentee as unknown as { people: { id: string; full_name: string } | null }).people
            const py = (mentee as unknown as { cmp_programme_years: { id: string; name: string } | null }).cmp_programme_years
            return (
              <tr class={i > 0 ? 'border-t border-neutral-100' : ''}>
                <td class="px-4 py-3.5">
                  <a href={`/admin/mentees/${mentee.id}`}
                    class="font-body text-sm font-medium text-brand-navy no-underline">
                    {mentee.full_name as string}
                  </a>
                  <p class="font-body text-xs text-neutral-400 mt-0.5 mb-0">{mentee.email as string}</p>
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-700">
                  {(mentee.school as string | null) ?? '—'}
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-700">
                  {(mentee.year_group as string | null) ?? '—'}
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-700">
                  {mentor ? (
                    <a href={`/admin/members/${mentor.id}`}
                      class="text-brand-navy no-underline text-[13px] font-body">
                      {mentor.full_name}
                    </a>
                  ) : (
                    <span class="text-neutral-400">Unassigned</span>
                  )}
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-700">
                  {py?.year_label ?? '—'}
                </td>
                <td class="px-4 py-3.5 text-right">
                  <a href={`/admin/mentees/${mentee.id}/edit`}
                    class="font-body text-[13px] text-neutral-500 no-underline mr-3">
                    Edit
                  </a>
                  <a href={`/admin/mentees/${mentee.id}`}
                    class="font-body text-[13px] text-brand-navy no-underline">
                    View →
                  </a>
                </td>
              </tr>
            )
          })}
        </tbody>
      </table>
    )}
    <Pagination page={page} totalPages={totalPages} baseUrl={paginationBase} />
  </div>
</DashboardLayout>
