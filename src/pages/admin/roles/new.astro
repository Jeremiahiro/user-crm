---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'

if (!Astro.locals.user) return Astro.redirect('/login')

const MODULES = [
  { key: 'members', label: 'Members' },
  { key: 'volunteers', label: 'Volunteers' },
  { key: 'teams', label: 'Teams' },
  { key: 'pillars', label: 'Pillars' },
  { key: 'elected_positions', label: 'Elected Positions' },
  { key: 'elected_tenures', label: 'Elected Tenures' },
  { key: 'dues', label: 'Dues' },
  { key: 'dbs_records', label: 'DBS Records' },
  { key: 'documents', label: 'Documents' },
  { key: 'mentees', label: 'Mentees' },
  { key: 'cmp_years', label: 'CMP Years' },
  { key: 'cmp_sessions', label: 'CMP Sessions' },
  { key: 'cmp_attendance', label: 'CMP Attendance' },
  { key: 'awards', label: 'Awards' },
  { key: 'praise', label: 'Praise' },
  { key: 'participation_events', label: 'Participation Events' },
  { key: 'roles', label: 'Roles' },
  { key: 'permissions', label: 'Permissions' },
  { key: 'user_role_assignment', label: 'Role Assignment' },
  { key: 'audit_log', label: 'Audit Log' },
]

const OPS = ['create', 'read', 'update', 'delete'] as const

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  // Build permissions from checkboxes
  const permissions: { module: string; operation: string; scope: string }[] = []
  for (const mod of MODULES) {
    for (const op of OPS) {
      if (form.get(`perm_${mod.key}_${op}`)) {
        permissions.push({ module: mod.key, operation: op, scope: 'all' })
      }
    }
  }

  const res = await fetch(`${Astro.url.origin}/api/roles`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({ name: values.name, description: values.description || undefined, permissions }),
  })

  if (res.ok) {
    return Astro.redirect('/admin/roles')
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? ''
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title="Create Role">
  <div class="max-w-225">
    <Breadcrumb crumbs={[{ label: 'Roles', href: '/admin/roles' }, { label: 'New Role' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0 mb-6">Create Role</h1>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="flex flex-col gap-6">
      <div class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">
        <Input label="Role name *" name="name" value={values.name} error={errors.name} required placeholder="e.g. Events Lead" />
        <Input label="Description" name="description" value={values.description} placeholder="Brief description of this role's purpose" />
      </div>

      <!-- Permissions grid -->
      <div class="bg-white border border-neutral-200 rounded-lg p-8">
        <h2 class="font-heading text-sm font-semibold text-neutral-500 uppercase tracking-[0.08em] m-0 mb-5">Permissions</h2>

        <div class="overflow-x-auto">
          <table class="w-full border-collapse min-w-150">
            <thead>
              <tr>
                <th class="px-3 py-2 text-left font-body text-xs font-semibold text-neutral-500 uppercase tracking-[0.08em] w-55">Module</th>
                {OPS.map(op => (
                  <th class="px-3 py-2 text-center font-body text-xs font-semibold text-neutral-500 uppercase tracking-[0.08em] w-20">{op}</th>
                ))}
                <th class="px-3 py-2 text-center font-body text-[11px] text-neutral-400">All</th>
              </tr>
            </thead>
            <tbody>
              {MODULES.map((mod, i) => (
                <tr class={`border-t border-neutral-100 ${i % 2 === 0 ? '' : 'bg-neutral-50'}`}>
                  <td class="px-3 py-2.5 font-body text-[13px] font-medium text-neutral-700">{mod.label}</td>
                  {OPS.map(op => (
                    <td class="px-3 py-2.5 text-center">
                      <input type="checkbox" name={`perm_${mod.key}_${op}`} value="1"
                        class="w-4 h-4 cursor-pointer accent-brand-navy" />
                    </td>
                  ))}
                  <td class="px-3 py-2.5 text-center">
                    <button type="button"
                      onclick={`toggleRow('${mod.key}')`}
                      class="font-body text-[11px] text-neutral-400 bg-transparent border-none cursor-pointer px-1.5 py-0.5 rounded-sm">
                      All
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="flex gap-3">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">
          Create role
        </button>
        <a href="/admin/roles" class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">Cancel</a>
      </div>
    </form>
  </div>
</DashboardLayout>

<script>
  function toggleRow(moduleKey: string) {
    const ops = ['create', 'read', 'update', 'delete']
    const checkboxes = ops.map(op =>
      document.querySelector<HTMLInputElement>(`input[name="perm_${moduleKey}_${op}"]`)
    ).filter(Boolean) as HTMLInputElement[]

    const allChecked = checkboxes.every(cb => cb.checked)
    checkboxes.forEach(cb => { cb.checked = !allChecked })
  }
</script>
