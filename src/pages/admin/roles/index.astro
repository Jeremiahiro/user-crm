---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { data: roles } = await supabaseAdmin
  .from('roles')
  .select('*, user_roles(count)')
  .order('name')

type RoleRow = {
  id: string
  name: string
  description: string | null
  is_system_protected: boolean
  is_archived: boolean
  user_roles: { count: number }[]
}

const rows = (roles ?? []) as RoleRow[]
const active = rows.filter(r => !r.is_archived)
const archived = rows.filter(r => r.is_archived)
---

<DashboardLayout title="Roles">
  <div x-data="{
    modalOpen: false,
    itemId: '',
    itemName: '',
    message: '',
    actionLabel: 'Delete',
    loading: false,
    error: '',
    openModal(el) {
      this.itemId = el.dataset.roleId;
      this.itemName = el.dataset.roleName;
      var mc = parseInt(el.dataset.memberCount || '0');
      this.actionLabel = mc > 0 ? 'Archive' : 'Delete';
      this.message = mc > 0
        ? 'Archive \'' + this.itemName + '\'? This role has ' + mc + ' member(s) assigned and will be archived, not permanently deleted.'
        : 'Delete \'' + this.itemName + '\'? This role has no members and will be permanently deleted. This cannot be undone.';
      this.modalOpen = true;
      this.error = '';
    },
    async doAction() {
      this.loading = true;
      var res = await fetch('/api/roles/' + this.itemId, { method: 'DELETE' });
      if (res.ok) {
        window.location.reload();
      } else {
        var e = await res.json();
        this.error = e.error || 'Failed to ' + this.actionLabel.toLowerCase() + ' role';
        this.loading = false;
      }
    }
  }">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Roles</h1>
        <p class="font-body text-sm text-neutral-500 m-0">
          System roles define what members can access.
        </p>
      </div>
      <a href="/admin/roles/new"
         class="inline-flex items-center gap-1.5 bg-brand-navy text-white py-2.5 px-4.5 rounded-md font-body text-sm font-semibold no-underline">
        + Create role
      </a>
    </div>

    {active.length > 0 ? (
      <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden mb-8">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-neutral-100">
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Name</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Members</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Type</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {active.map((role) => (
              <tr class="border-t border-neutral-100 hover:bg-neutral-50">
                <td class="px-4 py-3.5">
                  <p class="font-body text-sm font-semibold text-brand-navy mb-0.5">{role.name}</p>
                  {role.description && (
                    <p class="font-body text-xs text-neutral-500 m-0">{role.description}</p>
                  )}
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-700">
                  {(role.user_roles?.[0]?.count ?? 0) > 0
                    ? <a href={`/admin/roles/${role.id}`} class="text-brand-navy font-semibold no-underline">{role.user_roles[0].count}</a>
                    : <span class="text-neutral-400">0</span>}
                </td>
                <td class="px-4 py-3.5">
                  {role.is_system_protected
                    ? <Badge variant="info">System</Badge>
                    : <Badge variant="neutral">Custom</Badge>}
                </td>
                <td class="px-4 py-3.5 text-right whitespace-nowrap">
                  <a href={`/admin/roles/${role.id}/edit`}
                     class="font-body text-[13px] font-medium text-neutral-600 no-underline px-2.5 py-1 rounded-md hover:bg-neutral-100">
                    Edit
                  </a>
                  {!role.is_system_protected && (
                    <button
                      data-role-id={role.id}
                      data-role-name={role.name}
                      data-member-count={String(role.user_roles?.[0]?.count ?? 0)}
                      @click="openModal($el)"
                      class="font-body text-[13px] font-medium text-danger-600 bg-transparent border-0 cursor-pointer px-2.5 py-1 rounded-md">
                      {(role.user_roles?.[0]?.count ?? 0) > 0 ? 'Archive' : 'Delete'}
                    </button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <EmptyState heading="No roles" subtext="Create a role to assign permissions to members." />
    )}

    {archived.length > 0 && (
      <details>
        <summary class="font-body text-[13px] text-neutral-500 cursor-pointer mb-3">
          Archived roles ({archived.length})
        </summary>
        <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
          <table class="w-full border-collapse">
            <tbody>
              {archived.map((role) => (
                <tr class="border-t border-neutral-100">
                  <td class="px-4 py-3">
                    <span class="font-body text-sm text-neutral-400">{role.name}</span>
                  </td>
                  <td class="px-4 py-3">
                    <Badge variant="neutral">Archived</Badge>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )}

    <!-- Confirmation Modal -->
    <div x-show="modalOpen" @click.self="modalOpen = false" @keydown.escape.window="modalOpen = false"
      class="fixed inset-0 z-100 flex items-center justify-center bg-[rgba(0,0,0,0.45)]">
      <div class="bg-white rounded-lg py-7 px-8 max-w-105 w-[90%] shadow-[0_25px_50px_rgba(0,0,0,0.2)]">
        <h3 class="font-heading text-[17px] font-bold text-brand-navy mb-2.5" x-text="actionLabel + ' role'"></h3>
        <p x-text="message" class="font-body text-sm text-neutral-700 mb-5 leading-[1.55]"></p>
        <p x-show="error" x-text="error" class="font-body text-[13px] text-danger-600 mb-3.5"></p>
        <div class="flex gap-2.5 justify-end">
          <button @click="modalOpen = false" :disabled="loading"
            class="py-2 px-4.5 bg-neutral-100 border border-neutral-200 rounded-md font-body text-sm font-medium cursor-pointer text-neutral-700">
            Cancel
          </button>
          <button @click="doAction()" :disabled="loading" x-text="loading ? 'Working...' : actionLabel"
            class="py-2 px-4.5 bg-danger-600 text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
