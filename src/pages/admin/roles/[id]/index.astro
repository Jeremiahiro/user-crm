---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params

const { data: role } = await supabaseAdmin
  .from('roles')
  .select(`
    *,
    user_roles(
      assigned_at,
      people(id, full_name, email, status, profile_photo_url)
    )
  `)
  .eq('id', id ?? '')
  .single()

if (!role) return Astro.redirect('/admin/roles')

type UserRoleRow = {
  assigned_at: string
  people: { id: string; full_name: string; email: string; status: string; profile_photo_url: string | null } | null
}

const members = (role.user_roles as UserRoleRow[]) ?? []

function statusVariant(s: string): 'success' | 'warning' | 'neutral' | 'danger' | 'info' {
  const map: Record<string, 'success' | 'warning' | 'neutral' | 'danger' | 'info'> = {
    active: 'success', approved: 'info', pending_review: 'warning',
    applicant: 'neutral', suspended: 'warning', inactive: 'neutral',
  }
  return map[s] ?? 'neutral'
}

function titleCase(s: string): string {
  return s.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase())
}

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

function getInitials(name: string) {
  return name.trim().split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase()
}
---

<DashboardLayout title={role.name as string}>
  <div>
    <!-- Header -->
    <div class="flex items-start justify-between mb-7 pb-5 border-b border-neutral-200">
      <div>
        <a href="/admin/roles" class="font-body text-[13px] text-neutral-500 no-underline block mb-2">← Roles</a>
        <div class="flex items-center gap-2.5">
          <h1 class="font-heading text-2xl font-bold text-brand-navy m-0">{role.name as string}</h1>
          {(role.is_system_protected as boolean)
            ? <Badge variant="info">System</Badge>
            : <Badge variant="neutral">Custom</Badge>}
        </div>
        {(role.description as string | null) && (
          <p class="font-body text-sm text-neutral-500 mt-1.5 mb-0">{role.description as string}</p>
        )}
      </div>
      <a href={`/admin/roles/${id}/edit`}
        class="px-4 py-2 bg-neutral-100 text-neutral-700 rounded-md font-body text-[13px] font-medium no-underline">
        Edit
      </a>
    </div>

    <!-- Members with this role -->
    <div>
      <h2 class="font-heading text-[13px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mb-4">
        Members with this role ({members.length})
      </h2>

      {members.length > 0 ? (
        <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
          <table class="w-full border-collapse">
            <thead>
              <tr class="bg-neutral-100">
                <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Name</th>
                <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Status</th>
                <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Assigned</th>
              </tr>
            </thead>
            <tbody>
              {members.filter(m => m.people).map((m, i) => (
                <tr class={i > 0 ? 'border-t border-neutral-100 hover:bg-neutral-50' : 'hover:bg-neutral-50'}>
                  <td class="px-4 py-[14px]">
                    <a href={`/admin/members/${m.people!.id}`}
                      class="flex items-center gap-2.5 no-underline">
                      <div class="w-8 h-8 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center font-body text-[11px] font-semibold shrink-0 overflow-hidden">
                        {m.people!.profile_photo_url
                          ? <img src={m.people!.profile_photo_url} alt={m.people!.full_name} width={32} height={32} class="w-full h-full object-cover" />
                          : getInitials(m.people!.full_name)}
                      </div>
                      <div>
                        <p class="font-body text-sm font-medium text-brand-navy m-0">{m.people!.full_name}</p>
                        <p class="font-body text-xs text-neutral-400 m-0">{m.people!.email}</p>
                      </div>
                    </a>
                  </td>
                  <td class="px-4 py-[14px]">
                    <Badge variant={statusVariant(m.people!.status)}>{titleCase(m.people!.status)}</Badge>
                  </td>
                  <td class="px-4 py-[14px] font-body text-[13px] text-neutral-500">
                    {fmtDate(m.assigned_at)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="bg-white border border-neutral-200 rounded-lg p-10 text-center">
          <p class="font-body text-sm text-neutral-400 m-0">No members have been assigned this role yet.</p>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
