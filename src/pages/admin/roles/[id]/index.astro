---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params

const { data: role } = await supabaseAdmin
  .from('roles')
  .select(`
    *,
    user_roles(
      assigned_at,
      people(id, full_name, email, status, profile_photo_url)
    )
  `)
  .eq('id', id ?? '')
  .single()

if (!role) return Astro.redirect('/admin/roles')

type UserRoleRow = {
  assigned_at: string
  people: { id: string; full_name: string; email: string; status: string; profile_photo_url: string | null } | null
}

const members = (role.user_roles as UserRoleRow[]) ?? []

function statusVariant(s: string): 'success' | 'warning' | 'neutral' | 'danger' | 'info' {
  const map: Record<string, 'success' | 'warning' | 'neutral' | 'danger' | 'info'> = {
    active: 'success', approved: 'info', pending_review: 'warning',
    applicant: 'neutral', suspended: 'warning', inactive: 'neutral',
  }
  return map[s] ?? 'neutral'
}

function titleCase(s: string): string {
  return s.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase())
}

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

function getInitials(name: string) {
  return name.trim().split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase()
}
---

<DashboardLayout title={role.name as string}>
  <div>
    <!-- Header -->
    <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 28px; padding-bottom: 20px; border-bottom: 1px solid var(--color-neutral-200);">
      <div>
        <a href="/admin/roles" style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); text-decoration: none; display: block; margin-bottom: 8px;">← Roles</a>
        <div style="display: flex; align-items: center; gap: 10px;">
          <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0;">{role.name as string}</h1>
          {(role.is_system_protected as boolean)
            ? <Badge variant="info">System</Badge>
            : <Badge variant="neutral">Custom</Badge>}
        </div>
        {(role.description as string | null) && (
          <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 6px 0 0;">{role.description as string}</p>
        )}
      </div>
      <a href={`/admin/roles/${id}/edit`}
        style="padding: 8px 16px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 500; text-decoration: none;">
        Edit
      </a>
    </div>

    <!-- Members with this role -->
    <div>
      <h2 style="font-family: var(--font-heading); font-size: 13px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 16px;">
        Members with this role ({members.length})
      </h2>

      {members.length > 0 ? (
        <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
          <table style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="background-color: var(--color-neutral-100);">
                <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Name</th>
                <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Status</th>
                <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Assigned</th>
              </tr>
            </thead>
            <tbody>
              {members.filter(m => m.people).map((m, i) => (
                <tr style={`${i > 0 ? 'border-top: 1px solid var(--color-neutral-100);' : ''}`}
                  onmouseover="this.style.backgroundColor='var(--color-neutral-50)'"
                  onmouseout="this.style.backgroundColor=''">
                  <td style="padding: 14px 16px;">
                    <a href={`/admin/members/${m.people!.id}`}
                      style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
                      <div style="width: 32px; height: 32px; border-radius: var(--radius-full); background-color: var(--color-brand-gold); color: var(--color-brand-navy); display: flex; align-items: center; justify-content: center; font-family: var(--font-body); font-size: 11px; font-weight: 600; flex-shrink: 0; overflow: hidden;">
                        {m.people!.profile_photo_url
                          ? <img src={m.people!.profile_photo_url} alt={m.people!.full_name} width={32} height={32} style="width:100%;height:100%;object-fit:cover;" />
                          : getInitials(m.people!.full_name)}
                      </div>
                      <div>
                        <p style="font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--color-brand-navy); margin: 0;">{m.people!.full_name}</p>
                        <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0;">{m.people!.email}</p>
                      </div>
                    </a>
                  </td>
                  <td style="padding: 14px 16px;">
                    <Badge variant={statusVariant(m.people!.status)}>{titleCase(m.people!.status)}</Badge>
                  </td>
                  <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500);">
                    {fmtDate(m.assigned_at)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 40px; text-align: center;">
          <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-400); margin: 0;">No members have been assigned this role yet.</p>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
