---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Pagination from '@/components/ui/Pagination.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin, getTeamMemberIds } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const personId = user.person_id ?? ''
let viewerMemberIds: Set<string> | null = null
let isLead = false
if (!admin && personId) {
  viewerMemberIds = await getTeamMemberIds(personId)
  isLead = viewerMemberIds.size > 0
}

const PAGE_SIZE = 20
const statusFilter = Astro.url.searchParams.get('status') ?? ''
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10))
const offset = (page - 1) * PAGE_SIZE

let baseQuery = supabaseAdmin
  .from('documents')
  .select('id, title, status, created_at, expiry_date, person_id, document_type_id, document_type:document_types(name)', { count: 'exact' })
  .order('created_at', { ascending: false })

if (!admin) {
  if (isLead && viewerMemberIds) {
    baseQuery = baseQuery.in('person_id', [...viewerMemberIds])
  } else {
    baseQuery = baseQuery.eq('person_id', personId)
  }
}
if (statusFilter) baseQuery = baseQuery.eq('status', statusFilter)
baseQuery = baseQuery.range(offset, offset + PAGE_SIZE - 1)

const { data: rows, count: totalCount } = await baseQuery
const totalPages = Math.ceil((totalCount ?? 0) / PAGE_SIZE)
const docs = (rows ?? []) as any[]

let pendingDocs: any[] = []
if (admin || isLead) {
  let pendingQuery = supabaseAdmin
    .from('documents')
    .select('id, title, created_at, person_id, document_type:document_types(name)')
    .eq('status', 'pending')
    .order('created_at', { ascending: true })
  if (!admin && viewerMemberIds) pendingQuery = pendingQuery.in('person_id', [...viewerMemberIds])
  const { data: pd } = await pendingQuery
  pendingDocs = (pd ?? []) as any[]
}

const personIds = [...new Set(docs.map((d: any) => d.person_id).filter(Boolean))] as string[]
const allPersonIds = [...new Set([...personIds, ...pendingDocs.map((d: any) => d.person_id).filter(Boolean)])] as string[]
const { data: people } = allPersonIds.length > 0
  ? await supabaseAdmin.from('people').select('id, full_name').in('id', allPersonIds)
  : { data: [] }
const personMap = new Map(((people ?? []) as any[]).map((p: any) => [p.id, p.full_name]))

const filterParams = new URLSearchParams()
if (statusFilter) filterParams.set('status', statusFilter)
const paginationBase = `/admin/documents${filterParams.toString() ? `?${filterParams}` : ''}`

function fmt(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

const STATUS_CLASSES: Record<string, string> = {
  pending: 'bg-warning-50 text-warning-700 border border-warning-300',
  approved: 'bg-success-50 text-success-700 border border-success-100',
  rejected: 'bg-danger-50 text-danger-700 border border-danger-100',
}
---

<DashboardLayout title="Documents">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Documents</h1>
      <p class="font-body text-sm text-neutral-500 m-0">{totalCount ?? 0} document{(totalCount ?? 0) !== 1 ? 's' : ''}</p>
    </div>
    <a href="/admin/documents/upload"
      class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
      + Upload Document
    </a>
  </div>

  {(admin || isLead) && pendingDocs.length > 0 && (
    <div class="bg-warning-50 border border-warning-300 rounded-lg px-5 py-4 mb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-base text-warning-700">&#9888;</span>
        <h2 class="font-heading text-[15px] font-bold text-warning-800 m-0">
          {pendingDocs.length} document{pendingDocs.length !== 1 ? 's' : ''} awaiting review
        </h2>
      </div>
      <table class="w-full border-collapse">
        <tbody>
          {pendingDocs.map((d: any) => (
            <tr>
              <td class="font-body text-[13px] font-medium text-warning-800 px-2 py-1.5">{d.title}</td>
              <td class="font-body text-xs text-warning-700 px-2 py-1.5">{personMap.get(d.person_id) ?? '—'}</td>
              <td class="font-body text-xs text-warning-700 px-2 py-1.5">{(d.document_type as any)?.name ?? '—'}</td>
              <td class="font-body text-xs text-warning-700 px-2 py-1.5">{fmt(d.created_at)}</td>
              <td class="px-2 py-1.5 text-right">
                <a href={`/admin/documents/${d.id}`}
                  class="font-body text-xs font-semibold text-warning-800 underline">
                  Review &#8594;
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <!-- Status filter pills -->
  <div class="flex gap-2 mb-5 flex-wrap">
    {[
      { label: 'All', value: '' },
      { label: 'Pending', value: 'pending' },
      { label: 'Approved', value: 'approved' },
      { label: 'Rejected', value: 'rejected' },
    ].map(({ label, value }) => {
      const active = statusFilter === value
      return (
        <a
          href={value ? `/admin/documents?status=${value}` : '/admin/documents'}
          class={`px-4 py-1.5 rounded-full font-body text-[13px] no-underline border ${active ? 'font-semibold border-brand-navy bg-brand-navy text-white' : 'font-normal border-neutral-200 bg-white text-neutral-600'}`}
        >
          {label}
        </a>
      )
    })}
  </div>

  <!-- Documents table -->
  <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
    {docs.length === 0 ? (
      <div class="p-12 text-center">
        <p class="font-body text-sm text-neutral-400 mb-4 mt-0 mx-0">No documents found.</p>
        <a href="/admin/documents/upload"
          class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
          Upload first document
        </a>
      </div>
    ) : (
      <table class="w-full border-collapse">
        <thead class="bg-neutral-50 border-b border-neutral-200">
          <tr>
            {(admin || isLead) && (
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Member</th>
            )}
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Document</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Type</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Status</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Uploaded</th>
            <th class="px-4 py-2.5"></th>
          </tr>
        </thead>
        <tbody>
          {docs.map((doc: any, i: number) => {
            return (
              <tr class={i > 0 ? 'border-t border-neutral-100' : ''}>
                {(admin || isLead) && (
                  <td class="px-4 py-3.5 font-body text-[13px] text-neutral-700">
                    {personMap.get(doc.person_id) ?? '—'}
                  </td>
                )}
                <td class="px-4 py-3.5">
                  <span class="font-body text-sm font-medium text-neutral-800">{doc.title}</span>
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600">
                  {(doc.document_type as any)?.name ?? '—'}
                </td>
                <td class="px-4 py-3.5">
                  <span
                    class={`inline-block py-0.5 px-2.5 rounded-full font-body text-xs font-semibold ${STATUS_CLASSES[doc.status] ?? 'bg-neutral-100 text-neutral-700 border border-neutral-200'}`}
                  >
                    {doc.status.charAt(0).toUpperCase() + doc.status.slice(1)}
                  </span>
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600">{fmt(doc.created_at)}</td>
                <td class="px-4 py-3.5 text-right">
                  <a href={`/admin/documents/${doc.id}`}
                    class="font-body text-[13px] font-medium text-brand-navy no-underline">
                    {(admin || isLead) ? 'Review' : 'View'} &#8594;
                  </a>
                </td>
              </tr>
            )
          })}
        </tbody>
      </table>
    )}
    <Pagination page={page} totalPages={totalPages} baseUrl={paginationBase} />
  </div>
</DashboardLayout>
