---
/**
 * Admin page to manually link an unmatched document to a member.
 * Shown in the unmatched review queue.
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import MemberSearch from '@/components/ui/MemberSearch.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { writeAuditLog } from '@/lib/audit'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params

const { data: doc } = await supabaseAdmin
  .from('documents')
  .select('id, type, upload_status, uploaded_email, description, drive_url, created_at')
  .eq('id', id ?? '')
  .single()

if (!doc || doc.upload_status !== 'unmatched') {
  return Astro.redirect('/admin/documents')
}


const TYPE_LABELS: Record<string, string> = {
  dbs: 'DBS Certificate',
  photo_id: 'Photo ID',
  passport: 'Passport',
  training: 'Training Certificate',
  agreement: 'Agreement',
  other: 'Other',
}

let globalError = ''
let selectedPersonId = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  selectedPersonId = (form.get('person_id') as string ?? '').trim()

  if (!selectedPersonId) {
    globalError = 'Please select a member.'
  } else {
    const { error } = await supabaseAdmin
      .from('documents')
      .update({ person_id: selectedPersonId, upload_status: 'matched' })
      .eq('id', id ?? '')

    if (error) {
      console.error('[match doc] DB error:', error)
      globalError = 'Failed to link document. Please try again.'
    } else {
      await writeAuditLog({
        actorId: Astro.locals.user.person_id,
        action: 'update',
        targetTable: 'documents',
        targetId: id ?? '',
        beforeValue: { upload_status: 'unmatched' },
        afterValue: { person_id: selectedPersonId, upload_status: 'matched' },
      })
      return Astro.redirect(`/admin/documents`)
    }
  }
}

function formatDate(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}
---

<DashboardLayout title="Match Unmatched Document">
  <div style="max-width: 560px;">
    <Breadcrumb crumbs={[{ label: 'Documents', href: '/admin/documents' }, { label: 'Match Member' }]} />
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 24px;">Match Unmatched Document</h1>

    <!-- Document summary -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 20px 24px; margin-bottom: 24px;">
      <table style="border-collapse: collapse; width: 100%;">
        <tr>
          <td style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); padding: 4px 16px 4px 0; width: 140px;">Type</td>
          <td style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-800); padding: 4px 0;">{TYPE_LABELS[doc.type as string] ?? doc.type}</td>
        </tr>
        <tr>
          <td style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); padding: 4px 16px 4px 0;">Submitted email</td>
          <td style="font-family: var(--font-mono); font-size: 13px; color: var(--color-neutral-800); padding: 4px 0;">{(doc as { uploaded_email?: string }).uploaded_email ?? '—'}</td>
        </tr>
        <tr>
          <td style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); padding: 4px 16px 4px 0;">Received</td>
          <td style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-800); padding: 4px 0;">{formatDate(doc.created_at as string | null)}</td>
        </tr>
        {doc.drive_url && (
          <tr>
            <td style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); padding: 4px 16px 4px 0;">Drive link</td>
            <td style="padding: 4px 0;"><a href={doc.drive_url as string} target="_blank" rel="noopener noreferrer" style="font-family: var(--font-body); font-size: 13px; color: var(--color-brand-navy); text-decoration: underline;">Open ↗</a></td>
          </tr>
        )}
      </table>
    </div>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form method="POST" style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 28px 24px; display: flex; flex-direction: column; gap: 20px;">
      <div style="display: flex; flex-direction: column; gap: 4px;">
        <MemberSearch
          name="person_id"
          label="Link to member"
          required
          value={selectedPersonId}
        />
        <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0;">
          The document status will change to "Matched" once linked.
        </p>
      </div>

      <div style="display: flex; gap: 12px;">
        <button type="submit" style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Link document
        </button>
        <a href="/admin/documents" style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
