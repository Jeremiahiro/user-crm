---
/**
 * Admin page to manually link an unmatched document to a member.
 * Shown in the unmatched review queue.
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import MemberSearch from '@/components/ui/MemberSearch.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { writeAuditLog } from '@/lib/audit'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params

const { data: doc } = await supabaseAdmin
  .from('documents')
  .select('id, type, upload_status, uploaded_email, description, drive_url, created_at')
  .eq('id', id ?? '')
  .single()

if (!doc || doc.upload_status !== 'unmatched') {
  return Astro.redirect('/admin/documents')
}


const TYPE_LABELS: Record<string, string> = {
  dbs: 'DBS Certificate',
  photo_id: 'Photo ID',
  passport: 'Passport',
  training: 'Training Certificate',
  agreement: 'Agreement',
  other: 'Other',
}

let globalError = ''
let selectedPersonId = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  selectedPersonId = (form.get('person_id') as string ?? '').trim()

  if (!selectedPersonId) {
    globalError = 'Please select a member.'
  } else {
    const { error } = await supabaseAdmin
      .from('documents')
      .update({ person_id: selectedPersonId, upload_status: 'matched' })
      .eq('id', id ?? '')

    if (error) {
      console.error('[match doc] DB error:', error)
      globalError = 'Failed to link document. Please try again.'
    } else {
      await writeAuditLog({
        actorId: Astro.locals.user.person_id,
        action: 'update',
        targetTable: 'documents',
        targetId: id ?? '',
        beforeValue: { upload_status: 'unmatched' },
        afterValue: { person_id: selectedPersonId, upload_status: 'matched' },
      })
      return Astro.redirect(`/admin/documents`)
    }
  }
}

function formatDate(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}
---

<DashboardLayout title="Match Unmatched Document">
  <div class="max-w-140">
    <Breadcrumb crumbs={[{ label: 'Documents', href: '/admin/documents' }, { label: 'Match Member' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-6">Match Unmatched Document</h1>

    <!-- Document summary -->
    <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6 mb-6">
      <table class="border-collapse w-full">
        <tr>
          <td class="font-body text-[13px] text-neutral-500 py-1 pr-4 w-35">Type</td>
          <td class="font-body text-[13px] text-neutral-800 py-1">{TYPE_LABELS[doc.type as string] ?? doc.type}</td>
        </tr>
        <tr>
          <td class="font-body text-[13px] text-neutral-500 py-1 pr-4">Submitted email</td>
          <td class="font-mono text-[13px] text-neutral-800 py-1">{(doc as { uploaded_email?: string }).uploaded_email ?? '—'}</td>
        </tr>
        <tr>
          <td class="font-body text-[13px] text-neutral-500 py-1 pr-4">Received</td>
          <td class="font-body text-[13px] text-neutral-800 py-1">{formatDate(doc.created_at as string | null)}</td>
        </tr>
        {doc.drive_url && (
          <tr>
            <td class="font-body text-[13px] text-neutral-500 py-1 pr-4">Drive link</td>
            <td class="py-1"><a href={doc.drive_url as string} target="_blank" rel="noopener noreferrer" class="font-body text-[13px] text-brand-navy underline">Open ↗</a></td>
          </tr>
        )}
      </table>
    </div>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg py-7 px-6 flex flex-col gap-5">
      <div class="flex flex-col gap-1">
        <MemberSearch
          name="person_id"
          label="Link to member"
          required
          value={selectedPersonId}
        />
        <p class="font-body text-xs text-neutral-400 m-0">
          The document status will change to "Matched" once linked.
        </p>
      </div>

      <div class="flex gap-3">
        <button type="submit" class="py-2.5 px-5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Link document
        </button>
        <a href="/admin/documents" class="py-2.5 px-5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
