---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin, getTeamMemberIds } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const docId = Astro.params.id ?? ''

const { data: doc } = await supabaseAdmin
  .from('documents')
  .select('*, document_type:document_types(*), training:trainings(id, title), uploader:people!person_id(id, full_name, email), reviewer:people!reviewer_id(full_name)')
  .eq('id', docId)
  .single()
if (!doc) return Astro.redirect('/admin/documents')

const isOwn = (doc as any).uploader?.id === user.person_id
if (!admin && !isOwn) {
  const leadMemberIds = await getTeamMemberIds(user.person_id ?? '')
  if (!leadMemberIds.has((doc as any).person_id)) return Astro.redirect('/admin/documents')
}
const canReviewDoc = admin || !isOwn

const { data: signedData } = await supabaseAdmin.storage
  .from('member-documents')
  .createSignedUrl((doc as any).storage_path, 3600)
const viewUrl = signedData?.signedUrl ?? null

let actionError = ''
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = form.get('action') as string

  if (action === 'reassign') {
    if (!admin) { actionError = 'Only admins can reassign documents.' }
    else {
      const newPersonId = (form.get('person_id') as string | null) ?? ''
      if (!newPersonId) { actionError = 'Please select a person first.' }
      else {
        const res = await fetch(`${Astro.url.origin}/api/documents/${docId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
          body: JSON.stringify({ person_id: newPersonId }),
        })
        if (res.ok) return Astro.redirect(`/admin/documents/${docId}`)
        else {
          const body = await res.json() as { error?: string }
          actionError = body.error ?? 'Reassign failed.'
        }
      }
    }
  } else {
    const reviewer_notes = (form.get('reviewer_notes') as string | null) || null
    const res = await fetch(`${Astro.url.origin}/api/documents/${docId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({ action, reviewer_notes }),
    })
    if (res.ok) return Astro.redirect(`/admin/documents/${docId}`)
    else {
      const body = await res.json() as { error?: string }
      actionError = body.error ?? 'Action failed.'
    }
  }
}

function fmt(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

const STATUS_BG: Record<string, string> = {
  pending: 'var(--color-warning-50)',
  approved: 'var(--color-success-50)',
  rejected: 'var(--color-danger-50)',
}
const STATUS_COLOR: Record<string, string> = {
  pending: 'var(--color-warning-700)',
  approved: 'var(--color-success-700)',
  rejected: 'var(--color-danger-700)',
}
const STATUS_BORDER: Record<string, string> = {
  pending: 'var(--color-warning-300)',
  approved: 'var(--color-success-100)',
  rejected: 'var(--color-danger-100)',
}
const d = doc as any
const uploaderName = JSON.stringify(d.uploader?.full_name ?? '')
---

<style>
  @media (max-width: 700px) {
    .doc-grid {
      grid-template-columns: 1fr !important;
    }
  }
  [x-cloak] { display: none !important; }
  .search-result:hover { background: var(--color-neutral-50); }
</style>

<DashboardLayout title={d.title}>
  <div class="max-w-225">
    <Breadcrumb crumbs={[{ label: 'Documents', href: '/admin/documents' }, { label: d.title }]} />

    <!-- Header -->
    <div class="flex items-center gap-3 mb-6 flex-wrap">
      <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0">{d.title}</h1>
      <span class="inline-block py-0.75 px-3 rounded-full font-body text-xs font-semibold"
        style={`background-color: ${STATUS_BG[d.status] ?? 'var(--color-neutral-100)'}; color: ${STATUS_COLOR[d.status] ?? 'var(--color-neutral-700)'}; border: 1px solid ${STATUS_BORDER[d.status] ?? 'var(--color-neutral-200)'};`}>
        {d.status.charAt(0).toUpperCase() + d.status.slice(1)}
      </span>
    </div>

    <!-- Two-column layout -->
    <div class="doc-grid grid [grid-template-columns:1fr_340px] gap-6 items-start">

      <!-- Left: document info card -->
      <div class="bg-white border border-neutral-200 rounded-lg p-7 flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1">Document Type</p>
            <p class="font-body text-sm text-neutral-800 m-0">{d.document_type?.name ?? '—'}</p>
          </div>
          <div>
            <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1">Uploaded</p>
            <p class="font-body text-sm text-neutral-800 m-0">{fmt(d.created_at)}</p>
          </div>
          {d.issued_by && (
            <div>
              <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1">Issued by</p>
              <p class="font-body text-sm text-neutral-800 m-0">{d.issued_by}</p>
            </div>
          )}
          {d.expiry_date && (
            <div>
              <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1">Expiry date</p>
              <p class="font-body text-sm text-neutral-800 m-0">{fmt(d.expiry_date)}</p>
            </div>
          )}
        </div>

        {d.training && (
          <div class="pt-1 border-t border-neutral-100">
            <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1">Linked Training</p>
            <a href={`/admin/trainings/${d.training.id}`}
              class="font-body text-sm text-brand-navy no-underline font-medium">
              {d.training.title}
            </a>
          </div>
        )}

        <div class="pt-1 border-t border-neutral-100">
          <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1.5">Uploaded by</p>
          {d.uploader ? (
            <div>
              <a href={`/admin/members/${d.uploader.id}`}
                class="font-body text-sm font-medium text-brand-navy no-underline">
                {d.uploader.full_name}
              </a>
              <p class="font-body text-xs text-neutral-400 mt-0.5">{d.uploader.email}</p>
            </div>
          ) : (
            <p class="font-body text-sm text-neutral-400 m-0">—</p>
          )}
        </div>

        {viewUrl && (
          <div class="pt-2">
            <a href={viewUrl} target="_blank" rel="noopener noreferrer"
              class="inline-block py-2.5 px-4.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
              View file &#8599;
            </a>
          </div>
        )}
      </div>

      <!-- Right: review panel -->
      <div class="bg-white border border-neutral-200 rounded-lg p-6 flex flex-col gap-4">
        <h2 class="font-heading text-[15px] font-bold text-neutral-800 m-0">Review</h2>

        {d.status === 'approved' && (
          <div class="bg-success-50 border border-success-100 rounded-md py-3.5 px-4">
            <p class="font-body text-[13px] font-semibold text-success-700 mb-1">Approved</p>
            {d.reviewer && <p class="font-body text-xs text-success-700 mb-0.5">by {d.reviewer.full_name}</p>}
            {d.reviewed_at && <p class="font-body text-xs text-success-700 mb-1.5">{fmt(d.reviewed_at)}</p>}
            {d.reviewer_notes && <p class="font-body text-[13px] text-success-700 m-0 whitespace-pre-wrap">{d.reviewer_notes}</p>}
          </div>
        )}

        {d.status === 'rejected' && (
          <div class="bg-danger-50 border border-danger-100 rounded-md py-3.5 px-4">
            <p class="font-body text-[13px] font-semibold text-danger-700 mb-1">Rejected</p>
            {d.reviewer && <p class="font-body text-xs text-danger-700 mb-0.5">by {d.reviewer.full_name}</p>}
            {d.reviewed_at && <p class="font-body text-xs text-danger-700 mb-1.5">{fmt(d.reviewed_at)}</p>}
            {d.reviewer_notes && <p class="font-body text-[13px] text-danger-700 m-0 whitespace-pre-wrap">{d.reviewer_notes}</p>}
          </div>
        )}

        {d.status === 'pending' && canReviewDoc && (
          <form method="POST" class="flex flex-col gap-3.5">
            <div class="flex flex-col gap-1">
              <label for="reviewerNotes" class="font-body text-[13px] font-medium text-neutral-700">Notes (required to reject)</label>
              <textarea id="reviewerNotes" name="reviewer_notes" rows={4}
                placeholder="Optional notes for the member..."
                class="py-2.5 px-3 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 resize-y"></textarea>
            </div>

            {actionError && (
              <div class="bg-danger-50 border border-danger-200 rounded-md py-2.5 px-3.5 font-body text-[13px] text-danger-700">
                {actionError}
              </div>
            )}

            <div class="flex gap-2">
              <button type="submit" name="action" value="approve"
                class="flex-1 py-2.5 bg-success-700 text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
                Approve
              </button>
              <button type="submit" name="action" value="reject" id="rejectBtn"
                class="flex-1 py-2.5 bg-danger-600 text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
                Reject
              </button>
            </div>
          </form>
        )}

        {d.status === 'pending' && !canReviewDoc && (
          <div class="bg-neutral-50 border border-neutral-200 rounded-md py-3.5 px-4">
            <p class="font-body text-[13px] text-neutral-600 m-0">Awaiting review by an admin or team lead.</p>
          </div>
        )}
      </div>

      {/* Assigned to — admin only */}
      {admin && (
        <div class="bg-white border border-neutral-200 rounded-lg p-6 mt-4 flex flex-col gap-3"
          x-data={`{
            search: ${uploaderName},
            personId: '',
            selectedLabel: '',
            results: [],
            open: false,
            confirmOpen: false,
            _timer: null,
            onInput() {
              this.personId = ''
              this.selectedLabel = ''
              if (this.search.trim().length < 3) { this.open = false; return }
              clearTimeout(this._timer)
              this._timer = setTimeout(async () => {
                try {
                  const r = await fetch('/api/people/search?q=' + encodeURIComponent(this.search.trim()))
                  const j = await r.json()
                  this.results = j.data ?? []
                  this.open = true
                } catch(e) { this.open = false }
              }, 250)
            },
            onFocus() {
              if (this.search.trim().length >= 3) this.onInput()
            },
            select(p) {
              this.personId = p.id
              this.search = p.full_name
              this.selectedLabel = p.full_name + ' (' + p.email + ')'
              this.open = false
            },
            trySubmit() {
              if (!this.personId) return
              this.confirmOpen = true
            },
            doReassign() {
              this.confirmOpen = false
              this.$refs.form.submit()
            }
          }`}>
          <div>
            <h2 class="font-heading text-[15px] font-bold text-neutral-800 mb-1">Assigned to</h2>
            <p class="font-body text-xs text-neutral-400 m-0">Change who this document belongs to.</p>
          </div>

          {actionError && (
            <div class="bg-danger-50 border border-danger-200 rounded-md py-2.5 px-3.5 font-body text-[13px] text-danger-700">
              {actionError}
            </div>
          )}

          <form method="POST" id="reassignForm" x-ref="form" class="flex flex-col gap-2.5">
            <input type="hidden" name="action" value="reassign" />
            <input type="hidden" name="person_id" :value="personId" />

            <div class="relative">
              <input type="text" x-model="search"
                @input="onInput()"
                @focus="onFocus()"
                @blur="setTimeout(() => { open = false }, 150)"
                placeholder="Search by name or email…"
                autocomplete="off"
                class="w-full py-2.25 px-3 border border-neutral-300 rounded-md font-body text-[13px] text-neutral-800 box-border" />
              <div x-show="open"
                class="absolute top-full left-0 right-0 bg-white border border-neutral-300 border-t-0 rounded-t-none rounded-b-md max-h-50 overflow-y-auto z-[200] shadow-[0_4px_12px_rgba(0,0,0,0.08)]">
                <template x-if="results.length === 0">
                  <div x-text="search.trim().length < 3 ? 'Type at least 3 characters…' : 'No results'"
                    class="py-2.5 px-3.5 text-[13px] text-neutral-400 font-body"></div>
                </template>
                <template x-for="p in results" :key="p.id">
                  <div class="search-result py-2.5 px-3.5 cursor-pointer font-body text-[13px]" @mousedown.prevent="select(p)">
                    <span x-text="p.full_name" class="font-medium text-neutral-800"></span>
                    <span x-text="p.email" class="text-xs text-neutral-400 ml-2"></span>
                  </div>
                </template>
              </div>
            </div>

            <div x-show="personId"
              class="bg-neutral-50 border border-neutral-200 rounded-md py-2.5 px-3 font-body text-[13px] text-neutral-700"
              style="display:none">
              Will assign to: <span x-text="selectedLabel"></span>
            </div>

            <button type="button" @click="trySubmit()"
              :disabled="!personId"
              :style="personId ? 'opacity:1; cursor:pointer;' : 'opacity:0.4; cursor:not-allowed;'"
              class="py-2.25 px-4 bg-brand-navy text-white border-0 rounded-md font-body text-[13px] font-semibold transition-opacity duration-150">
              Reassign document
            </button>
          </form>

          <!-- Reassign confirm modal -->
          <div x-show="confirmOpen" x-cloak @click="confirmOpen = false"
            class="fixed inset-0 bg-black/45 z-[1000] flex items-center justify-center">
            <div @click.stop class="bg-white rounded-lg py-7 px-8 max-w-95 w-[90%] shadow-[0_20px_60px_rgba(0,0,0,0.2)]">
              <p class="font-body text-sm font-semibold text-neutral-800 mb-1.5">Reassign document?</p>
              <p class="font-body text-[13px] text-neutral-600 mb-1 leading-normal">Assign this document to:</p>
              <p x-text="selectedLabel" class="font-body text-[13px] font-semibold text-neutral-800 mb-5"></p>
              <div class="flex gap-2.5 justify-end">
                <button @click="confirmOpen = false"
                  class="py-2 px-4 bg-neutral-100 border border-neutral-200 rounded-md font-body text-[13px] font-medium cursor-pointer text-neutral-700">
                  Cancel
                </button>
                <button @click="doReassign()"
                  class="py-2 px-4 bg-brand-navy text-white border-0 rounded-md font-body text-[13px] font-semibold cursor-pointer">
                  Confirm
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
