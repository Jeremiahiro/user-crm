---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const thirtyDaysAgo = new Date()
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30)

type PersonRow = {
  id: string
  full_name: string
  email: string
  status: string
  applied_at: string | null
  date_joined: string | null
  phone: string | null
  address: string | null
  date_of_birth: string | null
  cancellation_type: string | null
}

const { data: pipeline } = await supabaseAdmin
  .from('people')
  .select('id, full_name, email, status, applied_at, date_joined, phone, address, date_of_birth, cancellation_type')
  .in('status', ['applicant', 'in_progress', 'in_training', 'approved', 'active', 'cancelled'])
  .eq('is_archived', false)
  .order('applied_at', { ascending: true })

const people = (pipeline ?? []) as PersonRow[]

const filtered = people.filter(p =>
  p.status !== 'active' ||
  (p.date_joined && new Date(p.date_joined) >= thirtyDaysAgo),
)

const personIds = filtered.map(p => p.id)

const [
  { data: checklistItems },
  { data: teamAssignments },
] = await Promise.all([
  supabaseAdmin
    .from('onboarding_checklist_items')
    .select('person_id, item_key, stage, completed_at')
    .in('person_id', personIds),
  supabaseAdmin
    .from('person_teams')
    .select('person_id')
    .in('person_id', personIds),
])

const IN_PROGRESS_ITEMS = ['interview', 'documentation', 'reference_check']
const IN_TRAINING_ITEMS = ['safeguarding', 'mentoring_100_way', 'dbs_check']
const ALL_ITEMS = [...IN_PROGRESS_ITEMS, ...IN_TRAINING_ITEMS]

const completedByPerson = new Map<string, Set<string>>()
for (const item of checklistItems ?? []) {
  if (item.completed_at) {
    if (!completedByPerson.has(item.person_id)) completedByPerson.set(item.person_id, new Set())
    completedByPerson.get(item.person_id)!.add(item.item_key)
  }
}

const hasTeamIds = new Set((teamAssignments ?? []).map(r => r.person_id))

function profileComplete(p: PersonRow): boolean {
  return !!(p.full_name && p.email && p.phone && p.address && p.date_of_birth)
}

function itemsForStage(status: string): string[] {
  if (status === 'in_progress') return IN_PROGRESS_ITEMS
  if (status === 'in_training') return IN_TRAINING_ITEMS
  return ALL_ITEMS
}

function checkedCount(p: PersonRow): { done: number; total: number } {
  const completed = completedByPerson.get(p.id) ?? new Set()
  const stageItems = itemsForStage(p.status)
  const done = stageItems.filter(k => completed.has(k)).length
  return { done, total: stageItems.length || ALL_ITEMS.length }
}

function daysIn(p: PersonRow): number {
  const d = p.status === 'active' ? p.date_joined : p.applied_at
  if (!d) return 0
  return Math.floor((Date.now() - new Date(d).getTime()) / 86_400_000)
}

const STAGES = [
  { key: 'applicant',   label: 'Applicant',   dotColor: 'bg-neutral-400', advanceLabel: 'Move to In Progress' },
  { key: 'in_progress', label: 'In Progress', dotColor: 'bg-warning-500', advanceLabel: 'Move to In Training' },
  { key: 'in_training', label: 'In Training', dotColor: 'bg-info-500',    advanceLabel: 'Approve'             },
  { key: 'approved',    label: 'Approved',    dotColor: 'bg-success-400', advanceLabel: 'Activate'            },
  { key: 'active',      label: 'Activated',   dotColor: 'bg-success-600', advanceLabel: ''                    },
  { key: 'cancelled',   label: 'Cancelled',   dotColor: 'bg-danger-400',  advanceLabel: ''                    },
] as const

const peopleJson = JSON.stringify(filtered.map(p => {
  const { done, total } = checkedCount(p)
  return {
    id: p.id,
    full_name: p.full_name,
    email: p.email,
    status: p.status,
    applied_at: p.applied_at,
    days: daysIn(p),
    done,
    total,
  }
}))
---

<style>
  .kanban-card:hover { background-color: var(--color-neutral-50); }
  .list-row:hover td { background-color: var(--color-neutral-50); }
  .view-btn:not(.view-btn--active):hover { background-color: var(--color-neutral-200); }
</style>

<DashboardLayout title="Onboarding Pipeline">
  <div x-data={`(function() {
    var people = ${peopleJson};
    return {
      view: 'kanban',
      search: '',
      modal: { open: false, personId: '', label: '', type: 'advance' },
      cancel: { type: '', reason: '' },
      banner: { show: false, text: '', ok: true },
      get filtered() {
        var q = this.search.toLowerCase().trim();
        if (!q) return people;
        return people.filter(function(p) {
          return p.full_name.toLowerCase().includes(q) || p.email.toLowerCase().includes(q);
        });
      },
      byStatus(status) {
        return this.filtered.filter(function(p) { return p.status === status; });
      },
      openAdvance(pid, label) {
        this.modal = { open: true, personId: pid, label: label, type: 'advance' };
      },
      openCancel(pid, name) {
        this.cancel = { type: '', reason: '' };
        this.modal = { open: true, personId: pid, label: name, type: 'cancel' };
      },
      async confirmAdvance(sendEmail) {
        var pid = this.modal.personId;
        this.modal.open = false;
        var res = await fetch('/api/onboarding/' + pid + '/advance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ send_email: sendEmail }),
        });
        var data = await res.json();
        if (res.ok) {
          this.banner = { show: true, text: 'Moved to ' + data.label + '.' + (data.emailSent ? ' Email sent.' : ''), ok: true };
          setTimeout(function() { window.location.reload(); }, 1200);
        } else {
          this.banner = { show: true, text: data.error || 'Failed to advance.', ok: false };
        }
      },
      async confirmCancel() {
        if (!this.cancel.type) return;
        var pid = this.modal.personId;
        this.modal.open = false;
        var res = await fetch('/api/onboarding/' + pid + '/advance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ direction: 'cancel', cancellation_type: this.cancel.type, reason: this.cancel.reason }),
        });
        var data = await res.json();
        if (res.ok) {
          this.banner = { show: true, text: 'Application cancelled.', ok: true };
          setTimeout(function() { window.location.reload(); }, 1200);
        } else {
          this.banner = { show: true, text: data.error || 'Failed to cancel.', ok: false };
        }
      },
    };
  })()`}>

    <!-- Header -->
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy m-0 mb-1">Onboarding Pipeline</h1>
        <p class="font-body text-sm text-neutral-500 m-0">
          {filtered.filter(p => !['active','cancelled'].includes(p.status)).length} applicant{filtered.filter(p => !['active','cancelled'].includes(p.status)).length !== 1 ? 's' : ''} in pipeline
        </p>
      </div>
      <div class="flex items-center gap-2.5">
        <a href="/admin/onboarding/analytics"
          class="px-3.5 py-2 bg-neutral-100 text-neutral-700 rounded-md font-body text-[13px] font-medium no-underline">
          Analytics
        </a>
        <a href="/admin/members/new"
          class="px-4 py-2 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
          + Add applicant
        </a>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="flex items-center gap-3 mb-5">
      <div class="relative flex-1 max-w-[360px]">
        <svg class="absolute left-[11px] top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          type="text"
          x-model="search"
          placeholder="Search by name or email…"
          class="w-full py-[9px] pl-[34px] pr-3 border border-neutral-200 rounded-md font-body text-sm text-neutral-800 outline-none box-border"
        />
      </div>

      <!-- View toggle -->
      <div class="flex items-center gap-1 bg-neutral-100 border border-neutral-200 rounded-md p-1 ml-auto">
        <button @click="view = 'kanban'" title="Board view"
          :class="view === 'kanban' ? 'view-btn--active bg-white text-brand-navy shadow-sm' : 'text-neutral-400'"
          class="view-btn flex items-center justify-center w-[34px] h-[34px] border-none rounded-[6px] cursor-pointer transition-all duration-150">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
          </svg>
        </button>
        <button @click="view = 'list'" title="List view"
          :class="view === 'list' ? 'view-btn--active bg-white text-brand-navy shadow-sm' : 'text-neutral-400'"
          class="view-btn flex items-center justify-center w-[34px] h-[34px] border-none rounded-[6px] cursor-pointer transition-all duration-150">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Banner -->
    <div
      x-show="banner.show"
      :class="banner.ok
        ? 'bg-success-50 border-success-200 text-success-800'
        : 'bg-danger-50 border-danger-200 text-danger-800'"
      x-text="banner.text"
      class="hidden py-3 px-[18px] border rounded-md font-body text-sm mb-4"
    ></div>

    <!-- ── KANBAN VIEW ── -->
    <div x-show="view === 'kanban'" class="overflow-x-auto">
      <div class="grid gap-4 items-start min-w-[1280px]" style="grid-template-columns: repeat(6, minmax(240px, 1fr));">

        {STAGES.map(stage => (
          <div>
            <!-- Column header -->
            <div class="flex items-center gap-2 mb-3 px-0.5">
              <div class={`w-2 h-2 rounded-full shrink-0 ${stage.dotColor}`}></div>
              <h2 class="font-heading text-[11px] font-bold text-neutral-600 m-0 uppercase tracking-[0.06em]">{stage.label}</h2>
              <span x-text={"byStatus('" + stage.key + "').length"} class="font-body text-xs text-neutral-400 ml-auto"></span>
            </div>

            <!-- Cards -->
            <div class="flex flex-col gap-2.5">
              <template x-if={"byStatus('" + stage.key + "').length === 0"}>
                <div class="p-[18px] text-center border border-dashed border-neutral-200 rounded-lg">
                  <p class="font-body text-xs text-neutral-300 m-0">None</p>
                </div>
              </template>

              <template x-for={"p in byStatus('" + stage.key + "')"} :key="p.id">
                <div class="kanban-card bg-white border border-neutral-200 rounded-lg p-4 transition-colors duration-150">
                  <div class="flex items-start justify-between gap-1.5 mb-0.5">
                    <a :href="'/admin/onboarding/' + p.id"
                      x-text="p.full_name"
                      class="font-body text-[13px] font-semibold text-brand-navy no-underline leading-[1.3] break-words">
                    </a>
                    <span
                      x-text="p.days + 'd'"
                      :class="p.days > 30 ? 'bg-danger-50 text-danger-600' : 'bg-neutral-100 text-neutral-500'"
                      class="font-body text-[11px] font-medium whitespace-nowrap py-0.5 px-1.5 rounded-full shrink-0">
                    </span>
                  </div>

                  <p x-text="p.email" class="font-body text-[11px] text-neutral-400 m-0 mb-2.5 overflow-hidden text-ellipsis whitespace-nowrap"></p>

                  {(stage.key === 'in_progress' || stage.key === 'in_training') && (
                    <div class="mb-2.5">
                      <div class="flex justify-between mb-[3px]">
                        <span class="font-body text-[10px] text-neutral-400">Checklist</span>
                        <span x-text="p.done + '/' + p.total" class="font-heading text-[10px] font-bold text-neutral-600"></span>
                      </div>
                      <div class="h-[3px] bg-neutral-100 rounded-full overflow-hidden">
                        <div :style="'width:' + Math.round((p.done/p.total)*100) + '%; height:100%; background:' + (p.done===p.total ? 'var(--color-success-500)' : 'var(--color-brand-gold)') + '; border-radius:9999px'"></div>
                      </div>
                    </div>
                  )}

                  <div class="flex gap-2 mt-1">
                    <a :href="'/admin/onboarding/' + p.id"
                      class="flex-1 text-center py-2 px-3 bg-neutral-100 rounded-md font-body text-xs font-medium text-neutral-600 no-underline">
                      Details
                    </a>

                    {/* Actions dropdown — all stages except active */}
                    {stage.key !== 'active' && (
                      <div class="relative" x-data="{ open: false }">
                        <button
                          @click="open = !open"
                          @keydown.escape.window="open = false"
                          class="flex items-center gap-1 py-2 px-3 bg-brand-navy text-white border-none rounded-md font-body text-xs font-semibold cursor-pointer">
                          Actions
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"/>
                          </svg>
                        </button>
                        <div
                          x-show="open"
                          x-cloak
                          @click.outside="open = false"
                          class="absolute bottom-full right-0 mb-1.5 bg-white border border-neutral-200 rounded-lg shadow-md z-20 min-w-[180px] overflow-hidden">

                          {stage.advanceLabel && (
                            <button
                              @click={`openAdvance(p.id, '${stage.advanceLabel}'); open = false`}
                              class="w-full text-left px-4 py-2.5 font-body text-[13px] text-neutral-700 hover:bg-neutral-50 border-none bg-transparent cursor-pointer">
                              {stage.advanceLabel}
                            </button>
                          )}

                          {stage.key === 'cancelled' && (
                            <button
                              @click="openAdvance(p.id, 'Reinstate'); open = false"
                              class="w-full text-left px-4 py-2.5 font-body text-[13px] text-neutral-700 hover:bg-neutral-50 border-none bg-transparent cursor-pointer">
                              Reinstate
                            </button>
                          )}

                          {stage.key !== 'cancelled' && (
                            <>
                              {stage.advanceLabel && <div class="border-t border-neutral-100 mx-2"></div>}
                              <button
                                @click="openCancel(p.id, p.full_name); open = false"
                                class="w-full text-left px-4 py-2.5 font-body text-[13px] text-danger-600 hover:bg-danger-50 border-none bg-transparent cursor-pointer">
                                Cancel application
                              </button>
                            </>
                          )}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </template>
            </div>
          </div>
        ))}

      </div>
    </div>

    <!-- ── LIST VIEW ── -->
    <div x-show="view === 'list'" style="display:none">
      <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
        <table class="w-full border-collapse">
          <thead class="bg-neutral-50 border-b border-neutral-200">
            <tr>
              <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-2.5 px-4 uppercase tracking-[0.05em]">Name</th>
              <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-2.5 px-4 uppercase tracking-[0.05em]">Stage</th>
              <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-2.5 px-4 uppercase tracking-[0.05em]">Checklist</th>
              <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-2.5 px-4 uppercase tracking-[0.05em]">Applied</th>
              <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-2.5 px-4 uppercase tracking-[0.05em]">Days</th>
              <th class="py-2.5 px-4"></th>
            </tr>
          </thead>
          <tbody>
            <template x-if="filtered.length === 0">
              <tr>
                <td colspan="6" class="p-10 text-center font-body text-sm text-neutral-400">No results match your search.</td>
              </tr>
            </template>
            <template x-for="(p, i) in filtered" :key="p.id">
              <tr class="list-row" :class="i > 0 ? 'border-t border-neutral-100' : ''">
                <td class="py-3 px-4">
                  <a :href="'/admin/onboarding/' + p.id" x-text="p.full_name"
                    class="font-body text-sm font-semibold text-brand-navy no-underline block"></a>
                  <span x-text="p.email" class="font-body text-xs text-neutral-400"></span>
                </td>
                <td class="py-3 px-4">
                  <span
                    x-text="p.status.replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); })"
                    :class="
                      p.status === 'applicant'   ? 'bg-neutral-100 text-neutral-600' :
                      p.status === 'in_progress' ? 'bg-warning-50 text-warning-700 border border-warning-200' :
                      p.status === 'in_training' ? 'bg-info-50 text-info-700 border border-info-200' :
                      p.status === 'approved'    ? 'bg-success-50 text-success-700 border border-success-200' :
                      p.status === 'active'      ? 'bg-success-100 text-success-800' :
                                                   'bg-danger-50 text-danger-700 border border-danger-200'"
                    class="inline-block py-0.5 px-2.5 rounded-full font-body text-xs font-semibold">
                  </span>
                </td>
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2">
                    <div class="w-20 h-1 bg-neutral-100 rounded-full overflow-hidden">
                      <div :style="'width:' + (p.total > 0 ? Math.round((p.done/p.total)*100) : 0) + '%; height:100%; background:var(--color-brand-gold); border-radius:9999px'"></div>
                    </div>
                    <span x-text="p.done + '/' + p.total" class="font-body text-xs text-neutral-500"></span>
                  </div>
                </td>
                <td x-text="p.applied_at ? new Date(p.applied_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'"
                  class="py-3 px-4 font-body text-[13px] text-neutral-600"></td>
                <td class="py-3 px-4">
                  <span
                    x-text="p.days + 'd'"
                    :class="p.days > 30 ? 'text-danger-600 font-semibold' : 'text-neutral-500'"
                    class="font-body text-[13px]">
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <a :href="'/admin/onboarding/' + p.id"
                    class="font-body text-[13px] font-medium text-brand-navy no-underline">
                    View →
                  </a>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── Advance modal ── -->
    <div x-show="modal.open && modal.type === 'advance'" x-cloak
      class="fixed inset-0 z-50 bg-black/45"
      @keydown.escape.window="modal.open = false">
      <div class="flex items-center justify-center w-full h-full" @click.self="modal.open = false">
        <div class="bg-white rounded-xl p-7 max-w-[420px] w-[calc(100%-48px)] shadow-lg">
          <h3 x-text="modal.label + '?'" class="font-heading text-[17px] font-bold text-brand-navy m-0 mb-2"></h3>
          <p class="font-body text-sm text-neutral-600 m-0 mb-6">Would you like to send a status notification email to the applicant?</p>
          <div class="flex gap-2 justify-end flex-wrap">
            <button @click="modal.open = false"
              class="py-[9px] px-4 bg-neutral-100 text-neutral-700 border-none rounded-md font-body text-sm cursor-pointer">
              Cancel
            </button>
            <button @click="confirmAdvance(false)"
              class="py-[9px] px-4 bg-neutral-200 text-neutral-800 border-none rounded-md font-body text-sm font-medium cursor-pointer">
              No email
            </button>
            <button @click="confirmAdvance(true)"
              class="py-[9px] px-[18px] bg-brand-navy text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">
              Send email
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Cancel modal ── -->
    <div x-show="modal.open && modal.type === 'cancel'" x-cloak
      class="fixed inset-0 z-50 bg-black/45"
      @keydown.escape.window="modal.open = false">
      <div class="flex items-center justify-center w-full h-full" @click.self="modal.open = false">
        <div class="bg-white rounded-xl p-7 max-w-[440px] w-[calc(100%-48px)] shadow-lg">
          <h3 class="font-heading text-[17px] font-bold text-danger-700 m-0 mb-1.5">Cancel application</h3>
          <p x-text="'Cancel ' + modal.label + '\'s application?'" class="font-body text-sm text-neutral-600 m-0 mb-5"></p>

          <div class="mb-4">
            <label class="block font-body text-[13px] font-semibold text-neutral-700 mb-1.5">
              Reason <span class="text-danger-600">*</span>
            </label>
            <select x-model="cancel.type"
              class="w-full py-[9px] px-3 border border-neutral-300 rounded-md font-body text-sm bg-white text-neutral-800">
              <option value="" disabled>Select a reason…</option>
              <option value="opted_out">Opted out voluntarily</option>
              <option value="training_incomplete">Did not complete training</option>
              <option value="eligibility">Eligibility / criteria not met</option>
              <option value="no_response">No response / unresponsive</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="mb-6">
            <label class="block font-body text-[13px] font-semibold text-neutral-700 mb-1.5">
              Notes (optional)
            </label>
            <textarea x-model="cancel.reason" rows="2"
              placeholder="Any additional context…"
              class="w-full py-[9px] px-3 border border-neutral-300 rounded-md font-body text-sm resize-y box-border"></textarea>
          </div>

          <div class="flex gap-2 justify-end">
            <button @click="modal.open = false"
              class="py-[9px] px-4 bg-neutral-100 text-neutral-700 border-none rounded-md font-body text-sm cursor-pointer">
              Back
            </button>
            <button @click="confirmCancel()"
              :disabled="!cancel.type"
              :class="cancel.type ? 'bg-danger-600 text-white cursor-pointer' : 'bg-neutral-200 text-neutral-400 cursor-not-allowed'"
              class="py-[9px] px-5 border-none rounded-md font-body text-sm font-semibold">
              Cancel application
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</DashboardLayout>
