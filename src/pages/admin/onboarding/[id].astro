---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Badge from '@/components/ui/Badge.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { formatDate, statusVariant } from '@/lib/utils'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params
const currentYear = new Date().getFullYear()

const [
  { data: person },
  { data: checklist },
  { data: dbs },
  { data: dues },
  { data: documents },
  { data: teams },
  { data: notesRaw },
] = await Promise.all([
  supabaseAdmin.from('people').select('id, full_name, email, status, applied_at, date_joined, phone, address, date_of_birth, notes').eq('id', id ?? '').single(),
  supabaseAdmin.from('onboarding_checklists').select('*').eq('person_id', id ?? '').maybeSingle(),
  supabaseAdmin.from('dbs_records').select('id, expiry_date, created_at').eq('person_id', id ?? '').eq('is_archived', false).order('created_at', { ascending: false }).limit(1),
  supabaseAdmin.from('dues').select('id, year, month, paid_at').eq('person_id', id ?? '').eq('year', currentYear).not('paid_at', 'is', null).limit(1),
  supabaseAdmin.from('documents').select('id, document_type, drive_url, created_at').eq('person_id', id ?? '').eq('upload_status', 'matched').order('created_at', { ascending: false }).limit(3),
  supabaseAdmin.from('person_teams').select('team_id, joined_at, teams(name)').eq('person_id', id ?? ''),
  supabaseAdmin.from('onboarding_notes').select('id, note, created_at, author_id').eq('person_id', id ?? '').order('created_at', { ascending: false }),
])

if (!person) return Astro.redirect('/admin/onboarding')

type ChecklistRow = { person_id: string; welcome_sent_at: string | null; dbs_completed_at: string | null; reference_checked_at: string | null; induction_done_at: string | null; agreement_signed_at: string | null; training_completed_at: string | null; completed_at: string | null; notes: string | null }
type TeamRow = { team_id: string; joined_at: string | null; teams: { name: string } | null }
type DbsRow = { id: string; expiry_date: string | null; created_at: string }
type DuesRow = { id: string; year: number; month: number; paid_at: string | null }
type DocRow = { id: string; document_type: string; drive_url: string | null; created_at: string }
type NoteRow = { id: string; note: string; created_at: string; author_id: string | null }

const cl = checklist as ChecklistRow | null
const teamRows = (teams ?? []) as unknown as TeamRow[]
const dbsRow = dbs?.[0] as DbsRow | undefined
const duesRow = dues?.[0] as DuesRow | undefined
const docRows = (documents ?? []) as unknown as DocRow[]
const noteRows = (notesRaw ?? []) as NoteRow[]

// Resolve author names
const authorIds = [...new Set(noteRows.map(n => n.author_id).filter(Boolean))] as string[]
const { data: authorPeople } = authorIds.length > 0
  ? await supabaseAdmin.from('people').select('id, full_name').in('id', authorIds)
  : { data: [] }
const authorMap = new Map((authorPeople ?? []).map(p => [p.id as string, p.full_name as string]))

function profileComplete(): boolean {
  return !!(person.full_name && person.email && person.phone && person.address && person.date_of_birth)
}

const TRANSITIONS: Record<string, string> = {
  applicant: 'Move to In Progress',
  pending_review: 'Approve',
  approved: 'Activate',
}

const PREV_TRANSITIONS: Record<string, string> = {
  pending_review: 'Move back to Applicant',
  approved: 'Move back to In Progress',
}

const nextAction = TRANSITIONS[person.status as string]
const prevAction = PREV_TRANSITIONS[person.status as string]
const isCancelled = person.status === 'cancelled'

// Build checklist items
const CHECKLIST = [
  {
    id: 'profile_complete',
    label: 'Profile complete',
    description: 'Name, email, phone, address, and date of birth all filled in',
    done: profileComplete(),
    derived: true,
    link: `/admin/members/${id}/edit`,
  },
  {
    id: 'welcome_sent_at',
    label: 'Welcome email sent',
    description: 'Member has received a welcome email from the portal',
    done: !!cl?.welcome_sent_at,
    derived: false,
    doneAt: cl?.welcome_sent_at,
    link: `/admin/email/compose?person_id=${id}`,
  },
  {
    id: 'dbs_submitted',
    label: 'DBS certificate submitted',
    description: dbsRow ? `Submitted — expires ${formatDate(dbsRow.expiry_date)}` : 'No DBS record on file',
    done: !!dbsRow,
    derived: true,
    link: `/admin/members/${id}/dbs/new`,
  },
  {
    id: 'dbs_completed_at',
    label: 'DBS check cleared',
    description: 'Admin has confirmed the DBS check has been fully verified and passed',
    done: !!cl?.dbs_completed_at,
    derived: false,
    doneAt: cl?.dbs_completed_at,
  },
  {
    id: 'reference_checked_at',
    label: 'References verified',
    description: 'Admin has verified the member\'s references',
    done: !!cl?.reference_checked_at,
    derived: false,
    doneAt: cl?.reference_checked_at,
  },
  {
    id: 'agreement_signed_at',
    label: 'Membership agreement signed',
    description: 'Signed membership agreement received and filed',
    done: !!cl?.agreement_signed_at,
    derived: false,
    doneAt: cl?.agreement_signed_at,
    link: `/admin/documents/new?person_id=${id}`,
  },
  {
    id: 'document_uploaded',
    label: 'Photo ID uploaded',
    description: docRows.length > 0 ? `${docRows.length} document${docRows.length !== 1 ? 's' : ''} on file` : 'No documents uploaded yet',
    done: docRows.length > 0,
    derived: true,
    link: `/admin/documents/new?person_id=${id}`,
  },
  {
    id: 'induction_done_at',
    label: 'Induction completed',
    description: 'Member has attended the chapter induction session',
    done: !!cl?.induction_done_at,
    derived: false,
    doneAt: cl?.induction_done_at,
  },
  {
    id: 'team_assigned',
    label: 'Team assigned',
    description: teamRows.length > 0
      ? teamRows.map(t => t.teams?.name).filter(Boolean).join(', ')
      : 'Not assigned to any team',
    done: teamRows.length > 0,
    derived: true,
    link: `/admin/members/${id}?tab=roles`,
  },
  {
    id: 'dues_paid',
    label: `${currentYear} dues paid`,
    description: duesRow ? `Dues marked paid for ${currentYear}` : `No ${currentYear} dues record`,
    done: !!duesRow,
    derived: true,
    link: `/admin/members/${id}?tab=dues`,
  },
  {
    id: 'training_completed_at',
    label: 'Training / Certification completed',
    description: 'Member has completed required training or certification for the chapter',
    done: !!cl?.training_completed_at,
    derived: false,
    doneAt: cl?.training_completed_at,
  },
]

const doneCount = CHECKLIST.filter(c => c.done).length
const progressPct = Math.round((doneCount / CHECKLIST.length) * 100)
---

<DashboardLayout title={`Onboarding — ${person.full_name}`}>
  <div style="max-width: 800px;">
    <Breadcrumb crumbs={[{ label: 'Onboarding', href: '/admin/onboarding' }, { label: 'Application' }]} />

    <!-- ── Header ── -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 24px; margin-bottom: 20px;">
      <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;">
        <div>
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
            <h1 style="font-family: var(--font-heading); font-size: 20px; font-weight: 700; color: var(--color-brand-navy); margin: 0;">{person.full_name}</h1>
            <Badge variant={statusVariant(person.status as string)}>{(person.status as string).replace('_', ' ')}</Badge>
          </div>
          <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0 0 4px;">{person.email}</p>
          {person.applied_at && (
            <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0;">
              Applied {formatDate(person.applied_at as string)}
            </p>
          )}
        </div>
        <div style="display: flex; gap: 8px; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end;">
          <a href={`/admin/members/${id}`}
            style="padding: 8px 14px; background: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; text-decoration: none;">
            Full profile
          </a>
          {prevAction && !isCancelled && (
            <button id="btnRevert"
              style="padding: 8px 14px; background: white; border: 1px solid var(--color-neutral-300); color: var(--color-neutral-600); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; cursor: pointer;">
              {prevAction}
            </button>
          )}
          {!isCancelled && person.status !== 'active' && (
            <button id="btnCancel"
              style="padding: 8px 14px; background: white; border: 1px solid var(--color-danger-300); color: var(--color-danger-600); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; cursor: pointer;">
              Cancel application
            </button>
          )}
          {nextAction && !isCancelled && (
            <button id="btnAdvance"
              style="padding: 8px 16px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
              {nextAction}
            </button>
          )}
          {isCancelled && (
            <button id="btnReactivate"
              style="padding: 8px 16px; background-color: var(--color-success-600); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
              Reinstate as Applicant
            </button>
          )}
        </div>
      </div>

      <!-- Progress bar -->
      <div style="margin-top: 20px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600);">Onboarding progress</span>
          <span style="font-family: var(--font-heading); font-size: 13px; font-weight: 700; color: var(--color-neutral-700);">{doneCount}/{CHECKLIST.length} complete</span>
        </div>
        <div style="height: 8px; background-color: var(--color-neutral-100); border-radius: var(--radius-full); overflow: hidden;">
          <div style={`height: 100%; width: ${progressPct}%; background-color: ${progressPct === 100 ? 'var(--color-success-500)' : 'var(--color-brand-gold)'}; border-radius: var(--radius-full); transition: width 0.3s;`}></div>
        </div>
      </div>
    </div>

    <!-- ── Status flash ── -->
    <div id="statusBanner" style="display: none; padding: 14px 20px; border-radius: var(--radius-md); margin-bottom: 16px; font-family: var(--font-body); font-size: 14px;"></div>

    <!-- ── Checklist ── -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 20px;">
      <div style="padding: 16px 24px; border-bottom: 1px solid var(--color-neutral-100);">
        <h2 style="font-family: var(--font-heading); font-size: 14px; font-weight: 700; color: var(--color-neutral-800); margin: 0;">Onboarding checklist</h2>
      </div>

      {CHECKLIST.map((item, i) => (
        <div style={`display: flex; align-items: flex-start; gap: 14px; padding: 14px 24px;${i > 0 ? ' border-top: 1px solid var(--color-neutral-100);' : ''}`}>

          <!-- Toggle button (only for non-derived items) -->
          {item.derived ? (
            <div style={`width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 13px; ${item.done ? 'background-color: var(--color-success-100); color: var(--color-success-600);' : 'background-color: var(--color-neutral-100); color: var(--color-neutral-300);'}`}>
              {item.done ? '✓' : '○'}
            </div>
          ) : (
            <button
              data-field={item.id}
              data-done={item.done ? 'true' : 'false'}
              onclick={`toggleMilestone('${item.id}', ${item.done})`}
              style={`width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 13px; ${item.done ? 'background-color: var(--color-success-500); color: white;' : 'background-color: var(--color-neutral-200); color: var(--color-neutral-400);'}`}
              title={item.done ? 'Click to unmark' : 'Click to mark complete'}>
              {item.done ? '✓' : '○'}
            </button>
          )}

          <div style="flex: 1; min-width: 0;">
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <span style={`font-family: var(--font-body); font-size: 14px; font-weight: 500; ${item.done ? 'color: var(--color-neutral-700);' : 'color: var(--color-neutral-800);'}`}>
                {item.label}
              </span>
              {item.done && !item.derived && 'doneAt' in item && item.doneAt && (
                <span style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400);">
                  {formatDate(item.doneAt)}
                </span>
              )}
              {!item.derived && (
                <span style="font-family: var(--font-body); font-size: 11px; color: var(--color-neutral-400); font-style: italic;">manual</span>
              )}
            </div>
            <p style={`font-family: var(--font-body); font-size: 13px; margin: 2px 0 0; ${item.done ? 'color: var(--color-neutral-400);' : 'color: var(--color-neutral-500);'}`}>
              {item.description}
            </p>
          </div>

          {item.link && !item.done && (
            <a href={item.link}
              style="flex-shrink: 0; padding: 4px 10px; background: var(--color-neutral-100); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-600); text-decoration: none; white-space: nowrap;">
              Fix →
            </a>
          )}
        </div>
      ))}
    </div>

    <!-- ── Notes ── -->
    <div id="pageData" data-person-id={id} style="display: none;"></div>
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
      <div style="padding: 16px 24px; border-bottom: 1px solid var(--color-neutral-100);">
        <h2 style="font-family: var(--font-heading); font-size: 14px; font-weight: 700; color: var(--color-neutral-800); margin: 0;">Onboarding notes</h2>
      </div>

      <!-- Existing notes -->
      <div id="notesList">
        {noteRows.length === 0 ? (
          <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-400); padding: 20px 24px; margin: 0;">No notes yet.</p>
        ) : noteRows.map(n => (
          <div data-note-id={n.id} style="padding: 14px 24px; border-bottom: 1px solid var(--color-neutral-100);">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;">
              <div style="flex: 1; min-width: 0;">
                <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-800); margin: 0 0 6px; white-space: pre-wrap; word-break: break-word;">{n.note}</p>
                <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0;">
                  {n.author_id ? authorMap.get(n.author_id) ?? 'Unknown' : 'System'} · {formatDate(n.created_at)}
                </p>
              </div>
              <button
                onclick={`deleteNote('${n.id}')`}
                style="flex-shrink: 0; padding: 3px 8px; background: none; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); cursor: pointer;"
                title="Delete note">
                ✕
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Add new note -->
      <div style="padding: 16px 24px; background: var(--color-neutral-50); border-top: 1px solid var(--color-neutral-100);">
        <textarea id="newNoteField" rows={3}
          style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; resize: vertical; box-sizing: border-box;"
          placeholder="Add a note — e.g. contacted by phone, awaiting documents…"></textarea>
        <button id="btnAddNote"
          style="margin-top: 8px; padding: 8px 16px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
          Add note
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  const personId = document.getElementById('pageData').dataset.personId
  const banner = document.getElementById('statusBanner')

  function showBanner(message, type) {
    if (!banner) return
    banner.textContent = message
    banner.style.display = 'block'
    banner.style.backgroundColor = type === 'success' ? 'var(--color-success-50)' : 'var(--color-danger-50)'
    banner.style.border = `1px solid ${type === 'success' ? 'var(--color-success-200)' : 'var(--color-danger-200)'}`
    banner.style.color = type === 'success' ? 'var(--color-success-700)' : 'var(--color-danger-700)'
    setTimeout(() => { if (banner) banner.style.display = 'none' }, 5000)
  }

  // ─── Toggle milestone ─────────────────────────────────────────────────────

  async function toggleMilestone(field, currentlyDone) {
    const res = await fetch(`/api/onboarding/${personId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ field, completed: !currentlyDone }),
    })
    const data = await res.json()
    if (res.ok) {
      window.location.reload()
    } else {
      showBanner(`Failed to update: ${data.error ?? 'Unknown error'}`, 'error')
    }
  }

  window.toggleMilestone = toggleMilestone

  // ─── Add note ─────────────────────────────────────────────────────────────

  document.getElementById('btnAddNote')?.addEventListener('click', async () => {
    const textarea = document.getElementById('newNoteField')
    const note = textarea.value.trim()
    if (!note) return
    const btn = document.getElementById('btnAddNote')
    btn.disabled = true
    btn.textContent = 'Saving…'
    const res = await fetch('/api/onboarding/notes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ person_id: personId, note }),
    })
    if (res.ok) {
      textarea.value = ''
      window.location.reload()
    } else {
      const data = await res.json()
      showBanner(`Failed to add note: ${data.error ?? 'Unknown error'}`, 'error')
      btn.disabled = false
      btn.textContent = 'Add note'
    }
  })

  // ─── Delete note ──────────────────────────────────────────────────────────

  async function deleteNote(noteId) {
    if (!confirm('Delete this note?')) return
    const res = await fetch('/api/onboarding/notes', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: noteId }),
    })
    if (res.ok) {
      const el = document.querySelector(`[data-note-id="${noteId}"]`)
      if (el) el.remove()
    } else {
      showBanner('Failed to delete note.', 'error')
    }
  }

  window.deleteNote = deleteNote

  // ─── Advance forward ──────────────────────────────────────────────────────

  document.getElementById('btnAdvance')?.addEventListener('click', async () => {
    const sendEmail = confirm('Send a status email to the member?\n\nOK = advance and send email\nCancel = advance without email')
    const res = await fetch(`/api/onboarding/${personId}/advance`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ send_email: sendEmail }),
    })
    const data = await res.json()
    if (res.ok && data.success) {
      showBanner(`Moved to "${data.newStatus}".${data.emailSent ? ' Email sent.' : ''}`, 'success')
      setTimeout(() => window.location.reload(), 1500)
    } else {
      showBanner(`Failed: ${data.error ?? 'Unknown error'}`, 'error')
    }
  })

  // ─── Move back ────────────────────────────────────────────────────────────

  document.getElementById('btnRevert')?.addEventListener('click', async () => {
    if (!confirm('Move this member back to the previous stage?')) return
    const res = await fetch(`/api/onboarding/${personId}/advance`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ direction: 'back' }),
    })
    const data = await res.json()
    if (res.ok && data.success) {
      showBanner(`Moved back to "${data.newStatus}".`, 'success')
      setTimeout(() => window.location.reload(), 1500)
    } else {
      showBanner(`Failed: ${data.error ?? 'Unknown error'}`, 'error')
    }
  })

  // ─── Cancel application ───────────────────────────────────────────────────

  document.getElementById('btnCancel')?.addEventListener('click', async () => {
    const reason = prompt('Reason for cancellation (e.g. "Not a good fit", "Withdrew application"):')
    if (reason === null) return
    const res = await fetch(`/api/onboarding/${personId}/advance`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ direction: 'cancel', reason }),
    })
    const data = await res.json()
    if (res.ok && data.success) {
      showBanner('Application cancelled.', 'success')
      setTimeout(() => window.location.reload(), 1500)
    } else {
      showBanner(`Failed: ${data.error ?? 'Unknown error'}`, 'error')
    }
  })

  // ─── Reinstate cancelled ──────────────────────────────────────────────────

  document.getElementById('btnReactivate')?.addEventListener('click', async () => {
    if (!confirm('Reinstate this person as an Applicant?')) return
    const res = await fetch(`/api/onboarding/${personId}/advance`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ direction: 'reinstate' }),
    })
    const data = await res.json()
    if (res.ok && data.success) {
      showBanner('Reinstated as Applicant.', 'success')
      setTimeout(() => window.location.reload(), 1500)
    } else {
      showBanner(`Failed: ${data.error ?? 'Unknown error'}`, 'error')
    }
  })
</script>
