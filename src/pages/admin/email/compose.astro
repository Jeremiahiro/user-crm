---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const preselectedPersonId = Astro.url.searchParams.get('person_id') ?? ''

// Fetch all non-archived members with emails
const { data: members } = await supabaseAdmin
  .from('people')
  .select('id, full_name, email, status')
  .eq('is_archived', false)
  .not('email', 'is', null)
  .order('full_name')

type MemberOption = { id: string; full_name: string; email: string; status: string }
const memberList = (members ?? []) as MemberOption[]

const preselected = preselectedPersonId
  ? (memberList.find(m => m.id === preselectedPersonId) ?? null)
  : null

const membersJSON = JSON.stringify(memberList)
const preselectedJSON = JSON.stringify(preselected)
---

<DashboardLayout title="Compose Email">
  <style is:global>
    .picker-wrap { position: relative; }
    .chips-input {
      display: flex; flex-wrap: wrap; gap: 6px;
      padding: 8px 10px;
      border: 1px solid var(--color-neutral-300);
      border-radius: var(--radius-md);
      background: white; min-height: 44px; cursor: text;
      transition: border-color 0.15s;
    }
    .chips-input:focus-within { border-color: var(--color-brand-navy); }
    .chip {
      display: inline-flex; align-items: center; gap: 5px;
      background: var(--color-brand-navy); color: white;
      padding: 3px 8px 3px 10px; border-radius: 99px;
      font-family: var(--font-body); font-size: 13px; font-weight: 500;
      white-space: nowrap;
    }
    .chip-remove {
      background: none; border: none; color: rgba(255,255,255,0.75);
      cursor: pointer; padding: 0; font-size: 16px; line-height: 1;
      display: flex; align-items: center;
    }
    .chip-remove:hover { color: white; }
    .picker-input {
      border: none; outline: none;
      font-family: var(--font-body); font-size: 14px;
      color: var(--color-neutral-800); flex: 1; min-width: 160px;
      background: transparent;
    }
    .picker-input::placeholder { color: var(--color-neutral-400); }
    .picker-dropdown {
      position: absolute; top: calc(100% + 4px); left: 0; right: 0;
      background: white; border: 1px solid var(--color-neutral-200);
      border-radius: var(--radius-md);
      box-shadow: 0 4px 16px rgba(0,0,0,0.1);
      z-index: 100; max-height: 240px; overflow-y: auto; display: none;
    }
    .picker-dropdown.open { display: block; }
    .picker-option {
      padding: 10px 14px; cursor: pointer;
      font-family: var(--font-body); font-size: 13px;
      color: var(--color-neutral-800);
      border-bottom: 1px solid var(--color-neutral-100);
      display: flex; flex-direction: column; gap: 1px;
    }
    .picker-option:last-child { border-bottom: none; }
    .picker-option:hover, .picker-option.focused { background: var(--color-neutral-50); }
    .picker-option .opt-name { font-weight: 500; }
    .picker-option .opt-email { color: var(--color-neutral-500); font-size: 12px; }
    .picker-option .opt-status { font-size: 11px; color: var(--color-neutral-400); }
    .picker-empty { padding: 12px 14px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-400); }
  </style>

  <div style="max-width: 720px;">
    <Breadcrumb crumbs={[{ label: 'Email', href: '/admin/email' }, { label: 'Compose' }]} />
    <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Compose Email</h1>
    <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0 0 28px;">Write a custom message to one or more members.</p>

    <div id="statusBanner" style="display: none; padding: 14px 20px; border-radius: var(--radius-md); margin-bottom: 20px; font-family: var(--font-body); font-size: 14px;"></div>

    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 20px;">

      <!-- Recipients -->
      <div>
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700); display: block; margin-bottom: 4px;">
          To <span style="color: var(--color-neutral-400); font-weight: 400;">— search members or type an email and press Enter</span>
        </label>
        <div class="picker-wrap" id="pickerWrap">
          <div class="chips-input" id="chipsBox" onclick="document.getElementById('pickerSearch').focus()">
            <input id="pickerSearch" class="picker-input" type="text" placeholder="Name or email…" autocomplete="off" />
          </div>
          <div class="picker-dropdown" id="pickerDropdown"></div>
        </div>
        <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 4px 0 0;">Each recipient gets a separate email — addresses are not shared.</p>
      </div>

      <!-- Subject -->
      <div>
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700); display: block; margin-bottom: 4px;">Subject *</label>
        <input type="text" id="subject" placeholder="Email subject…"
          style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; box-sizing: border-box;" />
      </div>

      <!-- Body -->
      <div>
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700); display: block; margin-bottom: 4px;">Message *</label>
        <textarea id="message" rows={10} placeholder="Write your message here…"
          style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; resize: vertical; box-sizing: border-box;"></textarea>
        <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 4px 0 0;">Blank lines create new paragraphs.</p>
      </div>

      <div style="display: flex; gap: 12px; padding-top: 8px; align-items: center;">
        <button id="btnSend"
          style="padding: 10px 24px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Send email
        </button>
        <button id="btnPreview"
          style="padding: 10px 18px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; cursor: pointer;">
          Preview HTML
        </button>
        <a href="/admin/email"
          style="padding: 10px 18px; color: var(--color-neutral-500); font-family: var(--font-body); font-size: 14px; text-decoration: none;">
          Cancel
        </a>
      </div>
    </div>

    <!-- Preview pane -->
    <div id="previewPane" style="display: none; margin-top: 20px; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
      <div style="padding: 12px 16px; background: var(--color-neutral-50); border-bottom: 1px solid var(--color-neutral-200); display: flex; justify-content: space-between; align-items: center;">
        <p style="font-family: var(--font-body); font-size: 13px; font-weight: 600; color: var(--color-neutral-700); margin: 0;">Email preview</p>
        <button id="btnClosePreview" style="background: none; border: none; cursor: pointer; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500);">Close</button>
      </div>
      <iframe id="previewFrame" style="width: 100%; height: 500px; border: none;"></iframe>
    </div>
  </div>
</DashboardLayout>

<script is:inline define:vars={{ membersJSON, preselectedJSON }}>
  var MEMBERS = JSON.parse(membersJSON)
  var PRESELECTED = JSON.parse(preselectedJSON)
  var selected = [] // [{ email, label }]

  var searchInput = document.getElementById('pickerSearch')
  var chipsBox    = document.getElementById('chipsBox')
  var dropdown    = document.getElementById('pickerDropdown')
  var focusedIdx  = -1

  function selectedEmails() { return selected.map(function(s) { return s.email }) }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
  }

  function renderChips() {
    chipsBox.querySelectorAll('.chip').forEach(function(el) { el.remove() })
    selected.forEach(function(s, i) {
      var chip = document.createElement('span')
      chip.className = 'chip'
      var label = document.createElement('span')
      label.textContent = s.label
      var btn = document.createElement('button')
      btn.className = 'chip-remove'
      btn.type = 'button'
      btn.textContent = '×'
      btn.setAttribute('aria-label', 'Remove ' + s.label)
      btn.addEventListener('click', function(e) {
        e.stopPropagation()
        selected.splice(i, 1)
        renderChips()
      })
      chip.appendChild(label)
      chip.appendChild(btn)
      chipsBox.insertBefore(chip, searchInput)
    })
  }

  function addRecipient(email, label) {
    email = (email || '').trim().toLowerCase()
    if (!email) return
    if (selectedEmails().indexOf(email) !== -1) return
    selected.push({ email: email, label: label || email })
    renderChips()
    searchInput.value = ''
    closeDropdown()
    searchInput.focus()
  }

  function openDropdown(query) {
    query = (query || '').toLowerCase().trim()
    var emails = selectedEmails()
    var matches = MEMBERS.filter(function(m) {
      if (emails.indexOf(m.email.toLowerCase()) !== -1) return false
      if (!query) return true
      return m.full_name.toLowerCase().indexOf(query) !== -1 ||
             m.email.toLowerCase().indexOf(query) !== -1
    }).slice(0, 8)

    dropdown.innerHTML = ''
    focusedIdx = -1

    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

    if (matches.length === 0 && query) {
      if (emailRegex.test(query) && emails.indexOf(query) === -1) {
        var div = document.createElement('div')
        div.className = 'picker-option'
        div.innerHTML = '<span class="opt-name">Add <strong>' + esc(query) + '</strong></span><span class="opt-email">Custom email address</span>'
        div.addEventListener('click', function() { addRecipient(query, query) })
        dropdown.appendChild(div)
      } else {
        var empty = document.createElement('div')
        empty.className = 'picker-empty'
        empty.textContent = 'No members found. Type a full email to add it.'
        dropdown.appendChild(empty)
      }
    } else {
      matches.forEach(function(m) {
        var div = document.createElement('div')
        div.className = 'picker-option'
        div.innerHTML =
          '<span class="opt-name">' + esc(m.full_name) + '</span>' +
          '<span class="opt-email">' + esc(m.email) + '</span>'
        div.addEventListener('click', function() { addRecipient(m.email, m.full_name) })
        dropdown.appendChild(div)
      })
    }
    dropdown.classList.add('open')
  }

  function closeDropdown() {
    dropdown.classList.remove('open')
    focusedIdx = -1
  }

  function moveFocus(dir) {
    var options = dropdown.querySelectorAll('.picker-option')
    focusedIdx = Math.max(0, Math.min(focusedIdx + dir, options.length - 1))
    options.forEach(function(o, i) { o.classList.toggle('focused', i === focusedIdx) })
  }

  searchInput.addEventListener('input', function() { openDropdown(searchInput.value) })
  searchInput.addEventListener('focus', function() { openDropdown(searchInput.value) })
  searchInput.addEventListener('keydown', function(e) {
    var options = dropdown.querySelectorAll('.picker-option')
    if (e.key === 'ArrowDown') { e.preventDefault(); moveFocus(1) }
    else if (e.key === 'ArrowUp') { e.preventDefault(); moveFocus(-1) }
    else if (e.key === 'Enter') {
      e.preventDefault()
      if (focusedIdx >= 0 && options[focusedIdx]) {
        options[focusedIdx].click()
      } else {
        var v = searchInput.value.trim()
        if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) addRecipient(v, v)
      }
    } else if (e.key === ',' || e.key === 'Tab') {
      if (e.key === ',') e.preventDefault()
      var v2 = searchInput.value.trim()
      if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v2)) { e.preventDefault(); addRecipient(v2, v2) }
    } else if ((e.key === 'Backspace') && searchInput.value === '' && selected.length > 0) {
      selected.pop(); renderChips()
    } else if (e.key === 'Escape') { closeDropdown() }
  })

  document.addEventListener('click', function(e) {
    if (!document.getElementById('pickerWrap').contains(e.target)) {
      var v = searchInput.value.trim()
      if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) addRecipient(v, v)
      closeDropdown()
    }
  })

  // Preselect from query param
  if (PRESELECTED) {
    addRecipient(PRESELECTED.email, PRESELECTED.full_name)
  }

  // ── Helpers ────────────────────────────────────────────────────────────────
  function textToHtml(text) {
    var escaped = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    return escaped.split(/\n\n+/).map(function(p) {
      return '<p style="margin:0 0 16px;font-size:15px;color:#333;line-height:1.7;">' +
             p.replace(/\n/g,'<br/>') + '</p>'
    }).join('')
  }

  var banner = document.getElementById('statusBanner')
  function showBanner(msg, type) {
    banner.innerHTML = msg
    banner.style.display = 'block'
    banner.style.backgroundColor = type === 'success' ? 'var(--color-success-50)' : 'var(--color-danger-50)'
    banner.style.border = '1px solid ' + (type === 'success' ? 'var(--color-success-200)' : 'var(--color-danger-200)')
    banner.style.color = type === 'success' ? 'var(--color-success-700)' : 'var(--color-danger-700)'
    banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  }

  // ── Send ──────────────────────────────────────────────────────────────────
  document.getElementById('btnSend').addEventListener('click', async function() {
    // Commit any partially-typed email in the input
    var rawInput = searchInput.value.trim()
    if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(rawInput)) addRecipient(rawInput, rawInput)

    var toEmails = selectedEmails()
    var subject  = document.getElementById('subject').value.trim()
    var msgText  = document.getElementById('message').value.trim()

    if (toEmails.length === 0) { showBanner('Please add at least one recipient.', 'error'); return }
    if (!subject)              { showBanner('Please enter a subject.', 'error'); return }
    if (!msgText)              { showBanner('Please write a message.', 'error'); return }

    var btn = document.getElementById('btnSend')
    btn.disabled = true
    btn.textContent = toEmails.length > 1 ? 'Sending to ' + toEmails.length + '…' : 'Sending…'

    try {
      var res = await fetch('/api/email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: toEmails, subject: subject, html: textToHtml(msgText) }),
      })
      var data = await res.json()
      btn.disabled = false
      btn.textContent = 'Send email'

      if (res.ok && data.success) {
        var msg = '✓ Sent to ' + data.sent + ' recipient' + (data.sent !== 1 ? 's' : '') + '.'
        if (data.failed > 0) {
          msg += ' <strong>' + data.failed + ' failed:</strong> ' +
                 (data.failures || []).map(function(f) { return esc(f.to) }).join(', ')
        }
        showBanner(msg, 'success')
        setTimeout(function() { window.location.href = '/admin/email' }, 2500)
      } else {
        showBanner('<strong>Send failed:</strong> ' + esc(data.error || 'Unknown error'), 'error')
      }
    } catch (err) {
      btn.disabled = false
      btn.textContent = 'Send email'
      showBanner('Network error — please try again.', 'error')
    }
  })

  // ── Preview ───────────────────────────────────────────────────────────────
  document.getElementById('btnPreview').addEventListener('click', function() {
    var msgText = document.getElementById('message').value.trim()
    document.getElementById('previewFrame').srcdoc = textToHtml(msgText)
    document.getElementById('previewPane').style.display = 'block'
  })
  document.getElementById('btnClosePreview').addEventListener('click', function() {
    document.getElementById('previewPane').style.display = 'none'
  })
</script>
