---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const today = new Date()
const currentYear = today.getFullYear()

// Dues reminders — only relevant email action
const [{ data: activeMembers }, { data: duesRows }] = await Promise.all([
  supabaseAdmin.from('people').select('id').eq('status', 'active').eq('is_archived', false).or('gender.is.null,gender.neq.female'),
  supabaseAdmin.from('dues').select('person_id').eq('year', currentYear).not('paid_at', 'is', null),
])

const activeMemberIds = new Set((activeMembers ?? []).map(m => m.id as string))
const paidIds = new Set((duesRows ?? []).map(d => d.person_id as string))
const duesUnpaidCount = [...activeMemberIds].filter(id => !paidIds.has(id)).length

// Fetch active templates for quick links
const { data: templates } = await supabaseAdmin
  .from('email_templates')
  .select('id, name, category')
  .eq('is_active', true)
  .order('name', { ascending: true })
  .limit(6)
---

<DashboardLayout title="Email Centre">
  <div class="flex items-center justify-between mb-7">
    <div>
      <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Email Centre</h1>
      <p class="font-body text-sm text-neutral-500 m-0">Compose and send emails to chapter members.</p>
    </div>
    <a href="/admin/email/compose"
      class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
      + Compose email
    </a>
  </div>

  <!-- Status banner -->
  <div id="statusBanner" style="display: none;" class="px-5 py-3.5 rounded-md mb-5 font-body text-sm"></div>

  <!-- Dues reminders card -->
  <div class="grid grid-cols-[1fr_2fr] gap-5 mb-7 items-start">
    <div class="bg-white border border-neutral-200 rounded-lg p-6">
      <p class="font-body text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">Dues reminders</p>
      <p class={`font-heading text-[40px] font-bold leading-none mt-0 mb-1 ${duesUnpaidCount > 0 ? 'text-warning-600' : 'text-success-600'}`}>{duesUnpaidCount}</p>
      <p class="font-body text-[13px] text-neutral-400 mb-4.5">
        {duesUnpaidCount > 0 ? `member${duesUnpaidCount !== 1 ? 's' : ''} yet to pay ${currentYear} dues` : `All members paid up for ${currentYear} ✓`}
      </p>
      {duesUnpaidCount > 0 && (
        <button id="btnDuesReminder"
          class="py-2.25 px-4 bg-warning-600 text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer w-full">
          Send {duesUnpaidCount} reminder{duesUnpaidCount !== 1 ? 's' : ''}
        </button>
      )}
    </div>

    <!-- Quick actions -->
    <div class="bg-white border border-neutral-200 rounded-lg p-6">
      <h2 class="font-heading text-sm font-bold text-neutral-800 mb-4">Quick actions</h2>
      <div class="grid grid-cols-2 gap-3">

        <a href="/admin/email/compose"
          class="flex items-center gap-3 px-4 py-3.5 border border-neutral-200 rounded-md no-underline">
          <span class="text-lg shrink-0">✉️</span>
          <div>
            <p class="font-body text-sm font-semibold text-neutral-800 mb-0.5">Compose email</p>
            <p class="font-body text-xs text-neutral-400 m-0">Write a custom message to members</p>
          </div>
        </a>

        <a href="/admin/email-templates/new"
          class="flex items-center gap-3 px-4 py-3.5 border border-neutral-200 rounded-md no-underline">
          <span class="text-lg shrink-0">📄</span>
          <div>
            <p class="font-body text-sm font-semibold text-neutral-800 mb-0.5">New template</p>
            <p class="font-body text-xs text-neutral-400 m-0">Create a reusable email template</p>
          </div>
        </a>

        <a href="/admin/members?status=pending_review"
          class="flex items-center gap-3 px-4 py-3.5 border border-neutral-200 rounded-md no-underline">
          <span class="text-lg shrink-0">👋</span>
          <div>
            <p class="font-body text-sm font-semibold text-neutral-800 mb-0.5">Welcome new members</p>
            <p class="font-body text-xs text-neutral-400 m-0">Review pending members</p>
          </div>
        </a>

        <a href="/admin/email-templates"
          class="flex items-center gap-3 px-4 py-3.5 border border-neutral-200 rounded-md no-underline">
          <span class="text-lg shrink-0">📋</span>
          <div>
            <p class="font-body text-sm font-semibold text-neutral-800 mb-0.5">All templates</p>
            <p class="font-body text-xs text-neutral-400 m-0">Browse saved email templates</p>
          </div>
        </a>

      </div>
    </div>
  </div>

  <!-- Saved templates list (if any) -->
  {(templates ?? []).length > 0 && (
    <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
      <div class="px-5 py-3.5 border-b border-neutral-100 flex items-center justify-between">
        <h2 class="font-heading text-sm font-bold text-neutral-800 m-0">Saved templates</h2>
        <a href="/admin/email-templates" class="font-body text-xs text-brand-navy no-underline font-medium">View all →</a>
      </div>
      {(templates ?? []).map((t, i) => (
        <div class={`px-5 py-3 flex items-center justify-between${i > 0 ? ' border-t border-neutral-100' : ''}`}>
          <div>
            <p class="font-body text-sm font-medium text-neutral-800 m-0">{t.name}</p>
            <p class="font-body text-xs text-neutral-400 mt-0.5 capitalize">{t.category}</p>
          </div>
          <a href={`/admin/email-templates/${t.id}/edit`}
            class="py-1.25 px-3 bg-neutral-100 text-neutral-700 rounded-md font-body text-xs font-medium no-underline">
            Edit
          </a>
        </div>
      ))}
    </div>
  )}
</DashboardLayout>

<script is:inline>
  (function () {
    var banner = document.getElementById('statusBanner')

    function showBanner(message, type) {
      banner.textContent = message
      banner.style.display = 'block'
      banner.style.backgroundColor = type === 'success' ? '#f0fdf4' : '#fef2f2'
      banner.style.border = '1px solid ' + (type === 'success' ? '#86efac' : '#fca5a5')
      banner.style.color = type === 'success' ? '#166534' : '#991b1b'
      setTimeout(function () { banner.style.display = 'none' }, 8000)
    }

    var duesBtn = document.getElementById('btnDuesReminder')
    if (duesBtn) {
      duesBtn.addEventListener('click', function () {
        var orig = duesBtn.textContent
        duesBtn.disabled = true
        duesBtn.textContent = 'Sending…'
        fetch('/api/email/dues-reminders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dry_run: true }),
        })
          .then(function (r) { return r.json() })
          .then(function (preview) {
            var count = (preview.targets || []).length
            if (!confirm('Send dues reminder to ' + count + ' member' + (count !== 1 ? 's' : '') + '?')) {
              duesBtn.disabled = false
              duesBtn.textContent = orig
              return
            }
            return fetch('/api/email/dues-reminders', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({}),
            })
              .then(function (r) { return r.json() })
              .then(function (result) {
                showBanner('Sent ' + (result.sent || 0) + ' reminder' + ((result.sent || 0) !== 1 ? 's' : '') + '.', 'success')
                setTimeout(function () { window.location.reload() }, 2000)
              })
          })
          .catch(function () { showBanner('Network error. Please try again.', 'error') })
          .finally(function () { duesBtn.disabled = false; duesBtn.textContent = orig })
      })
    }
  })()
</script>
