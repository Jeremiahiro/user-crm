---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const today = new Date()
const currentYear = today.getFullYear()

// Dues reminders — only relevant email action
const [{ data: activeMembers }, { data: duesRows }] = await Promise.all([
  supabaseAdmin.from('people').select('id').eq('status', 'active').eq('is_archived', false).or('gender.is.null,gender.neq.female'),
  supabaseAdmin.from('dues').select('person_id').eq('year', currentYear).not('paid_at', 'is', null),
])

const activeMemberIds = new Set((activeMembers ?? []).map(m => m.id as string))
const paidIds = new Set((duesRows ?? []).map(d => d.person_id as string))
const duesUnpaidCount = [...activeMemberIds].filter(id => !paidIds.has(id)).length

// Fetch active templates for quick links
const { data: templates } = await supabaseAdmin
  .from('email_templates')
  .select('id, name, category')
  .eq('is_active', true)
  .order('name', { ascending: true })
  .limit(6)
---

<DashboardLayout title="Email Centre">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px;">
    <div>
      <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Email Centre</h1>
      <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0;">Compose and send emails to chapter members.</p>
    </div>
    <a href="/admin/email/compose"
      style="padding: 10px 18px; background-color: var(--color-brand-navy); color: white; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
      + Compose email
    </a>
  </div>

  <!-- Status banner -->
  <div id="statusBanner" style="display: none; padding: 14px 20px; border-radius: var(--radius-md); margin-bottom: 20px; font-family: var(--font-body); font-size: 14px;"></div>

  <!-- Dues reminders card -->
  <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 20px; margin-bottom: 28px; align-items: start;">
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 24px;">
      <p style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 8px;">Dues reminders</p>
      <p style={`font-family: var(--font-heading); font-size: 40px; font-weight: 700; color: ${duesUnpaidCount > 0 ? 'var(--color-warning-600)' : 'var(--color-success-600)'}; margin: 0 0 4px; line-height: 1;`}>{duesUnpaidCount}</p>
      <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-400); margin: 0 0 18px;">
        {duesUnpaidCount > 0 ? `member${duesUnpaidCount !== 1 ? 's' : ''} yet to pay ${currentYear} dues` : `All members paid up for ${currentYear} ✓`}
      </p>
      {duesUnpaidCount > 0 && (
        <button id="btnDuesReminder"
          style="padding: 9px 16px; background-color: var(--color-warning-600); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer; width: 100%;">
          Send {duesUnpaidCount} reminder{duesUnpaidCount !== 1 ? 's' : ''}
        </button>
      )}
    </div>

    <!-- Quick actions -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 24px;">
      <h2 style="font-family: var(--font-heading); font-size: 14px; font-weight: 700; color: var(--color-neutral-800); margin: 0 0 16px;">Quick actions</h2>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">

        <a href="/admin/email/compose"
          style="display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); text-decoration: none;">
          <span style="font-size: 18px; flex-shrink: 0;">✉️</span>
          <div>
            <p style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-neutral-800); margin: 0 0 2px;">Compose email</p>
            <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0;">Write a custom message to members</p>
          </div>
        </a>

        <a href="/admin/email-templates/new"
          style="display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); text-decoration: none;">
          <span style="font-size: 18px; flex-shrink: 0;">📄</span>
          <div>
            <p style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-neutral-800); margin: 0 0 2px;">New template</p>
            <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0;">Create a reusable email template</p>
          </div>
        </a>

        <a href="/admin/members?status=pending_review"
          style="display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); text-decoration: none;">
          <span style="font-size: 18px; flex-shrink: 0;">👋</span>
          <div>
            <p style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-neutral-800); margin: 0 0 2px;">Welcome new members</p>
            <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0;">Review pending members</p>
          </div>
        </a>

        <a href="/admin/email-templates"
          style="display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); text-decoration: none;">
          <span style="font-size: 18px; flex-shrink: 0;">📋</span>
          <div>
            <p style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-neutral-800); margin: 0 0 2px;">All templates</p>
            <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0;">Browse saved email templates</p>
          </div>
        </a>

      </div>
    </div>
  </div>

  <!-- Saved templates list (if any) -->
  {(templates ?? []).length > 0 && (
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
      <div style="padding: 14px 20px; border-bottom: 1px solid var(--color-neutral-100); display: flex; align-items: center; justify-content: space-between;">
        <h2 style="font-family: var(--font-heading); font-size: 14px; font-weight: 700; color: var(--color-neutral-800); margin: 0;">Saved templates</h2>
        <a href="/admin/email-templates" style="font-family: var(--font-body); font-size: 12px; color: var(--color-brand-navy); text-decoration: none; font-weight: 500;">View all →</a>
      </div>
      {(templates ?? []).map((t, i) => (
        <div style={`padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; ${i > 0 ? 'border-top: 1px solid var(--color-neutral-100);' : ''}`}>
          <div>
            <p style="font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--color-neutral-800); margin: 0;">{t.name}</p>
            <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 2px 0 0; text-transform: capitalize;">{t.category}</p>
          </div>
          <a href={`/admin/email-templates/${t.id}/edit`}
            style="padding: 5px 12px; background: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; font-weight: 500; text-decoration: none;">
            Edit
          </a>
        </div>
      ))}
    </div>
  )}
</DashboardLayout>

<script is:inline>
  (function () {
    var banner = document.getElementById('statusBanner')

    function showBanner(message, type) {
      banner.textContent = message
      banner.style.display = 'block'
      banner.style.backgroundColor = type === 'success' ? '#f0fdf4' : '#fef2f2'
      banner.style.border = '1px solid ' + (type === 'success' ? '#86efac' : '#fca5a5')
      banner.style.color = type === 'success' ? '#166534' : '#991b1b'
      setTimeout(function () { banner.style.display = 'none' }, 8000)
    }

    var duesBtn = document.getElementById('btnDuesReminder')
    if (duesBtn) {
      duesBtn.addEventListener('click', function () {
        var orig = duesBtn.textContent
        duesBtn.disabled = true
        duesBtn.textContent = 'Sending…'
        fetch('/api/email/dues-reminders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dry_run: true }),
        })
          .then(function (r) { return r.json() })
          .then(function (preview) {
            var count = (preview.targets || []).length
            if (!confirm('Send dues reminder to ' + count + ' member' + (count !== 1 ? 's' : '') + '?')) {
              duesBtn.disabled = false
              duesBtn.textContent = orig
              return
            }
            return fetch('/api/email/dues-reminders', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({}),
            })
              .then(function (r) { return r.json() })
              .then(function (result) {
                showBanner('Sent ' + (result.sent || 0) + ' reminder' + ((result.sent || 0) !== 1 ? 's' : '') + '.', 'success')
                setTimeout(function () { window.location.reload() }, 2000)
              })
          })
          .catch(function () { showBanner('Network error. Please try again.', 'error') })
          .finally(function () { duesBtn.disabled = false; duesBtn.textContent = orig })
      })
    }
  })()
</script>
