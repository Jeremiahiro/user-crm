---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Pagination from '@/components/ui/Pagination.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'
import { createHash } from 'node:crypto'

if (!Astro.locals.user) return Astro.redirect('/login')
if (!isAdmin(Astro.locals.user)) return Astro.redirect('/dashboard')

const VALID_TYPES = ['member', 'mentor', 'volunteer', 'alumni', 'parent', 'trustee']

const PAGE_SIZE = 25
const searchQ      = Astro.url.searchParams.get('q') ?? ''
const statusFilter = Astro.url.searchParams.get('status') ?? ''
const teamFilter   = Astro.url.searchParams.get('team_id') ?? ''
const typeParam    = Astro.url.searchParams.get('type') ?? ''
// Default to 'volunteer' — this page is the volunteers directory
const typeFilter   = VALID_TYPES.includes(typeParam) ? typeParam : 'volunteer'
const page         = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1'))
const offset       = (page - 1) * PAGE_SIZE

let teamPersonIds: string[] | null = null
if (teamFilter) {
  const { data: ptRows } = await supabaseAdmin
    .from('person_teams')
    .select('person_id')
    .eq('team_id', teamFilter)
  teamPersonIds = (ptRows ?? []).map(r => r.person_id as string)
}

let query = supabaseAdmin
  .from('people')
  .select('id, full_name, email, status, person_types, profile_photo_url, date_joined, person_teams(is_team_lead, teams(id, name))', { count: 'exact' })
  .contains('person_types', [typeFilter])
  .eq('is_archived', false)
  .order('full_name')

if (statusFilter) query = query.eq('status', statusFilter)
if (searchQ)      query = query.ilike('full_name', `%${searchQ}%`)
if (teamPersonIds) query = query.in('id', teamPersonIds.length > 0 ? teamPersonIds : ['00000000-0000-0000-0000-000000000000'])

query = query.range(offset, offset + PAGE_SIZE - 1)

const { data: rawRows, count } = await query
const { data: teams } = await supabaseAdmin.from('teams').select('id, name').eq('is_active', true).order('name')

type Row = {
  id: string
  full_name: string
  email: string
  status: string
  person_types: string[]
  profile_photo_url: string | null
  date_joined: string | null
  person_teams: { is_team_lead: boolean; teams: { id: string; name: string } | null }[]
}

const volunteers = (rawRows ?? []) as Row[]
const totalPages = Math.ceil((count ?? 0) / PAGE_SIZE)

const filterParams = new URLSearchParams()
if (searchQ)      filterParams.set('q', searchQ)
if (statusFilter) filterParams.set('status', statusFilter)
if (teamFilter)   filterParams.set('team_id', teamFilter)
if (typeFilter !== 'volunteer') filterParams.set('type', typeFilter)
const paginationBase = `/admin/volunteers${filterParams.toString() ? `?${filterParams}` : ''}`

function titleCase(s: string) {
  return s.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase())
}

const statusOptions = [
  { value: '', label: 'All statuses' },
  { value: 'active', label: 'Active' },
  { value: 'inactive', label: 'Inactive' },
  { value: 'alumni', label: 'Alumni' },
  { value: 'left', label: 'Left' },
]

const STATUS_STYLES: Record<string, string> = {
  active:   'background: var(--color-success-50); color: var(--color-success-700); border: 1px solid var(--color-success-200);',
  inactive: 'background: var(--color-neutral-100); color: var(--color-neutral-600);',
  alumni:   'background: var(--color-info-50); color: var(--color-info-700); border: 1px solid var(--color-info-200);',
  left:     'background: var(--color-danger-50); color: var(--color-danger-700); border: 1px solid var(--color-danger-200);',
}

function gravatarUrl(email: string) {
  const hash = createHash('md5').update(email.toLowerCase().trim()).digest('hex')
  return `https://www.gravatar.com/avatar/${hash}?d=mp&s=72`
}
---

<DashboardLayout title="Volunteers">
  <div>
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
      <div>
        <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Volunteers</h1>
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0;">
          {count ?? 0} volunteer{(count ?? 0) !== 1 ? 's' : ''}{searchQ || statusFilter || teamFilter ? ' (filtered)' : ''}
        </p>
      </div>
      <a href="/admin/members/new?type=volunteer"
        style="padding: 10px 18px; background: var(--color-brand-navy); color: white; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
        + Add volunteer
      </a>
    </div>

    <!-- Filters -->
    <form method="GET" style="display: flex; gap: 10px; align-items: center; margin-bottom: 20px; flex-wrap: wrap;">
      <input type="search" name="q" value={searchQ} placeholder="Search by name…"
        style="padding: 9px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; min-width: 200px;" />
      <select name="type"
        style="padding: 9px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white;">
        {VALID_TYPES.map(t => <option value={t} selected={typeFilter === t}>{titleCase(t)}</option>)}
      </select>
      <select name="status"
        style="padding: 9px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white;">
        {statusOptions.map(o => <option value={o.value} selected={statusFilter === o.value}>{o.label}</option>)}
      </select>
      <select name="team_id"
        style="padding: 9px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white;">
        <option value="">All teams</option>
        {(teams ?? []).map((t: any) => <option value={t.id} selected={teamFilter === t.id}>{t.name}</option>)}
      </select>
      <button type="submit"
        style="padding: 9px 16px; background: var(--color-neutral-800); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; cursor: pointer;">
        Filter
      </button>
      {(searchQ || statusFilter || teamFilter || typeFilter !== 'volunteer') && (
        <a href="/admin/volunteers" style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); text-decoration: none;">
          Clear
        </a>
      )}
    </form>

    {volunteers.length > 0 ? (
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: var(--color-neutral-50); border-bottom: 1px solid var(--color-neutral-200);">
              <th style="padding: 10px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.07em;">Volunteer</th>
              <th style="padding: 10px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.07em;">Team(s)</th>
              <th style="padding: 10px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.07em;">Types</th>
              <th style="padding: 10px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.07em;">Status</th>
              <th style="padding: 10px 16px;"></th>
            </tr>
          </thead>
          <tbody>
            {volunteers.map((v, i) => (
              <tr style={`${i > 0 ? 'border-top: 1px solid var(--color-neutral-100);' : ''}`}
                onmouseover="this.style.backgroundColor='var(--color-neutral-50)'"
                onmouseout="this.style.backgroundColor=''">
                <td style="padding: 12px 16px;">
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; overflow: hidden; flex-shrink: 0;">
                      <img src={v.profile_photo_url ?? gravatarUrl(v.email)} alt={v.full_name} width="36" height="36" style="width:100%;height:100%;object-fit:cover;" />
                    </div>
                    <div>
                      <a href={`/admin/members/${v.id}?from=volunteers`}
                        style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-brand-navy); text-decoration: none; display: block;">
                        {v.full_name}
                      </a>
                      <span style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-500);">{v.email}</span>
                    </div>
                  </div>
                </td>
                <td style="padding: 12px 16px;">
                  <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                    {(v.person_teams ?? []).map(pt => pt.teams && (
                      <span style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-600); background: var(--color-neutral-100); padding: 2px 8px; border-radius: var(--radius-full);">
                        {pt.is_team_lead ? '★ ' : ''}{pt.teams.name}
                      </span>
                    ))}
                    {(!v.person_teams || v.person_teams.length === 0) && (
                      <span style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-400);">—</span>
                    )}
                  </div>
                </td>
                <td style="padding: 12px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600);">
                  {(v.person_types ?? []).map(titleCase).join(', ') || '—'}
                </td>
                <td style="padding: 12px 16px;">
                  <span style={`display: inline-block; padding: 2px 10px; border-radius: var(--radius-full); font-family: var(--font-body); font-size: 12px; font-weight: 600; ${STATUS_STYLES[v.status] ?? 'background: var(--color-neutral-100); color: var(--color-neutral-600);'}`}>
                    {titleCase(v.status)}
                  </span>
                </td>
                <td style="padding: 12px 16px; text-align: right;">
                  <a href={`/admin/members/${v.id}?from=volunteers`}
                    style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-brand-navy); text-decoration: none;">
                    View →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <Pagination page={page} totalPages={totalPages} baseUrl={paginationBase} />
    ) : (
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 60px; text-align: center;">
        <p style="font-family: var(--font-heading); font-size: 16px; font-weight: 700; color: var(--color-neutral-700); margin: 0 0 8px;">No volunteers found</p>
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-400); margin: 0 0 20px;">
          {searchQ || statusFilter || teamFilter ? 'Try adjusting your filters.' : 'Volunteers are people with the "volunteer" person type.'}
        </p>
        {!searchQ && !statusFilter && !teamFilter && (
          <a href="/admin/members/new?type=volunteer"
            style="display: inline-block; padding: 10px 18px; background: var(--color-brand-navy); color: white; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
            Add volunteer
          </a>
        )}
      </div>
    )}
  </div>
</DashboardLayout>
