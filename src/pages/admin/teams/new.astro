---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { data: pillars } = await supabaseAdmin.from('pillars').select('id, name').eq('is_active', true).order('name')

let errors: Record<string, string> = {}
let values: Record<string, string> = {}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/teams`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      name: values.name,
      description: values.description || undefined,
      pillar_id: values.pillar_id || null,
    }),
  })

  if (res.ok) {
    return Astro.redirect('/admin/teams')
  } else {
    const body = await res.json() as { issues?: { fieldErrors?: Record<string, string[]> } }
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title="Add Team">
  <div class="max-w-150">
    <Breadcrumb crumbs={[{ label: 'Teams', href: '/admin/teams' }, { label: 'New Team' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-6">Add Team</h1>

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">
      <Input label="Name *" name="name" value={values.name} error={errors.name} required placeholder="e.g. Education Committee" />
      <Input label="Description" name="description" value={values.description} placeholder="Brief description" />

      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Pillar</label>
        <select name="pillar_id"
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 bg-white">
          <option value="">— None —</option>
          {(pillars ?? []).map((p: { id: string; name: string }) => (
            <option value={p.id} selected={values.pillar_id === p.id}>{p.name}</option>
          ))}
        </select>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">Save team</button>
        <a href="/admin/teams" class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">Cancel</a>
      </div>
    </form>
  </div>
</DashboardLayout>
