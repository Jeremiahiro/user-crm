---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

const admin = isAdmin(user)

const { data: teams, error: teamsError } = await supabaseAdmin
  .from('teams')
  .select('*, pillars(name), person_teams(person_id)')
  .eq('is_active', true)
  .order('name')

if (teamsError) console.error('[teams/index] query error:', teamsError)

type TeamRow = {
  id: string
  name: string
  description: string | null
  is_active: boolean
  pillars: { name: string } | null
  person_teams: { person_id: string }[]
}

const rows = (teams ?? []) as TeamRow[]

// For non-admins: fetch membership and pending requests
let myTeamIds = new Set<string>()
let myPendingTeamIds = new Set<string>()

if (!admin && user.person_id) {
  const [{ data: myMemberships }, { data: myRequests }] = await Promise.all([
    supabaseAdmin
      .from('person_teams')
      .select('team_id')
      .eq('person_id', user.person_id),
    supabaseAdmin
      .from('team_join_requests')
      .select('team_id')
      .eq('person_id', user.person_id)
      .eq('status', 'pending'),
  ])
  myTeamIds = new Set(((myMemberships ?? []) as { team_id: string }[]).map(m => m.team_id))
  myPendingTeamIds = new Set(((myRequests ?? []) as { team_id: string }[]).map(r => r.team_id))
}

// For admins/chapter leadership: fetch pending join request counts per team
let pendingCountMap = new Map<string, number>()
let totalPending = 0
if (admin) {
  const { data: pendingCounts } = await supabaseAdmin
    .from('team_join_requests')
    .select('team_id')
    .eq('status', 'pending')
  const counts: Record<string, number> = {}
  for (const r of ((pendingCounts ?? []) as { team_id: string }[])) {
    counts[r.team_id] = (counts[r.team_id] ?? 0) + 1
  }
  pendingCountMap = new Map(Object.entries(counts))
  totalPending = Object.values(counts).reduce((sum, n) => sum + n, 0)
}
---

<DashboardLayout title="Teams">
  <div>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">
          Teams
        </h1>
        <p class="font-body text-sm text-neutral-500 m-0">
          Chapter teams and working groups.
        </p>
      </div>
      {admin && (
        <a href="/admin/teams/new"
           class="inline-flex items-center gap-1.5 bg-brand-navy text-white px-4.5 py-2.5 rounded-md font-body text-sm font-semibold no-underline">
          + Add team
        </a>
      )}
    </div>

    <!-- Pending requests banner for admins -->
    {admin && totalPending > 0 && (
      <div class="bg-warning-50 border border-warning-200 rounded-lg px-5 py-3.5 mb-5 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-lg">🔔</span>
          <p class="font-body text-sm font-semibold text-warning-800 m-0">
            {totalPending} pending join request{totalPending !== 1 ? 's' : ''} need{totalPending === 1 ? 's' : ''} review
          </p>
        </div>
        <p class="font-body text-[13px] text-warning-700 m-0">
          Click a team to approve or decline
        </p>
      </div>
    )}

    {teamsError && (
      <div class="bg-[#fef2f2] border border-[#fca5a5] rounded-md px-4 py-3 mb-5 font-body text-sm text-[#991b1b]">
        Failed to load teams. Please refresh the page.
      </div>
    )}

    {rows.length > 0 ? (
      <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-neutral-100">
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Name</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Pillar</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Members</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((team) => {
              const isMember = myTeamIds.has(team.id)
              const isPending = myPendingTeamIds.has(team.id)
              const pendingCount = pendingCountMap.get(team.id) ?? 0
              return (
                <tr class="border-t border-neutral-100 hover:bg-neutral-50">
                  <td class="px-4 py-3.5">
                    <a href={`/admin/teams/${team.id}`}
                       class="font-body text-sm font-semibold text-brand-navy no-underline">
                      {team.name}
                    </a>
                    {team.description && (
                      <p class="font-body text-xs text-neutral-500 mt-0.5">{team.description}</p>
                    )}
                  </td>
                  <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600">
                    {team.pillars?.name ?? <span class="text-neutral-400">—</span>}
                  </td>
                  <td class="px-4 py-3.5 font-body text-[13px] text-neutral-700">
                    {team.person_teams?.length ?? 0}
                  </td>
                  <td class="px-4 py-3.5 text-right">
                    <div class="inline-flex items-center gap-2">
                      {admin ? (
                        <>
                          {pendingCount > 0 && (
                            <span class="px-2 py-0.5 bg-warning-100 text-warning-700 rounded-full font-body text-[11px] font-semibold">
                              {pendingCount} pending
                            </span>
                          )}
                          <a href={`/admin/teams/${team.id}/edit`}
                             class="font-body text-[13px] font-medium text-neutral-600 no-underline px-3 py-1.5 rounded-md border border-neutral-200">
                            Edit
                          </a>
                        </>
                      ) : isMember ? (
                        <span class="px-2.5 py-1 bg-success-100 text-success-700 rounded-full font-body text-xs font-semibold">
                          Member
                        </span>
                      ) : isPending ? (
                        <span class="px-2.5 py-1 bg-warning-100 text-warning-700 rounded-full font-body text-xs font-semibold">
                          Requested
                        </span>
                      ) : (
                        <button
                          x-data={`{ loading: false, async request() { this.loading = true; try { const r = await fetch('/api/teams/${team.id}/join-request', { method: 'POST' }); if (r.ok) { location.reload() } else { const b = await r.json(); alert(b.error || 'Failed to send request.'); this.loading = false } } catch { alert('Network error.'); this.loading = false } } }`}
                          @click="request()"
                          :disabled="loading"
                          x-text="loading ? 'Sending…' : 'Request to join'"
                          class="px-3 py-1.5 bg-brand-navy text-white border-0 rounded-md font-body text-[13px] font-medium cursor-pointer">
                          Request to join
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    ) : (
      <EmptyState heading="No teams yet" subtext="Teams group members by function. Add your first team.">
        {admin && (
          <a slot="cta" href="/admin/teams/new"
             class="inline-block bg-brand-navy text-white px-4.5 py-2.5 rounded-md font-body text-sm font-semibold no-underline">
            Add first team
          </a>
        )}
      </EmptyState>
    )}
  </div>
</DashboardLayout>
