---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

const admin = isAdmin(user)

const { data: teams, error: teamsError } = await supabaseAdmin
  .from('teams')
  .select('*, pillars(name), person_teams(person_id)')
  .eq('is_active', true)
  .order('name')

if (teamsError) console.error('[teams/index] query error:', teamsError)

type TeamRow = {
  id: string
  name: string
  description: string | null
  is_active: boolean
  pillars: { name: string } | null
  person_teams: { person_id: string }[]
}

const rows = (teams ?? []) as TeamRow[]

// For non-admins: fetch membership and pending requests
let myTeamIds = new Set<string>()
let myPendingTeamIds = new Set<string>()

if (!admin && user.person_id) {
  const [{ data: myMemberships }, { data: myRequests }] = await Promise.all([
    supabaseAdmin
      .from('person_teams')
      .select('team_id')
      .eq('person_id', user.person_id),
    supabaseAdmin
      .from('team_join_requests')
      .select('team_id')
      .eq('person_id', user.person_id)
      .eq('status', 'pending'),
  ])
  myTeamIds = new Set(((myMemberships ?? []) as { team_id: string }[]).map(m => m.team_id))
  myPendingTeamIds = new Set(((myRequests ?? []) as { team_id: string }[]).map(r => r.team_id))
}

// For admins/chapter leadership: fetch pending join request counts per team
let pendingCountMap = new Map<string, number>()
let totalPending = 0
if (admin) {
  const { data: pendingCounts } = await supabaseAdmin
    .from('team_join_requests')
    .select('team_id')
    .eq('status', 'pending')
  const counts: Record<string, number> = {}
  for (const r of ((pendingCounts ?? []) as { team_id: string }[])) {
    counts[r.team_id] = (counts[r.team_id] ?? 0) + 1
  }
  pendingCountMap = new Map(Object.entries(counts))
  totalPending = Object.values(counts).reduce((sum, n) => sum + n, 0)
}
---

<DashboardLayout title="Teams">
  <div>
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
      <div>
        <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">
          Teams
        </h1>
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0;">
          Chapter teams and working groups.
        </p>
      </div>
      {admin && (
        <a href="/admin/teams/new"
           style="display: inline-flex; align-items: center; gap: 6px; background-color: var(--color-brand-navy); color: white; padding: 10px 18px; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
          + Add team
        </a>
      )}
    </div>

    <!-- Pending requests banner for admins -->
    {admin && totalPending > 0 && (
      <div style="background: #fffbeb; border: 1px solid var(--color-warning-200); border-radius: var(--radius-lg); padding: 14px 20px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 18px;">🔔</span>
          <p style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-warning-800); margin: 0;">
            {totalPending} pending join request{totalPending !== 1 ? 's' : ''} need{totalPending === 1 ? 's' : ''} review
          </p>
        </div>
        <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-warning-700); margin: 0;">
          Click a team to approve or decline
        </p>
      </div>
    )}

    {teamsError && (
      <div style="background: #fef2f2; border: 1px solid #fca5a5; border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: #991b1b;">
        Failed to load teams. Please refresh the page.
      </div>
    )}

    {rows.length > 0 ? (
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background-color: var(--color-neutral-100);">
              <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Name</th>
              <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Pillar</th>
              <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Members</th>
              <th style="padding: 12px 16px;"></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((team) => {
              const isMember = myTeamIds.has(team.id)
              const isPending = myPendingTeamIds.has(team.id)
              const pendingCount = pendingCountMap.get(team.id) ?? 0
              return (
                <tr style="border-top: 1px solid var(--color-neutral-100);" onmouseover="this.style.backgroundColor='var(--color-neutral-50)'" onmouseout="this.style.backgroundColor=''">
                  <td style="padding: 14px 16px;">
                    <a href={`/admin/teams/${team.id}`}
                       style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-brand-navy); text-decoration: none;">
                      {team.name}
                    </a>
                    {team.description && (
                      <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-500); margin: 2px 0 0;">{team.description}</p>
                    )}
                  </td>
                  <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600);">
                    {team.pillars?.name ?? <span style="color: var(--color-neutral-400);">—</span>}
                  </td>
                  <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-700);">
                    {team.person_teams?.length ?? 0}
                  </td>
                  <td style="padding: 14px 16px; text-align: right;">
                    <div style="display: inline-flex; align-items: center; gap: 8px;">
                      {admin ? (
                        <>
                          {pendingCount > 0 && (
                            <span style="padding: 2px 8px; background-color: var(--color-warning-100); color: var(--color-warning-700); border-radius: var(--radius-full); font-family: var(--font-body); font-size: 11px; font-weight: 600;">
                              {pendingCount} pending
                            </span>
                          )}
                          <a href={`/admin/teams/${team.id}/edit`}
                             style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-600); text-decoration: none; padding: 6px 12px; border-radius: var(--radius-md); border: 1px solid var(--color-neutral-200);">
                            Edit
                          </a>
                        </>
                      ) : isMember ? (
                        <span style="padding: 4px 10px; background-color: var(--color-success-100); color: var(--color-success-700); border-radius: var(--radius-full); font-family: var(--font-body); font-size: 12px; font-weight: 600;">
                          Member
                        </span>
                      ) : isPending ? (
                        <span style="padding: 4px 10px; background-color: var(--color-warning-100); color: var(--color-warning-700); border-radius: var(--radius-full); font-family: var(--font-body); font-size: 12px; font-weight: 600;">
                          Requested
                        </span>
                      ) : (
                        <button
                          x-data={`{ loading: false, async request() { this.loading = true; try { const r = await fetch('/api/teams/${team.id}/join-request', { method: 'POST' }); if (r.ok) { location.reload() } else { const b = await r.json(); alert(b.error || 'Failed to send request.'); this.loading = false } } catch { alert('Network error.'); this.loading = false } } }`}
                          @click="request()"
                          :disabled="loading"
                          x-text="loading ? 'Sending…' : 'Request to join'"
                          style="padding: 6px 12px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer;">
                          Request to join
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    ) : (
      <EmptyState heading="No teams yet" subtext="Teams group members by function. Add your first team.">
        {admin && (
          <a slot="cta" href="/admin/teams/new"
             style="display: inline-block; background-color: var(--color-brand-navy); color: white; padding: 10px 18px; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
            Add first team
          </a>
        )}
      </EmptyState>
    )}
  </div>
</DashboardLayout>

