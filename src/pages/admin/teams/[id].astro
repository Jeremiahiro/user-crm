---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Badge from '@/components/ui/Badge.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)
const currentPersonId = Astro.locals.user.person_id ?? null
const { id } = Astro.params

// Fetch team and pending requests in parallel — requests fetched without FK join to avoid
// PostgREST ambiguity (team_join_requests has two FKs to people: person_id + reviewed_by)
const [{ data: team }, { data: rawRequests }] = await Promise.all([
  supabaseAdmin
    .from('teams')
    .select(`
      *,
      pillars(name),
      person_teams(
        is_team_lead,
        joined_at,
        people(id, full_name, email, status, profile_photo_url)
      )
    `)
    .eq('id', id ?? '')
    .single(),
  supabaseAdmin
    .from('team_join_requests')
    .select('id, person_id, message, created_at')
    .eq('team_id', id ?? '')
    .eq('status', 'pending')
    .order('created_at', { ascending: true }),
])

if (!team) return Astro.redirect('/admin/teams')

// Resolve requester names via separate people lookup
type RawRequest = { id: string; person_id: string; message: string | null; created_at: string }
const rawReqs = (rawRequests ?? []) as RawRequest[]
const requesterIds = rawReqs.map(r => r.person_id)
const { data: requesterPeople } = requesterIds.length > 0
  ? await supabaseAdmin.from('people').select('id, full_name, email').in('id', requesterIds)
  : { data: [] }
const requesterMap = new Map(((requesterPeople ?? []) as { id: string; full_name: string; email: string }[]).map(p => [p.id, p]))

type JoinRequest = {
  id: string
  person_id: string
  message: string | null
  created_at: string
  person: { id: string; full_name: string; email: string } | null
}
const joinRequests: JoinRequest[] = rawReqs.map(r => ({ ...r, person: requesterMap.get(r.person_id) ?? null }))

type PersonTeamRow = {
  is_team_lead: boolean
  joined_at: string | null
  people: {
    id: string
    full_name: string
    email: string
    status: string
    profile_photo_url: string | null
  } | null
}

// Filter out any rows where the person record was deleted
const members = ((team.person_teams as PersonTeamRow[]) ?? []).filter(m => m.people != null) as (PersonTeamRow & { people: NonNullable<PersonTeamRow['people']> })[]
const leads = members.filter(m => m.is_team_lead)
const rest = members.filter(m => !m.is_team_lead)

// Membership and permission checks
const isMember    = currentPersonId ? members.some(m => m.people.id === currentPersonId) : false
const isTeamLead  = currentPersonId ? leads.some(m => m.people.id === currentPersonId) : false
const canReviewRequests = admin || isTeamLead
// Only admins and current members can see who else is on the team
const canSeeMemberList  = admin || isMember
const canManageMembers  = admin || isTeamLead

// Check chapter-level setting for team lead member removal
const { data: removeSetting } = await supabaseAdmin
  .from('org_settings')
  .select('value')
  .eq('key', 'allow_teamlead_remove_member')
  .maybeSingle()
const allowTeamleadRemoveMember = ((removeSetting as { value: string } | null)?.value ?? 'true') === 'true'
const canRemoveMembers = admin || (isTeamLead && allowTeamleadRemoveMember)

// For non-members: check if they have a pending or previously rejected request
let existingRequestStatus: 'pending' | 'rejected' | null = null
if (!admin && !isMember && currentPersonId) {
  const { data: existingReq } = await supabaseAdmin
    .from('team_join_requests')
    .select('status')
    .eq('team_id', id ?? '')
    .eq('person_id', currentPersonId)
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle()
  if (existingReq) existingRequestStatus = (existingReq as { status: string }).status as 'pending' | 'rejected'
}
---

<DashboardLayout title={team.name as string}>
  <Breadcrumb crumbs={[{ label: 'Teams', href: '/admin/teams' }, { label: team.name as string }]} />
  <div x-data="teamPage()">
    <!-- Header -->
    <div class="flex items-start justify-between mb-8 pb-6 border-b border-neutral-200">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mt-0 mb-2">{team.name}</h1>
        <div class="flex items-center gap-3">
          {team.pillars && (
            <span class="font-body text-[13px] text-neutral-500">
              {(team.pillars as { name: string }).name}
            </span>
          )}
          <Badge variant={(team.is_active as boolean) ? 'success' : 'neutral'}>
            {(team.is_active as boolean) ? 'Active' : 'Archived'}
          </Badge>
        </div>
        {team.description && (
          <p class="font-body text-sm text-neutral-600 mt-2 mb-0 max-w-120">{team.description}</p>
        )}
      </div>
      <div class="flex gap-2 items-center">
        {(admin || isTeamLead) && (
          <a href={`/admin/teams/${id}/export`}
             class="py-2 px-4 bg-neutral-100 text-neutral-700 rounded-md font-body text-[13px] font-medium no-underline border border-neutral-200">
            ↓ Export CSV
          </a>
        )}
        {admin && (
          <a href={`/admin/teams/${id}/edit`}
             class="py-2 px-4 bg-neutral-100 text-neutral-700 rounded-md font-body text-[13px] font-medium no-underline">
            Edit
          </a>
        )}
      </div>
    </div>

    <!-- Team leads (visible to members + admins only) -->
    {canSeeMemberList && leads.length > 0 && (
      <div class="mb-8">
        <h2 class="font-heading text-[13px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mt-0 mb-3">Team Lead{leads.length > 1 ? 's' : ''}</h2>
        <div class="flex gap-3 flex-wrap">
          {leads.map(m => (
            <a href={`/admin/members/${m.people.id}`}
               class="flex items-center gap-2.5 bg-white border border-neutral-200 rounded-lg py-3 px-4 no-underline">
              <div class="w-9 h-9 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center font-body text-[13px] font-semibold shrink-0">
                {m.people.profile_photo_url
                  ? <img src={m.people.profile_photo_url} alt={m.people.full_name} width={36} height={36} class="rounded-full object-cover" />
                  : m.people.full_name.split(' ').map((n: string) => n[0]).slice(0,2).join('')}
              </div>
              <div>
                <p class="font-body text-sm font-semibold text-brand-navy m-0">{m.people.full_name}</p>
                <p class="font-body text-xs text-neutral-500 m-0">Team Lead</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Pending join requests (admins + team leads only) -->
    {canReviewRequests && joinRequests.length > 0 && (
      <div class="mb-8">
        <h2 class="font-heading text-[13px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mt-0 mb-3">
          Pending Requests ({joinRequests.length})
        </h2>
        <div class="flex flex-col gap-2.5">
          {joinRequests.map(req => (
            <div id={`req-${req.id}`} class="bg-white border border-warning-200 rounded-lg py-4 px-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <a href={`/admin/members/${req.person_id}`}
                    class="font-body text-sm font-semibold text-brand-navy no-underline mb-0.5 block">
                    {req.person?.full_name ?? 'Unknown'}
                  </a>
                  <p class="font-body text-xs text-neutral-500 mt-0 mb-2">{req.person?.email}</p>
                  {req.message && (
                    <p class="font-body text-[13px] text-neutral-700 m-0 italic">"{req.message}"</p>
                  )}
                </div>
                <div class="flex gap-2 shrink-0">
                  <button
                    @click={`approveRequest('${req.id}')`}
                    class="py-1.5 px-3.5 bg-success-600 text-white border-0 rounded-md font-body text-[13px] font-semibold cursor-pointer">
                    Approve
                  </button>
                  <button
                    @click={`rejectOpen['${req.id}'] = !rejectOpen['${req.id}']`}
                    class="py-1.5 px-3.5 bg-neutral-100 text-danger-600 border border-danger-200 rounded-md font-body text-[13px] font-semibold cursor-pointer">
                    Decline
                  </button>
                </div>
              </div>
              <!-- Rejection reason form (hidden by default, controlled by Alpine) -->
              <div x-show={`rejectOpen['${req.id}']`} style="display: none;" class="mt-3 pt-3 border-t border-neutral-200">
                <label class="font-body text-[13px] font-medium text-neutral-700 block mb-1.5">
                  Reason for declining *
                </label>
                <textarea
                  x-model={`rejectReasons['${req.id}']`}
                  rows={2}
                  placeholder="Briefly explain why the request was declined. This will be shared with the member."
                  class="w-full py-2 px-2.5 border border-neutral-300 rounded-md font-body text-[13px] resize-y box-border"
                ></textarea>
                <div class="flex gap-2 mt-2">
                  <button
                    @click={`confirmReject('${req.id}')`}
                    class="py-1.5 px-3.5 bg-danger-600 text-white border-0 rounded-md font-body text-[13px] font-semibold cursor-pointer">
                    Confirm decline
                  </button>
                  <button
                    @click={`rejectOpen['${req.id}'] = false; rejectReasons['${req.id}'] = ''`}
                    class="py-1.5 px-3.5 bg-neutral-100 text-neutral-600 border-0 rounded-md font-body text-[13px] cursor-pointer">
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Members table — members and admins only -->
    {canSeeMemberList ? (
      <div>
        <div class="flex items-center justify-between mb-3 gap-3 flex-wrap">
          <h2 class="font-heading text-[13px] font-semibold text-neutral-500 uppercase tracking-[0.08em] m-0">
            Members ({members.length})
          </h2>
          {canManageMembers && (
            <div class="relative" @click.outside="hideSearch()">
              <input
                type="text"
                x-model="searchQuery"
                @input="onSearchInput()"
                @keydown.escape="hideSearch(); searchQuery = ''"
                placeholder="Add member by name…"
                autocomplete="off"
                class="py-[7px] px-3 border border-neutral-300 rounded-md font-body text-[13px] w-[220px] outline-none"
              />
              <div x-show="searchOpen" style="display: none;" class="absolute top-[calc(100%+4px)] right-0 min-w-[280px] bg-white border border-neutral-200 rounded-md shadow-[0_4px_16px_rgba(0,0,0,0.10)] z-[200] max-h-[260px] overflow-y-auto">
                <template x-if="searchResults.length === 1 && searchResults[0]._loading">
                  <div class="py-3 px-4 font-body text-[13px] text-neutral-500">Searching…</div>
                </template>
                <template x-if="searchResults.length === 1 && searchResults[0]._empty">
                  <div class="py-3 px-4 font-body text-[13px] text-neutral-500">No matching members found.</div>
                </template>
                <template x-if="searchResults.length === 1 && searchResults[0]._error">
                  <div class="py-3 px-4 font-body text-[13px] text-danger-600">Search failed. Try again.</div>
                </template>
                <template x-for="person in searchResults.filter(r => !r._loading && !r._empty && !r._error)" :key="person.id">
                  <div
                    @click="addMember(person.id)"
                    class="flex items-center gap-2.5 py-2.5 px-4 cursor-pointer border-b border-neutral-100 hover:bg-neutral-50">
                    <div class="w-7 h-7 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center text-[11px] font-semibold shrink-0 overflow-hidden">
                      <img x-show="person.profile_photo_url" :src="person.profile_photo_url" class="w-7 h-7 rounded-full object-cover" />
                      <span x-show="!person.profile_photo_url" x-text="person.full_name.split(' ').map(function(n){return n[0]||''}).slice(0,2).join('')"></span>
                    </div>
                    <div>
                      <div class="font-body text-sm font-medium text-brand-navy" x-text="person.full_name"></div>
                      <div class="font-body text-xs text-neutral-500" x-text="person.email"></div>
                    </div>
                  </div>
                </template>
              </div>
            </div>
          )}
        </div>

        {members.length > 0 ? (
          <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-neutral-100">
                  <th class="py-3 px-4 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Name</th>
                  <th class="py-3 px-4 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Status</th>
                  <th class="py-3 px-4 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Joined</th>
                  {canManageMembers && (
                    <th class="py-3 px-4 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Actions</th>
                  )}
                </tr>
              </thead>
              <tbody>
                {rest.map(m => (
                  <tr class="border-t border-neutral-100 hover:bg-neutral-50">
                    <td class="py-3.5 px-4">
                      <a href={`/admin/members/${m.people.id}`}
                         class="font-body text-sm font-medium text-brand-navy no-underline">
                        {m.people.full_name}
                      </a>
                      <p class="font-body text-xs text-neutral-500 m-0">{m.people.email}</p>
                    </td>
                    <td class="py-3.5 px-4">
                      <Badge variant={m.people.status === 'active' ? 'success' : m.people.status === 'pending_review' ? 'warning' : 'neutral'}>
                        {m.people.status}
                      </Badge>
                    </td>
                    <td class="py-3.5 px-4 font-body text-[13px] text-neutral-500">
                      {m.joined_at ? new Date(m.joined_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}
                    </td>
                    {canManageMembers && (
                      <td class="py-3.5 px-4">
                        <div class="flex gap-1.5 flex-wrap items-center">
                          <a href={`/admin/praise/new?person_id=${m.people.id}`}
                             class="py-1 px-2.5 bg-transparent text-warning-600 border border-warning-400 rounded-md font-body text-xs font-medium no-underline whitespace-nowrap">
                            Praise
                          </a>
                          <a href={`/admin/email/compose?person_id=${m.people.id}`}
                             class="py-1 px-2.5 bg-transparent text-neutral-700 border border-neutral-300 rounded-md font-body text-xs font-medium no-underline whitespace-nowrap">
                            Email
                          </a>
                          <button
                            @click="toggleLead($el.dataset.personId, $el.dataset.personName, true)"
                            data-person-id={m.people.id}
                            data-person-name={m.people.full_name}
                            class="py-1 px-2.5 bg-transparent text-brand-navy border border-brand-navy rounded-md font-body text-xs font-medium cursor-pointer whitespace-nowrap">
                            Make lead
                          </button>
                          {canRemoveMembers && (
                            <button
                              @click="removeMember($el.dataset.personId, $el.dataset.personName)"
                              data-person-id={m.people.id}
                              data-person-name={m.people.full_name}
                              class="py-1 px-2.5 bg-transparent text-danger-600 border border-danger-300 rounded-md font-body text-xs font-medium cursor-pointer whitespace-nowrap">
                              Remove
                            </button>
                          )}
                        </div>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <EmptyState heading="No members yet" subtext="Members are added to teams from the member profile page." />
        )}
      </div>
    ) : (
      <div class="bg-white border border-neutral-200 rounded-lg py-12 px-8 text-center">
        <p class="text-[32px] mt-0 mb-3">🔒</p>
        <p class="font-heading text-base font-bold text-brand-navy mt-0 mb-1.5">
          Members are only visible to team members
        </p>
        <p class="font-body text-sm text-neutral-500 mt-0 mb-5">
          This team has {members.length} member{members.length !== 1 ? 's' : ''}.
          {existingRequestStatus === 'pending'
            ? ' Your request to join is pending approval.'
            : existingRequestStatus === 'rejected'
              ? ' Your previous request was not approved.'
              : ' Request to join to see who\'s on the team.'}
        </p>
        {existingRequestStatus === 'pending' ? (
          <span class="inline-block py-2 px-[18px] bg-warning-100 text-warning-700 rounded-full font-body text-[13px] font-semibold">
            Request pending
          </span>
        ) : existingRequestStatus !== 'rejected' && (
          <button
            id="join-btn"
            @click="requestJoin()"
            class="py-2.5 px-[22px] bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
            Request to join
          </button>
        )}
      </div>
    )}

    <!-- ─── Alpine: confirm modal ──────────────────────────────────── -->
    <div
      x-show="modal.open"
      style="display:none;"
      class="fixed inset-0 z-[1000] flex items-center justify-center bg-[rgba(0,0,0,0.45)]"
      @click.self="modal.pending || (modal.open = false)"
    >
      <div class="bg-white rounded-lg p-7 max-w-[440px] w-[90%] shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
        <h3 x-text="modal.title" class="font-heading text-[17px] font-bold text-brand-navy mt-0 mb-2.5"></h3>
        <p x-text="modal.body" class="font-body text-sm text-neutral-600 mt-0 mb-6 leading-normal"></p>
        <div class="flex gap-2.5 justify-end">
          <button
            @click="modal.open = false"
            :disabled="modal.pending"
            class="py-2 px-4 bg-neutral-100 text-neutral-700 border-0 rounded-md font-body text-[13px] cursor-pointer">
            Cancel
          </button>
          <button
            @click="doConfirm()"
            :disabled="modal.pending"
            :style="modal.danger ? 'background: var(--color-danger-600); color: white;' : 'background: var(--color-brand-navy); color: white;'"
            class="py-2 px-4 border-0 rounded-md font-body text-[13px] font-semibold cursor-pointer">
            <span x-text="modal.pending ? 'Please wait…' : modal.confirmText"></span>
          </button>
        </div>
      </div>
    </div>

  </div>
</DashboardLayout>

<script is:inline>
  window.teamPage = function () {
    var teamId = window.location.pathname.split('/').filter(Boolean).pop()
    return {
      teamId: teamId,

      // ── Generic confirm modal ──────────────────────────────────────
      modal: { open: false, title: '', body: '', confirmText: 'Confirm', danger: true, pending: false, onConfirm: null },

      openConfirm: function (title, body, onConfirm, opts) {
        this.modal = {
          open: true, title: title, body: body,
          confirmText: (opts && opts.confirmText) ? opts.confirmText : 'Confirm',
          danger: opts ? opts.danger !== false : true,
          pending: false, onConfirm: onConfirm,
        }
      },

      doConfirm: async function () {
        this.modal.pending = true
        try { await this.modal.onConfirm() } finally { this.modal.pending = false; this.modal.open = false }
      },

      // ── Per-request reject form state ──────────────────────────────
      rejectOpen: {},
      rejectReasons: {},

      // ── Approve join request ───────────────────────────────────────
      approveRequest: function (requestId) {
        var self = this
        this.openConfirm(
          'Approve join request',
          'Approve this join request?',
          async function () {
            var r = await fetch('/api/teams/' + self.teamId + '/join-request', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ requestId: requestId, action: 'approve' }),
            })
            if (r.ok) {
              var el = document.getElementById('req-' + requestId)
              if (el) el.remove()
            } else {
              var j = await r.json()
              alert(j.error || 'Failed to approve.')
            }
          },
          { confirmText: 'Approve', danger: false }
        )
      },

      // ── Confirm reject ─────────────────────────────────────────────
      confirmReject: async function (requestId) {
        var reason = ((this.rejectReasons[requestId] || '')).trim()
        if (!reason) { alert('Please provide a reason for declining.'); return }
        var r = await fetch('/api/teams/' + this.teamId + '/join-request', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requestId: requestId, action: 'reject', reason: reason }),
        })
        if (r.ok) {
          var el = document.getElementById('req-' + requestId)
          if (el) el.remove()
        } else {
          var j = await r.json()
          alert(j.error || 'Failed to decline.')
        }
      },

      // ── Member search typeahead ────────────────────────────────────
      searchQuery: '',
      searchResults: [],
      searchOpen: false,
      _searchTimer: null,

      onSearchInput: function () {
        var self = this
        clearTimeout(this._searchTimer)
        if (this.searchQuery.trim().length < 3) { this.searchOpen = false; return }
        this._searchTimer = setTimeout(function () { self.runSearch() }, 300)
      },

      runSearch: async function () {
        this.searchResults = [{ _loading: true }]
        this.searchOpen = true
        try {
          var res = await fetch('/api/people/search?q=' + encodeURIComponent(this.searchQuery.trim()) + '&exclude_team=' + this.teamId)
          var data = await res.json()
          var people = data.data || []
          this.searchResults = people.length ? people : [{ _empty: true }]
        } catch (e) {
          this.searchResults = [{ _error: true }]
        }
      },

      hideSearch: function () {
        this.searchOpen = false
        this.searchResults = []
      },

      // ── Add member ─────────────────────────────────────────────────
      addMember: async function (personId) {
        this.hideSearch()
        this.searchQuery = ''
        var r = await fetch('/api/teams/' + this.teamId + '/members', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ personId: personId }),
        })
        if (r.ok) { location.reload() }
        else { var j = await r.json(); alert(j.error || 'Failed to add member.') }
      },

      // ── Remove member ──────────────────────────────────────────────
      removeMember: function (personId, name) {
        var self = this
        this.openConfirm(
          'Remove member',
          'Remove ' + name + ' from this team?',
          async function () {
            var r = await fetch('/api/teams/' + self.teamId + '/members/' + personId, { method: 'DELETE' })
            if (r.ok) { location.reload() }
            else { var j = await r.json(); alert(j.error || 'Failed.') }
          }
        )
      },

      // ── Toggle team lead ───────────────────────────────────────────
      toggleLead: function (personId, name, makeLead) {
        var self = this
        this.openConfirm(
          makeLead ? 'Make team lead' : 'Remove lead status',
          makeLead ? 'Make ' + name + ' a team lead?' : 'Remove lead status from ' + name + '?',
          async function () {
            var r = await fetch('/api/teams/' + self.teamId + '/members/' + personId, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ is_team_lead: makeLead }),
            })
            if (r.ok) { location.reload() }
            else { var j = await r.json(); alert(j.error || 'Failed.') }
          },
          { confirmText: makeLead ? 'Make lead' : 'Remove lead', danger: !makeLead }
        )
      },

      // ── Request to join ────────────────────────────────────────────
      requestJoin: async function () {
        var btn = document.getElementById('join-btn')
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…' }
        var r = await fetch('/api/teams/' + this.teamId + '/join-request', { method: 'POST' })
        if (r.ok) { location.reload() }
        else { var j = await r.json(); alert(j.error || 'Failed to send request.'); if (btn) { btn.disabled = false; btn.textContent = 'Request to join' } }
      },
    }
  }
</script>
