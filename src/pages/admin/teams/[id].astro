---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Badge from '@/components/ui/Badge.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)
const currentPersonId = Astro.locals.user.person_id ?? null
const { id } = Astro.params

// Fetch team and pending requests in parallel — requests fetched without FK join to avoid
// PostgREST ambiguity (team_join_requests has two FKs to people: person_id + reviewed_by)
const [{ data: team }, { data: rawRequests }] = await Promise.all([
  supabaseAdmin
    .from('teams')
    .select(`
      *,
      pillars(name),
      person_teams(
        is_team_lead,
        joined_at,
        people(id, full_name, email, status, profile_photo_url)
      )
    `)
    .eq('id', id ?? '')
    .single(),
  supabaseAdmin
    .from('team_join_requests')
    .select('id, person_id, message, created_at')
    .eq('team_id', id ?? '')
    .eq('status', 'pending')
    .order('created_at', { ascending: true }),
])

if (!team) return Astro.redirect('/admin/teams')

// Resolve requester names via separate people lookup
type RawRequest = { id: string; person_id: string; message: string | null; created_at: string }
const rawReqs = (rawRequests ?? []) as RawRequest[]
const requesterIds = rawReqs.map(r => r.person_id)
const { data: requesterPeople } = requesterIds.length > 0
  ? await supabaseAdmin.from('people').select('id, full_name, email').in('id', requesterIds)
  : { data: [] }
const requesterMap = new Map(((requesterPeople ?? []) as { id: string; full_name: string; email: string }[]).map(p => [p.id, p]))

type JoinRequest = {
  id: string
  person_id: string
  message: string | null
  created_at: string
  person: { id: string; full_name: string; email: string } | null
}
const joinRequests: JoinRequest[] = rawReqs.map(r => ({ ...r, person: requesterMap.get(r.person_id) ?? null }))

type PersonTeamRow = {
  is_team_lead: boolean
  joined_at: string | null
  people: {
    id: string
    full_name: string
    email: string
    status: string
    profile_photo_url: string | null
  } | null
}

// Filter out any rows where the person record was deleted
const members = ((team.person_teams as PersonTeamRow[]) ?? []).filter(m => m.people != null) as (PersonTeamRow & { people: NonNullable<PersonTeamRow['people']> })[]
const leads = members.filter(m => m.is_team_lead)
const rest = members.filter(m => !m.is_team_lead)

// Membership and permission checks
const isMember    = currentPersonId ? members.some(m => m.people.id === currentPersonId) : false
const isTeamLead  = currentPersonId ? leads.some(m => m.people.id === currentPersonId) : false
const canReviewRequests = admin || isTeamLead
// Only admins and current members can see who else is on the team
const canSeeMemberList  = admin || isMember
const canManageMembers  = admin || isTeamLead

// Check chapter-level setting for team lead member removal
const { data: removeSetting } = await supabaseAdmin
  .from('org_settings')
  .select('value')
  .eq('key', 'allow_teamlead_remove_member')
  .maybeSingle()
const allowTeamleadRemoveMember = ((removeSetting as { value: string } | null)?.value ?? 'true') === 'true'
const canRemoveMembers = admin || (isTeamLead && allowTeamleadRemoveMember)

// For non-members: check if they have a pending or previously rejected request
let existingRequestStatus: 'pending' | 'rejected' | null = null
if (!admin && !isMember && currentPersonId) {
  const { data: existingReq } = await supabaseAdmin
    .from('team_join_requests')
    .select('status')
    .eq('team_id', id ?? '')
    .eq('person_id', currentPersonId)
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle()
  if (existingReq) existingRequestStatus = (existingReq as { status: string }).status as 'pending' | 'rejected'
}
---

<DashboardLayout title={team.name as string}>
  <Breadcrumb crumbs={[{ label: 'Teams', href: '/admin/teams' }, { label: team.name as string }]} />
  <div x-data="teamPage()">
    <!-- Header -->
    <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--color-neutral-200);">
      <div>
        <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 8px;">{team.name}</h1>
        <div style="display: flex; align-items: center; gap: 12px;">
          {team.pillars && (
            <span style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500);">
              {(team.pillars as { name: string }).name}
            </span>
          )}
          <Badge variant={(team.is_active as boolean) ? 'success' : 'neutral'}>
            {(team.is_active as boolean) ? 'Active' : 'Archived'}
          </Badge>
        </div>
        {team.description && (
          <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-600); margin: 8px 0 0; max-width: 480px;">{team.description}</p>
        )}
      </div>
      <div style="display: flex; gap: 8px; align-items: center;">
        {(admin || isTeamLead) && (
          <a href={`/admin/teams/${id}/export`}
             style="padding: 8px 16px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 500; text-decoration: none; border: 1px solid var(--color-neutral-200);">
            ↓ Export CSV
          </a>
        )}
        {admin && (
          <a href={`/admin/teams/${id}/edit`}
             style="padding: 8px 16px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 500; text-decoration: none;">
            Edit
          </a>
        )}
      </div>
    </div>

    <!-- Team leads (visible to members + admins only) -->
    {canSeeMemberList && leads.length > 0 && (
      <div style="margin-bottom: 32px;">
        <h2 style="font-family: var(--font-heading); font-size: 13px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 12px;">Team Lead{leads.length > 1 ? 's' : ''}</h2>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          {leads.map(m => (
            <a href={`/admin/members/${m.people.id}`}
               style="display: flex; align-items: center; gap: 10px; background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 12px 16px; text-decoration: none;">
              <div style="width: 36px; height: 36px; border-radius: var(--radius-full); background-color: var(--color-brand-gold); color: var(--color-brand-navy); display: flex; align-items: center; justify-content: center; font-family: var(--font-body); font-size: 13px; font-weight: 600; flex-shrink: 0;">
                {m.people.profile_photo_url
                  ? <img src={m.people.profile_photo_url} alt={m.people.full_name} width={36} height={36} style="border-radius: var(--radius-full); object-fit: cover;" />
                  : m.people.full_name.split(' ').map((n: string) => n[0]).slice(0,2).join('')}
              </div>
              <div>
                <p style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-brand-navy); margin: 0;">{m.people.full_name}</p>
                <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-500); margin: 0;">Team Lead</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Pending join requests (admins + team leads only) -->
    {canReviewRequests && joinRequests.length > 0 && (
      <div style="margin-bottom: 32px;">
        <h2 style="font-family: var(--font-heading); font-size: 13px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 12px;">
          Pending Requests ({joinRequests.length})
        </h2>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {joinRequests.map(req => (
            <div id={`req-${req.id}`} style="background: white; border: 1px solid var(--color-warning-200); border-radius: var(--radius-lg); padding: 16px 20px;">
              <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;">
                <div>
                  <a href={`/admin/members/${req.person_id}`}
                    style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-brand-navy); text-decoration: none; margin: 0 0 2px; display: block;">
                    {req.person?.full_name ?? 'Unknown'}
                  </a>
                  <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-500); margin: 0 0 8px;">{req.person?.email}</p>
                  {req.message && (
                    <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-700); margin: 0; font-style: italic;">"{req.message}"</p>
                  )}
                </div>
                <div style="display: flex; gap: 8px; flex-shrink: 0;">
                  <button
                    @click={`approveRequest('${req.id}')`}
                    style="padding: 6px 14px; background: var(--color-success-600); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
                    Approve
                  </button>
                  <button
                    @click={`rejectOpen['${req.id}'] = !rejectOpen['${req.id}']`}
                    style="padding: 6px 14px; background: var(--color-neutral-100); color: var(--color-danger-600); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
                    Decline
                  </button>
                </div>
              </div>
              <!-- Rejection reason form (hidden by default, controlled by Alpine) -->
              <div x-show={`rejectOpen['${req.id}']`} style="display: none; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--color-neutral-200);">
                <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700); display: block; margin-bottom: 6px;">
                  Reason for declining *
                </label>
                <textarea
                  x-model={`rejectReasons['${req.id}']`}
                  rows={2}
                  placeholder="Briefly explain why the request was declined. This will be shared with the member."
                  style="width: 100%; padding: 8px 10px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; resize: vertical; box-sizing: border-box;"
                ></textarea>
                <div style="display: flex; gap: 8px; margin-top: 8px;">
                  <button
                    @click={`confirmReject('${req.id}')`}
                    style="padding: 6px 14px; background: var(--color-danger-600); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
                    Confirm decline
                  </button>
                  <button
                    @click={`rejectOpen['${req.id}'] = false; rejectReasons['${req.id}'] = ''`}
                    style="padding: 6px 14px; background: var(--color-neutral-100); color: var(--color-neutral-600); border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; cursor: pointer;">
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Members table — members and admins only -->
    {canSeeMemberList ? (
      <div>
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; gap: 12px; flex-wrap: wrap;">
          <h2 style="font-family: var(--font-heading); font-size: 13px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">
            Members ({members.length})
          </h2>
          {canManageMembers && (
            <div style="position: relative;" @click.outside="hideSearch()">
              <input
                type="text"
                x-model="searchQuery"
                @input="onSearchInput()"
                @keydown.escape="hideSearch(); searchQuery = ''"
                placeholder="Add member by name…"
                autocomplete="off"
                style="padding: 7px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; width: 220px; outline: none;"
              />
              <div x-show="searchOpen" style="display: none; position: absolute; top: calc(100% + 4px); right: 0; min-width: 280px; background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); box-shadow: 0 4px 16px rgba(0,0,0,0.10); z-index: 200; max-height: 260px; overflow-y: auto;">
                <template x-if="searchResults.length === 1 && searchResults[0]._loading">
                  <div style="padding: 12px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500);">Searching…</div>
                </template>
                <template x-if="searchResults.length === 1 && searchResults[0]._empty">
                  <div style="padding: 12px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500);">No matching members found.</div>
                </template>
                <template x-if="searchResults.length === 1 && searchResults[0]._error">
                  <div style="padding: 12px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-danger-600);">Search failed. Try again.</div>
                </template>
                <template x-for="person in searchResults.filter(r => !r._loading && !r._empty && !r._error)" :key="person.id">
                  <div
                    @click="addMember(person.id)"
                    style="display:flex;align-items:center;gap:10px;padding:10px 16px;cursor:pointer;border-bottom:1px solid var(--color-neutral-100);"
                    @mouseenter="$el.style.backgroundColor='var(--color-neutral-50)'"
                    @mouseleave="$el.style.backgroundColor=''">
                    <div style="width:28px;height:28px;border-radius:50%;background:var(--color-brand-gold);color:var(--color-brand-navy);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0;overflow:hidden;">
                      <img x-show="person.profile_photo_url" :src="person.profile_photo_url" style="width:28px;height:28px;border-radius:50%;object-fit:cover;" />
                      <span x-show="!person.profile_photo_url" x-text="person.full_name.split(' ').map(function(n){return n[0]||''}).slice(0,2).join('')"></span>
                    </div>
                    <div>
                      <div style="font-family:var(--font-body);font-size:14px;font-weight:500;color:var(--color-brand-navy);" x-text="person.full_name"></div>
                      <div style="font-family:var(--font-body);font-size:12px;color:var(--color-neutral-500);" x-text="person.email"></div>
                    </div>
                  </div>
                </template>
              </div>
            </div>
          )}
        </div>

        {members.length > 0 ? (
          <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr style="background-color: var(--color-neutral-100);">
                  <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Name</th>
                  <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Status</th>
                  <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Joined</th>
                  {canManageMembers && (
                    <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Actions</th>
                  )}
                </tr>
              </thead>
              <tbody>
                {rest.map(m => (
                  <tr style="border-top: 1px solid var(--color-neutral-100);" onmouseover="this.style.backgroundColor='var(--color-neutral-50)'" onmouseout="this.style.backgroundColor=''">
                    <td style="padding: 14px 16px;">
                      <a href={`/admin/members/${m.people.id}`}
                         style="font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--color-brand-navy); text-decoration: none;">
                        {m.people.full_name}
                      </a>
                      <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-500); margin: 0;">{m.people.email}</p>
                    </td>
                    <td style="padding: 14px 16px;">
                      <Badge variant={m.people.status === 'active' ? 'success' : m.people.status === 'pending_review' ? 'warning' : 'neutral'}>
                        {m.people.status}
                      </Badge>
                    </td>
                    <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500);">
                      {m.joined_at ? new Date(m.joined_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}
                    </td>
                    {canManageMembers && (
                      <td style="padding: 14px 16px;">
                        <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                          <a href={`/admin/praise/new?person_id=${m.people.id}`}
                             style="padding: 4px 10px; background: transparent; color: var(--color-warning-600, #d97706); border: 1px solid var(--color-warning-400, #fbbf24); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; font-weight: 500; text-decoration: none; white-space: nowrap;">
                            Praise
                          </a>
                          <a href={`/admin/email/compose?person_id=${m.people.id}`}
                             style="padding: 4px 10px; background: transparent; color: var(--color-neutral-700); border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; font-weight: 500; text-decoration: none; white-space: nowrap;">
                            Email
                          </a>
                          <button
                            @click="toggleLead($el.dataset.personId, $el.dataset.personName, true)"
                            data-person-id={m.people.id}
                            data-person-name={m.people.full_name}
                            style="padding: 4px 10px; background: transparent; color: var(--color-brand-navy); border: 1px solid var(--color-brand-navy); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; font-weight: 500; cursor: pointer; white-space: nowrap;">
                            Make lead
                          </button>
                          {canRemoveMembers && (
                            <button
                              @click="removeMember($el.dataset.personId, $el.dataset.personName)"
                              data-person-id={m.people.id}
                              data-person-name={m.people.full_name}
                              style="padding: 4px 10px; background: transparent; color: var(--color-danger-600, #dc2626); border: 1px solid var(--color-danger-300, #fca5a5); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; font-weight: 500; cursor: pointer; white-space: nowrap;">
                              Remove
                            </button>
                          )}
                        </div>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <EmptyState heading="No members yet" subtext="Members are added to teams from the member profile page." />
        )}
      </div>
    ) : (
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 48px 32px; text-align: center;">
        <p style="font-size: 32px; margin: 0 0 12px;">🔒</p>
        <p style="font-family: var(--font-heading); font-size: 16px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 6px;">
          Members are only visible to team members
        </p>
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0 0 20px;">
          This team has {members.length} member{members.length !== 1 ? 's' : ''}.
          {existingRequestStatus === 'pending'
            ? ' Your request to join is pending approval.'
            : existingRequestStatus === 'rejected'
              ? ' Your previous request was not approved.'
              : ' Request to join to see who\'s on the team.'}
        </p>
        {existingRequestStatus === 'pending' ? (
          <span style="display: inline-block; padding: 8px 18px; background: var(--color-warning-100); color: var(--color-warning-700); border-radius: var(--radius-full); font-family: var(--font-body); font-size: 13px; font-weight: 600;">
            Request pending
          </span>
        ) : existingRequestStatus !== 'rejected' && (
          <button
            id="join-btn"
            @click="requestJoin()"
            style="padding: 10px 22px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
            Request to join
          </button>
        )}
      </div>
    )}

    <!-- ─── Alpine: confirm modal ──────────────────────────────────── -->
    <div
      x-show="modal.open"
      style="display:none; position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.45);"
      @click.self="modal.pending || (modal.open = false)"
    >
      <div style="background: white; border-radius: var(--radius-lg); padding: 28px; max-width: 440px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.25);">
        <h3 x-text="modal.title" style="font-family: var(--font-heading); font-size: 17px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 10px;"></h3>
        <p x-text="modal.body" style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-600); margin: 0 0 24px; line-height: 1.5;"></p>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
          <button
            @click="modal.open = false"
            :disabled="modal.pending"
            style="padding: 8px 16px; background: var(--color-neutral-100); color: var(--color-neutral-700); border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; cursor: pointer;">
            Cancel
          </button>
          <button
            @click="doConfirm()"
            :disabled="modal.pending"
            :style="modal.danger ? 'background: var(--color-danger-600); color: white;' : 'background: var(--color-brand-navy); color: white;'"
            style="padding: 8px 16px; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
            <span x-text="modal.pending ? 'Please wait…' : modal.confirmText"></span>
          </button>
        </div>
      </div>
    </div>

  </div>
</DashboardLayout>

<script is:inline>
  window.teamPage = function () {
    var teamId = window.location.pathname.split('/').filter(Boolean).pop()
    return {
      teamId: teamId,

      // ── Generic confirm modal ──────────────────────────────────────
      modal: { open: false, title: '', body: '', confirmText: 'Confirm', danger: true, pending: false, onConfirm: null },

      openConfirm: function (title, body, onConfirm, opts) {
        this.modal = {
          open: true, title: title, body: body,
          confirmText: (opts && opts.confirmText) ? opts.confirmText : 'Confirm',
          danger: opts ? opts.danger !== false : true,
          pending: false, onConfirm: onConfirm,
        }
      },

      doConfirm: async function () {
        this.modal.pending = true
        try { await this.modal.onConfirm() } finally { this.modal.pending = false; this.modal.open = false }
      },

      // ── Per-request reject form state ──────────────────────────────
      rejectOpen: {},
      rejectReasons: {},

      // ── Approve join request ───────────────────────────────────────
      approveRequest: function (requestId) {
        var self = this
        this.openConfirm(
          'Approve join request',
          'Approve this join request?',
          async function () {
            var r = await fetch('/api/teams/' + self.teamId + '/join-request', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ requestId: requestId, action: 'approve' }),
            })
            if (r.ok) {
              var el = document.getElementById('req-' + requestId)
              if (el) el.remove()
            } else {
              var j = await r.json()
              alert(j.error || 'Failed to approve.')
            }
          },
          { confirmText: 'Approve', danger: false }
        )
      },

      // ── Confirm reject ─────────────────────────────────────────────
      confirmReject: async function (requestId) {
        var reason = ((this.rejectReasons[requestId] || '')).trim()
        if (!reason) { alert('Please provide a reason for declining.'); return }
        var r = await fetch('/api/teams/' + this.teamId + '/join-request', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requestId: requestId, action: 'reject', reason: reason }),
        })
        if (r.ok) {
          var el = document.getElementById('req-' + requestId)
          if (el) el.remove()
        } else {
          var j = await r.json()
          alert(j.error || 'Failed to decline.')
        }
      },

      // ── Member search typeahead ────────────────────────────────────
      searchQuery: '',
      searchResults: [],
      searchOpen: false,
      _searchTimer: null,

      onSearchInput: function () {
        var self = this
        clearTimeout(this._searchTimer)
        if (this.searchQuery.trim().length < 3) { this.searchOpen = false; return }
        this._searchTimer = setTimeout(function () { self.runSearch() }, 300)
      },

      runSearch: async function () {
        this.searchResults = [{ _loading: true }]
        this.searchOpen = true
        try {
          var res = await fetch('/api/people/search?q=' + encodeURIComponent(this.searchQuery.trim()) + '&exclude_team=' + this.teamId)
          var data = await res.json()
          var people = data.data || []
          this.searchResults = people.length ? people : [{ _empty: true }]
        } catch (e) {
          this.searchResults = [{ _error: true }]
        }
      },

      hideSearch: function () {
        this.searchOpen = false
        this.searchResults = []
      },

      // ── Add member ─────────────────────────────────────────────────
      addMember: async function (personId) {
        this.hideSearch()
        this.searchQuery = ''
        var r = await fetch('/api/teams/' + this.teamId + '/members', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ personId: personId }),
        })
        if (r.ok) { location.reload() }
        else { var j = await r.json(); alert(j.error || 'Failed to add member.') }
      },

      // ── Remove member ──────────────────────────────────────────────
      removeMember: function (personId, name) {
        var self = this
        this.openConfirm(
          'Remove member',
          'Remove ' + name + ' from this team?',
          async function () {
            var r = await fetch('/api/teams/' + self.teamId + '/members/' + personId, { method: 'DELETE' })
            if (r.ok) { location.reload() }
            else { var j = await r.json(); alert(j.error || 'Failed.') }
          }
        )
      },

      // ── Toggle team lead ───────────────────────────────────────────
      toggleLead: function (personId, name, makeLead) {
        var self = this
        this.openConfirm(
          makeLead ? 'Make team lead' : 'Remove lead status',
          makeLead ? 'Make ' + name + ' a team lead?' : 'Remove lead status from ' + name + '?',
          async function () {
            var r = await fetch('/api/teams/' + self.teamId + '/members/' + personId, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ is_team_lead: makeLead }),
            })
            if (r.ok) { location.reload() }
            else { var j = await r.json(); alert(j.error || 'Failed.') }
          },
          { confirmText: makeLead ? 'Make lead' : 'Remove lead', danger: !makeLead }
        )
      },

      // ── Request to join ────────────────────────────────────────────
      requestJoin: async function () {
        var btn = document.getElementById('join-btn')
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…' }
        var r = await fetch('/api/teams/' + this.teamId + '/join-request', { method: 'POST' })
        if (r.ok) { location.reload() }
        else { var j = await r.json(); alert(j.error || 'Failed to send request.'); if (btn) { btn.disabled = false; btn.textContent = 'Request to join' } }
      },
    }
  }
</script>

