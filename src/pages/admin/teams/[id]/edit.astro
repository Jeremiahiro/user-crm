---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

const { id } = Astro.params

const [{ data: team }, { data: pillars }, { count: memberCount }] = await Promise.all([
  supabaseAdmin.from('teams').select('*').eq('id', id ?? '').single(),
  supabaseAdmin.from('pillars').select('id, name').eq('is_active', true).order('name'),
  supabaseAdmin
    .from('person_teams')
    .select('*', { count: 'exact', head: true })
    .eq('team_id', id ?? ''),
])

if (!team) return Astro.redirect('/admin/teams')

const hasMembers = (memberCount ?? 0) > 0
const isActive = team.is_active as boolean

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {
  name: team.name as string,
  description: (team.description as string | null) ?? '',
  pillar_id: (team.pillar_id as string | null) ?? '',
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/teams/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      name: values.name,
      description: values.description || undefined,
      pillar_id: values.pillar_id || null,
    }),
  })

  if (res.ok) {
    return Astro.redirect('/admin/teams')
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? ''
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title={`Edit ${team.name}`}>
  <div class="max-w-150" id="edit-team-root" data-team-id={id} data-team-name={team.name as string}>
    <Breadcrumb crumbs={[
      { label: 'Teams', href: '/admin/teams' },
      { label: team.name as string, href: `/admin/teams/${id}` },
      { label: 'Edit' },
    ]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-6">Edit Team</h1>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5 mb-6">
      <Input label="Name *" name="name" value={values.name} error={errors.name} required />
      <Input label="Description" name="description" value={values.description} placeholder="Optional — what does this team focus on?" />

      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Pillar</label>
        <select name="pillar_id"
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 bg-white">
          <option value="">— None —</option>
          {(pillars ?? []).map((p: { id: string; name: string }) => (
            <option value={p.id} selected={values.pillar_id === p.id}>{p.name}</option>
          ))}
        </select>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Save changes
        </button>
        <a href="/admin/teams"
          class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>

    <!-- ── Danger zone (admin only) ──────────────────────────────────── -->
    {admin && (
      <div class="border border-danger-200 rounded-lg overflow-hidden">
        <div class="bg-danger-50 px-5 py-3.5 border-b border-danger-200">
          <h2 class="font-heading text-[13px] font-semibold text-danger-700 m-0 uppercase tracking-[0.06em]">Danger zone</h2>
        </div>

        <!-- Archive -->
        <div class="bg-white px-6 py-5 flex items-center justify-between gap-6 border-b border-neutral-100">
          <div>
            <p class="font-body text-sm font-semibold text-neutral-800 mb-0.5">Archive this team</p>
            <p class="font-body text-[13px] text-neutral-500 m-0">
              {hasMembers
                ? `${memberCount} member${memberCount !== 1 ? 's' : ''} assigned — reassign them first.`
                : isActive
                  ? 'Hides the team from active views. Can be reversed by contacting an admin.'
                  : 'This team is already archived.'}
            </p>
          </div>
          <button
            id="archive-btn"
            disabled={hasMembers || !isActive}
            class={`shrink-0 px-4 py-2 rounded-md font-body text-[13px] font-medium bg-white border ${hasMembers || !isActive ? 'cursor-not-allowed border-neutral-200 text-neutral-400' : 'cursor-pointer border-danger-300 text-danger-600'}`}>
            {isActive ? 'Archive' : 'Archived'}
          </button>
        </div>

        <!-- Permanent delete -->
        <div class="bg-white px-6 py-5 flex items-center justify-between gap-6">
          <div>
            <p class="font-body text-sm font-semibold text-neutral-800 mb-0.5">Delete permanently</p>
            <p class="font-body text-[13px] text-neutral-500 m-0">
              {hasMembers
                ? `${memberCount} member${memberCount !== 1 ? 's' : ''} assigned — reassign them first.`
                : 'Permanently removes the team. This cannot be undone.'}
            </p>
          </div>
          <button
            id="delete-btn"
            disabled={hasMembers}
            class={`shrink-0 px-4 py-2 rounded-md font-body text-[13px] font-semibold border-0 ${hasMembers ? 'cursor-not-allowed bg-neutral-100 text-neutral-400' : 'cursor-pointer bg-danger-600 text-white'}`}>
            Delete
          </button>
        </div>
      </div>
    )}
  </div>

  <script is:inline>
    (function () {
      var root = document.getElementById('edit-team-root')
      var teamId = root ? root.dataset.teamId : ''
      var teamName = root ? root.dataset.teamName : ''

      var archiveBtn = document.getElementById('archive-btn')
      if (archiveBtn && !archiveBtn.disabled) {
        archiveBtn.addEventListener('click', function () {
          if (!confirm('Archive "' + teamName + '"? It will be hidden from active views.')) return
          archiveBtn.disabled = true
          archiveBtn.textContent = 'Archiving…'
          fetch('/api/teams/' + teamId, { method: 'DELETE' })
            .then(function (r) {
              if (r.ok) { window.location.href = '/admin/teams' }
              else { r.json().then(function (e) { alert(e.error || 'Failed to archive'); archiveBtn.disabled = false; archiveBtn.textContent = 'Archive' }) }
            })
        })
      }

      var deleteBtn = document.getElementById('delete-btn')
      if (deleteBtn && !deleteBtn.disabled) {
        deleteBtn.addEventListener('click', function () {
          if (!confirm('Permanently delete "' + teamName + '"? This cannot be undone.')) return
          deleteBtn.disabled = true
          deleteBtn.textContent = 'Deleting…'
          fetch('/api/teams/' + teamId + '?permanent=true', { method: 'DELETE' })
            .then(function (r) {
              if (r.ok) { window.location.href = '/admin/teams' }
              else { r.json().then(function (e) { alert(e.error || 'Failed to delete'); deleteBtn.disabled = false; deleteBtn.textContent = 'Delete' }) }
            })
        })
      }
    })()
  </script>
</DashboardLayout>
