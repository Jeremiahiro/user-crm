---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Pagination from '@/components/ui/Pagination.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

const admin = isAdmin(user)

const PAGE_SIZE = 25
const url = Astro.url
const currentYear = new Date().getFullYear()

// Build distinct years list
const { data: yearData } = admin
  ? await supabaseAdmin.from('awards').select('year')
  : await supabaseAdmin.from('awards').select('year').eq('person_id', user.person_id ?? '')

const availableYears = [...new Set(((yearData ?? []) as { year: number }[]).map(r => r.year))].sort((a, b) => b - a)

// Default to current year; fall back to most recent with data
const yearParam = url.searchParams.get('year')
const selectedYear = yearParam
  ? parseInt(yearParam, 10)
  : (availableYears.includes(currentYear) ? currentYear : (availableYears[0] ?? currentYear))
const yearFilter = String(selectedYear)

const page = Math.max(1, parseInt(url.searchParams.get('page') ?? '1'))
const offset = (page - 1) * PAGE_SIZE

type AwardRow = {
  id: string
  type: string
  year: number
  citation: string | null
  created_at: string
  person_id: string | null
  awarded_by: string | null
}

let query = supabaseAdmin
  .from('awards')
  .select('*', { count: 'exact' })
  .order('year', { ascending: false })
  .order('created_at', { ascending: false })

if (!admin && user.person_id) query = query.eq('person_id', user.person_id)
query = query.eq('year', selectedYear)

query = query.range(offset, offset + PAGE_SIZE - 1)

const { data, count: awardCount } = await query
const rows = (data ?? []) as unknown as AwardRow[]
const totalPages = Math.ceil((awardCount ?? 0) / PAGE_SIZE)

const filterParams = new URLSearchParams()
if (yearFilter) filterParams.set('year', yearFilter)
const paginationBase = `/admin/awards${filterParams.toString() ? `?${filterParams}` : ''}`

// Fetch recipient and awarded_by people separately — avoids PostgREST ambiguity with two FKs to same table
const personIds = [...new Set(rows.map(r => r.person_id).filter(Boolean))] as string[]
const { data: rawRecipients } = personIds.length > 0
  ? await supabaseAdmin.from('people').select('id, full_name').in('id', personIds)
  : { data: [] }
const recipientMap = new Map(((rawRecipients ?? []) as { id: string; full_name: string }[]).map(p => [p.id, p.full_name]))

const awardedByIds = [...new Set(rows.map(r => r.awarded_by).filter(Boolean))] as string[]
const { data: rawGrantors } = awardedByIds.length > 0
  ? await supabaseAdmin.from('people').select('id, full_name').in('id', awardedByIds)
  : { data: [] }
const grantorMap = new Map(((rawGrantors ?? []) as { id: string; full_name: string }[]).map(p => [p.id, p.full_name]))

const AWARD_LABELS: Record<string, string> = {
  member_of_the_year: 'Member of the Year',
  volunteer_of_the_year: 'Volunteer of the Year',
  mentor_of_the_year: 'Mentor of the Year',
  rising_star: 'Rising Star',
  community_impact: 'Community Impact',
  leadership_excellence: 'Leadership Excellence',
  special_recognition: 'Special Recognition',
}
---

<DashboardLayout title="Awards">
  <div x-data="{
    modalOpen: false,
    itemId: '',
    message: 'Delete this award? This cannot be undone.',
    loading: false,
    error: '',
    openModal(awardId) {
      this.itemId = awardId;
      this.modalOpen = true;
      this.error = '';
    },
    async doAction() {
      this.loading = true;
      var res = await fetch('/api/awards/' + this.itemId, { method: 'DELETE' });
      if (res.ok) {
        var row = document.querySelector('[data-award-id=\'' + this.itemId + '\']');
        if (row) row.remove();
        this.modalOpen = false;
        this.loading = false;
      } else {
        this.error = 'Failed to delete award.';
        this.loading = false;
      }
    }
  }">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Awards</h1>
        <p class="font-body text-sm text-neutral-500 m-0">{awardCount ?? 0} award{(awardCount ?? 0) !== 1 ? 's' : ''} in {selectedYear}</p>
      </div>
      {admin && (
        <a href="/admin/awards/new"
          class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
          + Give award
        </a>
      )}
    </div>

    <!-- Year filter -->
    {availableYears.length > 0 && (
      <div class="mb-5">
        <select onchange="window.location.href='/admin/awards?year='+this.value"
          class="px-3 py-1.75 border border-neutral-300 rounded-md font-body text-sm bg-white text-neutral-700 cursor-pointer min-w-27.5">
          {availableYears.map(y => (
            <option value={String(y)} selected={y === selectedYear}>{y}</option>
          ))}
        </select>
      </div>
    )}

    <!-- Awards table -->
    <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
      {rows.length === 0 ? (
        <div class="p-12 text-center">
          <p class="font-body text-sm text-neutral-400 mb-4">No awards yet.</p>
          {admin && (
            <a href="/admin/awards/new"
              class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
              Give first award
            </a>
          )}
        </div>
      ) : (
        <table class="w-full border-collapse">
          <thead class="bg-neutral-50 border-b border-neutral-200">
            <tr>
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Award</th>
              {admin && <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Recipient</th>}
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Year</th>
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-wider">Awarded by</th>
              {admin && <th class="px-4 py-2.5"></th>}
            </tr>
          </thead>
          <tbody>
            {rows.map((award, i) => {
              const recipientName = award.person_id ? (recipientMap.get(award.person_id) ?? '—') : '—'
              const grantorName = award.awarded_by ? (grantorMap.get(award.awarded_by) ?? '—') : '—'
              return (
                <tr data-award-id={award.id} class={i > 0 ? 'border-t border-neutral-100' : ''}>
                  <td class="px-4 py-3.5">
                    <div class="flex items-center gap-2.5">
                      <span class="text-xl">🏆</span>
                      <div>
                        <p class="font-body text-sm font-semibold text-brand-gold mb-0.5">{AWARD_LABELS[award.type] ?? award.type}</p>
                        {award.citation && <p class="font-body text-xs text-neutral-500 m-0">{award.citation}</p>}
                      </div>
                    </div>
                  </td>
                  {admin && (
                    <td class="px-4 py-3.5">
                      {award.person_id ? (
                        <a href={`/admin/members/${award.person_id}`}
                          class="font-body text-sm font-medium text-brand-navy no-underline">
                          {recipientName}
                        </a>
                      ) : <span class="text-neutral-400">—</span>}
                    </td>
                  )}
                  <td class="px-4 py-3.5 font-heading text-sm font-semibold text-neutral-700">{award.year}</td>
                  <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600">
                    {grantorName}
                  </td>
                  {admin && (
                    <td class="px-4 py-3.5 text-right">
                      <button @click={`openModal('${award.id}')`}
                        class="px-2.5 py-1 bg-neutral-100 border border-neutral-200 rounded-md font-body text-xs text-neutral-600 cursor-pointer">
                        Delete
                      </button>
                    </td>
                  )}
                </tr>
              )
            })}
          </tbody>
        </table>
      )}
      <Pagination page={page} totalPages={totalPages} baseUrl={paginationBase} />
    </div>

    <!-- Confirmation Modal -->
    <div x-show="modalOpen" @click.self="modalOpen = false" @keydown.escape.window="modalOpen = false"
      class="fixed inset-0 z-100 flex items-center justify-center bg-[rgba(0,0,0,0.45)]">
      <div class="bg-white rounded-lg py-7 px-8 max-w-105 w-[90%] shadow-[0_25px_50px_rgba(0,0,0,0.2)]">
        <h3 class="font-heading text-[17px] font-bold text-brand-navy mb-2.5">Delete award</h3>
        <p x-text="message" class="font-body text-sm text-neutral-700 mb-5 leading-[1.55]"></p>
        <p x-show="error" x-text="error" class="font-body text-[13px] text-danger-600 mb-3.5"></p>
        <div class="flex gap-2.5 justify-end">
          <button @click="modalOpen = false" :disabled="loading"
            class="py-2 px-4.5 bg-neutral-100 border border-neutral-200 rounded-md font-body text-sm font-medium cursor-pointer text-neutral-700">
            Cancel
          </button>
          <button @click="doAction()" :disabled="loading" x-text="loading ? 'Deleting...' : 'Delete'"
            class="py-2 px-4.5 bg-danger-600 text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
