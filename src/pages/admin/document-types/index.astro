---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

const isSuperAdmin = user.roles?.includes('Super Admin') ?? false
const isAdminRole = user.roles?.some(r => ['Super Admin', 'Admin', 'Chapter Leadership'].includes(r)) ?? false
if (!isAdminRole) return Astro.redirect('/dashboard')

type DocType = {
  id: string
  name: string
  slug: string
  requires_issuer: boolean
  requires_expiry: boolean
  is_training_linkable: boolean
  is_active: boolean
  sort_order: number
}

let successMessage = ''
let errorMessage = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = form.get('_action') as string

  if (action === 'create') {
    const name = (form.get('name') as string).trim()
    const requires_issuer = form.get('requires_issuer') === 'true'
    const requires_expiry = form.get('requires_expiry') === 'true'
    const is_training_linkable = form.get('is_training_linkable') === 'true'

    const res = await fetch(`${Astro.url.origin}/api/document-types`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({ name, requires_issuer, requires_expiry, is_training_linkable }),
    })
    if (res.ok) successMessage = `Document type "${name}" created.`
    else {
      const b = await res.json() as { error?: string }
      errorMessage = b.error ?? 'Failed to create document type.'
    }

  } else if (action === 'toggle') {
    const typeId = form.get('type_id') as string
    const is_active = form.get('is_active') === 'true'
    const res = await fetch(`${Astro.url.origin}/api/document-types/${typeId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({ is_active: !is_active }),
    })
    if (!res.ok) {
      const b = await res.json() as { error?: string }
      errorMessage = b.error ?? 'Failed to update.'
    }

  } else if (action === 'delete') {
    const typeId = form.get('type_id') as string
    const res = await fetch(`${Astro.url.origin}/api/document-types/${typeId}`, {
      method: 'DELETE',
      headers: { Cookie: Astro.request.headers.get('cookie') ?? '' },
    })
    if (!res.ok) {
      const b = await res.json() as { error?: string }
      errorMessage = b.error ?? 'Failed to delete.'
    }
  }
}

const { data } = await supabaseAdmin
  .from('document_types')
  .select('*')
  .order('is_active', { ascending: false })
  .order('sort_order')
  .order('name')

const types = (data ?? []) as DocType[]

function flag(v: boolean) {
  return v ? '✓' : '—'
}
---

<DashboardLayout title="Document Types">
  <div class="max-w-215">
    <Breadcrumb crumbs={[{ label: 'Settings', href: '/admin/settings' }, { label: 'Document Types' }]} />
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Document Types</h1>
        <p class="font-body text-sm text-neutral-500 m-0">{types.length} type{types.length !== 1 ? 's' : ''} configured</p>
      </div>
    </div>

    {successMessage && (
      <div class="bg-success-50 border border-success-100 rounded-md px-4 py-3 mb-5 font-body text-sm text-success-700">
        {successMessage}
      </div>
    )}
    {errorMessage && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {errorMessage}
      </div>
    )}

    <!-- Existing types table -->
    <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden mb-8">
      <table class="w-full border-collapse">
        <thead class="bg-neutral-50 border-b border-neutral-200">
          <tr>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Name</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-center px-3 py-2.5 uppercase tracking-[0.05em]">Requires Issuer</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-center px-3 py-2.5 uppercase tracking-[0.05em]">Requires Expiry</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-center px-3 py-2.5 uppercase tracking-[0.05em]">Training Link</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-center px-3 py-2.5 uppercase tracking-[0.05em]">Status</th>
            <th class="px-4 py-2.5"></th>
          </tr>
        </thead>
        <tbody>
          {types.map((t, i) => (
            <tr class={i > 0 ? 'border-t border-neutral-100' : ''}>
              <td class="px-4 py-3.5">
                <p class="font-body text-sm font-semibold text-neutral-800 mb-0.5">{t.name}</p>
                <p class="font-mono text-[11px] text-neutral-400 m-0">{t.slug}</p>
              </td>
              <td class="px-3 py-3.5 text-center font-body text-sm text-neutral-600">{flag(t.requires_issuer)}</td>
              <td class="px-3 py-3.5 text-center font-body text-sm text-neutral-600">{flag(t.requires_expiry)}</td>
              <td class="px-3 py-3.5 text-center font-body text-sm text-neutral-600">{flag(t.is_training_linkable)}</td>
              <td class="px-3 py-3.5 text-center">
                <span
                  class={`inline-block py-0.5 px-2.5 rounded-full font-body text-xs font-semibold ${t.is_active ? 'bg-success-50 text-success-700' : 'bg-neutral-100 text-neutral-500'}`}>
                  {t.is_active ? 'Active' : 'Inactive'}
                </span>
              </td>
              <td class="px-4 py-3.5 text-right whitespace-nowrap flex gap-2 justify-end">
                <form method="POST" class="inline">
                  <input type="hidden" name="_action" value="toggle" />
                  <input type="hidden" name="type_id" value={t.id} />
                  <input type="hidden" name="is_active" value={String(t.is_active)} />
                  <button type="submit"
                    class="px-3 py-1 border border-neutral-200 rounded-md bg-neutral-100 font-body text-xs text-neutral-600 cursor-pointer">
                    {t.is_active ? 'Deactivate' : 'Activate'}
                  </button>
                </form>
                <form method="POST" class="inline" onsubmit="return confirm('Delete this document type? If documents reference it, it will be deactivated instead.')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="type_id" value={t.id} />
                  <button type="submit"
                    class="px-3 py-1 border border-danger-200 rounded-md bg-danger-50 font-body text-xs text-danger-700 cursor-pointer">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Add new type -->
    <div class="bg-white border border-neutral-200 rounded-lg py-7 px-8">
      <h2 class="font-heading text-base font-bold text-brand-navy mb-5">Add Document Type</h2>
      <form method="POST" class="flex flex-col gap-4">
        <input type="hidden" name="_action" value="create" />

        <div class="flex flex-col gap-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">Name *</label>
          <input name="name" required maxlength="100"
            placeholder="e.g. Enhanced DBS"
            class="py-2.25 px-3 border border-neutral-300 rounded-md font-body text-sm max-w-90" />
        </div>

        <div class="flex flex-col gap-2.5">
          <p class="font-body text-[13px] font-medium text-neutral-700 m-0">Flags</p>
          {[
            { name: 'requires_issuer', label: 'Requires Issuer', hint: 'Show "Issued by" field on upload form' },
            { name: 'requires_expiry', label: 'Requires Expiry Date', hint: 'Show expiry date picker on upload form' },
            { name: 'is_training_linkable', label: 'Training Linkable', hint: 'Show training selector on upload form (e.g. for certificates)' },
          ].map(f => (
            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="hidden" name={f.name} value="false" />
              <input type="checkbox" name={f.name} value="true" class="w-4 h-4 mt-0.5 shrink-0 accent-brand-navy" />
              <div>
                <span class="font-body text-sm font-medium text-neutral-800 block">{f.label}</span>
                <span class="font-body text-xs text-neutral-500">{f.hint}</span>
              </div>
            </label>
          ))}
        </div>

        <div class="pt-1">
          <button type="submit"
            class="py-2.5 px-5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
            Add type
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>
