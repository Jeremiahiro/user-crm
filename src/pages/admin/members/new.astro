---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
if (!Astro.locals.user) return Astro.redirect('/login')

const PERSON_TYPES = ['member', 'mentor', 'volunteer', 'parent', 'trustee']
const STATUS_OPTIONS = [
  { value: 'applicant',      label: 'Applicant' },
  { value: 'pending_review', label: 'Pending Review' },
  { value: 'active',         label: 'Active' },
  { value: 'suspended',      label: 'Suspended' },
  { value: 'inactive',       label: 'Inactive' },
]

let errors: Record<string, string> = {}
let globalError = ''
const preselectedType = Astro.url.searchParams.get('type')
const defaultTypes = preselectedType && PERSON_TYPES.includes(preselectedType) ? [preselectedType] : ['member']
let values: Record<string, string | string[]> = { status: 'applicant', person_types: defaultTypes }

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const person_types = form.getAll('person_types') as string[]
  values = { ...Object.fromEntries(form.entries()) as Record<string, string>, person_types }

  const res = await fetch(`${Astro.url.origin}/api/members`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      first_name: values.first_name,
      middle_name: (values.middle_name as string) || undefined,
      last_name: values.last_name,
      email: values.email,
      email_secondary: (values.email_secondary as string) || undefined,
      phone: (values.phone as string) || undefined,
      date_of_birth: (values.date_of_birth as string) || undefined,
      gender: (values.gender as string) || undefined,
      address: (values.address as string) || undefined,
      person_types,
      status: values.status,
      date_joined: (values.date_joined as string) || undefined,
      notes: (values.notes as string) || undefined,
      source: 'manual',
    }),
  })

  if (res.ok) {
    const { data } = await res.json() as { data: { id: string } }
    return Astro.redirect(`/admin/members/${data.id}`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? ''
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title="Add Member">
  <div class="max-w-175">
    <Breadcrumb crumbs={[{ label: 'Members', href: '/admin/members' }, { label: 'Add Member' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-6">Add Member</h1>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-7">

      <!-- Personal details -->
      <section>
        <h2 class="font-heading text-[13px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mb-4 pb-2 border-b border-neutral-100">Personal details</h2>
        <div class="grid grid-cols-2 gap-4">
          <Input label="First name *" name="first_name" value={values.first_name as string} error={errors.first_name} required placeholder="e.g. John" />
          <Input label="Last name *" name="last_name" value={values.last_name as string} error={errors.last_name} required placeholder="e.g. Smith" />
          <div class="col-span-full">
            <Input label="Middle name" name="middle_name" value={values.middle_name as string} placeholder="Optional" />
          </div>
          <Input label="Email *" name="email" type="email" value={values.email as string} error={errors.email} required placeholder="john@example.com" />
          <Input label="Secondary email" name="email_secondary" type="email" value={values.email_secondary as string} placeholder="Optional" />
          <Input label="Phone" name="phone" type="tel" value={values.phone as string} error={errors.phone} placeholder="+44 7700 000000" />
          <Input label="Date of birth" name="date_of_birth" type="date" value={values.date_of_birth as string} />
          <div class="flex flex-col gap-1">
            <label class="font-body text-[13px] font-medium text-neutral-700">Gender</label>
            <select name="gender" class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 bg-white">
              <option value="">— Select —</option>
              <option value="male" selected={values.gender === 'male'}>Male</option>
              <option value="female" selected={values.gender === 'female'}>Female</option>
              <option value="non_binary" selected={values.gender === 'non_binary'}>Non-binary</option>
              <option value="prefer_not_to_say" selected={values.gender === 'prefer_not_to_say'}>Prefer not to say</option>
            </select>
          </div>
        </div>
        <div class="mt-4">
          <Input label="Address" name="address" value={values.address as string} placeholder="Street, City, Postcode" />
        </div>
      </section>

      <!-- Organisation -->
      <section>
        <h2 class="font-heading text-[13px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mb-4 pb-2 border-b border-neutral-100">Organisation</h2>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="flex flex-col gap-1">
            <label class="font-body text-[13px] font-medium text-neutral-700">Status</label>
            <select name="status" class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 bg-white">
              {STATUS_OPTIONS.map(s => <option value={s.value} selected={values.status === s.value}>{s.label}</option>)}
            </select>
          </div>
          <Input label="Date joined" name="date_joined" type="date" value={values.date_joined as string} />
        </div>

        <div class="flex flex-col gap-2">
          <span class="font-body text-[13px] font-medium text-neutral-700">Person types *</span>
          <div class="flex flex-wrap gap-2">
            {PERSON_TYPES.map(type => (
              <label class="flex items-center gap-1.5 px-3 py-1.5 border border-neutral-300 rounded-full cursor-pointer font-body text-[13px] text-neutral-700">
                <input type="checkbox" name="person_types" value={type}
                  checked={(values.person_types as string[])?.includes(type)} />
                {type}
              </label>
            ))}
          </div>
          {errors.person_types && <p class="font-body text-xs text-danger-600 m-0">{errors.person_types}</p>}
        </div>
      </section>

      <!-- Notes -->
      <section>
        <h2 class="font-heading text-[13px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mb-4 pb-2 border-b border-neutral-100">Notes</h2>
        <div class="flex flex-col gap-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">Internal notes</label>
          <textarea name="notes" rows={4} placeholder="Any additional context about this member…"
            class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 resize-y">{values.notes as string}</textarea>
        </div>
      </section>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Add member
        </button>
        <a href="/admin/members" class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
