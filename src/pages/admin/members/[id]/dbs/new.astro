---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params
const { data: member } = await supabaseAdmin
  .from('people')
  .select('id, full_name')
  .eq('id', id ?? '')
  .single()

if (!member) return Astro.redirect('/admin/members')

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/dbs`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      person_id: id,
      certificate_reference: values.certificate_reference || undefined,
      clearance_date: values.clearance_date || undefined,
      expiry_date: values.expiry_date || undefined,
      drive_url: values.drive_url || undefined,
    }),
  })

  if (res.ok) {
    return Astro.redirect(`/admin/members/${id}?tab=dbs`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? ''
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title={`Add DBS — ${member.full_name}`}>
  <div style="max-width: 600px;">
    <Breadcrumb crumbs={[{ label: 'Members', href: '/admin/members' }, { label: member.full_name as string, href: `/admin/members/${id}?tab=dbs` }, { label: 'Add DBS Record' }]} />
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Add DBS Record</h1>
    <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0 0 24px;">{member.full_name}</p>

    <div style="background-color: var(--color-info-50); border: 1px solid var(--color-info-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 24px;">
      <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-info-700); margin: 0; line-height: 1.5;">
        DBS records are permanent and cannot be deleted. Previous records remain for audit purposes.
      </p>
    </div>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form method="POST" style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 20px;">
      <Input
        label="Certificate reference"
        name="certificate_reference"
        value={values.certificate_reference}
        error={errors.certificate_reference}
        placeholder="e.g. 001234567890"
      />
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <Input label="Clearance date" name="clearance_date" type="date" value={values.clearance_date} error={errors.clearance_date} />
        <Input label="Expiry date" name="expiry_date" type="date" value={values.expiry_date} error={errors.expiry_date} />
      </div>
      <Input
        label="Google Drive URL"
        name="drive_url"
        type="url"
        value={values.drive_url}
        error={errors.drive_url}
        placeholder="https://drive.google.com/file/d/..."
      />

      <div style="display: flex; gap: 12px; padding-top: 8px;">
        <button type="submit" style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Save DBS record
        </button>
        <a href={`/admin/members/${id}?tab=dbs`} style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
