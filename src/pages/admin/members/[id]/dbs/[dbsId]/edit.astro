---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)
if (!admin) return Astro.redirect('/admin/members')

const { id, dbsId } = Astro.params

const [{ data: member }, { data: dbsRecord }] = await Promise.all([
  supabaseAdmin.from('people').select('id, full_name').eq('id', id ?? '').single(),
  supabaseAdmin.from('dbs_records').select('*').eq('id', dbsId ?? '').single(),
])

if (!member || !dbsRecord) return Astro.redirect(`/admin/members/${id}?tab=dbs`)

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {
  certificate_reference: (dbsRecord.certificate_reference as string | null) ?? '',
  clearance_date: (dbsRecord.clearance_date as string | null) ?? '',
  expiry_date: (dbsRecord.expiry_date as string | null) ?? '',
  drive_url: (dbsRecord.drive_url as string | null) ?? '',
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/dbs/${dbsId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      certificate_reference: values.certificate_reference || null,
      clearance_date: values.clearance_date || null,
      expiry_date: values.expiry_date || null,
      drive_url: values.drive_url || null,
    }),
  })

  if (res.ok) {
    return Astro.redirect(`/admin/members/${id}?tab=dbs`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? ''
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title={`Edit DBS — ${member.full_name}`}>
  <div class="max-w-150">
    <Breadcrumb crumbs={[{ label: 'Members', href: '/admin/members' }, { label: member.full_name as string, href: `/admin/members/${id}?tab=dbs` }, { label: 'Edit DBS Record' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-1">Edit DBS Record</h1>
    <p class="font-body text-sm text-neutral-500 mb-6">{member.full_name}</p>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">
      <Input
        label="Certificate reference"
        name="certificate_reference"
        value={values.certificate_reference}
        error={errors.certificate_reference}
        placeholder="e.g. 001234567890"
      />
      <div class="grid grid-cols-2 gap-4">
        <Input label="Clearance date" name="clearance_date" type="date" value={values.clearance_date} error={errors.clearance_date} />
        <Input label="Expiry date" name="expiry_date" type="date" value={values.expiry_date} error={errors.expiry_date} />
      </div>
      <Input
        label="Google Drive URL"
        name="drive_url"
        type="url"
        value={values.drive_url}
        error={errors.drive_url}
        placeholder="https://drive.google.com/file/d/..."
      />

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Save changes
        </button>
        <a href={`/admin/members/${id}?tab=dbs`} class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
