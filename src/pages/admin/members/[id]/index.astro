        ) : (
          <div class="flex flex-col gap-2.5">
            {committeeAssignments.map((ca) => ca.committees && (
              <div class="bg-white border border-neutral-200 rounded-lg py-4 px-5 flex items-center justify-between gap-3">
                <div>
                  <a href={`/admin/committees/${ca.committees.id}`}
                    class="font-body text-sm font-semibold text-brand-navy no-underline">
                    {ca.committees.name}
                  </a>
                  {ca.is_lead && (
                    <span class="ml-2 font-body text-[11px] font-semibold text-warning-700 bg-warning-50 border border-warning-200 rounded-full py-px px-2">Lead</span>
