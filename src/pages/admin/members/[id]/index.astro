              {((member.pillar_interest as string | null) || (member.committee_interest as string | null) || (member.referral_source as string | null)) && (
                <dl class="grid [grid-template-columns:180px_1fr] gap-x-4 gap-y-2">
                  {(member.pillar_interest as string | null) && (
                    <>
                      <dt class="font-body text-[13px] font-medium text-neutral-500">Pillar interest</dt>
                      <dd class="font-body text-[13px] text-neutral-800 m-0">{member.pillar_interest as string}</dd>
                    </>
