          </div>
          <div class="flex gap-2">
            {canGiveAward && (
              <a href={`/admin/awards/new?person_id=${id}`}
                class="py-1.5 px-3.5 bg-neutral-100 text-neutral-700 border border-neutral-200 rounded-md font-body text-xs font-semibold no-underline">
                + Give award
              </a>
            )}
            <a href={`/admin/praise/new?person_id=${id}`}
              class="py-1.5 px-3.5 bg-brand-navy text-white rounded-md font-body text-xs font-semibold no-underline">
