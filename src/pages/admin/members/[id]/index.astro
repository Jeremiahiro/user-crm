                    {ur.roles.name}
                  </span>
                  {isSuperAdmin && (
                    <button @click="revokeRole($el.dataset.roleId)" data-role-id={ur.roles.id}
                      class="bg-transparent border-none cursor-pointer py-1.5 pr-2.5 pl-0.5 text-white/70 text-sm leading-none"
                      title={`Revoke ${ur.roles.name}`}>×</button>
                  )}
                </div>
              ))}
            </div>
          ) : (
            <p class="font-body text-sm text-neutral-400 m-0">No roles assigned.</p>
          )}

          {isSuperAdmin && roles.filter(r => !userRoles.some(ur => ur.roles?.id === r.id)).length > 0 && (
            <div class="flex items-center gap-2 mt-4 pt-4 border-t border-neutral-100">
              <select id="role-select"
                class="py-[7px] px-2.5 border border-neutral-300 rounded-md font-body text-[13px] text-neutral-700 bg-white min-w-[180px]">
                <option value="">— Assign role —</option>
                {roles.filter(r => !userRoles.some(ur => ur.roles?.id === r.id)).map(r => (
                  <option value={r.id}>{r.name}</option>
                ))}
              </select>
              <button @click="assignRole()"
                class="py-[7px] px-3.5 bg-brand-navy text-white border-none rounded-md font-body text-[13px] font-medium cursor-pointer">
                Assign
              </button>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- ─── Tab: Committees ──────────────────────────────────────── -->
    {tab === 'committees' && (
      <div>
