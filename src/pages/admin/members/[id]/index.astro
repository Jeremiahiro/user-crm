                  {(member.committee_interest as string | null) && (
                    <>
                      <dt class="font-body text-[13px] font-medium text-neutral-500">Committee interest</dt>
                      <dd class="font-body text-[13px] text-neutral-800 m-0">{member.committee_interest as string}</dd>
                    </>
                  )}
                  {(member.referral_source as string | null) && (
                    <>
                      <dt class="font-body text-[13px] font-medium text-neutral-500">How they heard</dt>
                      <dd class="font-body text-[13px] text-neutral-800 m-0">{member.referral_source as string}</dd>
                    </>
                  )}
                </dl>
              )}
              {((member.dbs_consent as boolean | null) !== null || (member.dues_consent as boolean | null) !== null) && (
                <dl class="grid [grid-template-columns:180px_1fr] gap-x-4 gap-y-2">
                  {(member.dbs_consent as boolean | null) !== null && (
                    <>
                      <dt class="font-body text-[13px] font-medium text-neutral-500">DBS consent</dt>
                      <dd class="font-body text-[13px] m-0">
                        {(member.dbs_consent as boolean)
                          ? <span class="text-success-700 font-semibold">✓ Yes</span>
                          : <span class="text-neutral-400">Not recorded</span>}
                      </dd>
                    </>
                  )}
                  {(member.dues_consent as boolean | null) !== null && (
                    <>
                      <dt class="font-body text-[13px] font-medium text-neutral-500">Dues consent</dt>
                      <dd class="font-body text-[13px] m-0">
                        {(member.dues_consent as boolean)
                          ? <span class="text-success-700 font-semibold">✓ Yes</span>
                          : <span class="text-neutral-400">Not recorded</span>}
                      </dd>
                    </>
                  )}
                </dl>
              )}
            </div>
          </div>
        )}

      </div>
    )}

    <!-- ─── Tab: Dues ──────────────────────────────────────────────── -->
    {tab === 'dues' && (
      <div>
        <p class="font-body text-[13px] text-neutral-500 mb-5">
          Click a month to toggle paid/unpaid. Changes are saved immediately.
        </p>
        {[currentYear, currentYear - 1, currentYear - 2].map(year => {
          const yearDues = dues.filter(d => d.year === year)
          const allPaid = months.every((_, i) => yearDues.some(d => d.month === i + 1))
          const unpaidMonths = months.map((_, i) => i + 1).filter(m => !yearDues.some(d => d.month === m))
          return (
            <div class="bg-white border border-neutral-200 rounded-lg p-6 mb-4">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-heading text-base font-bold text-brand-navy m-0">{year}</h3>
                {!allPaid && (
                  <button
                    @click="payYear($el.dataset.year, $el.dataset.unpaidMonths)"
                    data-year={year}
                    data-unpaid-months={unpaidMonths.join(',')}
                    class="py-1.5 px-3.5 bg-brand-navy text-white border-none rounded-md font-body text-xs font-semibold cursor-pointer">
                    ✓ Mark all paid
                  </button>
                )}
                {allPaid && (
                  <span class="font-body text-xs text-success-700 font-semibold">All paid ✓</span>
                )}
              </div>
              <div class="grid grid-cols-6 gap-2">
                {months.map((month, i) => {
                  const monthNum = i + 1
                  const paid = yearDues.find(d => d.month === monthNum)
                  return (
                    <button
                      @click="toggleDue(parseInt($el.dataset.year), parseInt($el.dataset.month), $el.dataset.dueId)"
                      data-year={year}
                      data-month={monthNum}
                      data-due-id={paid?.id ?? ''}
                      class={`py-2.5 rounded-md font-body text-[13px] font-semibold cursor-pointer border text-center ${paid ? 'bg-success-100 text-success-700 border-success-300' : 'bg-neutral-50 text-neutral-400 border-neutral-200'}`}>
                      {month}
                      <span class="block text-[10px] font-normal">{paid ? '✓' : '–'}</span>
                    </button>
                  )
                })}
              </div>
            </div>
          )
        })}
      </div>
    )}

    <!-- ─── Tab: DBS ───────────────────────────────────────────────── -->
    {tab === 'dbs' && (
      <div>
        <div class="flex items-center justify-end mb-5">
          <a href={`/admin/members/${id}/dbs/new`}
             class="py-2 px-3.5 bg-brand-navy text-white rounded-md font-body text-[13px] font-semibold no-underline">
            + Add DBS record
          </a>
        </div>
        {dbsRecords.length > 0 ? (
          <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-neutral-100">
                  <th class="py-3 px-4 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Certificate ref</th>
                  <th class="py-3 px-4 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Clearance date</th>
                  <th class="py-3 px-4 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Expiry date</th>
                  <th class="py-3 px-4 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Drive</th>
                  <th class="py-3 px-4"></th>
                </tr>
              </thead>
              <tbody>
                {dbsRecords.map((r, i) => {
                  const expiryDate = r.expiry_date ? new Date(r.expiry_date) : null
                  const now = Date.now()
                  const daysLeft = expiryDate ? Math.floor((expiryDate.getTime() - now) / 86400000) : null
                  return (
                    <tr class={i > 0 ? 'border-t border-neutral-100' : ''}>
                      <td class="py-3 px-4 font-body text-[13px] text-neutral-700">{r.certificate_reference ?? <span class="text-neutral-400 italic">Not set</span>}</td>
                      <td class="py-3 px-4 font-body text-[13px] text-neutral-700">{fmtDay(r.clearance_date)}</td>
                      <td class={`py-3 px-4 font-body text-[13px] ${daysLeft !== null ? (daysLeft < 0 ? 'text-danger-600 font-semibold' : daysLeft <= 90 ? 'text-warning-700 font-semibold' : 'text-success-700') : ''}`}>
                        {fmtDay(r.expiry_date)}
                        {daysLeft !== null && daysLeft < 0 && <span class="ml-1.5 text-[11px] py-px px-1.5 bg-danger-100 rounded-[10px]">Expired</span>}
                        {daysLeft !== null && daysLeft >= 0 && daysLeft <= 90 && <span class="ml-1.5 text-[11px] py-px px-1.5 bg-warning-100 rounded-[10px]">{daysLeft}d left</span>}
                      </td>
                      <td class="py-3 px-4">
                        {r.drive_url
                          ? <a href={r.drive_url} target="_blank" rel="noreferrer" class="font-body text-[13px] text-brand-navy no-underline">View ↗</a>
                          : <span class="font-body text-[13px] text-neutral-400">—</span>}
                      </td>
                      <td class="py-3 px-4 whitespace-nowrap">
                        <a href={`/admin/members/${id}/dbs/${r.id}/edit`}
