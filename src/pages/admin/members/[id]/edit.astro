---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'
import { createHash } from 'node:crypto'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

const { id } = Astro.params
const { data: member } = await supabaseAdmin.from('people').select('*').eq('id', id ?? '').single()
if (!member) return Astro.redirect('/admin/members')

const emailMd5 = createHash('md5').update((member.email as string).toLowerCase().trim()).digest('hex')
const gravatarUrl = `https://www.gravatar.com/avatar/${emailMd5}?d=mp&s=128`
const currentPhotoUrl = (member.profile_photo_url as string | null) ?? gravatarUrl

// Read-only context — all teams and latest DBS
const [{ data: teamData }, { data: dbsData }] = await Promise.all([
  supabaseAdmin
    .from('person_teams')
    .select('is_team_lead, joined_at, teams(id, name)')
    .eq('person_id', id ?? '')
    .order('joined_at', { ascending: false }),
  supabaseAdmin
    .from('dbs_records')
    .select('certificate_reference, clearance_date, expiry_date')
    .eq('person_id', id ?? '')
    .order('clearance_date', { ascending: false })
    .limit(1)
    .maybeSingle(),
])

type TeamAssignmentRow = { is_team_lead: boolean; joined_at: string; teams: { id: string; name: string } | null }
const teamAssignments = (teamData ?? []) as TeamAssignmentRow[]

type DbsRow = { certificate_reference: string | null; clearance_date: string | null; expiry_date: string | null } | null
const latestDbs = dbsData as DbsRow

// Buddy section (admin only)
type BuddyAssignmentRow = { id: string; person_id: string; buddy_id: string; assigned_at: string; notes: string | null }
type ActiveMemberRow = { id: string; full_name: string }

// currentBuddy = someone assigned TO this member (person_id = id)
let currentBuddy: { assignment: BuddyAssignmentRow; person: ActiveMemberRow | null } | null = null
// buddyingFor = all members this person is serving as buddy for (buddy_id = id), up to 3
let buddyingFor: { assignment: BuddyAssignmentRow; person: ActiveMemberRow | null }[] = []
let allActiveMembers: ActiveMemberRow[] = []

if (admin) {
  const [{ data: buddyAsPersonId }, { data: buddyAsBuddyId }] = await Promise.all([
    // This member has a buddy assigned to them
    supabaseAdmin
      .from('buddy_assignments')
      .select('id, person_id, buddy_id, assigned_at, notes')
      .eq('person_id', id ?? '')
      .is('ended_at', null)
      .maybeSingle(),
    // This member is serving as buddy for others (up to 3)
    supabaseAdmin
      .from('buddy_assignments')
      .select('id, person_id, buddy_id, assigned_at, notes')
      .eq('buddy_id', id ?? '')
      .is('ended_at', null),
  ])

  // Collect people IDs to resolve names in one query
  const resolveIds = new Set<string>()
  if (buddyAsPersonId) resolveIds.add((buddyAsPersonId as BuddyAssignmentRow).buddy_id)
  for (const r of ((buddyAsBuddyId ?? []) as BuddyAssignmentRow[])) resolveIds.add(r.person_id)

  let peopleMap = new Map<string, ActiveMemberRow>()
  if (resolveIds.size > 0) {
    const { data: resolvedPeople } = await supabaseAdmin
      .from('people').select('id, full_name').in('id', [...resolveIds])
    for (const p of ((resolvedPeople ?? []) as ActiveMemberRow[])) peopleMap.set(p.id, p)
  }

  if (buddyAsPersonId) {
    const a = buddyAsPersonId as BuddyAssignmentRow
    currentBuddy = { assignment: a, person: peopleMap.get(a.buddy_id) ?? null }
  }
  buddyingFor = ((buddyAsBuddyId ?? []) as BuddyAssignmentRow[]).map(a => ({
    assignment: a,
    person: peopleMap.get(a.person_id) ?? null,
  }))

  // Fetch all active members for the dropdown (excluding current member)
  const { data: activeMembers } = await supabaseAdmin
    .from('people')
    .select('id, full_name')
    .eq('is_archived', false)
    .neq('id', id ?? '')
    .order('full_name', { ascending: true })
  allActiveMembers = (activeMembers ?? []) as ActiveMemberRow[]
}

function fmtDate(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

function dbsStatus(expiry: string | null): { label: string; color: string } {
  if (!expiry) return { label: 'No expiry', color: 'var(--color-neutral-500)' }
  const diff = new Date(expiry).getTime() - Date.now()
  const days = Math.floor(diff / 86_400_000)
  if (days < 0) return { label: 'Expired', color: 'var(--color-danger-600)' }
  if (days <= 90) return { label: `Expires in ${days}d`, color: 'var(--color-warning-600)' }
  return { label: 'Valid', color: 'var(--color-success-600)' }
}

const PERSON_TYPES = ['member', 'mentor', 'volunteer', 'alumni', 'parent', 'trustee']
const STATUS_OPTIONS = [
  { value: 'applicant',      label: 'Applicant' },
  { value: 'pending_review', label: 'Pending Review' },
  { value: 'approved',       label: 'Approved' },
  { value: 'active',         label: 'Active' },
  { value: 'suspended',      label: 'Suspended' },
  { value: 'inactive',       label: 'Inactive' },
  { value: 'alumni',         label: 'Alumni' },
  { value: 'left',           label: 'Left' },
]

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string | string[]> = {
  first_name: member.first_name as string,
  middle_name: (member.middle_name as string | null) ?? '',
  last_name: member.last_name as string,
  email: member.email as string,
  email_secondary: (member.email_secondary as string | null) ?? '',
  phone: (member.phone as string | null) ?? '',
  date_of_birth: (member.date_of_birth as string | null) ?? '',
  gender: (member.gender as string | null) ?? '',
  address: (member.address as string | null) ?? '',
  person_types: (member.person_types as string[]) ?? ['member'],
  status: member.status as string,
  date_joined: (member.date_joined as string | null) ?? '',
  notes: (member.notes as string | null) ?? '',
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const person_types = form.getAll('person_types') as string[]
  values = { ...Object.fromEntries(form.entries()) as Record<string, string>, person_types }

  const res = await fetch(`${Astro.url.origin}/api/members/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      first_name: values.first_name,
      middle_name: (values.middle_name as string) || null,
      last_name: values.last_name,
      email: values.email,
      email_secondary: (values.email_secondary as string) || null,
      phone: (values.phone as string) || null,
      date_of_birth: (values.date_of_birth as string) || null,
      gender: (values.gender as string) || null,
      address: (values.address as string) || null,
      person_types,
      status: values.status,
      date_joined: (values.date_joined as string) || null,
      notes: (values.notes as string) || null,
    }),
  })

  if (res.ok) {
    return Astro.redirect(`/admin/members/${id}`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? ''
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title={`Edit ${member.full_name}`}>
  <div class="max-w-[1060px]">
    <Breadcrumb crumbs={[{ label: 'Members', href: '/admin/members' }, { label: member.full_name as string, href: `/admin/members/${id}` }, { label: 'Edit' }]} />

    <!-- Page header -->
    <div class="flex items-center justify-between mb-5 gap-4 flex-wrap">
      <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0">Edit Member</h1>
      <div class="flex gap-2.5">
        <button form="member-form" type="submit" class="px-5 py-[9px] bg-brand-navy text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">Save changes</button>
        <a href={`/admin/members/${id}`} class="px-5 py-[9px] bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">Cancel</a>
      </div>
    </div>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-4 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <!-- Two-column layout -->
    <div class="grid gap-5 items-start" style="grid-template-columns: 1fr 300px;">

      <!-- ── LEFT: Photo + Form ─────────────────────────────────────────── -->
      <div class="flex flex-col gap-4">

        <!-- Profile photo -->
        <div id="photo-card" class="bg-white border border-neutral-200 rounded-lg px-6 py-5 flex items-center gap-5">
          <div id="photo-preview" class="w-20 h-20 rounded-full overflow-hidden shrink-0 bg-brand-navy">
            <img id="photo-img" src={currentPhotoUrl} alt={member.full_name as string} width={80} height={80} class="w-full h-full object-cover" />
          </div>
          <div class="flex-1">
            <p class="font-body text-sm font-semibold text-neutral-800 m-0 mb-[3px]">Profile photo</p>
            <p class="font-body text-xs text-neutral-400 m-0 mb-2.5">JPEG, PNG or WebP · max 5 MB</p>
            <div class="flex items-center gap-2.5 flex-wrap">
              <label class="px-[14px] py-1.5 bg-brand-navy text-white rounded-md font-body text-[13px] font-medium cursor-pointer">
                <input id="photo-input" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
                Choose photo
              </label>
              <span id="photo-filename" class="font-body text-xs text-neutral-500">No file selected</span>
              <button id="photo-upload-btn" type="button" style="display:none;" class="px-[14px] py-1.5 bg-brand-gold text-brand-navy border-none rounded-md font-body text-[13px] font-semibold cursor-pointer">Upload</button>
            </div>
            <p id="photo-status" class="font-body text-xs mt-1.5" style="display: none;"></p>
          </div>
        </div>

        <!-- Personal info form -->
        <form id="member-form" method="POST" class="bg-white border border-neutral-200 rounded-lg px-8 py-7 flex flex-col gap-7">

          <section>
            <h2 class="font-heading text-xs font-semibold text-neutral-400 uppercase tracking-[0.08em] m-0 mb-4 pb-2 border-b border-neutral-100">Personal details</h2>
            <div class="grid grid-cols-2 gap-4">
              <Input label="First name *" name="first_name" value={values.first_name as string} error={errors.first_name} required />
              <Input label="Last name *" name="last_name" value={values.last_name as string} error={errors.last_name} required />
              <div class="col-span-full">
                <Input label="Middle name" name="middle_name" value={values.middle_name as string} placeholder="Optional" />
              </div>
              <Input label="Email *" name="email" type="email" value={values.email as string} error={errors.email} required />
              <Input label="Secondary email" name="email_secondary" type="email" value={values.email_secondary as string} placeholder="Optional" />
              <Input label="Phone" name="phone" type="tel" value={values.phone as string} />
              <Input label="Date of birth" name="date_of_birth" type="date" value={values.date_of_birth as string} />
              <div class="flex flex-col gap-1">
                <label class="font-body text-[13px] font-medium text-neutral-700">Gender</label>
                <select name="gender" class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 bg-white">
                  <option value="">— Select —</option>
                  <option value="male" selected={values.gender === 'male'}>Male</option>
                  <option value="female" selected={values.gender === 'female'}>Female</option>
                  <option value="non_binary" selected={values.gender === 'non_binary'}>Non-binary</option>
                  <option value="prefer_not_to_say" selected={values.gender === 'prefer_not_to_say'}>Prefer not to say</option>
                </select>
              </div>
            </div>
            <div class="mt-4">
              <Input label="Address" name="address" value={values.address as string} />
            </div>
          </section>

          <section>
            <h2 class="font-heading text-xs font-semibold text-neutral-400 uppercase tracking-[0.08em] m-0 mb-4 pb-2 border-b border-neutral-100">Organisation</h2>
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="flex flex-col gap-1">
                <label class="font-body text-[13px] font-medium text-neutral-700">Status</label>
                <select name="status" class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 bg-white">
                  {STATUS_OPTIONS.map(s => <option value={s.value} selected={values.status === s.value}>{s.label}</option>)}
                </select>
              </div>
              <Input label="Date joined" name="date_joined" type="date" value={values.date_joined as string} />
            </div>
            <div class="flex flex-col gap-2">
              <span class="font-body text-[13px] font-medium text-neutral-700">Person types *</span>
              <div class="flex flex-wrap gap-2">
                {PERSON_TYPES.map(type => (
                  <label class="flex items-center gap-1.5 px-3 py-1.5 border border-neutral-300 rounded-full cursor-pointer font-body text-[13px] text-neutral-700">
                    <input type="checkbox" name="person_types" value={type}
                      checked={(values.person_types as string[])?.includes(type)} />
                    {type}
                  </label>
                ))}
              </div>
            </div>
          </section>

          <section>
            <h2 class="font-heading text-xs font-semibold text-neutral-400 uppercase tracking-[0.08em] m-0 mb-3 pb-2 border-b border-neutral-100">Notes</h2>
            <textarea name="notes" rows={4}
              class="w-full px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 resize-y box-border">{values.notes as string}</textarea>
          </section>

          <!-- Inline save at bottom too -->
          <div class="flex gap-3 border-t border-neutral-100 pt-5">
            <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">Save changes</button>
            <a href={`/admin/members/${id}`} class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">Cancel</a>
          </div>
        </form>

      </div>

      <!-- ── RIGHT: Teams · DBS · Buddy ────────────────────────────────── -->
      <div class="flex flex-col gap-3.5 sticky top-4">

        <!-- Teams card -->
        <div class="bg-white border border-neutral-200 rounded-lg px-5 py-4">
          <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-[0.08em] m-0 mb-2.5">Teams</p>
          {teamAssignments.length > 0 ? (
            <div class="flex flex-col gap-2.5">
              {teamAssignments.map(ta => (
                <div class="flex items-center justify-between gap-2">
                  <div>
                    <a href={`/admin/teams/${ta.teams?.id}`}
                      class="font-body text-[13px] font-semibold text-brand-navy no-underline">
                      {ta.teams?.name ?? '—'}
                    </a>
                    <p class="font-body text-[11px] text-neutral-400 m-0 mt-0.5">Since {fmtDate(ta.joined_at)}</p>
                  </div>
                  {ta.is_team_lead && (
                    <span class="px-2 py-0.5 bg-brand-gold text-brand-navy rounded-full font-body text-[11px] font-semibold whitespace-nowrap shrink-0">Lead</span>
                  )}
                </div>
              ))}
            </div>
          ) : (
            <p class="font-body text-[13px] text-neutral-400 m-0">No team assigned</p>
          )}
          <a href={`/admin/members/${id}?tab=teams`}
            class="font-body text-xs text-neutral-400 underline inline-block mt-2.5">
            Manage teams →
          </a>
        </div>

        <!-- DBS card -->
        <div class="bg-white border border-neutral-200 rounded-lg px-5 py-4">
          <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-[0.08em] m-0 mb-2.5">DBS</p>
          {latestDbs?.clearance_date
            ? (() => {
              const { label, color } = dbsStatus(latestDbs.expiry_date)
              return (
                <div>
                  <p class="font-body text-[13px] font-semibold m-0 mb-1" style={`color: ${color};`}>{label}</p>
                  <p class="font-body text-xs text-neutral-500 m-0 leading-normal">
                    Cleared {fmtDate(latestDbs.clearance_date)}
                    {latestDbs.expiry_date && <><br />Expires {fmtDate(latestDbs.expiry_date)}</>}
                    {latestDbs.certificate_reference && <><br />Ref: {latestDbs.certificate_reference}</>}
                  </p>
                </div>
              )
            })()
            : <p class="font-body text-[13px] text-neutral-400 m-0">No DBS record</p>
          }
          <a href={`/admin/members/${id}?tab=dbs`}
            class="font-body text-xs text-neutral-400 underline inline-block mt-2.5">
            Manage DBS →
          </a>
        </div>

        <!-- Buddy card (admin only) -->
        {admin && (
          <div
            x-data={`{
              buddyId: '',
              showModal: false,
              assignmentId: '',
              statusMsg: '',
              personId: '${id}',
              async assignBuddy() {
                if (!this.buddyId) { this.statusMsg = 'Please select a member to assign as buddy.'; return; }
                const res = await fetch('/api/buddies', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ person_id: this.personId, buddy_id: this.buddyId }) });
                const d = await res.json();
                if (res.ok) { location.reload(); } else { this.statusMsg = d.error || 'Failed to assign buddy.'; }
              },
              async confirmRemove() {
                const res = await fetch('/api/buddies/' + this.assignmentId, { method: 'DELETE' });
                const d = await res.json();
                this.showModal = false;
                if (res.ok) { location.reload(); } else { this.statusMsg = d.error || 'Failed to remove buddy.'; }
              }
            }`}
            class="bg-white border border-neutral-200 rounded-lg px-5 py-4"
          >
            <p class="font-body text-[11px] font-semibold text-neutral-400 uppercase tracking-[0.08em] m-0 mb-2.5">Buddy</p>

            <!-- Remove confirmation modal -->
            <div
              x-show="showModal"
              class="fixed inset-0 bg-[rgba(0,0,0,0.5)] flex items-center justify-center z-[1000]"
              @click.self="showModal = false"
            >
              <div class="bg-white rounded-lg p-6 max-w-[320px] w-[90%] text-center">
                <p class="font-body text-sm text-neutral-700 m-0 mb-4">
                  Remove this buddy pairing? Both members will be notified.
                </p>
                <div class="flex gap-2 justify-center">
                  <button type="button" @click="showModal = false" class="px-4 py-2 bg-neutral-100 border border-neutral-200 rounded-md font-body text-[13px] cursor-pointer">Cancel</button>
                  <button type="button" @click="confirmRemove()" class="px-4 py-2 bg-danger-600 text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer">Remove</button>
                </div>
              </div>
            </div>

            <!-- Their buddy: someone assigned TO this member -->
            {currentBuddy ? (
              <div class="mb-3">
                <p class="font-body text-[11px] text-neutral-400 m-0 mb-1">Their buddy</p>
                <p class="font-body text-[13px] font-semibold text-brand-navy m-0 mb-0.5">{currentBuddy.person?.full_name ?? '—'}</p>
                <p class="font-body text-[11px] text-neutral-400 m-0 mb-2.5">
                  Since {new Date(currentBuddy.assignment.assigned_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                </p>
                {currentBuddy.assignment.notes && (
                  <p class="font-body text-xs text-neutral-500 m-0 mb-2.5 italic">"{currentBuddy.assignment.notes}"</p>
                )}
                <button
                  type="button"
                  @click={`assignmentId = '${currentBuddy.assignment.id}'; showModal = true`}
                  class="w-full py-[7px] px-0 bg-neutral-50 border border-neutral-200 rounded-md font-body text-[13px] text-danger-600 cursor-pointer">
                  Remove buddy
                </button>
              </div>
            ) : (
              <div class="flex flex-col gap-2 mb-3">
                <p class="font-body text-[11px] text-neutral-400 m-0 mb-0.5">Assign a buddy to this member</p>
                <select x-model="buddyId" class="py-[9px] px-3 border border-neutral-300 rounded-md font-body text-[13px] text-neutral-800 bg-white w-full">
                  <option value="">— Select a member —</option>
                  {allActiveMembers.map(m => (
                    <option value={m.id}>{m.full_name}</option>
                  ))}
                </select>
                <button
                  type="button"
                  @click="assignBuddy()"
                  class="w-full py-[9px] px-0 bg-brand-navy text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer">
                  Assign buddy
                </button>
              </div>
            )}

            <!-- Buddying for: members this person is serving as buddy for -->
            {buddyingFor.length > 0 && (
              <div class="pt-2.5 border-t border-neutral-100">
                <p class="font-body text-[11px] text-neutral-400 m-0 mb-2">
                  Serving as buddy to ({buddyingFor.length}/3)
                </p>
                <div class="flex flex-col gap-1.5">
                  {buddyingFor.map(bf => (
                    <a href={`/admin/members/${bf.person?.id}/edit`}
                      class="font-body text-[13px] font-semibold text-brand-navy no-underline">
                      {bf.person?.full_name ?? '—'}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <p x-show="statusMsg" x-text="statusMsg" class="font-body text-xs text-danger-600 m-0 mt-2"></p>
          </div>
        )}

      </div>
    </div>
  </div>

  <script is:inline data-member-id={id}>
    (function () {
      var memberId = document.currentScript.dataset.memberId
      var input = document.getElementById('photo-input')
      var uploadBtn = document.getElementById('photo-upload-btn')
      var filenameEl = document.getElementById('photo-filename')
      var statusEl = document.getElementById('photo-status')
      var imgEl = document.getElementById('photo-img')

      if (!input || !uploadBtn) return

      input.addEventListener('change', function () {
        var file = input.files && input.files[0]
        if (!file) return
        filenameEl.textContent = file.name
        uploadBtn.style.display = 'inline-block'
        // Show preview immediately
        var reader = new FileReader()
        reader.onload = function (e) { imgEl.src = e.target.result }
        reader.readAsDataURL(file)
      })

      uploadBtn.addEventListener('click', function () {
        var file = input.files && input.files[0]
        if (!file) return
        var formData = new FormData()
        formData.append('photo', file)
        uploadBtn.disabled = true
        uploadBtn.textContent = 'Uploading…'
        statusEl.style.display = 'none'

        fetch('/api/members/' + memberId + '/avatar', { method: 'POST', body: formData })
          .then(function (r) { return r.json() })
          .then(function (data) {
            if (data.ok) {
              uploadBtn.textContent = '✓ Saved'
              uploadBtn.style.backgroundColor = 'var(--color-success-100)'
              uploadBtn.style.color = 'var(--color-success-700)'
              statusEl.style.display = 'block'
              statusEl.style.color = 'var(--color-success-700)'
              statusEl.textContent = 'Photo updated successfully.'
            } else {
              uploadBtn.textContent = 'Upload'
              uploadBtn.disabled = false
              statusEl.style.display = 'block'
              statusEl.style.color = 'var(--color-danger-600)'
              statusEl.textContent = data.error || 'Upload failed.'
            }
          })
          .catch(function () {
            uploadBtn.textContent = 'Upload'
            uploadBtn.disabled = false
            statusEl.style.display = 'block'
            statusEl.style.color = 'var(--color-danger-600)'
            statusEl.textContent = 'Network error. Please try again.'
          })
      })
    })()
  </script>

