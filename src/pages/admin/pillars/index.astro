---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

const { data: pillars, error } = await supabaseAdmin
  .from('pillars')
  .select(`
    *,
    teams:teams(count)
  `)
  .eq('is_active', true)
  .order('name', { ascending: true })

if (error) console.error('[pillars/index] DB error:', error)

type PillarRow = {
  id: string
  name: string
  description: string | null
  is_active: boolean
  teams: { count: number }[]
}

const rows = (pillars ?? []) as PillarRow[]
---

<style>
  [x-cloak] { display: none !important; }
</style>

<DashboardLayout title="Pillars">
  <div x-data="{
    modal: { open: false, id: '', name: '' },
    async doDelete() {
      const res = await fetch('/api/pillars/' + this.modal.id, { method: 'DELETE' })
      const data = await res.json()
      if (res.ok) {
        document.querySelector('[data-pillar-id=\'' + this.modal.id + '\']')?.remove()
        this.modal.open = false
      } else {
        alert('Could not delete: ' + (data.error ?? 'Unknown error'))
        this.modal.open = false
      }
    }
  }">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
      <div>
        <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">
          Pillars
        </h1>
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0;">
          Strategic pillars of the chapter.
        </p>
      </div>
      {admin && (
        <a
          href="/admin/pillars/new"
          style="
            display: inline-flex; align-items: center; gap: 6px;
            background-color: var(--color-brand-navy); color: white;
            padding: 10px 18px; border-radius: var(--radius-md);
            font-family: var(--font-body); font-size: 14px; font-weight: 600;
            text-decoration: none;
          "
        >
          + Add pillar
        </a>
      )}
    </div>

    {error && (
      <div style="background: #fef2f2; border: 1px solid #fca5a5; border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: #991b1b;">
        Failed to load pillars. Please refresh the page.
      </div>
    )}

    {rows.length > 0 ? (
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background-color: var(--color-neutral-100);">
              <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Name</th>
              <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Description</th>
              <th style="padding: 12px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em;">Teams</th>
              <th style="padding: 12px 16px;"></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((pillar) => (
              <tr data-pillar-id={pillar.id} style="border-top: 1px solid var(--color-neutral-100);" onmouseover="this.style.backgroundColor='var(--color-neutral-50)'" onmouseout="this.style.backgroundColor=''">
                <td style="padding: 14px 16px;">
                  <span style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-brand-navy);">
                    {pillar.name}
                  </span>
                </td>
                <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600); max-width: 320px;">
                  {pillar.description ?? <span style="color: var(--color-neutral-400);">—</span>}
                </td>
                <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-700);">
                  {pillar.teams?.[0]?.count ?? 0}
                </td>
                <td style="padding: 14px 16px; text-align: right;">
                  {admin && (
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                      <a href={`/admin/pillars/${pillar.id}/edit`}
                         style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-600); text-decoration: none; padding: 4px 10px; border-radius: var(--radius-md);"
                         onmouseover="this.style.backgroundColor='var(--color-neutral-100)'"
                         onmouseout="this.style.backgroundColor=''">
                        Edit
                      </a>
                      {pillar.is_active && (
                        <button
                          @click={`modal.open = true; modal.id = '${pillar.id}'; modal.name = ${JSON.stringify(pillar.name)}`}
                          style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-danger-600); background: none; border: none; padding: 4px 10px; border-radius: var(--radius-md); cursor: pointer;"
                          onmouseover="this.style.backgroundColor='var(--color-danger-50)'"
                          onmouseout="this.style.backgroundColor=''">
                          Delete
                        </button>
                      )}
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <EmptyState
        heading="No pillars yet"
        subtext="Pillars are the strategic areas of the chapter. Add your first pillar to get started."
      >
        {admin && (
          <a slot="cta" href="/admin/pillars/new"
             style="display: inline-block; background-color: var(--color-brand-navy); color: white; padding: 10px 18px; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
            Add first pillar
          </a>
        )}
      </EmptyState>
    )}

    <!-- Delete confirm modal -->
    <div x-show="modal.open" x-cloak @click="modal.open = false"
      style="position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1000; display: flex; align-items: center; justify-content: center;">
      <div @click.stop style="background: white; border-radius: var(--radius-lg); padding: 28px 32px; max-width: 380px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.2);">
        <p style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-neutral-800); margin: 0 0 6px;">Archive pillar?</p>
        <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600); margin: 0 0 4px; line-height: 1.5;">Archive <span x-text="'&quot;' + modal.name + '&quot;'"></span>?</p>
        <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); margin: 0 0 20px; line-height: 1.5;">This will hide it from the list. It cannot be deleted if active teams are assigned to it.</p>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
          <button @click="modal.open = false"
            style="padding: 8px 16px; background: var(--color-neutral-100); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; color: var(--color-neutral-700);">
            Cancel
          </button>
          <button @click="doDelete()"
            style="padding: 8px 16px; background: var(--color-danger-600); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
            Archive
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
