---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

const { data: pillars, error } = await supabaseAdmin
  .from('pillars')
  .select(`
    *,
    teams:teams(count)
  `)
  .eq('is_active', true)
  .order('name', { ascending: true })

if (error) console.error('[pillars/index] DB error:', error)

type PillarRow = {
  id: string
  name: string
  description: string | null
  is_active: boolean
  teams: { count: number }[]
}

const rows = (pillars ?? []) as PillarRow[]
---

<style>
  [x-cloak] { display: none !important; }
</style>

<DashboardLayout title="Pillars">
  <div x-data="{
    modal: { open: false, id: '', name: '' },
    async doDelete() {
      const res = await fetch('/api/pillars/' + this.modal.id, { method: 'DELETE' })
      const data = await res.json()
      if (res.ok) {
        document.querySelector('[data-pillar-id=\'' + this.modal.id + '\']')?.remove()
        this.modal.open = false
      } else {
        alert('Could not delete: ' + (data.error ?? 'Unknown error'))
        this.modal.open = false
      }
    }
  }">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">
          Pillars
        </h1>
        <p class="font-body text-sm text-neutral-500 m-0">
          Strategic pillars of the chapter.
        </p>
      </div>
      {admin && (
        <a
          href="/admin/pillars/new"
          class="inline-flex items-center gap-1.5 bg-brand-navy text-white px-4.5 py-2.5 rounded-md font-body text-sm font-semibold no-underline"
        >
          + Add pillar
        </a>
      )}
    </div>

    {error && (
      <div class="bg-[#fef2f2] border border-[#fca5a5] rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-800">
        Failed to load pillars. Please refresh the page.
      </div>
    )}

    {rows.length > 0 ? (
      <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-neutral-100">
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Name</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Description</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Teams</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((pillar) => (
              <tr data-pillar-id={pillar.id} class="border-t border-neutral-100" onmouseover="this.style.backgroundColor='var(--color-neutral-50)'" onmouseout="this.style.backgroundColor=''">
                <td class="px-4 py-3.5">
                  <span class="font-body text-sm font-semibold text-brand-navy">
                    {pillar.name}
                  </span>
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600 max-w-[320px]">
                  {pillar.description ?? <span class="text-neutral-400">—</span>}
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-700">
                  {pillar.teams?.[0]?.count ?? 0}
                </td>
                <td class="px-4 py-3.5 text-right">
                  {admin && (
                    <div class="inline-flex items-center gap-1.5">
                      <a href={`/admin/pillars/${pillar.id}/edit`}
                         class="font-body text-[13px] font-medium text-neutral-600 no-underline px-2.5 py-1 rounded-md"
                         onmouseover="this.style.backgroundColor='var(--color-neutral-100)'"
                         onmouseout="this.style.backgroundColor=''">
                        Edit
                      </a>
                      {pillar.is_active && (
                        <button
                          @click={`modal.open = true; modal.id = '${pillar.id}'; modal.name = ${JSON.stringify(pillar.name)}`}
                          class="font-body text-[13px] font-medium text-danger-600 bg-transparent border-0 px-2.5 py-1 rounded-md cursor-pointer"
                          onmouseover="this.style.backgroundColor='var(--color-danger-50)'"
                          onmouseout="this.style.backgroundColor=''">
                          Delete
                        </button>
                      )}
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <EmptyState
        heading="No pillars yet"
        subtext="Pillars are the strategic areas of the chapter. Add your first pillar to get started."
      >
        {admin && (
          <a slot="cta" href="/admin/pillars/new"
             class="inline-block bg-brand-navy text-white px-4.5 py-2.5 rounded-md font-body text-sm font-semibold no-underline">
            Add first pillar
          </a>
        )}
      </EmptyState>
    )}

    <!-- Delete confirm modal -->
    <div x-show="modal.open" x-cloak @click="modal.open = false"
      class="fixed inset-0 bg-black/45 z-1000 flex items-center justify-center">
      <div @click.stop class="bg-white rounded-lg py-7 px-8 max-w-95 w-[90%] shadow-[0_20px_60px_rgba(0,0,0,0.2)]">
        <p class="font-body text-sm font-semibold text-neutral-800 mb-1.5">Archive pillar?</p>
        <p class="font-body text-[13px] text-neutral-600 mb-1 leading-normal">Archive <span x-text="'&quot;' + modal.name + '&quot;'"></span>?</p>
        <p class="font-body text-[13px] text-neutral-500 mb-5 leading-normal">This will hide it from the list. It cannot be deleted if active teams are assigned to it.</p>
        <div class="flex gap-2.5 justify-end">
          <button @click="modal.open = false"
            class="px-4 py-2 bg-neutral-100 border border-neutral-200 rounded-md font-body text-[13px] font-medium cursor-pointer text-neutral-700">
            Cancel
          </button>
          <button @click="doDelete()"
            class="px-4 py-2 bg-danger-600 text-white border-0 rounded-md font-body text-[13px] font-semibold cursor-pointer">
            Archive
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
