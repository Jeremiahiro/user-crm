---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

// Two separate queries to avoid nested FK join issues
const [{ data: rawPositions }, { data: rawActiveTenures }] = await Promise.all([
  supabaseAdmin
    .from('elected_positions')
    .select('id, title, description, order_of_precedence, is_active')
    .eq('is_active', true)
    .order('order_of_precedence', { ascending: true, nullsFirst: false }),
  // Active tenures only (no term_end)
  supabaseAdmin
    .from('elected_position_tenures')
    .select('id, position_id, person_id, term_start')
    .is('term_end', null),
])

type Position = {
  id: string
  title: string
  description: string | null
  order_of_precedence: number | null
  is_active: boolean
}

type ActiveTenure = {
  id: string
  position_id: string
  person_id: string
  term_start: string
}

const positions = (rawPositions ?? []) as Position[]
const activeTenures = (rawActiveTenures ?? []) as ActiveTenure[]

// Collect person_ids for active tenure holders
const personIds = [...new Set(activeTenures.map(t => t.person_id))]

const { data: rawPeople } = personIds.length > 0
  ? await supabaseAdmin
      .from('people')
      .select('id, full_name, profile_photo_url')
      .in('id', personIds)
  : { data: [] }

type Person = { id: string; full_name: string; profile_photo_url: string | null }
const people = (rawPeople ?? []) as Person[]
const peopleMap = new Map(people.map(p => [p.id, p]))

// Map position_id → active tenure
const activeTenureByPosition = new Map(activeTenures.map(t => [t.position_id, t]))

// Count ALL tenures per position (for delete eligibility)
const { data: allTenureCounts } = await supabaseAdmin
  .from('elected_position_tenures')
  .select('position_id')

const tenureCountMap = new Map<string, number>()
for (const row of allTenureCounts ?? []) {
  tenureCountMap.set(row.position_id, (tenureCountMap.get(row.position_id) ?? 0) + 1)
}

function getInitials(name: string): string {
  return name.trim().split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase()
}
---

<DashboardLayout title="Elected Positions">
  <div id="positions-root">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Elected Positions</h1>
        <p class="font-body text-sm text-neutral-500 m-0">
          Chapter leadership positions and current holders.
        </p>
      </div>
      <a href="/admin/positions/new"
         class="inline-flex items-center gap-1.5 bg-brand-navy text-white py-2.5 px-4.5 rounded-md font-body text-sm font-semibold no-underline">
        + Add position
      </a>
    </div>

    {positions.length === 0 ? (
      <div class="bg-white border border-neutral-200 rounded-lg px-6 py-12 text-center text-neutral-500 text-sm font-body">
        No active positions yet. <a href="/admin/positions/new" class="text-brand-navy">Add one →</a>
      </div>
    ) : (
      <div class="grid gap-4">
        {positions.map((position) => {
          const tenure = activeTenureByPosition.get(position.id)
          const holder = tenure ? peopleMap.get(tenure.person_id) : undefined
          const totalTenures = tenureCountMap.get(position.id) ?? 0
          const canDelete = admin && totalTenures === 0

          return (
            <div class="bg-white border border-neutral-200 rounded-lg px-6 py-5 flex items-center justify-between gap-6">
              <div class="flex items-center gap-5 flex-1 min-w-0">
                <div class="w-10 h-10 rounded-full bg-brand-navy text-white flex items-center justify-center font-heading text-base font-bold shrink-0">
                  {position.order_of_precedence ?? '—'}
                </div>
                <div class="min-w-0">
                  <a href={`/admin/positions/${position.id}`} class="no-underline">
                  <h2 class="font-heading text-base font-bold text-brand-navy mb-0.5 whitespace-nowrap overflow-hidden text-ellipsis">{position.title}</h2>
                  </a>
                  {position.description && (
                    <p class="font-body text-[13px] text-neutral-500 m-0">{position.description}</p>
                  )}
                </div>
              </div>

              <div class="flex items-center gap-4 shrink-0">
                {holder ? (
                  <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center font-body text-xs font-semibold shrink-0 overflow-hidden">
                      {holder.profile_photo_url
                        ? <img src={holder.profile_photo_url} alt={holder.full_name} width={36} height={36} class="w-full h-full object-cover" />
                        : getInitials(holder.full_name)}
                    </div>
                    <div>
                      <a href={`/admin/members/${holder.id}`}
                         class="font-body text-sm font-semibold text-brand-navy no-underline block">
                        {holder.full_name}
                      </a>
                      {tenure && (
                        <p class="font-body text-xs text-neutral-500 m-0">
                          Since {new Date(tenure.term_start).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
                        </p>
                      )}
                    </div>
                  </div>
                ) : (
                  <Badge variant="neutral">Vacant</Badge>
                )}

                <a href={`/admin/positions/${position.id}`}
                   class="py-1.75 px-3.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-[13px] font-medium no-underline">
                  View
                </a>
              </div>
            </div>
          )
        })}
      </div>
    )}
  </div>

</DashboardLayout>
