---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

// Two separate queries to avoid nested FK join issues
const [{ data: rawPositions }, { data: rawActiveTenures }] = await Promise.all([
  supabaseAdmin
    .from('elected_positions')
    .select('id, title, description, order_of_precedence, is_active')
    .eq('is_active', true)
    .order('order_of_precedence', { ascending: true, nullsFirst: false }),
  // Active tenures only (no term_end)
  supabaseAdmin
    .from('elected_position_tenures')
    .select('id, position_id, person_id, term_start')
    .is('term_end', null),
])

type Position = {
  id: string
  title: string
  description: string | null
  order_of_precedence: number | null
  is_active: boolean
}

type ActiveTenure = {
  id: string
  position_id: string
  person_id: string
  term_start: string
}

const positions = (rawPositions ?? []) as Position[]
const activeTenures = (rawActiveTenures ?? []) as ActiveTenure[]

// Collect person_ids for active tenure holders
const personIds = [...new Set(activeTenures.map(t => t.person_id))]

const { data: rawPeople } = personIds.length > 0
  ? await supabaseAdmin
      .from('people')
      .select('id, full_name, profile_photo_url')
      .in('id', personIds)
  : { data: [] }

type Person = { id: string; full_name: string; profile_photo_url: string | null }
const people = (rawPeople ?? []) as Person[]
const peopleMap = new Map(people.map(p => [p.id, p]))

// Map position_id → active tenure
const activeTenureByPosition = new Map(activeTenures.map(t => [t.position_id, t]))

// Count ALL tenures per position (for delete eligibility)
const { data: allTenureCounts } = await supabaseAdmin
  .from('elected_position_tenures')
  .select('position_id')

const tenureCountMap = new Map<string, number>()
for (const row of allTenureCounts ?? []) {
  tenureCountMap.set(row.position_id, (tenureCountMap.get(row.position_id) ?? 0) + 1)
}

function getInitials(name: string): string {
  return name.trim().split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase()
}
---

<DashboardLayout title="Elected Positions">
  <div id="positions-root">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
      <div>
        <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Elected Positions</h1>
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0;">
          Chapter leadership positions and current holders.
        </p>
      </div>
      <a href="/admin/positions/new"
         style="display: inline-flex; align-items: center; gap: 6px; background-color: var(--color-brand-navy); color: white; padding: 10px 18px; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
        + Add position
      </a>
    </div>

    {positions.length === 0 ? (
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 48px 24px; text-align: center; color: var(--color-neutral-500); font-size: 14px; font-family: var(--font-body);">
        No active positions yet. <a href="/admin/positions/new" style="color: var(--color-brand-navy);">Add one →</a>
      </div>
    ) : (
      <div style="display: grid; gap: 16px;">
        {positions.map((position) => {
          const tenure = activeTenureByPosition.get(position.id)
          const holder = tenure ? peopleMap.get(tenure.person_id) : undefined
          const totalTenures = tenureCountMap.get(position.id) ?? 0
          const canDelete = admin && totalTenures === 0

          return (
            <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px;">
              <div style="display: flex; align-items: center; gap: 20px; flex: 1; min-width: 0;">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-full); background-color: var(--color-brand-navy); color: white; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 16px; font-weight: 700; flex-shrink: 0;">
                  {position.order_of_precedence ?? '—'}
                </div>
                <div style="min-width: 0;">
                  <a href={`/admin/positions/${position.id}`} style="text-decoration: none;">
                  <h2 style="font-family: var(--font-heading); font-size: 16px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{position.title}</h2>
                  </a>
                  {position.description && (
                    <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); margin: 0;">{position.description}</p>
                  )}
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 16px; flex-shrink: 0;">
                {holder ? (
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; border-radius: var(--radius-full); background-color: var(--color-brand-gold); color: var(--color-brand-navy); display: flex; align-items: center; justify-content: center; font-family: var(--font-body); font-size: 12px; font-weight: 600; flex-shrink: 0; overflow: hidden;">
                      {holder.profile_photo_url
                        ? <img src={holder.profile_photo_url} alt={holder.full_name} width={36} height={36} style="width:100%;height:100%;object-fit:cover;" />
                        : getInitials(holder.full_name)}
                    </div>
                    <div>
                      <a href={`/admin/members/${holder.id}`}
                         style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-brand-navy); text-decoration: none; display: block;">
                        {holder.full_name}
                      </a>
                      {tenure && (
                        <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-500); margin: 0;">
                          Since {new Date(tenure.term_start).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
                        </p>
                      )}
                    </div>
                  </div>
                ) : (
                  <Badge variant="neutral">Vacant</Badge>
                )}

                <a href={`/admin/positions/${position.id}`}
                   style="padding: 7px 14px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 500; text-decoration: none;">
                  View
                </a>
              </div>
            </div>
          )
        })}
      </div>
    )}
  </div>

</DashboardLayout>
