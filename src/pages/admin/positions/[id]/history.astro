---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Badge from '@/components/ui/Badge.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params
const [{ data: position }, { data: tenures }] = await Promise.all([
  supabaseAdmin.from('elected_positions').select('title').eq('id', id ?? '').single(),
  supabaseAdmin
    .from('elected_position_tenures')
    .select('*, people(id, full_name, email, profile_photo_url)')
    .eq('position_id', id ?? '')
    .order('term_start', { ascending: false }),
])

if (!position) return Astro.redirect('/admin/positions')

type TenureRow = {
  id: string
  term_start: string
  term_end: string | null
  elected_by: string | null
  notes: string | null
  people: { id: string; full_name: string; email: string; profile_photo_url: string | null } | null
}

const rows = (tenures ?? []) as TenureRow[]
---

<DashboardLayout title={`${position.title} — History`}>
  <Breadcrumb crumbs={[{ label: 'Positions', href: '/admin/positions' }, { label: position.title as string, href: '/admin/positions' }, { label: 'History' }]} />
  <div>
    <div class="flex items-center justify-between mb-6">
      <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0">
        {position.title} — Tenure History
      </h1>
      <a href={`/admin/positions/${id}/assign`}
         class="px-4 py-2 bg-brand-gold text-brand-navy rounded-md font-body text-[13px] font-semibold no-underline">
        Assign new holder
      </a>
    </div>

    {rows.length > 0 ? (
      <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-neutral-100">
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Member</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Term start</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Term end</th>
              <th class="px-4 py-3 text-left font-body text-[11px] font-semibold text-neutral-600 uppercase tracking-[0.08em]">Elected by</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(t => (
              <tr class={`border-t border-neutral-100 ${!t.term_end ? 'bg-neutral-50' : ''}`}>
                <td class="px-4 py-[14px]">
                  {t.people ? (
                    <a href={`/admin/members/${t.people.id}`}
                       class="font-body text-sm font-semibold text-brand-navy no-underline block">
                      {t.people.full_name}
                      {!t.term_end && <Badge variant="success">Current</Badge>}
                    </a>
                  ) : (
                    <span class="font-body text-sm text-neutral-400">Unknown member</span>
                  )}
                </td>
                <td class="px-4 py-[14px] font-body text-[13px] text-neutral-700">{t.term_start}</td>
                <td class="px-4 py-[14px] font-body text-[13px] text-neutral-500">{t.term_end ?? '—'}</td>
                <td class="px-4 py-[14px] font-body text-[13px] text-neutral-600">{(t.elected_by ?? '').replace(/_/g, ' ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="font-body text-xs text-neutral-400 px-4 py-3 m-0 border-t border-neutral-100">
          Tenure records are permanent and cannot be deleted.
        </p>
      </div>
    ) : (
      <EmptyState heading="No tenure history" subtext="This position has not yet been assigned to anyone." />
    )}
  </div>
</DashboardLayout>
