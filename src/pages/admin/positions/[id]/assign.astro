---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import MemberSearch from '@/components/ui/MemberSearch.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params
const { data: position } = await supabaseAdmin
  .from('elected_positions').select('*').eq('id', id ?? '').single()

if (!position) return Astro.redirect('/admin/positions')

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {
  term_start: new Date().toISOString().split('T')[0] ?? '',
  elected_by: 'chapter_vote',
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/positions/${id}/assign`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      person_id: values.person_id,
      term_start: values.term_start,
      elected_by: values.elected_by,
      notes: values.notes || undefined,
    }),
  })

  if (res.ok) {
    return Astro.redirect('/admin/positions')
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? ''
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title={`Assign — ${position.title}`}>
  <div class="max-w-150">
    <Breadcrumb crumbs={[{ label: 'Positions', href: '/admin/positions' }, { label: position.title as string, href: '/admin/positions' }, { label: 'Assign' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0 mb-1">Assign Position</h1>
    <p class="font-body text-sm text-neutral-500 m-0 mb-6">{position.title}</p>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <div class="bg-warning-50 border border-warning-200 rounded-md px-4 py-3 mb-6">
      <p class="font-body text-[13px] text-warning-700 m-0 leading-normal">
        <strong>Note:</strong> Assigning this position will close the current holder's tenure (if any) and automatically grant the linked role where applicable.
      </p>
    </div>

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">
      <MemberSearch
        name="person_id"
        label="Member"
        required
        value={values.person_id}
        statusFilter="active"
        error={errors.person_id}
      />

      <Input label="Term start date *" name="term_start" type="date" value={values.term_start} error={errors.term_start} required />

      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Elected by *</label>
        <select name="elected_by" required
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 bg-white">
          <option value="chapter_vote" selected={values.elected_by === 'chapter_vote'}>Chapter vote</option>
          <option value="board_appointment" selected={values.elected_by === 'board_appointment'}>Board appointment</option>
          <option value="co_option" selected={values.elected_by === 'co_option'}>Co-option</option>
        </select>
      </div>

      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Notes</label>
        <textarea name="notes" rows={3}
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 resize-y">{values.notes}</textarea>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-5 py-2.5 bg-brand-gold text-brand-navy border-none rounded-md font-body text-sm font-semibold cursor-pointer">
          Confirm assignment
        </button>
        <a href="/admin/positions" class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">Cancel</a>
      </div>
    </form>
  </div>
</DashboardLayout>
