---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Badge from '@/components/ui/Badge.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

const { id } = Astro.params

// Three separate queries to avoid nested FK join failures
const [{ data: position }, { data: rawTenures }, { count: totalTenures }] = await Promise.all([
  supabaseAdmin
    .from('elected_positions')
    .select('id, title, description, order_of_precedence, is_active')
    .eq('id', id ?? '')
    .single(),
  supabaseAdmin
    .from('elected_position_tenures')
    .select('id, person_id, term_start, term_end, elected_by, notes')
    .eq('position_id', id ?? '')
    .order('term_start', { ascending: false }),
  supabaseAdmin
    .from('elected_position_tenures')
    .select('id', { count: 'exact', head: true })
    .eq('position_id', id ?? ''),
])

if (!position) return Astro.redirect('/admin/positions')

type TenureRow = {
  id: string
  person_id: string
  term_start: string
  term_end: string | null
  elected_by: string | null
  notes: string | null
}

const tenures = (rawTenures ?? []) as TenureRow[]

// Fetch people for all tenure holders in one query
const personIds = [...new Set(tenures.map(t => t.person_id))]
const { data: rawPeople } = personIds.length > 0
  ? await supabaseAdmin
      .from('people')
      .select('id, full_name, email, profile_photo_url')
      .in('id', personIds)
  : { data: [] }

type Person = { id: string; full_name: string; email: string; profile_photo_url: string | null }
const peopleMap = new Map(((rawPeople ?? []) as Person[]).map(p => [p.id, p]))

const activeTenure = tenures.find(t => !t.term_end)
const currentHolder = activeTenure ? peopleMap.get(activeTenure.person_id) : undefined
const canDelete = admin && (totalTenures ?? 0) === 0

function fmtDate(iso: string | null) {
  if (!iso) return '—'
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

function getInitials(name: string) {
  return name.trim().split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase()
}

// Handle edit form POST
let editErrors: Record<string, string> = {}
let editGlobalError = ''
let editSuccess = false

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/positions/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      title: values.title,
      description: values.description || null,
      order_of_precedence: values.order_of_precedence ? parseInt(values.order_of_precedence) : null,
    }),
  })

  if (res.ok) {
    return Astro.redirect(`/admin/positions/${id}?saved=1`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    editGlobalError = body.error ?? 'Failed to save changes.'
    editErrors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}

const saved = Astro.url.searchParams.get('saved') === '1'
---

<DashboardLayout title={position.title as string}>
  <div id="pos-root" data-pos-id={id} data-pos-title={position.title as string}
    x-data="{
      modalOpen: false,
      posId: '',
      posTitle: '',
      loading: false,
      error: '',
      init() {
        this.posId = this.$el.dataset.posId;
        this.posTitle = this.$el.dataset.posTitle;
      },
      openModal() {
        this.modalOpen = true;
        this.error = '';
      },
      async doAction() {
        this.loading = true;
        var res = await fetch('/api/positions/' + this.posId, { method: 'DELETE' });
        if (res.ok) {
          window.location.href = '/admin/positions';
        } else {
          var e = await res.json();
          this.error = e.error || 'Failed to delete';
          this.loading = false;
        }
      }
    }"
    class="max-w-180">
    <Breadcrumb crumbs={[{ label: 'Positions', href: '/admin/positions' }, { label: position.title as string }]} />

    <!-- Header -->
    <div class="flex items-start justify-between mb-7 gap-4">
      <div>
        <div class="flex items-center gap-2.5 mb-1">
          {(position.order_of_precedence as number | null) && (
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-brand-navy text-white font-heading text-sm font-bold shrink-0">
              {position.order_of_precedence}
            </span>
          )}
          <h1 class="font-heading text-2xl font-bold text-brand-navy m-0">
            {position.title}
          </h1>
        </div>
        {(position.description as string | null) && (
          <p class="font-body text-sm text-neutral-500 m-0">{position.description}</p>
        )}
      </div>
      <a href={`/admin/positions/${id}/assign`}
         class="shrink-0 px-4 py-2 bg-brand-gold text-brand-navy rounded-md font-body text-[13px] font-semibold no-underline whitespace-nowrap">
        Assign holder
      </a>
    </div>

    <!-- Saved banner -->
    {saved && (
      <div class="bg-[#f0fdf4] border border-[#86efac] rounded-md px-4 py-2.5 mb-5 font-body text-sm text-[#166534]">
        Changes saved.
      </div>
    )}

    <!-- Current holder -->
    <div class="bg-white border border-neutral-200 rounded-lg px-6 py-5 mb-5">
      <h2 class="font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mt-0 mb-3.5">Current holder</h2>
      {currentHolder ? (
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center font-body text-sm font-bold shrink-0 overflow-hidden">
              {currentHolder.profile_photo_url
                ? <img src={currentHolder.profile_photo_url} alt={currentHolder.full_name} width={44} height={44} class="w-full h-full object-cover" />
                : getInitials(currentHolder.full_name)}
            </div>
            <div>
              <a href={`/admin/members/${currentHolder.id}`}
                 class="font-body text-[15px] font-semibold text-brand-navy no-underline block">
                {currentHolder.full_name}
              </a>
              <p class="font-body text-xs text-neutral-500 mt-0.5 mb-0">
                Since {fmtDate(activeTenure!.term_start)}
              </p>
            </div>
          </div>
          <Badge variant="success">Current</Badge>
        </div>
      ) : (
        <p class="font-body text-sm text-neutral-400 m-0">
          Vacant — <a href={`/admin/positions/${id}/assign`} class="text-brand-navy">assign a holder →</a>
        </p>
      )}
    </div>

    <!-- Edit form -->
    {admin && (
      <div class="bg-white border border-neutral-200 rounded-lg p-6 mb-5">
        <h2 class="font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mt-0 mb-4">Edit position</h2>

        {editGlobalError && (
          <div class="bg-danger-50 border border-danger-200 rounded-md px-3.5 py-2.5 mb-4 font-body text-sm text-danger-700">
            {editGlobalError}
          </div>
        )}

        <form method="POST" class="flex flex-col gap-4">
          <div class="grid grid-cols-[1fr_auto] gap-4 items-end">
            <Input
              label="Title *"
              name="title"
              value={position.title as string}
              error={editErrors.title}
              required
            />
            <div class="flex flex-col gap-1 w-25">
              <label class="font-body text-[13px] font-medium text-neutral-700">Order</label>
              <input
                type="number"
                name="order_of_precedence"
                value={(position.order_of_precedence as number | null) ?? ''}
                min="1"
                placeholder="—"
                class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800 w-full box-border"
              />
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <label class="font-body text-[13px] font-medium text-neutral-700">Description</label>
            <textarea name="description" rows={2} placeholder="Optional — describe this position's responsibilities…"
              class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm resize-y">{(position.description as string | null) ?? ''}</textarea>
          </div>
          <div>
            <button type="submit"
              class="px-4.5 py-2 bg-brand-navy text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer">
              Save changes
            </button>
          </div>
        </form>
      </div>
    )}

    <!-- Tenure history -->
    <div class="mb-5">
      <h2 class="font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.08em] mt-0 mb-3">Tenure history</h2>

      {tenures.length > 0 ? (
        <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
          <table class="w-full border-collapse">
            <thead>
              <tr class="bg-neutral-50">
                <th class="px-4 py-2.5 text-left font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.06em]">Member</th>
                <th class="px-4 py-2.5 text-left font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.06em]">From</th>
                <th class="px-4 py-2.5 text-left font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.06em]">To</th>
                <th class="px-4 py-2.5 text-left font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.06em]">Elected by</th>
              </tr>
            </thead>
            <tbody>
              {tenures.map((t, i) => {
                const person = peopleMap.get(t.person_id)
                return (
                  <tr class={`${i > 0 ? 'border-t border-neutral-100' : ''} ${!t.term_end ? 'bg-neutral-50' : ''}`}>
                    <td class="px-4 py-3">
                      {person ? (
                        <div class="flex items-center gap-2">
                          <a href={`/admin/members/${person.id}`}
                             class="font-body text-sm font-medium text-brand-navy no-underline">
                            {person.full_name}
                          </a>
                          {!t.term_end && <Badge variant="success">Current</Badge>}
                        </div>
                      ) : (
                        <span class="font-body text-sm text-neutral-400">Unknown</span>
                      )}
                    </td>
                    <td class="px-4 py-3 font-body text-[13px] text-neutral-700">{fmtDate(t.term_start)}</td>
                    <td class="px-4 py-3 font-body text-[13px] text-neutral-500">{fmtDate(t.term_end)}</td>
                    <td class="px-4 py-3 font-body text-[13px] text-neutral-600">{(t.elected_by ?? '').replace(/_/g, ' ') || '—'}</td>
                  </tr>
                )
              })}
            </tbody>
          </table>
          <p class="font-body text-xs text-neutral-400 px-4 py-2.5 m-0 border-t border-neutral-100">
            Tenure records are permanent and cannot be deleted.
          </p>
        </div>
      ) : (
        <EmptyState heading="No tenure history" subtext="This position has not yet been assigned to anyone." />
      )}
    </div>

    <!-- Danger zone -->
    {admin && (
      <div class="border border-danger-200 rounded-lg overflow-hidden">
        <div class="bg-danger-50 px-5 py-3 border-b border-danger-200">
          <h2 class="font-heading text-xs font-semibold text-danger-700 m-0 uppercase tracking-[0.06em]">Danger zone</h2>
        </div>
        <div class="bg-white px-6 py-4.5 flex items-center justify-between gap-6">
          <div>
            <p class="font-body text-sm font-semibold text-neutral-800 m-0 mb-0.5">Delete this position</p>
            <p class="font-body text-[13px] text-neutral-500 m-0">
              {canDelete
                ? 'Permanently removes this position. Cannot be undone.'
                : `Has ${totalTenures} tenure record${(totalTenures ?? 0) !== 1 ? 's' : ''} — cannot delete.`}
            </p>
          </div>
          <button
            disabled={!canDelete}
            @click="openModal()"
            class={`shrink-0 px-4 py-2 rounded-md font-body text-[13px] font-semibold border-none ${canDelete ? 'cursor-pointer bg-danger-600 text-white' : 'cursor-not-allowed bg-neutral-100 text-neutral-400'}`}>
            Delete
          </button>
        </div>
      </div>
    )}

    <!-- Confirmation Modal -->
    <div x-show="modalOpen" @click.self="modalOpen = false" @keydown.escape.window="modalOpen = false"
      class="fixed inset-0 z-[100] flex items-center justify-center bg-[rgba(0,0,0,0.45)]">
      <div class="bg-white rounded-lg px-8 py-7 max-w-105 w-[90%] shadow-[0_25px_50px_rgba(0,0,0,0.2)]">
        <h3 class="font-heading text-[17px] font-bold text-brand-navy mt-0 mb-2.5">Delete position</h3>
        <p class="font-body text-sm text-neutral-700 mt-0 mb-5 leading-[1.55]">
          Permanently removes this position. This cannot be undone.
        </p>
        <p x-show="error" x-text="error" class="font-body text-[13px] text-danger-600 mt-0 mb-3.5"></p>
        <div class="flex gap-2.5 justify-end">
          <button @click="modalOpen = false" :disabled="loading"
            class="px-4.5 py-2 bg-neutral-100 border border-neutral-200 rounded-md font-body text-sm font-medium cursor-pointer text-neutral-700">
            Cancel
          </button>
          <button @click="doAction()" :disabled="loading" x-text="loading ? 'Deleting...' : 'Delete'"
            class="px-4.5 py-2 bg-danger-600 text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
