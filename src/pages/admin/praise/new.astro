---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const { data: settingRow } = await supabaseAdmin
  .from('org_settings')
  .select('value')
  .eq('key', 'allow_member_praise')
  .single()

const allowMemberPraise = (settingRow?.value ?? 'true') === 'true'
const userIsAdmin = isAdmin(Astro.locals.user)

if (!allowMemberPraise && !userIsAdmin) {
  return Astro.redirect('/admin/praise')
}

const personId = Astro.url.searchParams.get('person_id') ?? ''
const returnTo = personId ? `/admin/members/${personId}?tab=recognition` : '/admin/praise'

let globalError = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const recipientIds = (form.getAll('recipient_ids[]') as string[]).filter(Boolean)
  const message = (form.get('message') as string ?? '').trim()

  const res = await fetch(`${Astro.url.origin}/api/praise`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({ recipient_ids: recipientIds, message }),
  })

  if (res.ok) {
    return Astro.redirect(form.get('return_to') as string || returnTo)
  } else {
    const body = await res.json() as { error?: string }
    globalError = body.error ?? 'Failed to submit praise.'
  }
}

let memberName = ''
if (personId) {
  const { data: person } = await supabaseAdmin.from('people').select('full_name').eq('id', personId).single()
  memberName = (person?.full_name as string | null) ?? ''
}

const crumbs = personId
  ? [
      { label: 'Members', href: '/admin/members' },
      { label: memberName || 'Member', href: `/admin/members/${personId}?tab=recognition` },
      { label: 'Give Praise' },
    ]
  : [{ label: 'Praise', href: '/admin/praise' }, { label: 'Give Praise' }]

const initialId   = personId
const initialName = memberName
---

<DashboardLayout title="Give Praise">
  <div class="max-w-140">
    <Breadcrumb crumbs={crumbs} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-1">Give Praise ⭐</h1>
    <p class="font-body text-sm text-neutral-500 mb-6">Recognise one or more members for their contribution.</p>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form
      method="POST"
      id="praise-form"
      x-data={`{
        recipients: ${JSON.stringify(initialId ? [{ id: initialId, full_name: initialName }] : [])},
        search: '',
        results: [],
        open: false,
        showError: false,
        debounceTimer: null,
        doSearch() {
          const q = this.search.trim();
          if (q.length < 3) { this.results = []; this.open = false; return; }
          clearTimeout(this.debounceTimer);
          this.debounceTimer = setTimeout(async () => {
            try {
              const res = await fetch('/api/members?q=' + encodeURIComponent(q) + '&status=active,approved');
              const j = await res.json();
              const existing = new Set(this.recipients.map(r => r.id));
              this.results = (j.data || []).filter(m => !existing.has(m.id)).slice(0, 10);
              this.open = this.results.length > 0;
            } catch { this.results = []; this.open = false; }
          }, 300);
        },
        select(r) {
          if (!this.recipients.find(x => x.id === r.id)) { this.recipients.push(r); }
          this.search = '';
          this.results = [];
          this.open = false;
          this.showError = false;
        },
        remove(id) {
          this.recipients = this.recipients.filter(r => r.id !== id);
        }
      }`}
      @submit.prevent="if (recipients.length === 0) { showError = true } else { $el.submit() }"
      class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5"
    >
      <input type="hidden" name="return_to" value={returnTo} />

      <!-- Recipients -->
      <div>
        <label class="block font-body text-[13px] font-medium text-neutral-700 mb-2">
          Recognising <span class="text-danger-600">*</span>
        </label>

        <!-- Selected recipient chips -->
        <div class="flex flex-wrap gap-1.5 mb-2">
          <template x-for="r in recipients" :key="r.id">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-brand-navy text-white rounded-full font-body text-[13px] font-medium">
              <span x-text="r.full_name"></span>
              <button type="button" @click="remove(r.id)" class="bg-transparent border-0 text-white cursor-pointer p-0 leading-none text-sm opacity-80">&times;</button>
              <input type="hidden" name="recipient_ids[]" :value="r.id" />
            </span>
          </template>
        </div>

        <!-- Search input -->
        <div class="relative">
          <input
            type="text"
            x-model="search"
            @input="doSearch()"
            @blur="setTimeout(() => { open = false }, 150)"
            @keydown.escape="open = false; search = ''; results = []"
            autocomplete="off"
            spellcheck="false"
            placeholder="Type at least 3 characters to search…"
            class="w-full px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm box-border"
          />
          <!-- Dropdown results -->
          <ul
            x-show="open && results.length"
            class="absolute top-[calc(100%+2px)] left-0 right-0 bg-white border border-neutral-200 rounded-md m-0 p-1 list-none max-h-55 overflow-y-auto z-100 shadow-[0_4px_16px_rgba(0,0,0,0.12)]"
          >
            <template x-for="r in results" :key="r.id">
              <li
                @mousedown.prevent="select(r)"
                class="px-3 py-2.5 cursor-pointer rounded-[6px] text-sm font-body text-neutral-800"
                @mouseenter="$el.style.background='var(--color-neutral-100)'"
                @mouseleave="$el.style.background=''"
                x-text="r.full_name"
              ></li>
            </template>
          </ul>
        </div>

        <p class="font-body text-xs text-neutral-400 mt-1">Type at least 3 characters to search for a member</p>
        <p x-show="showError" class="font-body text-[13px] text-danger-600 mt-1.5">Please select at least one recipient.</p>
      </div>

      <!-- Message -->
      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Message <span class="text-danger-600">*</span></label>
        <textarea name="message" rows={5} required placeholder="What did they do that deserves recognition?"
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm resize-y"></textarea>
      </div>

      <p class="font-body text-[13px] text-neutral-500 m-0">
        Each recipient will be notified by email. All members will see this in their notifications.
      </p>

      <div class="flex gap-3 pt-1">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Give praise
        </button>
        <a href={returnTo} class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
