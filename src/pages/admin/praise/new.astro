---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const { data: settingRow } = await supabaseAdmin
  .from('org_settings')
  .select('value')
  .eq('key', 'allow_member_praise')
  .single()

const allowMemberPraise = (settingRow?.value ?? 'true') === 'true'
const userIsAdmin = isAdmin(Astro.locals.user)

if (!allowMemberPraise && !userIsAdmin) {
  return Astro.redirect('/admin/praise')
}

const personId = Astro.url.searchParams.get('person_id') ?? ''
const returnTo = personId ? `/admin/members/${personId}?tab=recognition` : '/admin/praise'

let globalError = ''
let successCount = 0

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const recipientIds = (form.getAll('recipient_ids[]') as string[]).filter(Boolean)
  const message = (form.get('message') as string ?? '').trim()

  const res = await fetch(`${Astro.url.origin}/api/praise`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({ recipient_ids: recipientIds, message }),
  })

  if (res.ok) {
    return Astro.redirect(form.get('return_to') as string || returnTo)
  } else {
    const body = await res.json() as { error?: string }
    globalError = body.error ?? 'Failed to submit praise.'
  }
}

let memberName = ''
if (personId) {
  const { data: person } = await supabaseAdmin.from('people').select('full_name').eq('id', personId).single()
  memberName = (person?.full_name as string | null) ?? ''
}

const crumbs = personId
  ? [
      { label: 'Members', href: '/admin/members' },
      { label: memberName || 'Member', href: `/admin/members/${personId}?tab=recognition` },
      { label: 'Give Praise' },
    ]
  : [{ label: 'Praise', href: '/admin/praise' }, { label: 'Give Praise' }]

const initialId   = personId
const initialName = memberName
---

<DashboardLayout title="Give Praise">
  <div style="max-width: 560px;">
    <Breadcrumb crumbs={crumbs} />
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Give Praise ⭐</h1>
    <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0 0 24px;">Recognise one or more members for their contribution.</p>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form
      method="POST"
      id="praise-form"
      x-data={`{
        recipients: ${JSON.stringify(initialId ? [{ id: initialId, full_name: initialName }] : [])},
        search: '',
        results: [],
        open: false,
        showError: false,
        debounceTimer: null,
        doSearch() {
          const q = this.search.trim();
          if (q.length < 3) { this.results = []; this.open = false; return; }
          clearTimeout(this.debounceTimer);
          this.debounceTimer = setTimeout(async () => {
            try {
              const res = await fetch('/api/members?q=' + encodeURIComponent(q) + '&status=active,approved');
              const j = await res.json();
              const existing = new Set(this.recipients.map(r => r.id));
              this.results = (j.data || []).filter(m => !existing.has(m.id)).slice(0, 10);
              this.open = this.results.length > 0;
            } catch { this.results = []; this.open = false; }
          }, 300);
        },
        select(r) {
          if (!this.recipients.find(x => x.id === r.id)) { this.recipients.push(r); }
          this.search = '';
          this.results = [];
          this.open = false;
          this.showError = false;
        },
        remove(id) {
          this.recipients = this.recipients.filter(r => r.id !== id);
        }
      }`}
      @submit.prevent="if (recipients.length === 0) { showError = true } else { $el.submit() }"
      style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 20px;"
    >
      <input type="hidden" name="return_to" value={returnTo} />

      <!-- Recipients -->
      <div>
        <label style="display: block; font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700); margin-bottom: 8px;">
          Recognising <span style="color: var(--color-danger-600);">*</span>
        </label>

        <!-- Selected recipient chips -->
        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px;">
          <template x-for="r in recipients" :key="r.id">
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: var(--color-brand-navy); color: white; border-radius: var(--radius-full); font-family: var(--font-body); font-size: 13px; font-weight: 500;">
              <span x-text="r.full_name"></span>
              <button type="button" @click="remove(r.id)" style="background: none; border: none; color: white; cursor: pointer; padding: 0; line-height: 1; font-size: 14px; opacity: 0.8;">&times;</button>
              <input type="hidden" name="recipient_ids[]" :value="r.id" />
            </span>
          </template>
        </div>

        <!-- Search input -->
        <div style="position: relative;">
          <input
            type="text"
            x-model="search"
            @input="doSearch()"
            @blur="setTimeout(() => { open = false }, 150)"
            @keydown.escape="open = false; search = ''; results = []"
            autocomplete="off"
            spellcheck="false"
            placeholder="Type at least 3 characters to search…"
            style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; box-sizing: border-box;"
          />
          <!-- Dropdown results -->
          <ul
            x-show="open && results.length"
            style="position: absolute; top: calc(100% + 2px); left: 0; right: 0; background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); margin: 0; padding: 4px; list-style: none; max-height: 220px; overflow-y: auto; z-index: 100; box-shadow: 0 4px 16px rgba(0,0,0,0.12);"
          >
            <template x-for="r in results" :key="r.id">
              <li
                @mousedown.prevent="select(r)"
                style="padding: 10px 12px; cursor: pointer; border-radius: 6px; font-size: 14px; font-family: var(--font-body); color: var(--color-neutral-800);"
                @mouseenter="$el.style.background='var(--color-neutral-100)'"
                @mouseleave="$el.style.background=''"
                x-text="r.full_name"
              ></li>
            </template>
          </ul>
        </div>

        <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 4px 0 0;">Type at least 3 characters to search for a member</p>
        <p x-show="showError" style="font-family: var(--font-body); font-size: 13px; color: var(--color-danger-600); margin: 6px 0 0;">Please select at least one recipient.</p>
      </div>

      <!-- Message -->
      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Message <span style="color: var(--color-danger-600);">*</span></label>
        <textarea name="message" rows={5} required placeholder="What did they do that deserves recognition?"
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; resize: vertical;"></textarea>
      </div>

      <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); margin: 0;">
        Each recipient will be notified by email. All members will see this in their notifications.
      </p>

      <div style="display: flex; gap: 12px; padding-top: 4px;">
        <button type="submit" style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Give praise
        </button>
        <a href={returnTo} style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
