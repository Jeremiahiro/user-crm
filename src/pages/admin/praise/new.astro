---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const { data: settingRow } = await supabaseAdmin
  .from('org_settings')
  .select('value')
  .eq('key', 'allow_member_praise')
  .single()

const allowMemberPraise = (settingRow?.value ?? 'true') === 'true'
const userIsAdmin = isAdmin(Astro.locals.user)

if (!allowMemberPraise && !userIsAdmin) {
  return Astro.redirect('/admin/praise')
}

const personId = Astro.url.searchParams.get('person_id') ?? ''
const returnTo = personId ? `/admin/members/${personId}?tab=recognition` : '/admin/praise'

let globalError = ''
let successCount = 0

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const recipientIds = (form.getAll('recipient_id') as string[]).filter(Boolean)
  const message = (form.get('message') as string ?? '').trim()

  const res = await fetch(`${Astro.url.origin}/api/praise`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({ recipient_ids: recipientIds, message }),
  })

  if (res.ok) {
    return Astro.redirect(form.get('return_to') as string || returnTo)
  } else {
    const body = await res.json() as { error?: string }
    globalError = body.error ?? 'Failed to submit praise.'
  }
}

let memberName = ''
if (personId) {
  const { data: person } = await supabaseAdmin.from('people').select('full_name').eq('id', personId).single()
  memberName = (person?.full_name as string | null) ?? ''
}

const crumbs = personId
  ? [
      { label: 'Members', href: '/admin/members' },
      { label: memberName || 'Member', href: `/admin/members/${personId}?tab=recognition` },
      { label: 'Give Praise' },
    ]
  : [{ label: 'Praise', href: '/admin/praise' }, { label: 'Give Praise' }]

const initialId   = personId
const initialName = memberName
---

<DashboardLayout title="Give Praise">
  <div style="max-width: 560px;">
    <Breadcrumb crumbs={crumbs} />
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Give Praise ⭐</h1>
    <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0 0 24px;">Recognise one or more members for their contribution.</p>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form method="POST" id="praise-form" style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 20px;">
      <input type="hidden" name="return_to" value={returnTo} />

      <!-- Recipients -->
      <div>
        <label style="display: block; font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700); margin-bottom: 8px;">
          Recognising <span style="color: var(--color-danger-600);">*</span>
        </label>

        <div id="recipients-container" style="display: flex; flex-direction: column; gap: 8px;">
          <!-- First recipient — pre-filled if coming from a member profile -->
          <div class="recipient-field" style="display: flex; align-items: flex-start; gap: 8px;">
            <div style="flex: 1; position: relative;">
              <input
                type="text"
                class="search-input"
                autocomplete="off"
                spellcheck="false"
                placeholder="Type at least 3 characters…"
                value={initialName}
                style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; box-sizing: border-box;"
              />
              <input type="hidden" name="recipient_id" class="search-value" value={initialId} />
              <ul class="search-results" style="display:none; position:absolute; top:calc(100% + 2px); left:0; right:0; background:white; border:1px solid var(--color-neutral-200); border-radius:var(--radius-md); margin:0; padding:4px; list-style:none; max-height:220px; overflow-y:auto; z-index:100; box-shadow:0 4px 16px rgba(0,0,0,0.12);"></ul>
            </div>
          </div>
        </div>

        <button type="button" id="add-recipient-btn"
          style="margin-top: 8px; background: none; border: none; padding: 0; font-family: var(--font-body); font-size: 13px; color: var(--color-brand-navy); cursor: pointer; text-decoration: underline;">
          + Add another recipient
        </button>
        <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 4px 0 0;">Type at least 3 characters to search</p>
      </div>

      <!-- Message -->
      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Message <span style="color: var(--color-danger-600);">*</span></label>
        <textarea name="message" rows={5} required placeholder="What did they do that deserves recognition?"
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; resize: vertical;"></textarea>
      </div>

      <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); margin: 0;">
        Each recipient will be notified by email. All members will see this in their notifications.
      </p>

      <div style="display: flex; gap: 12px; padding-top: 4px;">
        <button type="submit" style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Give praise
        </button>
        <a href={returnTo} style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>

<script is:inline>
  // ── Member search logic ───────────────────────────────────────────────────

  function attachSearch(field) {
    var input   = field.querySelector('.search-input')
    var hidden  = field.querySelector('.search-value')
    var results = field.querySelector('.search-results')
    if (!input || !hidden || !results) return

    var debounceTimer
    var activeIndex = -1
    var currentItems = []

    function getItems() { return results.querySelectorAll('li[data-id]') }

    function highlight(idx) {
      getItems().forEach(function(el, i) {
        el.style.background = i === idx ? 'var(--color-neutral-100)' : ''
      })
    }

    function selectItem(id, name) {
      hidden.value = id
      input.value  = name
      close()
    }

    function close() {
      results.style.display = 'none'
      results.innerHTML = ''
      activeIndex = -1
      currentItems = []
    }

    function render(items) {
      results.innerHTML = ''
      activeIndex = -1
      currentItems = items

      if (items.length === 0) {
        var li = document.createElement('li')
        li.style.cssText = 'padding:10px 12px;font-size:13px;color:var(--color-neutral-400);font-family:var(--font-body);'
        li.textContent = 'No members found'
        results.appendChild(li)
        results.style.display = 'block'
        return
      }

      items.forEach(function(item, idx) {
        var li = document.createElement('li')
        li.dataset.id = item.id
        li.style.cssText = 'padding:10px 12px;cursor:pointer;border-radius:6px;font-size:14px;font-family:var(--font-body);color:var(--color-neutral-800);'
        li.textContent = item.full_name
        li.addEventListener('mouseenter', function() { activeIndex = idx; highlight(idx) })
        li.addEventListener('mousedown', function(e) { e.preventDefault(); selectItem(item.id, item.full_name) })
        results.appendChild(li)
      })
      results.style.display = 'block'
    }

    input.addEventListener('input', function() {
      var q = input.value.trim()
      hidden.value = ''
      clearTimeout(debounceTimer)
      if (q.length < 3) { close(); return }
      debounceTimer = setTimeout(function() {
        fetch('/api/members?q=' + encodeURIComponent(q) + '&status=active,approved')
          .then(function(r) { return r.json() })
          .then(function(j) { render((j.data || []).slice(0, 10)) })
          .catch(function() { close() })
      }, 300)
    })

    input.addEventListener('keydown', function(e) {
      var items = getItems()
      if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = Math.min(activeIndex + 1, items.length - 1); highlight(activeIndex) }
      else if (e.key === 'ArrowUp') { e.preventDefault(); activeIndex = Math.max(activeIndex - 1, 0); highlight(activeIndex) }
      else if (e.key === 'Enter' && activeIndex >= 0 && currentItems[activeIndex]) { e.preventDefault(); selectItem(currentItems[activeIndex].id, currentItems[activeIndex].full_name) }
      else if (e.key === 'Escape') { close() }
    })

    input.addEventListener('blur', function() {
      setTimeout(function() { if (!field.contains(document.activeElement)) close() }, 150)
    })
  }

  // Attach to initial field
  document.querySelectorAll('.recipient-field').forEach(attachSearch)

  // ── Add / remove recipients ───────────────────────────────────────────────

  document.getElementById('add-recipient-btn').addEventListener('click', function() {
    var container = document.getElementById('recipients-container')

    var field = document.createElement('div')
    field.className = 'recipient-field'
    field.style.cssText = 'display:flex;align-items:flex-start;gap:8px;'
    field.innerHTML = '<div style="flex:1;position:relative;">'
      + '<input type="text" class="search-input" autocomplete="off" spellcheck="false" placeholder="Type at least 3 characters…" '
      + 'style="width:100%;padding:10px 12px;border:1px solid var(--color-neutral-300);border-radius:var(--radius-md);font-family:var(--font-body);font-size:14px;box-sizing:border-box;"/>'
      + '<input type="hidden" name="recipient_id" class="search-value" value=""/>'
      + '<ul class="search-results" style="display:none;position:absolute;top:calc(100% + 2px);left:0;right:0;background:white;border:1px solid var(--color-neutral-200);border-radius:var(--radius-md);margin:0;padding:4px;list-style:none;max-height:220px;overflow-y:auto;z-index:100;box-shadow:0 4px 16px rgba(0,0,0,0.12);"></ul>'
      + '</div>'
      + '<button type="button" style="padding:9px 10px;background:var(--color-neutral-100);border:1px solid var(--color-neutral-200);border-radius:var(--radius-md);font-size:14px;cursor:pointer;color:var(--color-neutral-500);line-height:1;flex-shrink:0;" title="Remove">&times;</button>'

    // Remove button
    field.querySelector('button').addEventListener('click', function() { field.remove() })

    container.appendChild(field)
    attachSearch(field)
    field.querySelector('.search-input').focus()
  })

  // ── Validate before submit ────────────────────────────────────────────────

  document.getElementById('praise-form').addEventListener('submit', function(e) {
    var values = Array.from(document.querySelectorAll('.search-value')).map(function(el) { return el.value.trim() })
    var filled = values.filter(Boolean)
    if (filled.length === 0) {
      e.preventDefault()
      alert('Please select at least one recipient.')
    }
  })
</script>
