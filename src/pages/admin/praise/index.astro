---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin    = isAdmin(Astro.locals.user)
const personId = Astro.locals.user.person_id   // may be null for admins without a linked person

// Check if members are allowed to give praise
const { data: settingRow } = await supabaseAdmin
  .from('org_settings').select('value').eq('key', 'allow_member_praise').single()
const allowMemberPraise = (settingRow?.value ?? 'true') === 'true'
const canGivePraise = admin || allowMemberPraise

// ── Year filter ─────────────────────────────────────────────────────────────
const currentYear = new Date().getFullYear()
const yearParam   = Astro.url.searchParams.get('year') // null/'' = all, '2026' = filter

// Admins: default to current year. Members: default to all years.
const selectedYear: number | null = yearParam && yearParam !== 'all'
  ? parseInt(yearParam, 10)
  : admin ? currentYear : null

// ── Pagination ──────────────────────────────────────────────────────────────
const PAGE_SIZE = 8
const recvPage       = Math.max(1, parseInt(Astro.url.searchParams.get('rp') ?? '1', 10))
const givenPage      = Math.max(1, parseInt(Astro.url.searchParams.get('gp') ?? '1', 10))
const currentFeedPage = Math.max(1, parseInt(Astro.url.searchParams.get('fp') ?? '1', 10))

type PraiseRow = {
  id: string
  message: string
  visibility: string
  created_at: string
  recipient_id: string | null
  given_by: string | null
}

// ── State ────────────────────────────────────────────────────────────────────
let receivedRows: PraiseRow[] = []
let givenRows: PraiseRow[]    = []
let receivedCount = 0
let givenCount    = 0
let receivedTotalPages = 1
let givenTotalPages    = 1
let availableYears: number[] = []
let feedRows: PraiseRow[] = []
let feedCount   = 0
let feedTotalPages = 1
// Single map of people id → name for rendering
let peopleMap = new Map<string, string>()

if (!admin && personId) {
  // Discover which years this user has praise in (received OR given)
  const [{ data: recvYears }, { data: givenYears }] = await Promise.all([
    supabaseAdmin.from('praise').select('created_at').eq('is_archived', false).eq('recipient_id', personId),
    supabaseAdmin.from('praise').select('created_at').eq('is_archived', false).eq('given_by', personId),
  ])
  availableYears = [...new Set([
    ...(recvYears  ?? []).map((r: any) => new Date(r.created_at).getFullYear()),
    ...(givenYears ?? []).map((r: any) => new Date(r.created_at).getFullYear()),
  ])].sort((a, b) => b - a)

  // Received praise
  let rq: any = supabaseAdmin.from('praise').select('*', { count: 'exact' })
    .eq('is_archived', false).eq('recipient_id', personId).order('created_at', { ascending: false })
  if (selectedYear) rq = rq.gte('created_at', `${selectedYear}-01-01`).lt('created_at', `${selectedYear + 1}-01-01`)
  const { data: rd, count: rc } = await rq.range((recvPage - 1) * PAGE_SIZE, recvPage * PAGE_SIZE - 1)
  receivedRows  = (rd ?? []) as PraiseRow[]
  receivedCount = rc ?? 0
  receivedTotalPages = Math.max(1, Math.ceil(receivedCount / PAGE_SIZE))

  // Given praise
  let gq: any = supabaseAdmin.from('praise').select('*', { count: 'exact' })
    .eq('is_archived', false).eq('given_by', personId).order('created_at', { ascending: false })
  if (selectedYear) gq = gq.gte('created_at', `${selectedYear}-01-01`).lt('created_at', `${selectedYear + 1}-01-01`)
  const { data: gd, count: gc } = await gq.range((givenPage - 1) * PAGE_SIZE, givenPage * PAGE_SIZE - 1)
  givenRows  = (gd ?? []) as PraiseRow[]
  givenCount = gc ?? 0
  givenTotalPages = Math.max(1, Math.ceil(givenCount / PAGE_SIZE))

  // Resolve people names for all rows
  const ids = [...new Set([
    ...receivedRows.map(r => r.given_by),
    ...givenRows.map(r => r.recipient_id),
  ].filter(Boolean) as string[])]
  if (ids.length > 0) {
    const { data: ppl } = await supabaseAdmin.from('people').select('id, full_name').in('id', ids)
    for (const p of (ppl ?? []) as { id: string; full_name: string }[]) peopleMap.set(p.id, p.full_name)
  }

} else if (admin) {
  // Available years across all praise
  const { data: allYears } = await supabaseAdmin.from('praise').select('created_at').eq('is_archived', false)
  availableYears = [...new Set(
    (allYears ?? []).map((r: any) => new Date(r.created_at).getFullYear())
  )].sort((a, b) => b - a)

  // Full feed
  let fq: any = supabaseAdmin.from('praise').select('*', { count: 'exact' })
    .eq('is_archived', false).order('created_at', { ascending: false })
  if (selectedYear) fq = fq.gte('created_at', `${selectedYear}-01-01`).lt('created_at', `${selectedYear + 1}-01-01`)
  const { data: fd, count: fc } = await fq.range((currentFeedPage - 1) * PAGE_SIZE, currentFeedPage * PAGE_SIZE - 1)
  feedRows  = (fd ?? []) as PraiseRow[]
  feedCount = fc ?? 0
  feedTotalPages = Math.max(1, Math.ceil(feedCount / PAGE_SIZE))

  // Resolve people names for all rows
  const ids = [...new Set([
    ...feedRows.map(r => r.recipient_id),
    ...feedRows.map(r => r.given_by),
  ].filter(Boolean) as string[])]
  if (ids.length > 0) {
    const { data: ppl } = await supabaseAdmin.from('people').select('id, full_name').in('id', ids)
    for (const p of (ppl ?? []) as { id: string; full_name: string }[]) peopleMap.set(p.id, p.full_name)
  }
}

function timeAgo(d: string): string {
  const days = Math.floor((Date.now() - new Date(d).getTime()) / 86400000)
  if (days === 0) return 'Today'
  if (days === 1) return 'Yesterday'
  if (days < 7) return `${days}d ago`
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

function pageUrl(param: string, p: number) {
  const params = new URLSearchParams()
  if (selectedYear) params.set('year', String(selectedYear))
  params.set(param, String(p))
  return `/admin/praise?${params}`
}
---

<DashboardLayout title={admin ? 'Praise Feed' : 'My Praise'}>
  <div x-data="{
    modalOpen: false,
    itemId: '',
    message: 'Archive this praise message? It will be hidden from the feed.',
    loading: false,
    error: '',
    openModal(praiseId) {
      this.itemId = praiseId;
      this.modalOpen = true;
      this.error = '';
    },
    async doAction() {
      this.loading = true;
      var res = await fetch('/api/praise/' + this.itemId, { method: 'DELETE' });
      if (res.ok) {
        var card = document.querySelector('[data-praise-id=\'' + this.itemId + '\']');
        if (card) card.remove();
        this.modalOpen = false;
        this.loading = false;
      } else {
        this.error = 'Failed to archive.';
        this.loading = false;
      }
    }
  }">

    <!-- Header -->
    <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">
          {admin ? 'Praise Feed' : 'My Praise'}
        </h1>
        <p class="font-body text-sm text-neutral-500 m-0">
          {admin
            ? `${feedCount} message${feedCount !== 1 ? 's' : ''}${selectedYear ? ` in ${selectedYear}` : ''}`
            : `${receivedCount} received · ${givenCount} given${selectedYear ? ` in ${selectedYear}` : ''}`}
        </p>
      </div>
      {canGivePraise && (
        <a href="/admin/praise/new"
          class="py-[10px] px-[18px] bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
          + Give praise
        </a>
      )}
    </div>

    <!-- Year filter -->
    {availableYears.length > 0 && (
      <div class="mb-5">
        <select onchange={`window.location.href='/admin/praise?year='+this.value`}
          class="py-[7px] px-3 border border-neutral-300 rounded-md font-body text-sm bg-white text-neutral-700 cursor-pointer min-w-[120px]">
          <option value="all" selected={!selectedYear}>All years</option>
          {availableYears.map(y => <option value={String(y)} selected={y === selectedYear}>{y}</option>)}
        </select>
      </div>
    )}

    <!-- ── Admin: single feed ─────────────────────────────────────────────── -->
    {admin && (
      <>
        {feedRows.length === 0 ? (
          <div class="bg-white border border-neutral-200 rounded-lg p-12 text-center">
            <p class="font-body text-sm text-neutral-400 mb-4">
              No praise{selectedYear ? ` in ${selectedYear}` : ' yet'}.
            </p>
            <a href="/admin/praise/new"
              class="py-[10px] px-[18px] bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
              Give praise
            </a>
          </div>
        ) : (
          <>
            <div class="flex flex-col gap-3">
              {feedRows.map(p => {
                const giverName     = p.given_by     ? (peopleMap.get(p.given_by)     ?? 'Admin') : 'Admin'
                const recipientName = p.recipient_id ? (peopleMap.get(p.recipient_id) ?? 'Unknown') : 'Unknown'
                return (
                  <div data-praise-id={p.id} class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
                    <div class="flex items-start justify-between mb-[10px]">
                      <div class="flex items-center gap-[10px]">
                        <span class="text-lg">⭐</span>
                        <div>
                          <p class="font-body text-sm m-0">
                            <strong class="text-brand-navy">{giverName}</strong>
                            <span class="text-neutral-500"> praised </span>
                            {p.recipient_id
                              ? <a href={`/admin/members/${p.recipient_id}`} class="font-semibold text-brand-navy no-underline">{recipientName}</a>
                              : <strong>someone</strong>}
                          </p>
                          <p class="font-body text-xs text-neutral-400 mt-[2px]">{timeAgo(p.created_at)}</p>
                        </div>
                      </div>
                      <button @click={`openModal('${p.id}')`}
                        class="py-1 px-[10px] bg-neutral-100 border border-neutral-200 rounded-md font-body text-xs text-neutral-500 cursor-pointer">
                        Archive
                      </button>
                    </div>
                    <p class="font-body text-sm text-neutral-700 m-0 leading-[1.6] border-l-[3px] border-brand-gold pl-3">{p.message}</p>
                  </div>
                )
              })}
            </div>
            {feedTotalPages > 1 && (
              <div class="flex items-center justify-between mt-5">
                <span class="font-body text-[13px] text-neutral-500">Page {currentFeedPage} of {feedTotalPages}</span>
                <div class="flex gap-[6px]">
                  {currentFeedPage > 1 && <a href={pageUrl('fp', currentFeedPage - 1)} class="py-[6px] px-[14px] bg-white border border-neutral-200 rounded-md font-body text-[13px] text-neutral-700 no-underline">← Prev</a>}
                  {currentFeedPage < feedTotalPages && <a href={pageUrl('fp', currentFeedPage + 1)} class="py-[6px] px-[14px] bg-white border border-neutral-200 rounded-md font-body text-[13px] text-neutral-700 no-underline">Next →</a>}
                </div>
              </div>
            )}
          </>
        )}
      </>
    )}

    <!-- ── Member: side-by-side received / given ─────────────────────────── -->
    {!admin && (
      <div class="grid grid-cols-2 gap-5 items-start">

        <!-- Received -->
        <div>
          <h2 class="font-heading text-sm font-bold text-neutral-600 uppercase tracking-[0.06em] mb-3">
            ⭐ Received <span class="font-normal text-xs text-neutral-400 normal-case tracking-[0]">({receivedCount})</span>
          </h2>
          {receivedRows.length === 0 ? (
            <div class="bg-neutral-50 border border-dashed border-neutral-200 rounded-lg py-8 px-4 text-center">
              <p class="font-body text-[13px] text-neutral-400 m-0">
                {selectedYear ? `No praise received in ${selectedYear}` : "You haven't received any praise yet"}
              </p>
            </div>
          ) : (
            <div class="flex flex-col gap-[10px]">
              {receivedRows.map(p => {
                const giverName = p.given_by ? (peopleMap.get(p.given_by) ?? 'Admin') : 'Admin'
                return (
                  <div class="bg-white border border-neutral-200 rounded-lg py-[14px] px-4">
                    <div class="flex items-center gap-[6px] mb-[6px]">
                      <span class="text-base">⭐</span>
                      <span class="font-body text-[13px] font-semibold text-brand-navy">{giverName}</span>
                      <span class="font-body text-[11px] text-neutral-400">· {timeAgo(p.created_at)}</span>
                    </div>
                    <p class="font-body text-[13px] text-neutral-700 m-0 leading-[1.6] border-l-[3px] border-brand-gold pl-[10px]">{p.message}</p>
                  </div>
                )
              })}
            </div>
          )}
          {receivedTotalPages > 1 && (
            <div class="flex items-center justify-between mt-[10px]">
              <span class="font-body text-xs text-neutral-400">{recvPage}/{receivedTotalPages}</span>
              <div class="flex gap-1">
                {recvPage > 1 && <a href={pageUrl('rp', recvPage - 1)} class="py-1 px-[10px] border border-neutral-200 rounded-md text-xs font-body text-neutral-600 no-underline">←</a>}
                {recvPage < receivedTotalPages && <a href={pageUrl('rp', recvPage + 1)} class="py-1 px-[10px] border border-neutral-200 rounded-md text-xs font-body text-neutral-600 no-underline">→</a>}
              </div>
            </div>
          )}
        </div>

        <!-- Given -->
        <div>
          <h2 class="font-heading text-sm font-bold text-neutral-600 uppercase tracking-[0.06em] mb-3">
            👏 Given <span class="font-normal text-xs text-neutral-400 normal-case tracking-[0]">({givenCount})</span>
          </h2>
          {givenRows.length === 0 ? (
            <div class="bg-neutral-50 border border-dashed border-neutral-200 rounded-lg py-8 px-4 text-center">
              <p class="font-body text-[13px] text-neutral-400 m-0">
                {selectedYear ? `No praise given in ${selectedYear}` : "You haven't given any praise yet"}
              </p>
              {canGivePraise && (
                <a href="/admin/praise/new"
                  class="inline-block mt-[10px] py-[6px] px-[14px] bg-brand-navy text-white rounded-md font-body text-xs font-semibold no-underline">
                  Give praise
                </a>
              )}
            </div>
          ) : (
            <div class="flex flex-col gap-[10px]">
              {givenRows.map(p => {
                const recipientName = p.recipient_id ? (peopleMap.get(p.recipient_id) ?? 'Someone') : 'Someone'
                return (
                  <div class="bg-white border border-neutral-200 rounded-lg py-[14px] px-4">
                    <div class="flex items-center gap-[6px] mb-[6px]">
                      <span class="text-base">👏</span>
                      <span class="font-body text-[13px] font-semibold text-brand-navy">
                        {recipientName}
                      </span>
                      <span class="font-body text-[11px] text-neutral-400">· {timeAgo(p.created_at)}</span>
                    </div>
                    <p class="font-body text-[13px] text-neutral-700 m-0 leading-[1.6] border-l-[3px] border-neutral-200 pl-[10px]">{p.message}</p>
                  </div>
                )
              })}
            </div>
          )}
          {givenTotalPages > 1 && (
            <div class="flex items-center justify-between mt-[10px]">
              <span class="font-body text-xs text-neutral-400">{givenPage}/{givenTotalPages}</span>
              <div class="flex gap-1">
                {givenPage > 1 && <a href={pageUrl('gp', givenPage - 1)} class="py-1 px-[10px] border border-neutral-200 rounded-md text-xs font-body text-neutral-600 no-underline">←</a>}
                {givenPage < givenTotalPages && <a href={pageUrl('gp', givenPage + 1)} class="py-1 px-[10px] border border-neutral-200 rounded-md text-xs font-body text-neutral-600 no-underline">→</a>}
              </div>
            </div>
          )}
        </div>

      </div>
    )}

    <!-- ── No person_id fallback ─────────────────────────────────────────── -->
    {!admin && !personId && (
      <div class="bg-white border border-neutral-200 rounded-lg p-12 text-center">
        <p class="font-body text-sm text-neutral-400 m-0">Your account isn't linked to a member profile yet. Please contact an admin.</p>
      </div>
    )}

    <!-- Confirmation Modal -->
    <div x-show="modalOpen" @click.self="modalOpen = false" @keydown.escape.window="modalOpen = false"
      class="fixed inset-0 z-[100] flex items-center justify-center bg-black/45">
      <div class="bg-white rounded-lg py-7 px-8 max-w-[420px] w-[90%] shadow-[0_25px_50px_rgba(0,0,0,0.2)]">
        <h3 class="font-heading text-[17px] font-bold text-brand-navy mb-[10px]">Archive praise</h3>
        <p x-text="message" class="font-body text-sm text-neutral-700 mb-5 leading-[1.55]"></p>
        <p x-show="error" x-text="error" class="font-body text-[13px] text-danger-600 mb-[14px]"></p>
        <div class="flex gap-[10px] justify-end">
          <button @click="modalOpen = false" :disabled="loading"
            class="py-2 px-[18px] bg-neutral-100 border border-neutral-200 rounded-md font-body text-sm font-medium cursor-pointer text-neutral-700">
            Cancel
          </button>
          <button @click="doAction()" :disabled="loading" x-text="loading ? 'Archiving...' : 'Archive'"
            class="py-2 px-[18px] bg-danger-600 text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
