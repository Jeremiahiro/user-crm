---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

const categoryFilter = Astro.url.searchParams.get('category') ?? 'all'
const showArchived = Astro.url.searchParams.get('archived') === '1'

const { data: rawTemplates } = await supabaseAdmin
  .from('email_templates')
  .select('id, name, description, subject, category, is_active, created_at, updated_at')
  .order('name', { ascending: true })

type Template = {
  id: string
  name: string
  description: string | null
  subject: string
  category: string
  is_active: boolean
  created_at: string
  updated_at: string
}

const allTemplates = (rawTemplates ?? []) as Template[]

// Filter by active/archived
const visibleTemplates = showArchived
  ? allTemplates
  : allTemplates.filter(t => t.is_active)

// Category filter
const filtered = categoryFilter === 'all'
  ? visibleTemplates
  : visibleTemplates.filter(t => t.category === categoryFilter)

const CATEGORIES = ['general', 'welcome', 'award', 'reminder', 'event']
const CATEGORY_LABELS: Record<string, string> = {
  general: 'General',
  welcome: 'Welcome',
  award: 'Award',
  reminder: 'Reminder',
  event: 'Event',
}
const CATEGORY_COLORS: Record<string, string> = {
  general: 'neutral',
  welcome: 'success',
  award: 'warning',
  reminder: 'danger',
  event: 'info',
}

function countInCategory(cat: string) {
  return visibleTemplates.filter(t => t.category === cat).length
}
---

<DashboardLayout title="Email Templates">
  <div id="templates-root" x-data="{
    modalOpen: false,
    itemId: '',
    itemName: '',
    message: '',
    loading: false,
    error: '',
    openModal(el) {
      this.itemId = el.dataset.templateId;
      this.itemName = el.dataset.templateName;
      this.message = 'Archive \'' + this.itemName + '\'? It will no longer appear in the active list.';
      this.modalOpen = true;
      this.error = '';
    },
    async doAction() {
      this.loading = true;
      var res = await fetch('/api/email-templates/' + this.itemId, { method: 'DELETE' });
      if (res.ok) {
        var row = document.querySelector('[data-template-id=\'' + this.itemId + '\']');
        if (row) row.remove();
        this.modalOpen = false;
        this.loading = false;
      } else {
        var e = await res.json();
        this.error = e.error || 'Failed to archive';
        this.loading = false;
      }
    }
  }">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
      <div>
        <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Email Templates</h1>
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0;">
          Reusable styled emails with variable substitution.
        </p>
      </div>
      <a href="/admin/email-templates/new"
        style="padding: 10px 18px; background-color: var(--color-brand-navy); color: white; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
        + New template
      </a>
    </div>

    <!-- Category tabs -->
    <div style="display: flex; gap: 4px; margin-bottom: 20px; border-bottom: 1px solid var(--color-neutral-200); padding-bottom: 0;">
      {[['all', 'All', visibleTemplates.length], ...CATEGORIES.map(c => [c, CATEGORY_LABELS[c], countInCategory(c)])].map(([cat, label, count]) => {
        const active = categoryFilter === cat
        const href = cat === 'all'
          ? `/admin/email-templates${showArchived ? '?archived=1' : ''}`
          : `/admin/email-templates?category=${cat}${showArchived ? '&archived=1' : ''}`
        return (
          <a href={href}
            style={`display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: var(--radius-md) var(--radius-md) 0 0; font-family: var(--font-body); font-size: 13px; font-weight: ${active ? '600' : '400'}; text-decoration: none; color: ${active ? 'var(--color-brand-navy)' : 'var(--color-neutral-500)'}; border-bottom: 2px solid ${active ? 'var(--color-brand-navy)' : 'transparent'}; margin-bottom: -1px;`}>
            {label}
            <span style={`font-size: 11px; padding: 1px 6px; border-radius: 20px; background: ${active ? 'var(--color-brand-navy)' : 'var(--color-neutral-200)'}; color: ${active ? 'white' : 'var(--color-neutral-600)'};`}>{count}</span>
          </a>
        )
      })}
      <div style="flex: 1;"></div>
      <a href={`/admin/email-templates${categoryFilter !== 'all' ? `?category=${categoryFilter}` : ''}${showArchived ? '' : (categoryFilter !== 'all' ? '&archived=1' : '?archived=1')}`}
        style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); text-decoration: none; padding: 8px 4px; align-self: center;">
        {showArchived ? 'Hide archived' : 'Show archived'}
      </a>
    </div>

    <!-- Table -->
    {filtered.length === 0 ? (
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 48px 24px; text-align: center;">
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-400); margin: 0 0 16px;">No templates yet in this category.</p>
        <a href="/admin/email-templates/new"
          style="padding: 10px 18px; background-color: var(--color-brand-navy); color: white; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
          Create first template
        </a>
      </div>
    ) : (
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead style="background: var(--color-neutral-50); border-bottom: 1px solid var(--color-neutral-200);">
            <tr>
              <th style="padding: 10px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.06em;">Name</th>
              <th style="padding: 10px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.06em;">Category</th>
              <th style="padding: 10px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.06em;">Subject</th>
              <th style="padding: 10px 16px; text-align: left; font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.06em;">Status</th>
              <th style="padding: 10px 16px;"></th>
            </tr>
          </thead>
          <tbody>
            {filtered.map((t, i) => (
              <tr data-template-id={t.id} style={`${i > 0 ? 'border-top: 1px solid var(--color-neutral-100);' : ''} ${!t.is_active ? 'opacity: 0.6;' : ''}`}>
                <td style="padding: 14px 16px;">
                  <a href={`/admin/email-templates/${t.id}/edit`}
                    style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-brand-navy); text-decoration: none; display: block;">
                    {t.name}
                  </a>
                  {t.description && (
                    <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 2px 0 0;">{t.description}</p>
                  )}
                </td>
                <td style="padding: 14px 16px;">
                  <Badge variant={CATEGORY_COLORS[t.category] as 'neutral' | 'success' | 'warning' | 'danger' ?? 'neutral'}>
                    {CATEGORY_LABELS[t.category] ?? t.category}
                  </Badge>
                </td>
                <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600); max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {t.subject}
                </td>
                <td style="padding: 14px 16px;">
                  <Badge variant={t.is_active ? 'success' : 'neutral'}>
                    {t.is_active ? 'Active' : 'Archived'}
                  </Badge>
                </td>
                <td style="padding: 14px 16px; text-align: right; white-space: nowrap;">
                  <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                    <a href={`/admin/email-templates/${t.id}/edit`}
                      style="padding: 5px 12px; background: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; font-weight: 500; text-decoration: none;">
                      Edit
                    </a>
                    {admin && t.is_active && (
                      <button
                        data-template-id={t.id}
                        data-template-name={t.name}
                        @click="openModal($el)"
                        style="padding: 5px 12px; background: white; color: var(--color-danger-600); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; cursor: pointer;">
                        Archive
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Confirmation Modal -->
    <div x-show="modalOpen" @click.self="modalOpen = false" @keydown.escape.window="modalOpen = false"
      style="position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.45);">
      <div style="background: white; border-radius: var(--radius-lg); padding: 28px 32px; max-width: 420px; width: 90%; box-shadow: 0 25px 50px rgba(0,0,0,0.2);">
        <h3 style="font-family: var(--font-heading); font-size: 17px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 10px;">Archive template</h3>
        <p x-text="message" style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-700); margin: 0 0 20px; line-height: 1.55;"></p>
        <p x-show="error" x-text="error" style="font-family: var(--font-body); font-size: 13px; color: var(--color-danger-600); margin: 0 0 14px;"></p>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
          <button @click="modalOpen = false" :disabled="loading"
            style="padding: 8px 18px; background: var(--color-neutral-100); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; cursor: pointer; color: var(--color-neutral-700);">
            Cancel
          </button>
          <button @click="doAction()" :disabled="loading" x-text="loading ? 'Archiving...' : 'Archive'"
            style="padding: 8px 18px; background: var(--color-danger-600); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
