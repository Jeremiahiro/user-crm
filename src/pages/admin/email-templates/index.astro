---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)

const categoryFilter = Astro.url.searchParams.get('category') ?? 'all'
const showArchived = Astro.url.searchParams.get('archived') === '1'

const { data: rawTemplates } = await supabaseAdmin
  .from('email_templates')
  .select('id, name, description, subject, category, is_active, created_at, updated_at')
  .order('name', { ascending: true })

type Template = {
  id: string
  name: string
  description: string | null
  subject: string
  category: string
  is_active: boolean
  created_at: string
  updated_at: string
}

const allTemplates = (rawTemplates ?? []) as Template[]

// Filter by active/archived
const visibleTemplates = showArchived
  ? allTemplates
  : allTemplates.filter(t => t.is_active)

// Category filter
const filtered = categoryFilter === 'all'
  ? visibleTemplates
  : visibleTemplates.filter(t => t.category === categoryFilter)

const CATEGORIES = ['general', 'welcome', 'award', 'reminder', 'event']
const CATEGORY_LABELS: Record<string, string> = {
  general: 'General',
  welcome: 'Welcome',
  award: 'Award',
  reminder: 'Reminder',
  event: 'Event',
}
const CATEGORY_COLORS: Record<string, string> = {
  general: 'neutral',
  welcome: 'success',
  award: 'warning',
  reminder: 'danger',
  event: 'info',
}

function countInCategory(cat: string) {
  return visibleTemplates.filter(t => t.category === cat).length
}
---

<DashboardLayout title="Email Templates">
  <div id="templates-root" x-data="{
    modalOpen: false,
    itemId: '',
    itemName: '',
    message: '',
    loading: false,
    error: '',
    openModal(el) {
      this.itemId = el.dataset.templateId;
      this.itemName = el.dataset.templateName;
      this.message = 'Archive \'' + this.itemName + '\'? It will no longer appear in the active list.';
      this.modalOpen = true;
      this.error = '';
    },
    async doAction() {
      this.loading = true;
      var res = await fetch('/api/email-templates/' + this.itemId, { method: 'DELETE' });
      if (res.ok) {
        var row = document.querySelector('[data-template-id=\'' + this.itemId + '\']');
        if (row) row.remove();
        this.modalOpen = false;
        this.loading = false;
      } else {
        var e = await res.json();
        this.error = e.error || 'Failed to archive';
        this.loading = false;
      }
    }
  }">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Email Templates</h1>
        <p class="font-body text-sm text-neutral-500 m-0">
          Reusable styled emails with variable substitution.
        </p>
      </div>
      <a href="/admin/email-templates/new"
        class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
        + New template
      </a>
    </div>

    <!-- Category tabs -->
    <div class="flex gap-1 mb-5 border-b border-neutral-200 pb-0">
      {[['all', 'All', visibleTemplates.length], ...CATEGORIES.map(c => [c, CATEGORY_LABELS[c], countInCategory(c)])].map(([cat, label, count]) => {
        const active = categoryFilter === cat
        const href = cat === 'all'
          ? `/admin/email-templates${showArchived ? '?archived=1' : ''}`
          : `/admin/email-templates?category=${cat}${showArchived ? '&archived=1' : ''}`
        return (
          <a href={href}
            class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-t-md font-body text-[13px] no-underline -mb-px border-b-2 ${active ? 'font-semibold text-brand-navy border-brand-navy' : 'font-normal text-neutral-500 border-transparent'}`}>
            {label}
            <span class={`text-[11px] px-1.5 py-0.25 rounded-5 ${active ? 'bg-brand-navy text-white' : 'bg-neutral-200 text-neutral-600'}`}>{count}</span>
          </a>
        )
      })}
      <div class="flex-1"></div>
      <a href={`/admin/email-templates${categoryFilter !== 'all' ? `?category=${categoryFilter}` : ''}${showArchived ? '' : (categoryFilter !== 'all' ? '&archived=1' : '?archived=1')}`}
        class="font-body text-xs text-neutral-400 no-underline py-2 px-1 self-center">
        {showArchived ? 'Hide archived' : 'Show archived'}
      </a>
    </div>

    <!-- Table -->
    {filtered.length === 0 ? (
      <div class="bg-white border border-neutral-200 rounded-lg p-12 text-center">
        <p class="font-body text-sm text-neutral-400 mb-4 mt-0 mx-0">No templates yet in this category.</p>
        <a href="/admin/email-templates/new"
          class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
          Create first template
        </a>
      </div>
    ) : (
      <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
        <table class="w-full border-collapse">
          <thead class="bg-neutral-50 border-b border-neutral-200">
            <tr>
              <th class="px-4 py-2.5 text-left font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.06em]">Name</th>
              <th class="px-4 py-2.5 text-left font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.06em]">Category</th>
              <th class="px-4 py-2.5 text-left font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.06em]">Subject</th>
              <th class="px-4 py-2.5 text-left font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.06em]">Status</th>
              <th class="px-4 py-2.5"></th>
            </tr>
          </thead>
          <tbody>
            {filtered.map((t, i) => (
              <tr data-template-id={t.id} class={`${i > 0 ? 'border-t border-neutral-100' : ''} ${!t.is_active ? 'opacity-60' : ''}`}>
                <td class="px-4 py-3.5">
                  <a href={`/admin/email-templates/${t.id}/edit`}
                    class="font-body text-sm font-semibold text-brand-navy no-underline block">
                    {t.name}
                  </a>
                  {t.description && (
                    <p class="font-body text-xs text-neutral-400 mt-0.5 mb-0">{t.description}</p>
                  )}
                </td>
                <td class="px-4 py-3.5">
                  <Badge variant={CATEGORY_COLORS[t.category] as 'neutral' | 'success' | 'warning' | 'danger' ?? 'neutral'}>
                    {CATEGORY_LABELS[t.category] ?? t.category}
                  </Badge>
                </td>
                <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600 max-w-60 overflow-hidden text-ellipsis whitespace-nowrap">
                  {t.subject}
                </td>
                <td class="px-4 py-3.5">
                  <Badge variant={t.is_active ? 'success' : 'neutral'}>
                    {t.is_active ? 'Active' : 'Archived'}
                  </Badge>
                </td>
                <td class="px-4 py-3.5 text-right whitespace-nowrap">
                  <div class="flex gap-2 justify-end items-center">
                    <a href={`/admin/email-templates/${t.id}/edit`}
                      class="px-3 py-1.25 bg-neutral-100 text-neutral-700 rounded-md font-body text-xs font-medium no-underline">
                      Edit
                    </a>
                    {admin && t.is_active && (
                      <button
                        data-template-id={t.id}
                        data-template-name={t.name}
                        @click="openModal($el)"
                        class="px-3 py-1.25 bg-white text-danger-600 border border-danger-200 rounded-md font-body text-xs cursor-pointer">
                        Archive
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Confirmation Modal -->
    <div x-show="modalOpen" @click.self="modalOpen = false" @keydown.escape.window="modalOpen = false"
      class="fixed inset-0 z-[100] flex items-center justify-center bg-black/45">
      <div class="bg-white rounded-lg py-7 px-8 max-w-105 w-[90%] shadow-[0_25px_50px_rgba(0,0,0,0.2)]">
        <h3 class="font-heading text-[17px] font-bold text-brand-navy mt-0 mb-2.5">Archive template</h3>
        <p x-text="message" class="font-body text-sm text-neutral-700 mb-5 mt-0 mx-0 leading-normal"></p>
        <p x-show="error" x-text="error" class="font-body text-[13px] text-danger-600 mb-3.5 mt-0 mx-0"></p>
        <div class="flex gap-2.5 justify-end">
          <button @click="modalOpen = false" :disabled="loading"
            class="px-4.5 py-2 bg-neutral-100 border border-neutral-200 rounded-md font-body text-sm font-medium cursor-pointer text-neutral-700">
            Cancel
          </button>
          <button @click="doAction()" :disabled="loading" x-text="loading ? 'Archiving...' : 'Archive'"
            class="px-4.5 py-2 bg-danger-600 text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
