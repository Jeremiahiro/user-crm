---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)
if (!admin) return Astro.redirect('/admin/email-templates')

const CATEGORIES = ['general', 'welcome', 'award', 'reminder', 'event'] as const
const CATEGORY_LABELS: Record<string, string> = {
  general: 'General', welcome: 'Welcome', award: 'Award', reminder: 'Reminder', event: 'Event',
}

// Available variables per category
const VARIABLE_HINTS: Record<string, string[]> = {
  general: ['{{full_name}}', '{{first_name}}', '{{year}}'],
  welcome: ['{{full_name}}', '{{first_name}}', '{{year}}'],
  award: ['{{full_name}}', '{{first_name}}', '{{award_type}}', '{{year}}', '{{citation}}'],
  reminder: ['{{full_name}}', '{{first_name}}', '{{year}}'],
  event: ['{{full_name}}', '{{first_name}}', '{{event_name}}', '{{event_date}}', '{{year}}'],
}

const DEFAULT_HTML = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="margin:0;padding:0;background:#f4f6fa;font-family:'Segoe UI',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6fa;padding:32px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.08);">
          <!-- Header -->
          <tr>
            <td style="background:#0a1a3b;padding:32px 40px;text-align:center;">
              <p style="color:#c9a227;font-size:12px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;margin:0 0 8px;">100 Black Men of London</p>
              <h1 style="color:#ffffff;font-size:26px;font-weight:800;margin:0;">Subject here</h1>
            </td>
          </tr>
          <!-- Body -->
          <tr>
            <td style="padding:40px 40px 32px;">
              <p style="color:#374151;font-size:16px;line-height:1.7;margin:0 0 20px;">Dear <strong>{{full_name}}</strong>,</p>
              <p style="color:#374151;font-size:16px;line-height:1.7;margin:0 0 20px;">Your message here.</p>
              <p style="color:#374151;font-size:16px;line-height:1.7;margin:0;">Warm regards,<br /><strong>The 100 Black Men of London Team</strong></p>
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="background:#f8fafc;padding:20px 40px;border-top:1px solid #e5e7eb;text-align:center;">
              <p style="color:#9ca3af;font-size:12px;margin:0;">100 Black Men of London · Member Portal</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>`

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {
  category: 'general',
  html_body: DEFAULT_HTML,
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/email-templates`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      name: values.name,
      description: values.description || null,
      subject: values.subject,
      html_body: values.html_body,
      category: values.category,
    }),
  })

  if (res.ok) {
    return Astro.redirect('/admin/email-templates?created=1')
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to create template.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title="New Email Template">
  <div style="max-width: 800px;" id="new-template-root" data-default-html="">
    <Breadcrumb crumbs={[{ label: 'Email Templates', href: '/admin/email-templates' }, { label: 'New Template' }]} />
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 24px;">New Email Template</h1>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form method="POST" id="template-form" style="display: flex; flex-direction: column; gap: 20px;">

      <div style="display: grid; grid-template-columns: 1fr auto; gap: 16px;">
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Name *</label>
          <input type="text" name="name" value={values.name ?? ''} required maxlength="100"
            style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px;" />
          {errors.name && <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-danger-600); margin: 0;">{errors.name}</p>}
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px; min-width: 140px;">
          <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Category *</label>
          <select name="category" id="category-select"
            style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white; height: 42px;">
            {Object.entries(CATEGORY_LABELS).map(([v, l]) => (
              <option value={v} selected={values.category === v}>{l}</option>
            ))}
          </select>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Description <span style="color: var(--color-neutral-400); font-weight: 400;">(internal note)</span></label>
        <textarea name="description" rows={2} placeholder="Optional — describe what this template is used for"
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; resize: vertical;">{values.description ?? ''}</textarea>
      </div>

      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Subject *</label>
        <input type="text" name="subject" value={values.subject ?? ''} required maxlength="300"
          placeholder="e.g. Congratulations — {{award_type}} {{year}}"
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px;" />
        {errors.subject && <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-danger-600); margin: 0;">{errors.subject}</p>}
      </div>

      <!-- Variable hints -->
      <div id="variable-hints" style="background: var(--color-neutral-50); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); padding: 12px 16px;">
        <p style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-600); margin: 0 0 8px;">Available variables for this category:</p>
        <div id="vars-list" style="display: flex; flex-wrap: wrap; gap: 6px;">
          {(VARIABLE_HINTS[values.category ?? 'general'] ?? VARIABLE_HINTS.general).map(v => (
            <code style="font-family: var(--font-mono, monospace); font-size: 12px; padding: 2px 8px; background: white; border: 1px solid var(--color-neutral-300); border-radius: 4px; color: var(--color-brand-navy);">{v}</code>
          ))}
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 4px;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">HTML Body *</label>
          <button type="button" id="preview-btn"
            style="padding: 4px 12px; background: var(--color-neutral-100); color: var(--color-neutral-700); border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 12px; cursor: pointer;">
            Preview
          </button>
        </div>
        <textarea name="html_body" id="html-body" rows={16} required
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: 'JetBrains Mono', monospace; font-size: 12px; resize: vertical; line-height: 1.5;">{values.html_body ?? DEFAULT_HTML}</textarea>
        {errors.html_body && <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-danger-600); margin: 0;">{errors.html_body}</p>}
      </div>

      <!-- Live preview -->
      <div id="preview-panel" style="display: none; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
        <div style="padding: 8px 14px; background: var(--color-neutral-50); border-bottom: 1px solid var(--color-neutral-200); font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-500);">Preview (variables replaced with sample values)</div>
        <iframe id="preview-frame" style="width: 100%; height: 500px; border: none; display: block;"></iframe>
      </div>

      <div style="display: flex; gap: 12px; padding-top: 4px;">
        <button type="submit"
          style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Save template
        </button>
        <a href="/admin/email-templates"
          style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>
  </div>

  <script is:inline>
    var VARIABLE_HINTS = {
      general: ['{{full_name}}', '{{first_name}}', '{{year}}'],
      welcome: ['{{full_name}}', '{{first_name}}', '{{year}}'],
      award: ['{{full_name}}', '{{first_name}}', '{{award_type}}', '{{year}}', '{{citation}}'],
      reminder: ['{{full_name}}', '{{first_name}}', '{{year}}'],
      event: ['{{full_name}}', '{{first_name}}', '{{event_name}}', '{{event_date}}', '{{year}}'],
    }

    var SAMPLE_VARS = {
      full_name: 'John Smith',
      first_name: 'John',
      last_name: 'Smith',
      year: String(new Date().getFullYear()),
      award_type: 'Member of the Year',
      citation: 'For outstanding service to the chapter.',
      event_name: 'Annual Gala',
      event_date: 'Saturday, 15 November 2025',
      message: 'Your contributions to the mentorship programme have been outstanding.',
      sender_name: 'James Brown',
    }

    function applyVars(html) {
      return html.replace(/\{\{(\w+)\}\}/g, function (_, key) {
        return SAMPLE_VARS[key] !== undefined ? SAMPLE_VARS[key] : '{{' + key + '}}'
      })
    }

    // Update variable hints when category changes
    var catSelect = document.getElementById('category-select')
    var varsList = document.getElementById('vars-list')

    function refreshVarHints() {
      var cat = catSelect ? catSelect.value : 'general'
      var hints = VARIABLE_HINTS[cat] || VARIABLE_HINTS.general
      if (varsList) {
        varsList.innerHTML = hints.map(function (v) {
          return '<code style="font-family:monospace;font-size:12px;padding:2px 8px;background:white;border:1px solid #d1d5db;border-radius:4px;color:#0a1a3b;">' + v + '</code>'
        }).join('')
      }
    }

    if (catSelect) catSelect.addEventListener('change', refreshVarHints)

    // Preview toggle
    var previewBtn = document.getElementById('preview-btn')
    var previewPanel = document.getElementById('preview-panel')
    var previewFrame = document.getElementById('preview-frame')
    var htmlBody = document.getElementById('html-body')
    var previewVisible = false

    if (previewBtn) {
      previewBtn.addEventListener('click', function () {
        previewVisible = !previewVisible
        previewPanel.style.display = previewVisible ? 'block' : 'none'
        previewBtn.textContent = previewVisible ? 'Hide preview' : 'Preview'
        if (previewVisible && previewFrame && htmlBody) {
          var doc = previewFrame.contentDocument || previewFrame.contentWindow.document
          doc.open()
          doc.write(applyVars(htmlBody.value))
          doc.close()
        }
      })
    }

    // Refresh preview as user types
    if (htmlBody && previewFrame) {
      var debounceTimer
      htmlBody.addEventListener('input', function () {
        if (!previewVisible) return
        clearTimeout(debounceTimer)
        debounceTimer = setTimeout(function () {
          var doc = previewFrame.contentDocument || previewFrame.contentWindow.document
          doc.open()
          doc.write(applyVars(htmlBody.value))
          doc.close()
        }, 400)
      })
    }
  </script>
</DashboardLayout>
