---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

if (!Astro.locals.user) return Astro.redirect('/login')

const admin = isAdmin(Astro.locals.user)
if (!admin) return Astro.redirect('/admin/email-templates')

const { id } = Astro.params
const { data: template } = await supabaseAdmin
  .from('email_templates').select('*').eq('id', id ?? '').single()

if (!template) return Astro.redirect('/admin/email-templates')

const CATEGORY_LABELS: Record<string, string> = {
  general: 'General', welcome: 'Welcome', award: 'Award', reminder: 'Reminder', event: 'Event',
}

const VARIABLE_HINTS: Record<string, string[]> = {
  general: ['{{full_name}}', '{{first_name}}', '{{year}}'],
  welcome: ['{{full_name}}', '{{first_name}}', '{{year}}'],
  award: ['{{full_name}}', '{{first_name}}', '{{award_type}}', '{{year}}', '{{citation}}'],
  reminder: ['{{full_name}}', '{{first_name}}', '{{year}}'],
  event: ['{{full_name}}', '{{first_name}}', '{{event_name}}', '{{event_date}}', '{{year}}'],
}

let errors: Record<string, string> = {}
let globalError = ''
let successMsg = ''
let values: Record<string, string> = {
  name: template.name as string,
  description: (template.description as string | null) ?? '',
  subject: template.subject as string,
  html_body: template.html_body as string,
  category: template.category as string,
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const formValues = Object.fromEntries(form.entries()) as Record<string, string>

  if (formValues._action === 'test') {
    // Send test email
    const res = await fetch(`${Astro.url.origin}/api/email-templates/${id}/test`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({ to: formValues.test_email }),
    })
    if (res.ok) {
      successMsg = `Test email sent to ${formValues.test_email}.`
    } else {
      const body = await res.json() as { error?: string }
      globalError = body.error ?? 'Failed to send test email.'
    }
  } else {
    values = formValues
    const res = await fetch(`${Astro.url.origin}/api/email-templates/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({
        name: values.name,
        description: values.description || null,
        subject: values.subject,
        html_body: values.html_body,
        category: values.category,
      }),
    })

    if (res.ok) {
      return Astro.redirect(`/admin/email-templates/${id}/edit?saved=1`)
    } else {
      const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
      globalError = body.error ?? 'Failed to save.'
      errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
    }
  }
}

const saved = Astro.url.searchParams.get('saved') === '1'
const adminEmail = Astro.locals.user?.email ?? ''
---

<DashboardLayout title={`Edit: ${template.name}`}>
  <div id="edit-template-root" data-template-id={id}>
    <Breadcrumb crumbs={[
      { label: 'Email Templates', href: '/admin/email-templates' },
      { label: template.name as string, href: `/admin/email-templates/${id}/edit` },
      { label: 'Edit' },
    ]} />

    {saved && (
      <div class="bg-[#f0fdf4] border border-[#86efac] rounded-md px-4 py-2.5 mb-4 font-body text-sm text-[#166534]">
        Changes saved.
      </div>
    )}
    {successMsg && (
      <div class="bg-[#f0fdf4] border border-[#86efac] rounded-md px-4 py-2.5 mb-4 font-body text-sm text-[#166534]">
        {successMsg}
      </div>
    )}
    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-4 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="flex flex-col gap-4 mb-6">
      <input type="hidden" name="_action" value="edit" />

      <!-- Top metadata row -->
      <div class="grid grid-cols-[1fr_180px] gap-4 max-w-[700px]">
        <div class="flex flex-col gap-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">Name *</label>
          <input type="text" name="name" value={values.name} required maxlength="100"
            class="px-3 py-[9px] border border-neutral-300 rounded-md font-body text-sm" />
          {errors.name && <p class="font-body text-xs text-danger-600 m-0">{errors.name}</p>}
        </div>
        <div class="flex flex-col gap-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">Category *</label>
          <select name="category" id="category-select"
            class="px-3 py-[9px] border border-neutral-300 rounded-md font-body text-sm bg-white h-[40px]">
            {Object.entries(CATEGORY_LABELS).map(([v, l]) => (
              <option value={v} selected={values.category === v}>{l}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="flex flex-col gap-1 max-w-[700px]">
        <label class="font-body text-[13px] font-medium text-neutral-700">Subject *</label>
        <input type="text" name="subject" value={values.subject} required maxlength="300"
          class="px-3 py-[9px] border border-neutral-300 rounded-md font-body text-sm" />
        {errors.subject && <p class="font-body text-xs text-danger-600 m-0">{errors.subject}</p>}
      </div>

      <!-- Variable hints -->
      <div class="bg-neutral-50 border border-neutral-200 rounded-md px-[14px] py-2.5 max-w-[700px]">
        <span class="font-body text-xs font-semibold text-neutral-600">Variables: </span>
        <span id="vars-list" class="inline-flex flex-wrap gap-[5px] align-middle ml-1">
          {(VARIABLE_HINTS[values.category ?? 'general'] ?? VARIABLE_HINTS.general).map(v => (
            <code class="font-mono text-xs px-[7px] py-[1px] bg-white border border-neutral-300 rounded-[4px] text-brand-navy">{v}</code>
          ))}
        </span>
      </div>

      <!-- Side-by-side editor + preview -->
      <div class="grid grid-cols-2 gap-4 items-start">

        <!-- Editor column -->
        <div class="flex flex-col gap-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">HTML Body *</label>
          <textarea name="html_body" id="html-body" required
            class="px-3 py-2.5 border border-neutral-300 rounded-md text-xs leading-normal resize-y h-[600px] min-h-[400px] font-mono">{values.html_body}</textarea>
          {errors.html_body && <p class="font-body text-xs text-danger-600 m-0">{errors.html_body}</p>}
        </div>

        <!-- Preview column -->
        <div class="flex flex-col gap-1">
          <div class="flex items-center justify-between">
            <label class="font-body text-[13px] font-medium text-neutral-700">Preview</label>
            <span class="font-body text-[11px] text-neutral-400">Sample values · updates as you type</span>
          </div>
          <div class="border border-neutral-200 rounded-md overflow-hidden h-[600px] min-h-[400px] bg-white">
            <iframe id="preview-frame" class="w-full h-full border-none block"></iframe>
          </div>
        </div>
      </div>

      <div class="flex gap-3 pt-1">
        <button type="submit"
          class="px-5 py-2.5 bg-brand-navy text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">
          Save changes
        </button>
        <a href="/admin/email-templates"
          class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>

    <!-- Send test section -->
    <div class="border border-neutral-200 rounded-lg overflow-hidden mb-7 max-w-[500px]">
      <div class="bg-neutral-50 px-5 py-2.5 border-b border-neutral-200">
        <h2 class="font-body text-xs font-semibold text-neutral-600 uppercase tracking-[0.06em] m-0">Send test email</h2>
      </div>
      <form method="POST" class="bg-white px-5 py-4 flex gap-3 items-end">
        <input type="hidden" name="_action" value="test" />
        <div class="flex flex-col gap-1 flex-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">Send to</label>
          <input type="email" name="test_email" value={adminEmail} required
            class="px-3 py-[9px] border border-neutral-300 rounded-md font-body text-sm" />
        </div>
        <button type="submit"
          class="px-4.5 py-[9px] bg-neutral-700 text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer whitespace-nowrap">
          Send test
        </button>
      </form>
    </div>
  </div>

  <script is:inline>
    var VARIABLE_HINTS = {
      general: ['{{full_name}}', '{{first_name}}', '{{year}}'],
      welcome: ['{{full_name}}', '{{first_name}}', '{{year}}'],
      award: ['{{full_name}}', '{{first_name}}', '{{award_type}}', '{{year}}', '{{citation}}'],
      reminder: ['{{full_name}}', '{{first_name}}', '{{year}}'],
      event: ['{{full_name}}', '{{first_name}}', '{{event_name}}', '{{event_date}}', '{{year}}'],
    }

    var SAMPLE_VARS = {
      full_name: 'John Smith', first_name: 'John', last_name: 'Smith',
      year: String(new Date().getFullYear()),
      award_type: 'Member of the Year',
      citation: 'For outstanding service to the chapter.',
      event_name: 'Annual Gala', event_date: 'Saturday, 15 November 2025',
      message: 'Your contributions to the mentorship programme have been outstanding.',
      sender_name: 'James Brown',
    }

    function applyVars(html) {
      return html.replace(/\{\{(\w+)\}\}/g, function (_, key) {
        return SAMPLE_VARS[key] !== undefined ? SAMPLE_VARS[key] : '{{' + key + '}}'
      })
    }

    function refreshPreview() {
      var htmlBody = document.getElementById('html-body')
      var previewFrame = document.getElementById('preview-frame')
      if (!htmlBody || !previewFrame) return
      var doc = previewFrame.contentDocument || previewFrame.contentWindow.document
      doc.open(); doc.write(applyVars(htmlBody.value)); doc.close()
    }

    // Category → variable hints
    var catSelect = document.getElementById('category-select')
    var varsList = document.getElementById('vars-list')

    function refreshVarHints() {
      var cat = catSelect ? catSelect.value : 'general'
      var hints = VARIABLE_HINTS[cat] || VARIABLE_HINTS.general
      if (varsList) {
        varsList.innerHTML = hints.map(function (v) {
          return '<code style="font-family:monospace;font-size:12px;padding:1px 7px;background:white;border:1px solid #d1d5db;border-radius:4px;color:#0a1a3b;">' + v + '</code>'
        }).join('')
      }
    }

    if (catSelect) catSelect.addEventListener('change', refreshVarHints)

    // Live preview — debounced on input
    var htmlBody = document.getElementById('html-body')
    if (htmlBody) {
      var debounce
      htmlBody.addEventListener('input', function () {
        clearTimeout(debounce)
        debounce = setTimeout(refreshPreview, 300)
      })
    }

    // Initial render
    refreshPreview()
  </script>
</DashboardLayout>
