---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const isSuperAdmin = Astro.locals.user.roles?.includes('Super Admin') ?? false
if (!isSuperAdmin) return Astro.redirect('/dashboard')

type SettingRow = {
  key: string
  value: string
  label: string | null
  description: string | null
  updated_at: string
}

const { data: rows } = await supabaseAdmin
  .from('org_settings')
  .select('key, value, label, description, updated_at')
  .order('key')

const settings = (rows ?? []) as SettingRow[]
const settingMap = Object.fromEntries(settings.map(s => [s.key, s]))

let successMessage = ''
let errorMessage = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const updates: { key: string; value: string }[] = []

  // Iterate over the known set of form-editable keys (not just DB rows)
  // so new settings are upserted even if no row exists yet.
  const FORM_SETTING_KEYS = [
    'dbs_validity_years',
    'dbs_warn_days',
    'allow_member_praise',
    'allow_teamlead_remove_member',
  ]
  for (const key of FORM_SETTING_KEYS) {
    // Hidden+checkbox pattern: getAll returns last value wins
    const vals = form.getAll(key)
    const val = vals[vals.length - 1]
    if (typeof val === 'string' && val.trim() !== '') {
      updates.push({ key, value: val.trim() })
    }
  }

  const failed: string[] = []
  for (const update of updates) {
    const res = await fetch(new URL('/api/settings', Astro.url), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify(update),
    })
    if (!res.ok) failed.push(update.key)
  }

  if (failed.length > 0) {
    errorMessage = `Failed to save: ${failed.join(', ')}`
  } else {
    successMessage = 'Settings saved successfully.'
  }

  // Reload fresh values
  const { data: freshRows } = await supabaseAdmin
    .from('org_settings')
    .select('key, value, label, description, updated_at')
    .order('key')
  const fresh = (freshRows ?? []) as SettingRow[]
  settings.splice(0, settings.length, ...fresh)
  settingMap.dbs_validity_years = fresh.find(s => s.key === 'dbs_validity_years') ?? settingMap.dbs_validity_years
  settingMap.dbs_warn_days = fresh.find(s => s.key === 'dbs_warn_days') ?? settingMap.dbs_warn_days
}

const dbsValidityYears = settingMap['dbs_validity_years']?.value ?? '3'
const dbsWarnDays = settingMap['dbs_warn_days']?.value ?? '60'
const logoUrl = settingMap['logo_url']?.value ?? ''
const allowMemberPraise = (settingMap['allow_member_praise']?.value ?? 'true') === 'true'
const allowTeamleadRemoveMember = (settingMap['allow_teamlead_remove_member']?.value ?? 'true') === 'true'
const lastUpdated = settingMap['dbs_validity_years']?.updated_at
  ? new Date(settingMap['dbs_validity_years'].updated_at).toLocaleDateString('en-GB', {
      day: 'numeric', month: 'long', year: 'numeric',
    })
  : null

let logoError = ''
let logoSuccess = ''
---

<DashboardLayout title="Settings">
  <div>
    <div class="mb-7">
      <h1 class="font-heading text-[26px] font-bold text-brand-navy mt-0 mb-1">Organisation Settings</h1>
      <p class="text-neutral-500 text-sm m-0">Configure chapter-wide defaults. Changes take effect immediately.</p>
    </div>

    {successMessage && (
      <div class="bg-success-50 border border-success-400 rounded-md py-3 px-4 mb-5 text-success-800 text-sm font-body">
        {successMessage}
      </div>
    )}
    {errorMessage && (
      <div class="bg-danger-50 border border-danger-400 rounded-md py-3 px-4 mb-5 text-danger-800 text-sm font-body">
        {errorMessage}
      </div>
    )}

    <!-- Two-column layout: main settings left, sidebar right -->
    <div class="grid [grid-template-columns:1fr_300px] gap-6 items-start">

      <!-- ── Left column: editable settings ── -->
      <div class="flex flex-col gap-5">

        <!-- Logo -->
        <div class="bg-white border border-neutral-200 rounded-lg p-6">
          <h2 class="font-heading text-[15px] font-bold text-brand-navy mt-0 mb-1">Organisation Logo</h2>
          <p class="text-neutral-500 text-[13px] mb-4">Shown in the portal header. PNG, JPG, SVG or WebP, max 5 MB.</p>

          {logoUrl && (
            <div class="mb-3.5 flex items-center gap-3">
              <img src={logoUrl} alt="Organisation logo" class="max-h-10 max-w-40 object-contain border border-neutral-200 rounded-md p-1.5" />
              <span class="text-xs text-neutral-400">Current logo</span>
            </div>
          )}

          <div id="logo-error" class="bg-danger-50 border border-danger-200 rounded-md px-3 py-2 mb-2.5 text-danger-800 text-[13px]" style={`display:${logoError ? 'block' : 'none'};`}>{logoError}</div>
          <div id="logo-success" class="bg-success-50 border border-success-200 rounded-md px-3 py-2 mb-2.5 text-success-800 text-[13px]" style={`display:${logoSuccess ? 'block' : 'none'};`}>{logoSuccess}</div>

          <form id="logo-form" class="flex items-center gap-2.5 flex-wrap">
            <input type="file" name="logo" id="logo-file" accept="image/png,image/jpeg,image/svg+xml,image/webp"
              class="font-body text-[13px] text-neutral-700" />
            <button type="submit" id="logo-btn"
              class="py-[7px] px-4 bg-brand-navy text-white border-0 rounded-md font-body text-[13px] font-semibold cursor-pointer">
              Upload
            </button>
          </form>
        </div>

        <form method="POST" class="contents">

          <!-- DBS Compliance -->
          <div class="bg-white border border-neutral-200 rounded-lg p-6">
            <h2 class="font-heading text-[15px] font-bold text-brand-navy mt-0 mb-1">DBS Compliance</h2>
            <p class="text-neutral-500 text-[13px] mb-5">Controls how DBS certificate validity and expiry warnings are calculated.</p>

            <div class="grid grid-cols-2 gap-5">
              <div>
                <label for="dbs_validity_years" class="block text-[13px] font-semibold text-neutral-800 mb-1">Validity (years)</label>
                <p class="text-xs text-neutral-500 mb-2">How long a certificate is valid from its clearance date.</p>
                <input id="dbs_validity_years" name="dbs_validity_years" type="number" min="1" max="10" value={dbsValidityYears} required
                  class="w-[100px] py-2 px-3 border border-neutral-300 rounded-md text-sm font-body" />
              </div>
              <div>
                <label for="dbs_warn_days" class="block text-[13px] font-semibold text-neutral-800 mb-1">Warning window (days)</label>
                <p class="text-xs text-neutral-500 mb-2">Days before expiry to flag a certificate as "expiring soon".</p>
                <input id="dbs_warn_days" name="dbs_warn_days" type="number" min="7" max="365" value={dbsWarnDays} required
                  class="w-[100px] py-2 px-3 border border-neutral-300 rounded-md text-sm font-body" />
              </div>
            </div>
            {lastUpdated && (
              <p class="text-xs text-neutral-400 mt-4">Last updated {lastUpdated}</p>
            )}
          </div>

          <!-- Member Permissions -->
          <div class="bg-white border border-neutral-200 rounded-lg p-6">
            <h2 class="font-heading text-[15px] font-bold text-brand-navy mt-0 mb-1">Member Permissions</h2>
            <p class="font-body text-[13px] text-neutral-500 mb-5">Control what members and team leads can do in the portal.</p>

            <div class="flex flex-col gap-4">
              <label class="flex items-start gap-3 cursor-pointer p-3.5 bg-neutral-50 rounded-md border border-neutral-200">
                <input type="hidden" name="allow_member_praise" value="false" />
                <input type="checkbox" name="allow_member_praise" value="true" checked={allowMemberPraise}
                  class="w-4 h-4 mt-0.5 accent-brand-navy shrink-0" />
                <div>
                  <span class="font-body text-sm font-semibold text-neutral-800 block">Members can give praise</span>
                  <span class="font-body text-xs text-neutral-500 block mt-0.5">When off, only admins can give praise.</span>
                </div>
              </label>

              <label class="flex items-start gap-3 cursor-pointer p-3.5 bg-neutral-50 rounded-md border border-neutral-200">
                <input type="hidden" name="allow_teamlead_remove_member" value="false" />
                <input type="checkbox" name="allow_teamlead_remove_member" value="true" checked={allowTeamleadRemoveMember}
                  class="w-4 h-4 mt-0.5 accent-brand-navy shrink-0" />
                <div>
                  <span class="font-body text-sm font-semibold text-neutral-800 block">Team leads can remove members</span>
                  <span class="font-body text-xs text-neutral-500 block mt-0.5">Admins can always remove regardless of this setting.</span>
                </div>
              </label>
            </div>
          </div>

          <div>
            <button type="submit"
              class="py-2.5 px-6 bg-brand-navy text-white border-0 rounded-md text-sm font-semibold font-body cursor-pointer">
              Save settings
            </button>
          </div>

        </form>
      </div>

      <!-- ── Right sidebar ── -->
      <div class="flex flex-col gap-4 sticky top-20">

        <!-- Data Management -->
        <div class="bg-white border border-neutral-200 rounded-lg p-5">
          <h2 class="font-heading text-sm font-bold text-brand-navy mt-0 mb-1 uppercase tracking-[0.04em]">Data Management</h2>
          <p class="font-body text-xs text-neutral-500 mb-3.5">Manage lookup tables and reference data.</p>
          <div class="flex flex-col gap-0.5">
            <a href="/admin/document-types"
              class="flex items-center justify-between py-[10px] px-3 rounded-md no-underline text-neutral-800 font-body text-[13px] font-medium">
              <span>Document Types</span>
              <span class="text-neutral-400 text-xs">→</span>
            </a>
            <a href="/admin/roles"
              class="flex items-center justify-between py-[10px] px-3 rounded-md no-underline text-neutral-800 font-body text-[13px] font-medium">
              <span>Roles</span>
              <span class="text-neutral-400 text-xs">→</span>
            </a>
            <a href="/admin/positions"
              class="flex items-center justify-between py-[10px] px-3 rounded-md no-underline text-neutral-800 font-body text-[13px] font-medium">
              <span>Elected Positions</span>
              <span class="text-neutral-400 text-xs">→</span>
            </a>
            <a href="/admin/email-templates"
              class="flex items-center justify-between py-[10px] px-3 rounded-md no-underline text-neutral-800 font-body text-[13px] font-medium">
              <span>Email Templates</span>
              <span class="text-neutral-400 text-xs">→</span>
            </a>
          </div>
        </div>

        <!-- Audit log -->
        <div class="bg-white border border-neutral-200 rounded-lg p-5">
          <h2 class="font-heading text-sm font-bold text-brand-navy mt-0 mb-1 uppercase tracking-[0.04em]">Logs & History</h2>
          <p class="font-body text-xs text-neutral-500 mb-3.5">Track all changes made in the portal.</p>
          <a href="/admin/audit"
            class="inline-flex items-center gap-1.5 py-2 px-[14px] border border-neutral-200 rounded-md no-underline text-neutral-700 font-body text-[13px] font-medium bg-neutral-50">
            View Audit Log →
          </a>
        </div>

      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('logo-form') as HTMLFormElement
    const btn = document.getElementById('logo-btn') as HTMLButtonElement
    const errBox = document.getElementById('logo-error') as HTMLDivElement
    const okBox = document.getElementById('logo-success') as HTMLDivElement

    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      const input = document.getElementById('logo-file') as HTMLInputElement
      if (!input.files?.length) { errBox.textContent = 'Please select a file.'; errBox.style.display = 'block'; return }

      btn.textContent = 'Uploading…'
      btn.disabled = true
      errBox.style.display = 'none'
      okBox.style.display = 'none'

      const fd = new FormData()
      fd.append('logo', input.files[0])

      const res = await fetch('/api/settings/logo', { method: 'POST', body: fd })
      const json = await res.json() as { data?: { logo_url: string }; error?: string }

      btn.textContent = 'Upload'
      btn.disabled = false

      if (res.ok && json.data) {
        okBox.textContent = 'Logo updated. Reload the page to see it in the header.'
        okBox.style.display = 'block'
        input.value = ''
      } else {
        errBox.textContent = json.error ?? 'Upload failed.'
        errBox.style.display = 'block'
      }
    })
  </script>
</DashboardLayout>
