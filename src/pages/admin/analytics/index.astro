---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const currentYear = new Date().getFullYear()

// ─── Parallel data fetches ──────────────────────────────────────────────────

const [
  { data: allMembers },
  { data: duesAll },
  { data: dbsAll },
  { data: participationByPillar },
  { data: pillars },
  { data: teams },
  { data: membersByJoinMonth },
  { data: participationByTeam },
] = await Promise.all([
  // All non-archived people with status
  supabaseAdmin
    .from('people')
    .select('id, status, member_type, joined_at')
    .eq('is_archived', false),

  // All dues records (for compliance calc)
  supabaseAdmin
    .from('dues')
    .select('person_id, year, paid_at')
    .eq('year', currentYear),

  // All DBS records to find expiry status
  supabaseAdmin
    .from('dbs_records')
    .select('person_id, expiry_date')
    .eq('is_archived', false),

  // Participation events grouped by pillar (we'll count in JS)
  supabaseAdmin
    .from('participation_events')
    .select('pillar_id, pillars(name)')
    .eq('is_archived', false)
    .not('pillar_id', 'is', null),

  // Pillar list for labels
  supabaseAdmin
    .from('pillars')
    .select('id, name')
    .eq('is_active', true)
    .order('display_order'),

  // Team list
  supabaseAdmin
    .from('teams')
    .select('id, name')
    .eq('is_active', true)
    .order('name'),

  // All members with joined_at for cohort chart
  supabaseAdmin
    .from('people')
    .select('joined_at')
    .eq('is_archived', false)
    .not('joined_at', 'is', null),

  // Participation by team
  supabaseAdmin
    .from('participation_events')
    .select('team_id, teams(name)')
    .eq('is_archived', false)
    .not('team_id', 'is', null),
])

// ─── Status breakdown ───────────────────────────────────────────────────────

const STATUS_LABELS: Record<string, string> = {
  active: 'Active',
  approved: 'Approved',
  pending_review: 'Pending Review',
  applicant: 'Applicant',
  inactive: 'Inactive',
  alumni: 'Alumni',
  left: 'Left',
}

const STATUS_COLORS: Record<string, string> = {
  active: 'var(--color-success-500)',
  approved: 'var(--color-info-500)',
  pending_review: 'var(--color-warning-500)',
  applicant: 'var(--color-neutral-400)',
  inactive: 'var(--color-neutral-400)',
  alumni: 'var(--color-neutral-500)',
  left: 'var(--color-danger-500)',
}

const memberRows = allMembers ?? []
const totalMembers = memberRows.length

const statusCounts: Record<string, number> = {}
for (const m of memberRows) {
  const s = m.status ?? 'unknown'
  statusCounts[s] = (statusCounts[s] ?? 0) + 1
}

const memberTypeCounts: Record<string, number> = {}
for (const m of memberRows) {
  const t = m.member_type ?? 'unknown'
  memberTypeCounts[t] = (memberTypeCounts[t] ?? 0) + 1
}

// ─── Dues compliance ────────────────────────────────────────────────────────

const activeMembers = memberRows.filter(m => m.status === 'active')
const activeMemberIds = new Set(activeMembers.map(m => m.id))

const duesPaidIds = new Set(
  (duesAll ?? [])
    .filter(d => d.paid_at && activeMemberIds.has(d.person_id))
    .map(d => d.person_id)
)

const duesCompliance = activeMembers.length > 0
  ? Math.round((duesPaidIds.size / activeMembers.length) * 100)
  : 0

// ─── DBS status ─────────────────────────────────────────────────────────────

const today = new Date()
const in60Days = new Date(today)
in60Days.setDate(today.getDate() + 60)

// Latest DBS record per person
const latestDbs = new Map<string, { expiry_date: string | null }>()
for (const rec of dbsAll ?? []) {
  const existing = latestDbs.get(rec.person_id)
  if (!existing || (rec.expiry_date && (!existing.expiry_date || rec.expiry_date > existing.expiry_date))) {
    latestDbs.set(rec.person_id, rec)
  }
}

let dbsExpiredCount = 0
let dbsExpiringSoonCount = 0
let dbsValidCount = 0
let dbsMissingCount = 0

for (const m of activeMembers) {
  const dbs = latestDbs.get(m.id)
  if (!dbs) {
    dbsMissingCount++
  } else if (!dbs.expiry_date) {
    dbsMissingCount++
  } else {
    const exp = new Date(dbs.expiry_date)
    if (exp < today) dbsExpiredCount++
    else if (exp < in60Days) dbsExpiringSoonCount++
    else dbsValidCount++
  }
}

// ─── Pillar participation ───────────────────────────────────────────────────

type PillarRow = { pillar_id: string | null; pillars: { name: string } | null }
const pillarCounts: Map<string, { name: string; count: number }> = new Map()
for (const row of (participationByPillar ?? []) as unknown as PillarRow[]) {
  if (!row.pillar_id) continue
  const name = row.pillars?.name ?? row.pillar_id
  const entry = pillarCounts.get(row.pillar_id) ?? { name, count: 0 }
  entry.count++
  pillarCounts.set(row.pillar_id, entry)
}

const pillarBreakdown = Array.from(pillarCounts.values())
  .sort((a, b) => b.count - a.count)

// ─── Team participation ─────────────────────────────────────────────────────

type TeamRow = { team_id: string | null; teams: { name: string } | null }
const teamCounts: Map<string, { name: string; count: number }> = new Map()
for (const row of (participationByTeam ?? []) as unknown as TeamRow[]) {
  if (!row.team_id) continue
  const name = row.teams?.name ?? row.team_id
  const entry = teamCounts.get(row.team_id) ?? { name, count: 0 }
  entry.count++
  teamCounts.set(row.team_id, entry)
}

const teamBreakdown = Array.from(teamCounts.values())
  .sort((a, b) => b.count - a.count)
  .slice(0, 8)

// ─── Membership growth by year ──────────────────────────────────────────────

const joinYearCounts: Record<number, number> = {}
for (const m of membersByJoinMonth ?? []) {
  if (!m.joined_at) continue
  const yr = new Date(m.joined_at).getFullYear()
  joinYearCounts[yr] = (joinYearCounts[yr] ?? 0) + 1
}

const growthYears = Object.keys(joinYearCounts)
  .map(Number)
  .sort((a, b) => a - b)
  .slice(-8) // last 8 years

const maxGrowth = Math.max(...growthYears.map(y => joinYearCounts[y] ?? 0), 1)

// ─── Helpers ────────────────────────────────────────────────────────────────

function pct(n: number, total: number) {
  return total === 0 ? 0 : Math.round((n / total) * 100)
}
---

<DashboardLayout title="Analytics">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px;">
    <div>
      <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Analytics</h1>
      <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0;">Organisation-wide metrics for {currentYear}</p>
    </div>
  </div>

  <!-- ── Top row: 4 summary cards ── -->
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">

    <!-- Total members -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 20px 24px;">
      <p style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 8px;">Total members</p>
      <p style="font-family: var(--font-heading); font-size: 32px; font-weight: 700; color: var(--color-brand-navy); margin: 0;">{totalMembers}</p>
    </div>

    <!-- Active members -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 20px 24px;">
      <p style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 8px;">Active</p>
      <p style="font-family: var(--font-heading); font-size: 32px; font-weight: 700; color: var(--color-success-600); margin: 0;">{statusCounts['active'] ?? 0}</p>
      <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 4px 0 0;">{pct(statusCounts['active'] ?? 0, totalMembers)}% of total</p>
    </div>

    <!-- Dues compliance -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 20px 24px;">
      <p style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 8px;">Dues compliance {currentYear}</p>
      <p style="font-family: var(--font-heading); font-size: 32px; font-weight: 700; color: {duesCompliance >= 80 ? 'var(--color-success-600)' : duesCompliance >= 50 ? 'var(--color-warning-600)' : 'var(--color-danger-600)'}; margin: 0;">{duesCompliance}%</p>
      <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 4px 0 0;">{duesPaidIds.size} / {activeMembers.length} active paid</p>
    </div>

    <!-- DBS valid -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 20px 24px;">
      <p style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 8px;">DBS valid</p>
      <p style="font-family: var(--font-heading); font-size: 32px; font-weight: 700; color: var(--color-success-600); margin: 0;">{dbsValidCount}</p>
      <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 4px 0 0;">
        {dbsExpiredCount > 0 ? `${dbsExpiredCount} expired · ` : ''}{dbsExpiringSoonCount > 0 ? `${dbsExpiringSoonCount} expiring soon · ` : ''}{dbsMissingCount} missing
      </p>
    </div>

  </div>

  <!-- ── Main grid ── -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">

    <!-- Member status breakdown -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 24px;">
      <h2 style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-neutral-800); margin: 0 0 20px;">Member status breakdown</h2>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        {Object.entries(STATUS_LABELS).filter(([s]) => statusCounts[s]).map(([status, label]) => {
          const count = statusCounts[status] ?? 0
          const barPct = pct(count, totalMembers)
          return (
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                <span style={`font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);`}>{label}</span>
                <span style="font-family: var(--font-heading); font-size: 13px; font-weight: 600; color: var(--color-neutral-800);">{count} <span style="font-weight: 400; color: var(--color-neutral-400);">({barPct}%)</span></span>
              </div>
              <div style="height: 8px; background-color: var(--color-neutral-100); border-radius: var(--radius-full); overflow: hidden;">
                <div style={`height: 100%; width: ${barPct}%; background-color: ${STATUS_COLORS[status] ?? 'var(--color-neutral-400)'}; border-radius: var(--radius-full); transition: width 0.3s;`}></div>
              </div>
            </div>
          )
        })}
      </div>
    </div>

    <!-- DBS status breakdown -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 24px;">
      <h2 style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-neutral-800); margin: 0 0 20px;">DBS status (active members)</h2>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        {[
          { label: 'Valid (>60 days remaining)', count: dbsValidCount, color: 'var(--color-success-500)' },
          { label: 'Expiring within 60 days', count: dbsExpiringSoonCount, color: 'var(--color-warning-500)' },
          { label: 'Expired', count: dbsExpiredCount, color: 'var(--color-danger-500)' },
          { label: 'No DBS record', count: dbsMissingCount, color: 'var(--color-neutral-400)' },
        ].map(row => {
          const barPct = pct(row.count, activeMembers.length)
          return (
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                <span style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">{row.label}</span>
                <span style="font-family: var(--font-heading); font-size: 13px; font-weight: 600; color: var(--color-neutral-800);">{row.count}</span>
              </div>
              <div style="height: 8px; background-color: var(--color-neutral-100); border-radius: var(--radius-full); overflow: hidden;">
                <div style={`height: 100%; width: ${barPct}%; background-color: ${row.color}; border-radius: var(--radius-full);`}></div>
              </div>
            </div>
          )
        })}
      </div>
      <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--color-neutral-100); display: flex; gap: 12px;">
        {dbsExpiredCount > 0 && (
          <a href="/admin/dbs?filter=expired"
            style="font-family: var(--font-body); font-size: 12px; color: var(--color-danger-600); text-decoration: none; font-weight: 500;">
            View expired →
          </a>
        )}
        {dbsExpiringSoonCount > 0 && (
          <a href="/admin/dbs?filter=expiring"
            style="font-family: var(--font-body); font-size: 12px; color: var(--color-warning-600); text-decoration: none; font-weight: 500;">
            View expiring soon →
          </a>
        )}
      </div>
    </div>

  </div>

  <!-- ── Second row ── -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">

    <!-- Pillar participation -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 24px;">
      <h2 style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-neutral-800); margin: 0 0 4px;">Participation by pillar</h2>
      <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0 0 20px;">Logged participation events</p>
      {pillarBreakdown.length === 0 ? (
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-400);">No participation events with pillars logged.</p>
      ) : (
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {pillarBreakdown.map(row => {
            const maxCount = pillarBreakdown[0].count
            const barPct = maxCount > 0 ? Math.round((row.count / maxCount) * 100) : 0
            return (
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                  <span style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-700);">{row.name}</span>
                  <span style="font-family: var(--font-heading); font-size: 13px; font-weight: 600; color: var(--color-neutral-800);">{row.count}</span>
                </div>
                <div style="height: 8px; background-color: var(--color-neutral-100); border-radius: var(--radius-full); overflow: hidden;">
                  <div style={`height: 100%; width: ${barPct}%; background-color: var(--color-brand-gold); border-radius: var(--radius-full);`}></div>
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>

    <!-- Team participation -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 24px;">
      <h2 style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-neutral-800); margin: 0 0 4px;">Participation by team</h2>
      <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0 0 20px;">Top 8 teams by logged events</p>
      {teamBreakdown.length === 0 ? (
        <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-400);">No participation events with teams logged.</p>
      ) : (
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {teamBreakdown.map(row => {
            const maxCount = teamBreakdown[0].count
            const barPct = maxCount > 0 ? Math.round((row.count / maxCount) * 100) : 0
            return (
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                  <span style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-700);">{row.name}</span>
                  <span style="font-family: var(--font-heading); font-size: 13px; font-weight: 600; color: var(--color-neutral-800);">{row.count}</span>
                </div>
                <div style="height: 8px; background-color: var(--color-neutral-100); border-radius: var(--radius-full); overflow: hidden;">
                  <div style={`height: 100%; width: ${barPct}%; background-color: var(--color-brand-navy); border-radius: var(--radius-full);`}></div>
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>

  </div>

  <!-- ── Membership growth ── -->
  <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 24px; margin-bottom: 24px;">
    <h2 style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-neutral-800); margin: 0 0 4px;">Membership growth</h2>
    <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-400); margin: 0 0 24px;">New members joined by year (last 8 years)</p>
    {growthYears.length === 0 ? (
      <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-400);">No join date data available.</p>
    ) : (
      <div style="display: flex; align-items: flex-end; gap: 16px; height: 140px;">
        {growthYears.map(year => {
          const count = joinYearCounts[year] ?? 0
          const barH = maxGrowth > 0 ? Math.round((count / maxGrowth) * 120) : 0
          return (
            <div style="display: flex; flex-direction: column; align-items: center; flex: 1; gap: 6px;">
              <span style="font-family: var(--font-heading); font-size: 11px; font-weight: 600; color: var(--color-neutral-600);">{count}</span>
              <div style={`width: 100%; height: ${barH}px; min-height: 4px; background-color: ${year === currentYear ? 'var(--color-brand-gold)' : 'var(--color-brand-navy)'}; border-radius: var(--radius-md) var(--radius-md) 0 0;`}></div>
              <span style="font-family: var(--font-body); font-size: 11px; color: var(--color-neutral-400);">{year}</span>
            </div>
          )
        })}
      </div>
    )}
  </div>

  <!-- ── Member type breakdown table ── -->
  <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--color-neutral-200);">
      <h2 style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-neutral-800); margin: 0;">Member type breakdown</h2>
    </div>
    <table style="width: 100%; border-collapse: collapse;">
      <thead style="background-color: var(--color-neutral-50); border-bottom: 1px solid var(--color-neutral-200);">
        <tr>
          <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: left; padding: 10px 24px; text-transform: uppercase; letter-spacing: 0.05em;">Type</th>
          <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: right; padding: 10px 24px; text-transform: uppercase; letter-spacing: 0.05em;">Count</th>
          <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: right; padding: 10px 24px; text-transform: uppercase; letter-spacing: 0.05em;">% of total</th>
        </tr>
      </thead>
      <tbody>
        {Object.entries(memberTypeCounts)
          .sort(([, a], [, b]) => b - a)
          .map(([type, count], i) => (
            <tr style={i > 0 ? 'border-top: 1px solid var(--color-neutral-100);' : ''}>
              <td style="padding: 12px 24px; font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-800); text-transform: capitalize;">{type.replace(/_/g, ' ')}</td>
              <td style="padding: 12px 24px; font-family: var(--font-heading); font-size: 14px; font-weight: 600; color: var(--color-neutral-700); text-align: right;">{count}</td>
              <td style="padding: 12px 24px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); text-align: right;">{pct(count, totalMembers)}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

</DashboardLayout>
