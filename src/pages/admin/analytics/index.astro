---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const currentYear = new Date().getFullYear()

// ─── Parallel data fetches ──────────────────────────────────────────────────

const [
  { data: allMembers },
  { data: duesAll },
  { data: dbsAll },
  { data: participationByPillar },
  ,  // pillars — fetched but not used directly (labels come from participation join)
  ,  // teams — fetched but not used directly (names come from participation join)
  { data: membersByJoinMonth },
  { data: participationByTeam },
] = await Promise.all([
  // All non-archived people with status
  supabaseAdmin
    .from('people')
    .select('id, status, member_type, joined_at')
    .eq('is_archived', false),

  // All dues records (for compliance calc)
  supabaseAdmin
    .from('dues')
    .select('person_id, year, paid_at')
    .eq('year', currentYear),

  // All DBS records to find expiry status
  supabaseAdmin
    .from('dbs_records')
    .select('person_id, expiry_date')
    .eq('is_archived', false),

  // Participation events grouped by pillar (we'll count in JS)
  supabaseAdmin
    .from('participation_events')
    .select('pillar_id, pillars(name)')
    .eq('is_archived', false)
    .not('pillar_id', 'is', null),

  // Pillar list for labels
  supabaseAdmin
    .from('pillars')
    .select('id, name')
    .eq('is_active', true)
    .order('display_order'),

  // Team list
  supabaseAdmin
    .from('teams')
    .select('id, name')
    .eq('is_active', true)
    .order('name'),

  // All members with joined_at for cohort chart
  supabaseAdmin
    .from('people')
    .select('joined_at')
    .eq('is_archived', false)
    .not('joined_at', 'is', null),

  // Participation by team
  supabaseAdmin
    .from('participation_events')
    .select('team_id, teams(name)')
    .eq('is_archived', false)
    .not('team_id', 'is', null),
])

// ─── Status breakdown ───────────────────────────────────────────────────────

const STATUS_LABELS: Record<string, string> = {
  active: 'Active',
  pending_review: 'Pending Review',
  applicant: 'Applicant',
  inactive: 'Inactive',
}

const STATUS_COLORS: Record<string, string> = {
  active: 'var(--color-success-500)',
  pending_review: 'var(--color-warning-500)',
  applicant: 'var(--color-neutral-400)',
  inactive: 'var(--color-neutral-400)',
}

const memberRows = allMembers ?? []
const totalMembers = memberRows.length

const statusCounts: Record<string, number> = {}
for (const m of memberRows) {
  const s = m.status ?? 'unknown'
  statusCounts[s] = (statusCounts[s] ?? 0) + 1
}

const memberTypeCounts: Record<string, number> = {}
for (const m of memberRows) {
  const t = m.member_type ?? 'unknown'
  memberTypeCounts[t] = (memberTypeCounts[t] ?? 0) + 1
}

// ─── Dues compliance ────────────────────────────────────────────────────────

const activeMembers = memberRows.filter(m => m.status === 'active')
const activeMemberIds = new Set(activeMembers.map(m => m.id))

const duesPaidIds = new Set(
  (duesAll ?? [])
    .filter(d => d.paid_at && activeMemberIds.has(d.person_id))
    .map(d => d.person_id)
)

const duesCompliance = activeMembers.length > 0
  ? Math.round((duesPaidIds.size / activeMembers.length) * 100)
  : 0

// ─── DBS status ─────────────────────────────────────────────────────────────

const today = new Date()
const in60Days = new Date(today)
in60Days.setDate(today.getDate() + 60)

// Latest DBS record per person
const latestDbs = new Map<string, { expiry_date: string | null }>()
for (const rec of dbsAll ?? []) {
  const existing = latestDbs.get(rec.person_id)
  if (!existing || (rec.expiry_date && (!existing.expiry_date || rec.expiry_date > existing.expiry_date))) {
    latestDbs.set(rec.person_id, rec)
  }
}

let dbsExpiredCount = 0
let dbsExpiringSoonCount = 0
let dbsValidCount = 0
let dbsMissingCount = 0

for (const m of activeMembers) {
  const dbs = latestDbs.get(m.id)
  if (!dbs) {
    dbsMissingCount++
  } else if (!dbs.expiry_date) {
    dbsMissingCount++
  } else {
    const exp = new Date(dbs.expiry_date)
    if (exp < today) dbsExpiredCount++
    else if (exp < in60Days) dbsExpiringSoonCount++
    else dbsValidCount++
  }
}

// ─── Pillar participation ───────────────────────────────────────────────────

type PillarRow = { pillar_id: string | null; pillars: { name: string } | null }
const pillarCounts: Map<string, { name: string; count: number }> = new Map()
for (const row of (participationByPillar ?? []) as unknown as PillarRow[]) {
  if (!row.pillar_id) continue
  const name = row.pillars?.name ?? row.pillar_id
  const entry = pillarCounts.get(row.pillar_id) ?? { name, count: 0 }
  entry.count++
  pillarCounts.set(row.pillar_id, entry)
}

const pillarBreakdown = Array.from(pillarCounts.values())
  .sort((a, b) => b.count - a.count)

// ─── Team participation ─────────────────────────────────────────────────────

type TeamRow = { team_id: string | null; teams: { name: string } | null }
const teamCounts: Map<string, { name: string; count: number }> = new Map()
for (const row of (participationByTeam ?? []) as unknown as TeamRow[]) {
  if (!row.team_id) continue
  const name = row.teams?.name ?? row.team_id
  const entry = teamCounts.get(row.team_id) ?? { name, count: 0 }
  entry.count++
  teamCounts.set(row.team_id, entry)
}

const teamBreakdown = Array.from(teamCounts.values())
  .sort((a, b) => b.count - a.count)
  .slice(0, 8)

// ─── Membership growth by year ──────────────────────────────────────────────

const joinYearCounts: Record<number, number> = {}
for (const m of membersByJoinMonth ?? []) {
  if (!m.joined_at) continue
  const yr = new Date(m.joined_at).getFullYear()
  joinYearCounts[yr] = (joinYearCounts[yr] ?? 0) + 1
}

const growthYears = Object.keys(joinYearCounts)
  .map(Number)
  .sort((a, b) => a - b)
  .slice(-8) // last 8 years

const maxGrowth = Math.max(...growthYears.map(y => joinYearCounts[y] ?? 0), 1)

// ─── Helpers ────────────────────────────────────────────────────────────────

function pct(n: number, total: number) {
  return total === 0 ? 0 : Math.round((n / total) * 100)
}
---

<DashboardLayout title="Analytics">
  <div class="flex items-center justify-between mb-7">
    <div>
      <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Analytics</h1>
      <p class="font-body text-sm text-neutral-500 m-0">Organisation-wide metrics for {currentYear}</p>
    </div>
  </div>

  <!-- ── Top row: 4 summary cards ── -->
  <div class="grid grid-cols-4 gap-4 mb-6">

    <!-- Total members -->
    <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
      <p class="font-body text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">Total members</p>
      <p class="font-heading text-[32px] font-bold text-brand-navy m-0">{totalMembers}</p>
    </div>

    <!-- Active members -->
    <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
      <p class="font-body text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">Active</p>
      <p class="font-heading text-[32px] font-bold text-success-600 m-0">{statusCounts['active'] ?? 0}</p>
      <p class="font-body text-xs text-neutral-400 mt-1">{pct(statusCounts['active'] ?? 0, totalMembers)}% of total</p>
    </div>

    <!-- Dues compliance -->
    <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
      <p class="font-body text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">Dues compliance {currentYear}</p>
      <p class={`font-heading text-[32px] font-bold m-0 ${duesCompliance >= 80 ? 'text-success-600' : duesCompliance >= 50 ? 'text-warning-600' : 'text-danger-600'}`}>{duesCompliance}%</p>
      <p class="font-body text-xs text-neutral-400 mt-1">{duesPaidIds.size} / {activeMembers.length} active paid</p>
    </div>

    <!-- DBS valid -->
    <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
      <p class="font-body text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">DBS valid</p>
      <p class="font-heading text-[32px] font-bold text-success-600 m-0">{dbsValidCount}</p>
      <p class="font-body text-xs text-neutral-400 mt-1">
        {dbsExpiredCount > 0 ? `${dbsExpiredCount} expired · ` : ''}{dbsExpiringSoonCount > 0 ? `${dbsExpiringSoonCount} expiring soon · ` : ''}{dbsMissingCount} missing
      </p>
    </div>

  </div>

  <!-- ── Main grid ── -->
  <div class="grid grid-cols-2 gap-6 mb-6">

    <!-- Member status breakdown -->
    <div class="bg-white border border-neutral-200 rounded-lg p-6">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 mb-5">Member status breakdown</h2>
      <div class="flex flex-col gap-3">
        {Object.entries(STATUS_LABELS).filter(([s]) => statusCounts[s]).map(([status, label]) => {
          const count = statusCounts[status] ?? 0
          const barPct = pct(count, totalMembers)
          return (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="font-body text-[13px] font-medium text-neutral-700">{label}</span>
                <span class="font-heading text-[13px] font-semibold text-neutral-800">{count} <span class="font-normal text-neutral-400">({barPct}%)</span></span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div style={`height: 100%; width: ${barPct}%; background-color: ${STATUS_COLORS[status] ?? 'var(--color-neutral-400)'}; border-radius: var(--radius-full); transition: width 0.3s;`}></div>
              </div>
            </div>
          )
        })}
      </div>
    </div>

    <!-- DBS status breakdown -->
    <div class="bg-white border border-neutral-200 rounded-lg p-6">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 mb-5">DBS status (active members)</h2>
      <div class="flex flex-col gap-4">
        {[
          { label: 'Valid (>60 days remaining)', count: dbsValidCount, color: 'var(--color-success-500)' },
          { label: 'Expiring within 60 days', count: dbsExpiringSoonCount, color: 'var(--color-warning-500)' },
          { label: 'Expired', count: dbsExpiredCount, color: 'var(--color-danger-500)' },
          { label: 'No DBS record', count: dbsMissingCount, color: 'var(--color-neutral-400)' },
        ].map(row => {
          const barPct = pct(row.count, activeMembers.length)
          return (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="font-body text-[13px] font-medium text-neutral-700">{row.label}</span>
                <span class="font-heading text-[13px] font-semibold text-neutral-800">{row.count}</span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div style={`height: 100%; width: ${barPct}%; background-color: ${row.color}; border-radius: var(--radius-full);`}></div>
              </div>
            </div>
          )
        })}
      </div>
      <div class="mt-5 pt-4 border-t border-neutral-100 flex gap-3">
        {dbsExpiredCount > 0 && (
          <a href="/admin/dbs?filter=expired"
            class="font-body text-xs text-danger-600 no-underline font-medium">
            View expired →
          </a>
        )}
        {dbsExpiringSoonCount > 0 && (
          <a href="/admin/dbs?filter=expiring"
            class="font-body text-xs text-warning-600 no-underline font-medium">
            View expiring soon →
          </a>
        )}
      </div>
    </div>

  </div>

  <!-- ── Second row ── -->
  <div class="grid grid-cols-2 gap-6 mb-6">

    <!-- Pillar participation -->
    <div class="bg-white border border-neutral-200 rounded-lg p-6">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 mb-1">Participation by pillar</h2>
      <p class="font-body text-xs text-neutral-400 mb-5">Logged participation events</p>
      {pillarBreakdown.length === 0 ? (
        <p class="font-body text-sm text-neutral-400">No participation events with pillars logged.</p>
      ) : (
        <div class="flex flex-col gap-2.5">
          {pillarBreakdown.map(row => {
            const maxCount = pillarBreakdown[0]?.count ?? 0
            const barPct = maxCount > 0 ? Math.round((row.count / maxCount) * 100) : 0
            return (
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="font-body text-[13px] text-neutral-700">{row.name}</span>
                  <span class="font-heading text-[13px] font-semibold text-neutral-800">{row.count}</span>
                </div>
                <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                  <div style={`height: 100%; width: ${barPct}%; background-color: var(--color-brand-gold); border-radius: var(--radius-full);`}></div>
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>

    <!-- Team participation -->
    <div class="bg-white border border-neutral-200 rounded-lg p-6">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 mb-1">Participation by team</h2>
      <p class="font-body text-xs text-neutral-400 mb-5">Top 8 teams by logged events</p>
      {teamBreakdown.length === 0 ? (
        <p class="font-body text-sm text-neutral-400">No participation events with teams logged.</p>
      ) : (
        <div class="flex flex-col gap-2.5">
          {teamBreakdown.map(row => {
            const maxCount = teamBreakdown[0]?.count ?? 0
            const barPct = maxCount > 0 ? Math.round((row.count / maxCount) * 100) : 0
            return (
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="font-body text-[13px] text-neutral-700">{row.name}</span>
                  <span class="font-heading text-[13px] font-semibold text-neutral-800">{row.count}</span>
                </div>
                <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                  <div style={`height: 100%; width: ${barPct}%; background-color: var(--color-brand-navy); border-radius: var(--radius-full);`}></div>
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>

  </div>

  <!-- ── Membership growth ── -->
  <div class="bg-white border border-neutral-200 rounded-lg p-6 mb-6">
    <h2 class="font-heading text-[15px] font-bold text-neutral-800 mb-1">Membership growth</h2>
    <p class="font-body text-xs text-neutral-400 mb-6">New members joined by year (last 8 years)</p>
    {growthYears.length === 0 ? (
      <p class="font-body text-sm text-neutral-400">No join date data available.</p>
    ) : (
      <div class="flex items-end gap-4 h-35">
        {growthYears.map(year => {
          const count = joinYearCounts[year] ?? 0
          const barH = maxGrowth > 0 ? Math.round((count / maxGrowth) * 120) : 0
          return (
            <div class="flex flex-col items-center flex-1 gap-1.5">
              <span class="font-heading text-[11px] font-semibold text-neutral-600">{count}</span>
              <div style={`width: 100%; height: ${barH}px; min-height: 4px; background-color: ${year === currentYear ? 'var(--color-brand-gold)' : 'var(--color-brand-navy)'}; border-radius: var(--radius-md) var(--radius-md) 0 0;`}></div>
              <span class="font-body text-[11px] text-neutral-400">{year}</span>
            </div>
          )
        })}
      </div>
    )}
  </div>

  <!-- ── Member type breakdown table ── -->
  <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
    <div class="py-5 px-6 border-b border-neutral-200">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 m-0">Member type breakdown</h2>
    </div>
    <table class="w-full border-collapse">
      <thead class="bg-neutral-50 border-b border-neutral-200">
        <tr>
          <th class="font-body text-xs font-semibold text-neutral-500 text-left py-2.5 px-6 uppercase tracking-wider">Type</th>
          <th class="font-body text-xs font-semibold text-neutral-500 text-right py-2.5 px-6 uppercase tracking-wider">Count</th>
          <th class="font-body text-xs font-semibold text-neutral-500 text-right py-2.5 px-6 uppercase tracking-wider">% of total</th>
        </tr>
      </thead>
      <tbody>
        {Object.entries(memberTypeCounts)
          .sort(([, a], [, b]) => b - a)
          .map(([type, count], i) => (
            <tr class={i > 0 ? 'border-t border-neutral-100' : ''}>
              <td class="py-3 px-6 font-body text-sm text-neutral-800 capitalize">{type.replace(/_/g, ' ')}</td>
              <td class="py-3 px-6 font-heading text-sm font-semibold text-neutral-700 text-right">{count}</td>
              <td class="py-3 px-6 font-body text-[13px] text-neutral-500 text-right">{pct(count, totalMembers)}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

</DashboardLayout>
