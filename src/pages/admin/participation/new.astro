---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Input from '@/components/ui/Input.astro'
import MemberSearch from '@/components/ui/MemberSearch.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const [teamsRes, pillarsRes] = await Promise.all([
  supabaseAdmin.from('teams').select('id, name').eq('is_active', true).order('name'),
  supabaseAdmin.from('pillars').select('id, name').eq('is_active', true).order('display_order'),
])

const teams = teamsRes.data ?? []
const pillars = pillarsRes.data ?? []

// Fetch pre-selected member name if coming from a member profile
const preselectedPersonId = Astro.url.searchParams.get('person_id') ?? ''
let preselectedName = ''
if (preselectedPersonId) {
  const { data: pre } = await supabaseAdmin.from('people').select('full_name').eq('id', preselectedPersonId).single()
  preselectedName = (pre?.full_name as string | null) ?? ''
}

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {}

if (preselectedPersonId) values.person_id = preselectedPersonId

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/participation`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      person_id: values.person_id,
      event_name: values.event_name,
      event_date: values.event_date || null,
      team_id: values.team_id || null,
      pillar_id: values.pillar_id || null,
      notes: values.notes || null,
    }),
  })

  if (res.ok) {
    return Astro.redirect('/admin/participation')
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to log event.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title="Log Participation Event">
  <div style="max-width: 560px;">
    <div style="margin-bottom: 24px;">
      <a href="/admin/participation" style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-500); text-decoration: none;">← Back to events</a>
    </div>
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Log Participation Event</h1>
    <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0 0 24px;">Record a member's participation in a chapter event or external activity.</p>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form method="POST" style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 20px;">

      <MemberSearch
        name="person_id"
        label="Member"
        required
        value={values.person_id || preselectedPersonId}
        initialName={preselectedName}
        error={errors.person_id}
      />

      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
        <Input label="Event name *" name="event_name" value={values.event_name} error={errors.event_name} required placeholder="e.g. Black History Month Panel" />
        <Input label="Date" name="event_date" type="date" value={values.event_date} error={errors.event_date} />
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Team (optional)</label>
          <select name="team_id"
            style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white;">
            <option value="">— None —</option>
            {teams.map(t => (
              <option value={t.id} selected={values.team_id === t.id}>{t.name as string}</option>
            ))}
          </select>
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Pillar (optional)</label>
          <select name="pillar_id"
            style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white;">
            <option value="">— None —</option>
            {pillars.map(p => (
              <option value={p.id} selected={values.pillar_id === p.id}>{p.name as string}</option>
            ))}
          </select>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Notes (optional)</label>
        <textarea name="notes" rows={3} placeholder="Any additional context…"
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; resize: vertical;">{values.notes ?? ''}</textarea>
      </div>

      <div style="display: flex; gap: 12px; padding-top: 8px;">
        <button type="submit" style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Log event
        </button>
        <a href="/admin/participation" style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
