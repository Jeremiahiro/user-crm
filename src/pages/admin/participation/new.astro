---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Input from '@/components/ui/Input.astro'
import MemberSearch from '@/components/ui/MemberSearch.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const [teamsRes, pillarsRes] = await Promise.all([
  supabaseAdmin.from('teams').select('id, name').eq('is_active', true).order('name'),
  supabaseAdmin.from('pillars').select('id, name').eq('is_active', true).order('display_order'),
])

const teams = teamsRes.data ?? []
const pillars = pillarsRes.data ?? []

// Fetch pre-selected member name if coming from a member profile
const preselectedPersonId = Astro.url.searchParams.get('person_id') ?? ''
let preselectedName = ''
if (preselectedPersonId) {
  const { data: pre } = await supabaseAdmin.from('people').select('full_name').eq('id', preselectedPersonId).single()
  preselectedName = (pre?.full_name as string | null) ?? ''
}

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {}

if (preselectedPersonId) values.person_id = preselectedPersonId

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/participation`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      person_id: values.person_id,
      event_name: values.event_name,
      event_date: values.event_date || null,
      team_id: values.team_id || null,
      pillar_id: values.pillar_id || null,
      notes: values.notes || null,
    }),
  })

  if (res.ok) {
    return Astro.redirect('/admin/participation')
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to log event.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title="Log Participation Event">
  <div class="max-w-140">
    <div class="mb-6">
      <a href="/admin/participation" class="font-body text-[13px] text-neutral-500 no-underline">← Back to events</a>
    </div>
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-1">Log Participation Event</h1>
    <p class="font-body text-sm text-neutral-500 mb-6">Record a member's participation in a chapter event or external activity.</p>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">

      <MemberSearch
        name="person_id"
        label="Member"
        required
        value={values.person_id || preselectedPersonId}
        initialName={preselectedName}
        error={errors.person_id}
      />

      <div class="grid grid-cols-[2fr_1fr] gap-4">
        <Input label="Event name *" name="event_name" value={values.event_name} error={errors.event_name} required placeholder="e.g. Black History Month Panel" />
        <Input label="Date" name="event_date" type="date" value={values.event_date} error={errors.event_date} />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">Team (optional)</label>
          <select name="team_id"
            class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm bg-white">
            <option value="">— None —</option>
            {teams.map(t => (
              <option value={t.id} selected={values.team_id === t.id}>{t.name as string}</option>
            ))}
          </select>
        </div>
        <div class="flex flex-col gap-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">Pillar (optional)</label>
          <select name="pillar_id"
            class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm bg-white">
            <option value="">— None —</option>
            {pillars.map(p => (
              <option value={p.id} selected={values.pillar_id === p.id}>{p.name as string}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Notes (optional)</label>
        <textarea name="notes" rows={3} placeholder="Any additional context…"
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm resize-y">{values.notes ?? ''}</textarea>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Log event
        </button>
        <a href="/admin/participation" class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
