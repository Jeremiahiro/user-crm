---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Pagination from '@/components/ui/Pagination.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const page = parseInt(Astro.url.searchParams.get('page') ?? '1')
const limit = 50
const offset = (page - 1) * limit

type AuditRow = {
  id: string
  action: string
  target_table: string
  target_id: string | null
  created_at: string
  actor: { full_name: string; email: string } | null
}

const { data: rows, count } = await supabaseAdmin
  .from('audit_log')
  .select('id, action, target_table, target_id, created_at, actor:people!actor_id(full_name, email)', { count: 'exact' })
  .order('created_at', { ascending: false })
  .range(offset, offset + limit - 1)

const entries = (rows ?? []) as unknown as AuditRow[]
const totalPages = Math.ceil((count ?? 0) / limit)

function fmtDate(iso: string) {
  return new Date(iso).toLocaleString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit',
  })
}

function actionBadge(action: string): { bg: string; color: string } {
  switch (action) {
    case 'create': return { bg: '#f0fdf4', color: '#166534' }
    case 'update': return { bg: '#eff6ff', color: '#1e40af' }
    case 'delete': return { bg: '#fef2f2', color: '#991b1b' }
    default:       return { bg: '#f8fafc', color: '#475569' }
  }
}
---

<DashboardLayout title="Audit Log">
  <div>
    <div style="margin-bottom: 28px;">
      <h1 style="font-family: var(--font-heading); font-size: 28px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 6px;">
        Audit Log
      </h1>
      <p style="color: var(--color-neutral-600); font-size: 15px; margin: 0;">
        Immutable record of all changes — {count ?? 0} entries
      </p>
    </div>

    <div style="background: white; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-lg); overflow: hidden;">
      {entries.length === 0 ? (
        <div style="padding: 48px 24px; text-align: center; color: var(--color-neutral-500); font-size: 14px;">
          No audit entries yet.
        </div>
      ) : (
        <table style="width: 100%; border-collapse: collapse; font-size: 13px; font-family: var(--font-body);">
          <thead>
            <tr style="background-color: var(--color-neutral-50); border-bottom: 1px solid var(--color-neutral-200);">
              <th style="text-align: left; padding: 11px 16px; font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap;">When</th>
              <th style="text-align: left; padding: 11px 16px; font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.04em;">Actor</th>
              <th style="text-align: left; padding: 11px 16px; font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.04em;">Action</th>
              <th style="text-align: left; padding: 11px 16px; font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.04em;">Table</th>
              <th style="text-align: left; padding: 11px 16px; font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.04em;">Record ID</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((row, i) => {
              const badge = actionBadge(row.action)
              return (
                <tr style={`border-bottom: ${i < entries.length - 1 ? '1px solid var(--color-neutral-100)' : 'none'};`}>
                  <td style="padding: 10px 16px; color: var(--color-neutral-500); white-space: nowrap;">{fmtDate(row.created_at)}</td>
                  <td style="padding: 10px 16px; color: var(--color-neutral-800);">
                    {row.actor ? row.actor.full_name : <span style="color: var(--color-neutral-400);">System</span>}
                  </td>
                  <td style="padding: 10px 16px;">
                    <span style={`display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; background-color: ${badge.bg}; color: ${badge.color};`}>
                      {row.action}
                    </span>
                  </td>
                  <td style="padding: 10px 16px; color: var(--color-neutral-600); font-family: var(--font-mono, monospace);">{row.target_table}</td>
                  <td style="padding: 10px 16px; color: var(--color-neutral-400); font-family: var(--font-mono, monospace); font-size: 11px; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{row.target_id ?? '—'}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      )}
    </div>

    <Pagination page={page} totalPages={totalPages} baseUrl="/admin/audit" />
  </div>
</DashboardLayout>
