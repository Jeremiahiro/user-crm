---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Pagination from '@/components/ui/Pagination.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const page = parseInt(Astro.url.searchParams.get('page') ?? '1')
const limit = 50
const offset = (page - 1) * limit

type AuditRow = {
  id: string
  action: string
  target_table: string
  target_id: string | null
  created_at: string
  actor: { full_name: string; email: string } | null
}

const { data: rows, count } = await supabaseAdmin
  .from('audit_log')
  .select('id, action, target_table, target_id, created_at, actor:people!actor_id(full_name, email)', { count: 'exact' })
  .order('created_at', { ascending: false })
  .range(offset, offset + limit - 1)

const entries = (rows ?? []) as unknown as AuditRow[]
const totalPages = Math.ceil((count ?? 0) / limit)

function fmtDate(iso: string) {
  return new Date(iso).toLocaleString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit',
  })
}

function actionBadge(action: string): { bg: string; color: string } {
  switch (action) {
    case 'create': return { bg: '#f0fdf4', color: '#166534' }
    case 'update': return { bg: '#eff6ff', color: '#1e40af' }
    case 'delete': return { bg: '#fef2f2', color: '#991b1b' }
    default:       return { bg: '#f8fafc', color: '#475569' }
  }
}
---

<DashboardLayout title="Audit Log">
  <div>
    <div class="mb-7">
      <h1 class="font-heading text-[28px] font-bold text-brand-navy mb-1.5">
        Audit Log
      </h1>
      <p class="text-neutral-600 text-[15px] m-0">
        Immutable record of all changes — {count ?? 0} entries
      </p>
    </div>

    <div class="bg-white border border-neutral-300 rounded-lg overflow-hidden">
      {entries.length === 0 ? (
        <div class="py-12 px-6 text-center text-neutral-500 text-sm">
          No audit entries yet.
        </div>
      ) : (
        <table class="w-full border-collapse text-[13px] font-body">
          <thead>
            <tr class="bg-neutral-50 border-b border-neutral-200">
              <th class="text-left py-[11px] px-4 text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.04em] whitespace-nowrap">When</th>
              <th class="text-left py-[11px] px-4 text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.04em]">Actor</th>
              <th class="text-left py-[11px] px-4 text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.04em]">Action</th>
              <th class="text-left py-[11px] px-4 text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.04em]">Table</th>
              <th class="text-left py-[11px] px-4 text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.04em]">Record ID</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((row, i) => {
              const badge = actionBadge(row.action)
              return (
                <tr class={i < entries.length - 1 ? 'border-b border-neutral-100' : ''}>
                  <td class="px-4 py-2.5 text-neutral-500 whitespace-nowrap">{fmtDate(row.created_at)}</td>
                  <td class="px-4 py-2.5 text-neutral-800">
                    {row.actor ? row.actor.full_name : <span class="text-neutral-400">System</span>}
                  </td>
                  <td class="px-4 py-2.5">
                    <span class="inline-block px-2 py-0.5 rounded-[10px] text-[11px] font-semibold uppercase tracking-[0.04em]" style={`background-color: ${badge.bg}; color: ${badge.color};`}>
                      {row.action}
                    </span>
                  </td>
                  <td class="px-4 py-2.5 text-neutral-600 font-mono">{row.target_table}</td>
                  <td class="px-4 py-2.5 text-neutral-400 font-mono text-[11px] max-w-[180px] truncate">{row.target_id ?? '—'}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      )}
    </div>

    <Pagination page={page} totalPages={totalPages} baseUrl="/admin/audit" />
  </div>
</DashboardLayout>
