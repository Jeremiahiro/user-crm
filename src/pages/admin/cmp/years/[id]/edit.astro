---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params

const { data: year } = await supabaseAdmin
  .from('cmp_programme_years')
  .select('*')
  .eq('id', id ?? '')
  .single()

if (!year) return Astro.redirect('/admin/cmp/years')

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {
  name: year.name as string,
  start_date: (year.start_date as string | null) ?? '',
  end_date: (year.end_date as string | null) ?? '',
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/cmp/years/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      name: values.name,
      start_date: values.start_date || null,
      end_date: values.end_date || null,
    }),
  })

  if (res.ok) {
    return Astro.redirect(`/admin/cmp/years/${id}`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to update programme year.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title={`Edit — ${year.name as string}`}>
  <div class="max-w-130">
    <Breadcrumb crumbs={[{ label: 'CMP', href: '/admin/cmp' }, { label: year.name as string, href: `/admin/cmp/years/${id}` }, { label: 'Edit' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-6">Edit — {year.name as string}</h1>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">
      <Input label="Name *" name="name" value={values.name} error={errors.name} required />
      <div class="grid grid-cols-2 gap-4">
        <Input label="Start date" name="start_date" type="date" value={values.start_date} error={errors.start_date} />
        <Input label="End date" name="end_date" type="date" value={values.end_date} error={errors.end_date} />
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Save changes
        </button>
        <a href={`/admin/cmp/years/${id}`} class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
