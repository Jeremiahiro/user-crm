---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { data: years } = await supabaseAdmin
  .from('cmp_programme_years')
  .select('*, cmp_sessions(id)')
  .order('start_date', { ascending: false })

const rows = years ?? []

function formatDate(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

// Count sessions per year
function sessionCount(year: typeof rows[number]) {
  const sessions = (year as unknown as { cmp_sessions: { id: string }[] }).cmp_sessions
  return sessions?.length ?? 0
}
---

<DashboardLayout title="CMP — Programme Years">
  <div class="flex items-center justify-between mb-6">
    <div>
      <p class="font-body text-[13px] text-neutral-400 mb-1">
        <a href="/admin/cmp" class="text-neutral-400 no-underline">CMP</a>
      </p>
      <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Programme Years</h1>
      <p class="font-body text-sm text-neutral-500 m-0">{rows.length} year{rows.length !== 1 ? 's' : ''}</p>
    </div>
    <a href="/admin/cmp/years/new"
      class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
      + New year
    </a>
  </div>

  {rows.length === 0 ? (
    <div class="bg-white border border-neutral-200 rounded-lg p-12 text-center">
      <p class="font-body text-sm text-neutral-400 mb-4">No programme years yet.</p>
      <a href="/admin/cmp/years/new"
        class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
        Create first year
      </a>
    </div>
  ) : (
    <div class="flex flex-col gap-3">
      {rows.map(year => (
        <div class="bg-white border border-neutral-200 rounded-lg px-6 py-5 flex items-center justify-between">
          <div class="flex items-center gap-5">
            <div>
              <h2 class="font-heading text-base font-bold text-brand-navy mb-1">
                <a href={`/admin/cmp/years/${year.id}`}
                  class="text-brand-navy no-underline">{year.name as string}</a>
              </h2>
              <p class="font-body text-[13px] text-neutral-400 m-0">
                {formatDate(year.start_date as string | null)} → {formatDate(year.end_date as string | null)}
              </p>
            </div>
            <span class="inline-block px-3 py-1 rounded-full font-body text-[13px] font-semibold text-brand-navy bg-neutral-100">
              {sessionCount(year)} session{sessionCount(year) !== 1 ? 's' : ''}
            </span>
          </div>
          <div class="flex gap-3">
            <a href={`/admin/cmp/years/${year.id}/edit`}
              class="px-3.5 py-1.5 bg-neutral-100 rounded-md font-body text-[13px] text-neutral-600 no-underline">
              Edit
            </a>
            <a href={`/admin/cmp/years/${year.id}`}
              class="px-3.5 py-1.5 bg-brand-navy text-white rounded-md font-body text-[13px] font-semibold no-underline">
              View sessions →
            </a>
          </div>
        </div>
      ))}
    </div>
  )}
</DashboardLayout>
