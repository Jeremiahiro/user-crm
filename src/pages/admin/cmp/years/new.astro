---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'

if (!Astro.locals.user) return Astro.redirect('/login')

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/cmp/years`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      name: values.name,
      start_date: values.start_date || null,
      end_date: values.end_date || null,
    }),
  })

  if (res.ok) {
    const body = await res.json() as { data: { id: string } }
    return Astro.redirect(`/admin/cmp/years/${body.data.id}`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to create programme year.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}
---

<DashboardLayout title="New Programme Year">
  <div style="max-width: 520px;">
    <Breadcrumb crumbs={[{ label: 'CMP', href: '/admin/cmp' }, { label: 'New Year' }]} />
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 24px;">New Programme Year</h1>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form method="POST" style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 20px;">
      <Input
        label="Name *"
        name="name"
        value={values.name}
        error={errors.name}
        required
        placeholder="e.g. 2024–25 Cohort"
      />
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <Input label="Start date" name="start_date" type="date" value={values.start_date} error={errors.start_date} />
        <Input label="End date" name="end_date" type="date" value={values.end_date} error={errors.end_date} />
      </div>

      <div style="display: flex; gap: 12px; padding-top: 8px;">
        <button type="submit" style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Create year
        </button>
        <a href="/admin/cmp/years" style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
