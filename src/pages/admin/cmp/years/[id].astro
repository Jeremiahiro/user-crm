---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params

// ── Programme year + sessions ─────────────────────────────────────────────────
const { data: year } = await supabaseAdmin
  .from('cmp_programme_years')
  .select(`
    *,
    cmp_sessions(
      id, title, session_date, session_time, location, type, is_cancelled,
      cmp_attendance(id, role, person_id, mentee_id, visitor_name)
    )
  `)
  .eq('id', id ?? '')
  .single()

if (!year) return Astro.redirect('/admin/cmp/years')

type AttendanceRow = { id: string; role: string; person_id: string | null; mentee_id: string | null; visitor_name: string | null }
type Session = {
  id: string
  title: string
  session_date: string
  session_time: string | null
  location: string | null
  type: string | null
  is_cancelled: boolean
  cmp_attendance: AttendanceRow[]
}

const sessions = ((year as unknown as { cmp_sessions: Session[] }).cmp_sessions ?? [])
  .sort((a, b) => new Date(a.session_date).getTime() - new Date(b.session_date).getTime())

// ── Mentees enrolled in this programme year ───────────────────────────────────
const { data: enrolledMentees } = await supabaseAdmin
  .from('mentees')
  .select('id, full_name, school, year_group, mentor_id, email')
  .eq('programme_year_id', id ?? '')
  .eq('is_archived', false)
  .order('full_name', { ascending: true })

const menteeRows = enrolledMentees ?? []

// Mentor name lookup
const mentorIds = [...new Set(menteeRows.map(m => m.mentor_id).filter(Boolean))] as string[]
const { data: mentorPeople } = mentorIds.length > 0
  ? await supabaseAdmin.from('people').select('id, full_name').in('id', mentorIds)
  : { data: [] }
const mentorMap = new Map((mentorPeople ?? []).map(p => [p.id, p.full_name as string]))

// ── Aggregate stats ────────────────────────────────────────────────────────────
const allAttendance = sessions.flatMap(s => s.cmp_attendance)
const uniqueMentors = new Set(allAttendance.filter(a => a.role === 'mentor').map(a => a.person_id))
const uniqueParents = new Set(allAttendance.filter(a => a.role === 'parent').map(a => a.visitor_name))

const nonCancelledSessions = sessions.filter(s => !s.is_cancelled)
const totalPossibleMenteeAttendances = menteeRows.length * nonCancelledSessions.length
const actualMenteeAttendances = allAttendance.filter(a => a.role === 'mentee').length
const menteeAttendancePct = totalPossibleMenteeAttendances > 0
  ? Math.round((actualMenteeAttendances / totalPossibleMenteeAttendances) * 100)
  : 0

const totalSessions = sessions.length
const upcomingCount = sessions.filter(s => new Date(s.session_date) >= new Date() && !s.is_cancelled).length
const cancelledCount = sessions.filter(s => s.is_cancelled).length

function formatDate(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

function formatTime(t: string | null) {
  if (!t) return ''
  const [h, m] = t.split(':')
  const hour = parseInt(h ?? '0')
  const ampm = hour >= 12 ? 'pm' : 'am'
  const displayHour = hour % 12 || 12
  return `${displayHour}:${m}${ampm}`
}

const TYPE_LABELS: Record<string, string> = { regular: 'Regular', special: 'Special', trip: 'Trip' }
const TYPE_COLORS: Record<string, string> = {
  regular: '#e0e7ff',
  special: '#fef3c7',
  trip: '#d1fae5',
}
---

<DashboardLayout title={year.name as string}>
  <Breadcrumb crumbs={[{ label: 'CMP', href: '/admin/cmp' }, { label: year.name as string }]} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-6">
    <div>
      <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">{year.name as string}</h1>
      <p class="font-body text-sm text-neutral-500 m-0">
        {formatDate(year.start_date as string | null)} → {formatDate(year.end_date as string | null)}
      </p>
    </div>
    <div class="flex gap-2.5">
      <a href={`/admin/cmp/years/${id}/edit`}
        class="py-2 px-4 bg-white border border-neutral-300 rounded-md font-body text-[13px] font-medium text-neutral-700 no-underline">
        Edit year
      </a>
      <a href={`/admin/cmp/sessions/new?year_id=${id}`}
        class="py-2 px-4 bg-brand-navy text-white rounded-md font-body text-[13px] font-semibold no-underline">
        + Add session
      </a>
    </div>
  </div>

  <!-- Enrolment stat cards -->
  <div class="grid grid-cols-3 gap-4 mb-4">
    <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6 flex items-center gap-4">
      <div class="w-11 h-11 rounded-[10px] bg-[#e0e7ff] flex items-center justify-center text-[22px] shrink-0">👨‍🏫</div>
      <div>
        <p class="font-body text-xs font-medium text-neutral-500 mb-0.5">Mentors active</p>
        <p class="font-heading text-[28px] font-bold text-brand-navy m-0">{uniqueMentors.size}</p>
      </div>
    </div>
    <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6 flex items-center gap-4">
      <div class="w-11 h-11 rounded-[10px] bg-[#fef3c7] flex items-center justify-center text-[22px] shrink-0">🎓</div>
      <div>
        <p class="font-body text-xs font-medium text-neutral-500 mb-0.5">Mentees enrolled</p>
        <p class="font-heading text-[28px] font-bold text-brand-navy m-0">{menteeRows.length}</p>
      </div>
    </div>
    <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6 flex items-center gap-4">
      <div class="w-11 h-11 rounded-[10px] bg-[#d1fae5] flex items-center justify-center text-[22px] shrink-0">👨‍👩‍👧</div>
      <div>
        <p class="font-body text-xs font-medium text-neutral-500 mb-0.5">Parents attended</p>
        <p class="font-heading text-[28px] font-bold text-brand-navy m-0">{uniqueParents.size}</p>
      </div>
    </div>
  </div>

  <!-- Session/attendance summary -->
  <div class="grid grid-cols-4 gap-4 mb-7">
    {[
      { label: 'Total sessions', value: String(totalSessions), sub: '' },
      { label: 'Upcoming', value: String(upcomingCount), sub: '' },
      { label: 'Cancelled', value: String(cancelledCount), sub: '' },
      { label: 'Mentee attendance', value: `${menteeAttendancePct}%`, sub: totalPossibleMenteeAttendances > 0 ? `${actualMenteeAttendances}/${totalPossibleMenteeAttendances} slots` : 'no data yet' },
    ].map(stat => (
      <div class="bg-white border border-neutral-200 rounded-lg py-4 px-5">
        <p class="font-body text-xs font-medium text-neutral-500 mb-1">{stat.label}</p>
        <p class="font-heading text-[26px] font-bold text-brand-navy m-0">{stat.value}</p>
        {stat.sub && <p class="font-body text-[11px] text-neutral-400 mt-0.5">{stat.sub}</p>}
      </div>
    ))}
  </div>

  <!-- Enrolled mentees -->
  <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden mb-6">
    <div class="py-3.5 px-5 border-b border-neutral-200 flex items-center justify-between">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 m-0">
        Enrolled Mentees
        <span class="font-body text-[13px] font-normal text-neutral-400 ml-1.5">{menteeRows.length}</span>
      </h2>
      <a href={`/admin/mentees/new?programme_year_id=${id}`}
        class="py-1.5 px-3.5 bg-brand-navy text-white rounded-md font-body text-[13px] font-semibold no-underline">
        + Enrol mentee
      </a>
    </div>

    {menteeRows.length === 0 ? (
      <div class="p-9 text-center">
        <p class="font-body text-sm text-neutral-400 mb-3.5">No mentees enrolled in this programme year yet.</p>
        <a href={`/admin/mentees/new?programme_year_id=${id}`}
          class="py-2 px-[18px] bg-brand-navy text-white rounded-md font-body text-[13px] font-semibold no-underline">
          Enrol first mentee
        </a>
      </div>
    ) : (
      <table class="w-full border-collapse">
        <thead class="bg-neutral-50 border-b border-neutral-200">
          <tr>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">Name</th>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">School</th>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">Year</th>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">Mentor</th>
            <th class="py-[9px] px-4"></th>
          </tr>
        </thead>
        <tbody>
          {menteeRows.map((m, i) => (
            <tr class:list={[{ 'border-t border-neutral-100': i > 0 }]}>
              <td class="py-3 px-4">
                <a href={`/admin/mentees/${m.id}`}
                  class="font-body text-sm font-medium text-brand-navy no-underline">
                  {m.full_name as string}
                </a>
                {m.email && <p class="font-body text-xs text-neutral-400 mt-0.5">{m.email as string}</p>}
              </td>
              <td class="py-3 px-4 font-body text-[13px] text-neutral-600">{(m.school as string | null) ?? '—'}</td>
              <td class="py-3 px-4 font-body text-[13px] text-neutral-600">{(m.year_group as string | null) ?? '—'}</td>
              <td class="py-3 px-4 font-body text-[13px]">
                {m.mentor_id ? (
                  <a href={`/admin/members/${m.mentor_id}`}
                    class="text-brand-navy no-underline font-body text-[13px]">
                    {mentorMap.get(m.mentor_id as string) ?? '—'}
                  </a>
                ) : (
                  <span class="text-warning-600 text-xs font-medium">Unassigned</span>
                )}
              </td>
              <td class="py-3 px-4 text-right">
                <a href={`/admin/mentees/${m.id}`}
                  class="font-body text-xs font-medium text-brand-navy no-underline">
                  View →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  <!-- Sessions -->
  <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
    <div class="py-3.5 px-5 border-b border-neutral-200 flex items-center justify-between">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 m-0">Sessions</h2>
      <a href={`/admin/cmp/sessions/new?year_id=${id}`}
        class="font-body text-[13px] font-medium text-brand-navy no-underline">
        + Add
      </a>
    </div>

    {sessions.length === 0 ? (
      <div class="p-12 text-center">
        <p class="font-body text-sm text-neutral-400 mb-4">No sessions yet for this programme year.</p>
        <a href={`/admin/cmp/sessions/new?year_id=${id}`}
          class="py-2.5 px-[18px] bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
          Add first session
        </a>
      </div>
    ) : (
      <table class="w-full border-collapse">
        <thead class="bg-neutral-50 border-b border-neutral-200">
          <tr>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">Session</th>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">Date</th>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">Location</th>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">Type</th>
            <th class="font-body text-[11px] font-semibold text-neutral-500 text-left py-[9px] px-4 uppercase tracking-wider">Attendance</th>
            <th class="py-[9px] px-4"></th>
          </tr>
        </thead>
        <tbody>
          {sessions.map((s, i) => {
            const isPast = new Date(s.session_date) < new Date()
            return (
              <tr class:list={[{ 'border-t border-neutral-100': i > 0 }, { 'opacity-[0.55]': s.is_cancelled }]}>
                <td class="py-[13px] px-4">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    {s.is_cancelled && (
                      <span class="py-[1px] px-[7px] rounded-full bg-danger-100 text-danger-700 font-body text-[10px] font-bold tracking-[0.04em]">CANCELLED</span>
                    )}
                    {!isPast && !s.is_cancelled && (
                      <span class="py-[1px] px-[7px] rounded-full bg-success-100 text-success-700 font-body text-[10px] font-semibold">Upcoming</span>
                    )}
                    <a href={`/admin/cmp/sessions/${s.id}`}
                      class:list={['font-body text-sm font-medium text-brand-navy no-underline', { 'line-through': s.is_cancelled }]}>
                      {s.title}
                    </a>
                  </div>
                </td>
                <td class="py-[13px] px-4 font-body text-[13px] text-neutral-600">
                  {formatDate(s.session_date)}
                  {s.session_time && <span class="text-neutral-400 ml-1">{formatTime(s.session_time)}</span>}
                </td>
                <td class="py-[13px] px-4 font-body text-[13px] text-neutral-600">{s.location ?? '—'}</td>
                <td class="py-[13px] px-4">
                  {s.type ? (
                    <span class="py-0.5 px-2.5 rounded-full font-body text-xs font-medium text-neutral-700" style={`background: ${TYPE_COLORS[s.type] ?? '#f3f4f6'};`}>
                      {TYPE_LABELS[s.type] ?? s.type}
                    </span>
                  ) : <span class="text-neutral-400">—</span>}
                </td>
                <td class="py-[13px] px-4 font-body text-[13px] text-neutral-600">{s.cmp_attendance?.length ?? 0}</td>
                <td class="py-[13px] px-4 text-right whitespace-nowrap">
                  <a href={`/admin/cmp/sessions/${s.id}/attendance`}
                    class="font-body text-xs font-semibold text-brand-navy no-underline mr-2.5">
                    Attendance
                  </a>
                  <a href={`/admin/cmp/sessions/${s.id}`}
                    class="font-body text-xs text-neutral-400 no-underline">
                    View →
                  </a>
                </td>
              </tr>
            )
          })}
        </tbody>
      </table>
    )}
  </div>
</DashboardLayout>
