---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

const { id } = Astro.params

const { data: session } = await supabaseAdmin
  .from('cmp_sessions')
  .select(`
    *,
    cmp_programme_years(id, name),
    cmp_attendance(
      id, status, role, recorded_at,
      mentee_id, mentees(id, full_name),
      person_id, people(id, full_name),
      visitor_name
    )
  `)
  .eq('id', id ?? '')
  .single()

if (!session) return Astro.redirect('/admin/cmp/years')

type AttendanceRow = {
  id: string
  status: string
  role: string
  recorded_at: string
  mentee_id: string | null
  mentees: { id: string; full_name: string } | null
  person_id: string | null
  people: { id: string; full_name: string } | null
  visitor_name: string | null
}

const attendanceRows = (session as unknown as { cmp_attendance: AttendanceRow[] }).cmp_attendance ?? []
const _programmeYear = (session as unknown as { cmp_programme_years: { id: string; name: string } | null }).cmp_programme_years

const presentCount = attendanceRows.filter(a => a.status === 'present').length
const absentCount = attendanceRows.filter(a => a.status === 'absent').length
const apologyCount = attendanceRows.filter(a => a.status === 'apology').length

function formatDate(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
}

function formatTime(t: string | null) {
  if (!t) return ''
  const [h, m] = t.split(':')
  const hour = parseInt(h ?? '0')
  const ampm = hour >= 12 ? 'pm' : 'am'
  const displayHour = hour % 12 || 12
  return `${displayHour}:${m}${ampm}`
}

const STATUS_CLASSES: Record<string, string> = {
  present: 'bg-success-100 text-success-700',
  absent: 'bg-neutral-100 text-neutral-500',
  apology: 'bg-warning-100 text-warning-700',
}
---

<DashboardLayout title={session.title as string}>
  <Breadcrumb crumbs={[{ label: 'CMP', href: '/admin/cmp' }, { label: session.title as string ?? 'Session' }]} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-7">
    <div>
      <div class="flex items-center gap-2.5 mb-1">
        {(session.is_cancelled as boolean) && (
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-danger-100 text-danger-700 font-body text-xs font-bold">CANCELLED</span>
        )}
        <h1 class="font-heading text-2xl font-bold text-brand-navy m-0">{session.title as string}</h1>
      </div>
      <p class="font-body text-sm text-neutral-500 m-0">
        {formatDate(session.session_date as string)}
        {session.session_time && <span class="ml-1.5">{formatTime(session.session_time as string | null)}</span>}
        {session.location && <span class="ml-1.5">· {session.location as string}</span>}
      </p>
    </div>
    <div class="flex gap-2.5">
      <a href={`/admin/cmp/sessions/${id}/edit`}
        class="px-4 py-2 bg-white border border-neutral-300 rounded-md font-body text-[13px] font-medium text-neutral-700 no-underline">
        Edit
      </a>
      <a href={`/admin/cmp/sessions/${id}/attendance`}
        class="px-4 py-2 bg-brand-navy text-white rounded-md font-body text-[13px] font-semibold no-underline">
        Mark attendance
      </a>
    </div>
  </div>

  <!-- Cancellation notice -->
  {(session.is_cancelled as boolean) && session.cancellation_reason && (
    <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5">
      <p class="font-body text-[13px] text-danger-700 m-0">
        <strong>Cancellation reason:</strong> {session.cancellation_reason as string}
      </p>
    </div>
  )}

  <!-- Notes -->
  {(session.notes as string | null) && (
    <div class="bg-white border border-neutral-200 rounded-lg px-6 py-5 mb-5">
      <h2 class="font-heading text-[13px] font-bold text-neutral-500 mb-2 uppercase tracking-[0.05em]">Notes</h2>
      <p class="font-body text-sm text-neutral-700 m-0 leading-relaxed whitespace-pre-wrap">{session.notes as string}</p>
    </div>
  )}

  <!-- Attendance summary stats -->
  <div class="grid grid-cols-3 gap-4 mb-6">
    {[
      { label: 'Present', value: presentCount, colorClass: 'text-success-700' },
      { label: 'Absent', value: absentCount, colorClass: 'text-neutral-500' },
      { label: 'Apology', value: apologyCount, colorClass: 'text-warning-700' },
    ].map(stat => (
      <div class="bg-white border border-neutral-200 rounded-lg px-5 py-4">
        <p class="font-body text-[13px] text-neutral-500 mb-1">{stat.label}</p>
        <p class={`font-heading text-[28px] font-bold m-0 ${stat.colorClass}`}>{stat.value}</p>
      </div>
    ))}
  </div>

  <!-- Attendance table -->
  <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
    <div class="px-6 py-4 border-b border-neutral-200 flex items-center justify-between">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 m-0">Attendance ({attendanceRows.length})</h2>
      {attendanceRows.length === 0 && (
        <a href={`/admin/cmp/sessions/${id}/attendance`}
          class="font-body text-[13px] font-semibold text-brand-navy no-underline">
          Mark attendance →
        </a>
      )}
    </div>

    {attendanceRows.length === 0 ? (
      <div class="p-10 text-center">
        <p class="font-body text-sm text-neutral-400 m-0">No attendance recorded yet.</p>
      </div>
    ) : (
      <table class="w-full border-collapse">
        <thead class="bg-neutral-50 border-b border-neutral-200">
          <tr>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Name</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Role</th>
            <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Status</th>
          </tr>
        </thead>
        <tbody>
          {attendanceRows.map((a, i) => {
            const name = a.visitor_name ?? a.mentees?.full_name ?? a.people?.full_name ?? 'Unknown'
            const role = (a.role ?? (a.mentee_id ? 'mentee' : 'mentor')).charAt(0).toUpperCase() + (a.role ?? (a.mentee_id ? 'mentee' : 'mentor')).slice(1)
            const profileUrl = a.mentee_id
              ? `/admin/mentees/${a.mentee_id}`
              : a.person_id ? `/admin/members/${a.person_id}` : null
            return (
              <tr class={i > 0 ? 'border-t border-neutral-100' : ''}>
                <td class="px-4 py-3">
                  {profileUrl
                    ? <a href={profileUrl} class="font-body text-sm font-medium text-brand-navy no-underline">{name}</a>
                    : <span class="font-body text-sm font-medium text-neutral-800">{name}</span>}
                </td>
                <td class="px-4 py-3 font-body text-[13px] text-neutral-500">{role}</td>
                <td class="px-4 py-3">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full font-body text-xs font-semibold ${STATUS_CLASSES[a.status] ?? 'bg-neutral-100 text-neutral-700'}`}>
                    {a.status.charAt(0).toUpperCase() + a.status.slice(1)}
                  </span>
                </td>
              </tr>
            )
          })}
        </tbody>
      </table>
    )}
  </div>
</DashboardLayout>
