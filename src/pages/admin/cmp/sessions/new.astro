---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

// Pre-fill year from query param
const preselectedYearId = Astro.url.searchParams.get('year_id') ?? ''

const { data: years } = await supabaseAdmin
  .from('cmp_programme_years')
  .select('id, name')
  .order('start_date', { ascending: false })

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {
  programme_year_id: preselectedYearId,
  type: 'regular',
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/cmp/sessions`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      programme_year_id: values.programme_year_id,
      title: values.title,
      session_date: values.session_date,
      session_time: values.session_time || null,
      session_end_time: values.session_end_time || null,
      location: values.location || null,
      type: values.type || null,
      notes: values.notes || null,
    }),
  })

  if (res.ok) {
    const body = await res.json() as { data: { id: string; programme_year_id: string } }
    return Astro.redirect(`/admin/cmp/years/${body.data.programme_year_id}`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to create session.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}

const backUrl = preselectedYearId ? `/admin/cmp/years/${preselectedYearId}` : '/admin/cmp/years'
---

<DashboardLayout title="New Session">
  <div style="max-width: 600px;">
    <Breadcrumb crumbs={[{ label: 'CMP', href: '/admin/cmp' }, { label: 'New Session' }]} />
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 24px;">New Session</h1>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form method="POST" style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 20px;">

      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Programme year *</label>
        <select name="programme_year_id" required
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white;">
          <option value="">Select year…</option>
          {(years ?? []).map(y => (
            <option value={y.id} selected={values.programme_year_id === y.id}>{y.name as string}</option>
          ))}
        </select>
        {errors.programme_year_id && <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-danger-600); margin: 0;">{errors.programme_year_id}</p>}
      </div>

      <Input label="Title *" name="title" value={values.title} error={errors.title} required placeholder="e.g. Session 3 — CV Writing" />

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
        <Input label="Date *" name="session_date" type="date" value={values.session_date} error={errors.session_date} required />
        <Input label="Start time" name="session_time" type="time" value={values.session_time} error={errors.session_time} />
        <Input label="End time" name="session_end_time" type="time" value={values.session_end_time} error={errors.session_end_time} />
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <Input label="Location" name="location" value={values.location} error={errors.location} placeholder="e.g. Google HQ, London" />
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Type</label>
          <select name="type"
            style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white;">
            <option value="regular" selected={values.type === 'regular'}>Regular</option>
            <option value="special" selected={values.type === 'special'}>Special</option>
            <option value="trip" selected={values.type === 'trip'}>Trip</option>
          </select>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Notes</label>
        <textarea name="notes" rows={3} placeholder="Any details about the session…"
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; resize: vertical;">{values.notes ?? ''}</textarea>
      </div>

      <div style="display: flex; gap: 12px; padding-top: 8px;">
        <button type="submit" style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Create session
        </button>
        <a href={backUrl} style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
