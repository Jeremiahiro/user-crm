---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import Input from '@/components/ui/Input.astro'
import { supabaseAdmin } from '@/lib/supabase'

if (!Astro.locals.user) return Astro.redirect('/login')

// Pre-fill year from query param
const preselectedYearId = Astro.url.searchParams.get('year_id') ?? ''

const { data: years } = await supabaseAdmin
  .from('cmp_programme_years')
  .select('id, name')
  .order('start_date', { ascending: false })

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {
  programme_year_id: preselectedYearId,
  type: 'regular',
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries(form.entries()) as Record<string, string>

  const res = await fetch(`${Astro.url.origin}/api/cmp/sessions`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      programme_year_id: values.programme_year_id,
      title: values.title,
      session_date: values.session_date,
      session_time: values.session_time || null,
      session_end_time: values.session_end_time || null,
      location: values.location || null,
      type: values.type || null,
      notes: values.notes || null,
    }),
  })

  if (res.ok) {
    const body = await res.json() as { data: { id: string; programme_year_id: string } }
    return Astro.redirect(`/admin/cmp/years/${body.data.programme_year_id}`)
  } else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to create session.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, v[0] ?? '']))
  }
}

const backUrl = preselectedYearId ? `/admin/cmp/years/${preselectedYearId}` : '/admin/cmp/years'
---

<DashboardLayout title="New Session">
  <div class="max-w-150">
    <Breadcrumb crumbs={[{ label: 'CMP', href: '/admin/cmp' }, { label: 'New Session' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-6">New Session</h1>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">

      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Programme year *</label>
        <select name="programme_year_id" required
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm bg-white">
          <option value="">Select year…</option>
          {(years ?? []).map(y => (
            <option value={y.id} selected={values.programme_year_id === y.id}>{y.name as string}</option>
          ))}
        </select>
        {errors.programme_year_id && <p class="font-body text-xs text-danger-600 m-0">{errors.programme_year_id}</p>}
      </div>

      <Input label="Title *" name="title" value={values.title} error={errors.title} required placeholder="e.g. Session 3 — CV Writing" />

      <div class="grid grid-cols-3 gap-4">
        <Input label="Date *" name="session_date" type="date" value={values.session_date} error={errors.session_date} required />
        <Input label="Start time" name="session_time" type="time" value={values.session_time} error={errors.session_time} />
        <Input label="End time" name="session_end_time" type="time" value={values.session_end_time} error={errors.session_end_time} />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <Input label="Location" name="location" value={values.location} error={errors.location} placeholder="e.g. Google HQ, London" />
        <div class="flex flex-col gap-1">
          <label class="font-body text-[13px] font-medium text-neutral-700">Type</label>
          <select name="type"
            class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm bg-white">
            <option value="regular" selected={values.type === 'regular'}>Regular</option>
            <option value="special" selected={values.type === 'special'}>Special</option>
            <option value="trip" selected={values.type === 'trip'}>Trip</option>
          </select>
        </div>
      </div>

      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Notes</label>
        <textarea name="notes" rows={3} placeholder="Any details about the session…"
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm resize-y">{values.notes ?? ''}</textarea>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-5 py-2.5 bg-brand-navy text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
          Create session
        </button>
        <a href={backUrl} class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>
