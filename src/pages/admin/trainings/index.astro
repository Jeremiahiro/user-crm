---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin, getTeamLeadIds } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const personId = user.person_id ?? ''
const leadIds = admin ? new Set<string>() : await getTeamLeadIds(personId)
const isLead = admin || leadIds.size > 0

let trainings: any[] = []
if (admin || isLead) {
  const { data } = await supabaseAdmin
    .from('trainings')
    .select('id, title, description, external_url, requires_document, is_active, created_at, creator:people!created_by(full_name)')
    .eq('is_active', true)
    .order('created_at', { ascending: false })
  trainings = data ?? []
} else {
  const { data: assignments } = await supabaseAdmin
    .from('training_assignments')
    .select('training_id')
    .or(`person_id.eq.${personId},scope.eq.all`)
  const ids = [...new Set((assignments ?? []).map((a: any) => a.training_id))]
  if (ids.length > 0) {
    const { data } = await supabaseAdmin
      .from('trainings')
      .select('id, title, description, external_url, requires_document')
      .in('id', ids)
      .eq('is_active', true)
    trainings = data ?? []
  }
}

const { data: completions } = personId
  ? await supabaseAdmin.from('training_completions').select('training_id').eq('person_id', personId)
  : { data: [] }
const completedIds = new Set((completions ?? []).map((c: any) => c.training_id))
---

<DashboardLayout title="Trainings">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="font-heading text-2xl font-bold text-brand-navy mb-1">Trainings</h1>
      <p class="font-body text-sm text-neutral-500 m-0">{trainings.length} training{trainings.length !== 1 ? 's' : ''}</p>
    </div>
    {isLead && (
      <a href="/admin/trainings/new"
        class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
        + New Training
      </a>
    )}
  </div>

  {trainings.length === 0 ? (
    <div class="bg-white border border-neutral-200 rounded-lg p-12 text-center">
      <p class="font-body text-sm text-neutral-400 mb-4">No trainings available.</p>
      {isLead && (
        <a href="/admin/trainings/new"
          class="px-4.5 py-2.5 bg-brand-navy text-white rounded-md font-body text-sm font-semibold no-underline">
          Create first training
        </a>
      )}
    </div>
  ) : (
    <div class="grid grid-cols-[repeat(auto-fill,minmax(340px,1fr))] gap-4">
      {trainings.map((t: any) => (
        <div class="bg-white border border-neutral-200 rounded-lg p-[22px] flex flex-col gap-2.5">
          <!-- Title + badges -->
          <div class="flex items-start justify-between gap-2">
            <a href={`/admin/trainings/${t.id}`}
              class="font-heading text-[15px] font-bold text-brand-navy no-underline leading-[1.3]">
              {t.title}
            </a>
            {completedIds.has(t.id) && (
              <span class="shrink-0 inline-block px-2 py-0.5 rounded-full font-body text-[11px] font-semibold bg-success-50 text-success-700 border border-success-100">
                Completed &#10003;
              </span>
            )}
          </div>

          <!-- Description -->
          {t.description && (
            <p class="font-body text-[13px] text-neutral-600 m-0 line-clamp-2 leading-normal">
              {t.description}
            </p>
          )}

          <!-- Badges row -->
          <div class="flex gap-1.5 flex-wrap">
            {t.requires_document && (
              <span class="inline-block px-2 py-0.5 rounded-full font-body text-[11px] font-medium bg-warning-50 text-warning-800 border border-warning-300">
                Requires document
              </span>
            )}
          </div>

          <!-- Footer -->
          <div class="flex items-center justify-between pt-1.5 border-t border-neutral-100">
            <div class="flex gap-3 items-center">
              {t.external_url && (
                <a href={t.external_url} target="_blank" rel="noopener noreferrer"
                  class="font-body text-xs text-brand-navy no-underline font-medium">
                  Open &#8599;
                </a>
              )}
              {isLead && (
                <a href={`/admin/trainings/${t.id}/edit`}
                  class="font-body text-xs text-neutral-500 no-underline">
                  Edit
                </a>
              )}
            </div>
            {isLead && t.creator && (
              <span class="font-body text-[11px] text-neutral-400">by {(t.creator as any).full_name}</span>
            )}
          </div>
        </div>
      ))}
    </div>
  )}
</DashboardLayout>
