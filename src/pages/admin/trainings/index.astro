---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin, getTeamLeadIds } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const personId = user.person_id ?? ''
const leadIds = admin ? new Set<string>() : await getTeamLeadIds(personId)
const isLead = admin || leadIds.size > 0

let trainings: any[] = []
if (admin || isLead) {
  const { data } = await supabaseAdmin
    .from('trainings')
    .select('id, title, description, external_url, requires_document, is_active, created_at, creator:people!created_by(full_name)')
    .eq('is_active', true)
    .order('created_at', { ascending: false })
  trainings = data ?? []
} else {
  const { data: assignments } = await supabaseAdmin
    .from('training_assignments')
    .select('training_id')
    .or(`person_id.eq.${personId},scope.eq.all`)
  const ids = [...new Set((assignments ?? []).map((a: any) => a.training_id))]
  if (ids.length > 0) {
    const { data } = await supabaseAdmin
      .from('trainings')
      .select('id, title, description, external_url, requires_document')
      .in('id', ids)
      .eq('is_active', true)
    trainings = data ?? []
  }
}

const { data: completions } = personId
  ? await supabaseAdmin.from('training_completions').select('training_id').eq('person_id', personId)
  : { data: [] }
const completedIds = new Set((completions ?? []).map((c: any) => c.training_id))
---

<DashboardLayout title="Trainings">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
    <div>
      <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 4px;">Trainings</h1>
      <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-500); margin: 0;">{trainings.length} training{trainings.length !== 1 ? 's' : ''}</p>
    </div>
    {isLead && (
      <a href="/admin/trainings/new"
        style="padding: 10px 18px; background-color: var(--color-brand-navy); color: white; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
        + New Training
      </a>
    )}
  </div>

  {trainings.length === 0 ? (
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 48px; text-align: center;">
      <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-400); margin: 0 0 16px;">No trainings available.</p>
      {isLead && (
        <a href="/admin/trainings/new"
          style="padding: 10px 18px; background-color: var(--color-brand-navy); color: white; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; text-decoration: none;">
          Create first training
        </a>
      )}
    </div>
  ) : (
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px;">
      {trainings.map((t: any) => (
        <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 22px; display: flex; flex-direction: column; gap: 10px;">
          <!-- Title + badges -->
          <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;">
            <a href={`/admin/trainings/${t.id}`}
              style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-brand-navy); text-decoration: none; line-height: 1.3;">
              {t.title}
            </a>
            {completedIds.has(t.id) && (
              <span style="flex-shrink: 0; display: inline-block; padding: 2px 8px; border-radius: var(--radius-full); font-family: var(--font-body); font-size: 11px; font-weight: 600; background-color: var(--color-success-50); color: var(--color-success-700); border: 1px solid var(--color-success-100);">
                Completed &#10003;
              </span>
            )}
          </div>

          <!-- Description -->
          {t.description && (
            <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600); margin: 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; line-height: 1.5;">
              {t.description}
            </p>
          )}

          <!-- Badges row -->
          <div style="display: flex; gap: 6px; flex-wrap: wrap;">
            {t.requires_document && (
              <span style="display: inline-block; padding: 2px 8px; border-radius: var(--radius-full); font-family: var(--font-body); font-size: 11px; font-weight: 500; background-color: var(--color-warning-50); color: var(--color-warning-800); border: 1px solid var(--color-warning-300);">
                Requires document
              </span>
            )}
          </div>

          <!-- Footer -->
          <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 6px; border-top: 1px solid var(--color-neutral-100);">
            <div style="display: flex; gap: 12px; align-items: center;">
              {t.external_url && (
                <a href={t.external_url} target="_blank" rel="noopener noreferrer"
                  style="font-family: var(--font-body); font-size: 12px; color: var(--color-brand-navy); text-decoration: none; font-weight: 500;">
                  Open &#8599;
                </a>
              )}
              {isLead && (
                <a href={`/admin/trainings/${t.id}/edit`}
                  style="font-family: var(--font-body); font-size: 12px; color: var(--color-neutral-500); text-decoration: none;">
                  Edit
                </a>
              )}
            </div>
            {isLead && t.creator && (
              <span style="font-family: var(--font-body); font-size: 11px; color: var(--color-neutral-400);">by {(t.creator as any).full_name}</span>
            )}
          </div>
        </div>
      ))}
    </div>
  )}
</DashboardLayout>
