---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin, getTeamLeadIds } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const leadIds = admin ? new Set<string>(['x']) : await getTeamLeadIds(user.person_id ?? '')
if (!admin && leadIds.size === 0) return Astro.redirect('/admin/trainings')

const { data: docTypes } = await supabaseAdmin
  .from('document_types')
  .select('id, name')
  .eq('is_active', true)
  .order('sort_order')
  .order('name')

let errors: Record<string, string> = {}
let globalError = ''
let values: Record<string, string> = {}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = Object.fromEntries([...form.entries()].map(([k, v]) => [k, v as string]))
  const res = await fetch(`${Astro.url.origin}/api/trainings`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
    body: JSON.stringify({
      title: values.title,
      description: values.description || null,
      requires_document: values.requires_document === 'on',
      expected_document_type_id: values.expected_document_type_id || null,
    }),
  })
  if (res.ok) return Astro.redirect('/admin/trainings')
  else {
    const body = await res.json() as { error?: string; issues?: { fieldErrors?: Record<string, string[]> } }
    globalError = body.error ?? 'Failed to create training.'
    errors = Object.fromEntries(Object.entries(body.issues?.fieldErrors ?? {}).map(([k, v]) => [k, (v as string[])[0] ?? '']))
  }
}

const safeDocTypes = docTypes ?? []
---

<style>
  [x-cloak] { display: none !important; }
  .col-field { display: flex; flex-direction: column; gap: 4px; }
</style>

<DashboardLayout title="New Training">
  <div class="max-w-[600px]">
    <Breadcrumb crumbs={[{ label: 'Trainings', href: '/admin/trainings' }, { label: 'New Training' }]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0 mb-6">New Training</h1>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" x-data={`{ requiresDoc: ${values.requires_document === 'on'} }`} class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">

      <!-- Title -->
      <div class="flex flex-col gap-1">
        <label for="titleInput" class="font-body text-[13px] font-medium text-neutral-700">Title *</label>
        <input id="titleInput" name="title" type="text" required value={values.title ?? ''}
          class={`px-3 py-2.5 border rounded-md font-body text-sm text-neutral-800 ${errors.title ? 'border-danger-600' : 'border-neutral-300'}`} />
        {errors.title && <p class="font-body text-xs text-danger-600 m-0">{errors.title}</p>}
      </div>

      <!-- Description (CKEditor) -->
      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Description</label>
        <input type="hidden" name="description" id="descriptionInput" value={values.description ?? ''} />
        <div id="descriptionEditor" class="min-h-[200px]"></div>
      </div>

      <!-- Requires document checkbox -->
      <div class="flex items-center gap-2.5">
        <input id="requiresDocCheck" name="requires_document" type="checkbox" x-model="requiresDoc"
          checked={values.requires_document === 'on'}
          class="w-4 h-4 cursor-pointer" />
        <label for="requiresDocCheck" class="font-body text-sm text-neutral-700 cursor-pointer">Requires document upload</label>
      </div>

      <!-- Expected document type (conditional) -->
      <div class="col-field" x-show="requiresDoc" style={values.requires_document === 'on' ? '' : 'display: none;'}>
        <label for="docTypeSelect" class="font-body text-[13px] font-medium text-neutral-700">Expected document type</label>
        <select id="docTypeSelect" name="expected_document_type_id"
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm bg-white text-neutral-800">
          <option value="">Any type</option>
          {safeDocTypes.map((dt: any) => (
            <option value={dt.id} selected={values.expected_document_type_id === dt.id}>{dt.name}</option>
          ))}
        </select>
      </div>

      <!-- Actions -->
      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="px-5 py-2.5 bg-brand-navy text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">
          Create training
        </button>
        <a href="/admin/trainings"
          class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>
  </div>
</DashboardLayout>

<script is:inline>
  // CKEditor
  var ckScript = document.createElement('script')
  ckScript.src = 'https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js'
  ckScript.onload = function() {
    ClassicEditor.create(document.getElementById('descriptionEditor'), {
      toolbar: ['heading', '|', 'bold', 'italic', 'link', '|', 'bulletedList', 'numberedList', '|', 'blockQuote', '|', 'undo', 'redo'],
    }).then(function(editor) {
      window._trainingEditor = editor
      var initial = document.getElementById('descriptionInput').value
      if (initial) editor.setData(initial)
    })
  }
  document.head.appendChild(ckScript)

  // Sync editor content to hidden input on submit
  document.querySelector('form[method="POST"]').addEventListener('submit', function() {
    if (window._trainingEditor) {
      document.getElementById('descriptionInput').value = window._trainingEditor.getData()
    }
  })
</script>
