---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const trainingId = Astro.params.id ?? ''

const { data: training } = await supabaseAdmin.from('trainings').select('*').eq('id', trainingId).single()
if (!training) return Astro.redirect('/admin/trainings')

if (!admin && (training as any).created_by !== user.person_id) return Astro.redirect(`/admin/trainings/${trainingId}`)

const { data: docTypes } = await supabaseAdmin
  .from('document_types')
  .select('id, name')
  .eq('is_active', true)
  .order('sort_order')
  .order('name')

let globalError = ''
let errors: Record<string, string> = {}
let values: any = training

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = { ...training, ...Object.fromEntries([...form.entries()].map(([k, v]) => [k, v as string])) }
  const _action = form.get('_action')
  if (_action === 'archive') {
    const res = await fetch(`${Astro.url.origin}/api/trainings/${trainingId}`, {
      method: 'DELETE',
      headers: { Cookie: Astro.request.headers.get('cookie') ?? '' },
    })
    if (res.ok) return Astro.redirect('/admin/trainings')
    else { const b = await res.json() as any; globalError = b.error ?? 'Cannot archive.' }
  } else {
    const res = await fetch(`${Astro.url.origin}/api/trainings/${trainingId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({
        title: values.title,
        description: values.description || null,
        requires_document: values.requires_document === 'on' || values.requires_document === true,
        expected_document_type_id: values.expected_document_type_id || null,
      }),
    })
    if (res.ok) return Astro.redirect(`/admin/trainings/${trainingId}`)
    else {
      const b = await res.json() as any
      globalError = b.error ?? 'Failed to update.'
      errors = Object.fromEntries(Object.entries(b.issues?.fieldErrors ?? {}).map(([k, v]) => [k, (v as string[])[0] ?? '']))
    }
  }
}

const safeDocTypes = docTypes ?? []
const t = values as any
const requiresDocInitial = t.requires_document === true || t.requires_document === 'on'
---

<style>
  [x-cloak] { display: none !important; }
</style>

<DashboardLayout title={`Edit — ${t.title}`}>
  <div class="max-w-150" x-data={`{
    archiveModal: { open: false },
    async doArchive() {
      const form = document.createElement('form')
      form.method = 'POST'
      form.innerHTML = '<input name="_action" value="archive">'
      document.body.appendChild(form)
      form.submit()
    }
  }`}>
    <Breadcrumb crumbs={[
      { label: 'Trainings', href: '/admin/trainings' },
      { label: t.title, href: `/admin/trainings/${trainingId}` },
      { label: 'Edit' },
    ]} />
    <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0 mb-6">Edit Training</h1>

    {globalError && (
      <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-5 font-body text-sm text-danger-700">
        {globalError}
      </div>
    )}

    <form method="POST" id="editForm" x-data={`{ requiresDoc: ${requiresDocInitial} }`} class="bg-white border border-neutral-200 rounded-lg p-8 flex flex-col gap-5">

      <!-- Title -->
      <div class="flex flex-col gap-1">
        <label for="titleInput" class="font-body text-[13px] font-medium text-neutral-700">Title *</label>
        <input id="titleInput" name="title" type="text" required value={t.title ?? ''}
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm text-neutral-800" />
        {errors.title && <p class="font-body text-xs text-danger-600 m-0">{errors.title}</p>}
      </div>

      <!-- Description (CKEditor) -->
      <div class="flex flex-col gap-1">
        <label class="font-body text-[13px] font-medium text-neutral-700">Description</label>
        <input type="hidden" name="description" id="descriptionInput" value={t.description ?? ''} />
        <div id="descriptionEditor" class="min-h-50"></div>
      </div>

      <!-- Requires document -->
      <div class="flex items-center gap-2.5">
        <input id="requiresDocCheck" name="requires_document" type="checkbox" x-model="requiresDoc"
          checked={requiresDocInitial}
          class="w-4 h-4 cursor-pointer" />
        <label for="requiresDocCheck" class="font-body text-sm text-neutral-700 cursor-pointer">Requires document upload</label>
      </div>

      <!-- Expected document type (conditional) -->
      <div class="flex flex-col gap-1" x-show="requiresDoc" style={requiresDocInitial ? '' : 'display: none;'}>
        <label for="docTypeSelect" class="font-body text-[13px] font-medium text-neutral-700">Expected document type</label>
        <select id="docTypeSelect" name="expected_document_type_id"
          class="px-3 py-2.5 border border-neutral-300 rounded-md font-body text-sm bg-white text-neutral-800">
          <option value="">Any type</option>
          {safeDocTypes.map((dt: any) => (
            <option value={dt.id} selected={t.expected_document_type_id === dt.id}>{dt.name}</option>
          ))}
        </select>
      </div>

      <!-- Actions -->
      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="px-5 py-2.5 bg-brand-navy text-white border-none rounded-md font-body text-sm font-semibold cursor-pointer">
          Save changes
        </button>
        <a href={`/admin/trainings/${trainingId}`}
          class="px-5 py-2.5 bg-neutral-100 text-neutral-700 rounded-md font-body text-sm font-medium no-underline">
          Cancel
        </a>
      </div>
    </form>

    <!-- Archive section -->
    <div class="bg-white border border-danger-200 rounded-lg p-6 mt-6">
      <h2 class="font-heading text-sm font-bold text-danger-700 m-0 mb-2">Danger zone</h2>
      <p class="font-body text-[13px] text-neutral-600 m-0 mb-3.5">Archiving a training hides it from the list and prevents new completions. This cannot be easily undone.</p>
      <button type="button" @click="archiveModal.open = true"
        class="px-4.5 py-2.25 bg-danger-600 text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer">
        Archive training
      </button>
    </div>

    <!-- Archive confirm modal -->
    <div x-show="archiveModal.open" x-cloak @click="archiveModal.open = false"
      class="fixed inset-0 bg-[rgba(0,0,0,0.45)] z-1000 flex items-center justify-center">
      <div @click.stop class="bg-white rounded-lg px-8 py-7 max-w-95 w-[90%] shadow-[0_20px_60px_rgba(0,0,0,0.2)]">
        <p class="font-body text-sm font-semibold text-neutral-800 m-0 mb-1.5">Archive this training?</p>
        <p class="font-body text-[13px] text-neutral-600 m-0 mb-5 leading-normal">It will no longer appear in the list and new completions will be prevented.</p>
        <div class="flex gap-2.5 justify-end">
          <button @click="archiveModal.open = false"
            class="px-4 py-2 bg-neutral-100 border border-neutral-200 rounded-md font-body text-[13px] font-medium cursor-pointer text-neutral-700">
            Cancel
          </button>
          <button @click="doArchive()"
            class="px-4 py-2 bg-danger-600 text-white border-none rounded-md font-body text-[13px] font-semibold cursor-pointer">
            Archive
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  // CKEditor
  var ckScript = document.createElement('script')
  ckScript.src = 'https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js'
  ckScript.onload = function() {
    ClassicEditor.create(document.getElementById('descriptionEditor'), {
      toolbar: ['heading', '|', 'bold', 'italic', 'link', '|', 'bulletedList', 'numberedList', '|', 'blockQuote', '|', 'undo', 'redo'],
    }).then(function(editor) {
      window._trainingEditor = editor
      var initial = document.getElementById('descriptionInput').value
      if (initial) editor.setData(initial)
    })
  }
  document.head.appendChild(ckScript)

  // Sync editor content to hidden input on submit
  document.getElementById('editForm').addEventListener('submit', function() {
    if (window._trainingEditor) {
      document.getElementById('descriptionInput').value = window._trainingEditor.getData()
    }
  })
</script>
