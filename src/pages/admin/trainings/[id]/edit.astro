---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const trainingId = Astro.params.id ?? ''

const { data: training } = await supabaseAdmin.from('trainings').select('*').eq('id', trainingId).single()
if (!training) return Astro.redirect('/admin/trainings')

if (!admin && (training as any).created_by !== user.person_id) return Astro.redirect(`/admin/trainings/${trainingId}`)

const { data: docTypes } = await supabaseAdmin
  .from('document_types')
  .select('id, name')
  .eq('is_active', true)
  .order('sort_order')
  .order('name')

let globalError = ''
let errors: Record<string, string> = {}
let values: any = training

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  values = { ...training, ...Object.fromEntries([...form.entries()].map(([k, v]) => [k, v as string])) }
  const _action = form.get('_action')
  if (_action === 'archive') {
    const res = await fetch(`${Astro.url.origin}/api/trainings/${trainingId}`, {
      method: 'DELETE',
      headers: { Cookie: Astro.request.headers.get('cookie') ?? '' },
    })
    if (res.ok) return Astro.redirect('/admin/trainings')
    else { const b = await res.json() as any; globalError = b.error ?? 'Cannot archive.' }
  } else {
    const res = await fetch(`${Astro.url.origin}/api/trainings/${trainingId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({
        title: values.title,
        description: values.description || null,
        requires_document: values.requires_document === 'on' || values.requires_document === true,
        expected_document_type_id: values.expected_document_type_id || null,
      }),
    })
    if (res.ok) return Astro.redirect(`/admin/trainings/${trainingId}`)
    else {
      const b = await res.json() as any
      globalError = b.error ?? 'Failed to update.'
      errors = Object.fromEntries(Object.entries(b.issues?.fieldErrors ?? {}).map(([k, v]) => [k, (v as string[])[0] ?? '']))
    }
  }
}

const safeDocTypes = docTypes ?? []
const t = values as any
const requiresDocInitial = t.requires_document === true || t.requires_document === 'on'
---

<style>
  [x-cloak] { display: none !important; }
  .col-field { display: flex; flex-direction: column; gap: 4px; }
</style>

<DashboardLayout title={`Edit — ${t.title}`}>
  <div style="max-width: 600px;" x-data={`{
    archiveModal: { open: false },
    async doArchive() {
      const form = document.createElement('form')
      form.method = 'POST'
      form.innerHTML = '<input name="_action" value="archive">'
      document.body.appendChild(form)
      form.submit()
    }
  }`}>
    <Breadcrumb crumbs={[
      { label: 'Trainings', href: '/admin/trainings' },
      { label: t.title, href: `/admin/trainings/${trainingId}` },
      { label: 'Edit' },
    ]} />
    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 24px;">Edit Training</h1>

    {globalError && (
      <div style="background-color: var(--color-danger-50); border: 1px solid var(--color-danger-200); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; font-family: var(--font-body); font-size: 14px; color: var(--color-danger-700);">
        {globalError}
      </div>
    )}

    <form method="POST" id="editForm" x-data={`{ requiresDoc: ${requiresDocInitial} }`} style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 20px;">

      <!-- Title -->
      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label for="titleInput" style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Title *</label>
        <input id="titleInput" name="title" type="text" required value={t.title ?? ''}
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-800);" />
        {errors.title && <p style="font-family: var(--font-body); font-size: 12px; color: var(--color-danger-600); margin: 0;">{errors.title}</p>}
      </div>

      <!-- Description (CKEditor) -->
      <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Description</label>
        <input type="hidden" name="description" id="descriptionInput" value={t.description ?? ''} />
        <div id="descriptionEditor" style="min-height: 200px;"></div>
      </div>

      <!-- Requires document -->
      <div style="display: flex; align-items: center; gap: 10px;">
        <input id="requiresDocCheck" name="requires_document" type="checkbox" x-model="requiresDoc"
          checked={requiresDocInitial}
          style="width: 16px; height: 16px; cursor: pointer;" />
        <label for="requiresDocCheck" style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-700); cursor: pointer;">Requires document upload</label>
      </div>

      <!-- Expected document type (conditional) -->
      <div class="col-field" x-show="requiresDoc" style={requiresDocInitial ? '' : 'display: none;'}>
        <label for="docTypeSelect" style="font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--color-neutral-700);">Expected document type</label>
        <select id="docTypeSelect" name="expected_document_type_id"
          style="padding: 10px 12px; border: 1px solid var(--color-neutral-300); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; background: white; color: var(--color-neutral-800);">
          <option value="">Any type</option>
          {safeDocTypes.map((dt: any) => (
            <option value={dt.id} selected={t.expected_document_type_id === dt.id}>{dt.name}</option>
          ))}
        </select>
      </div>

      <!-- Actions -->
      <div style="display: flex; gap: 12px; padding-top: 8px;">
        <button type="submit"
          style="padding: 10px 20px; background-color: var(--color-brand-navy); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 600; cursor: pointer;">
          Save changes
        </button>
        <a href={`/admin/trainings/${trainingId}`}
          style="padding: 10px 20px; background-color: var(--color-neutral-100); color: var(--color-neutral-700); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 14px; font-weight: 500; text-decoration: none;">
          Cancel
        </a>
      </div>
    </form>

    <!-- Archive section -->
    <div style="background: white; border: 1px solid var(--color-danger-200); border-radius: var(--radius-lg); padding: 24px; margin-top: 24px;">
      <h2 style="font-family: var(--font-heading); font-size: 14px; font-weight: 700; color: var(--color-danger-700); margin: 0 0 8px;">Danger zone</h2>
      <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600); margin: 0 0 14px;">Archiving a training hides it from the list and prevents new completions. This cannot be easily undone.</p>
      <button type="button" @click="archiveModal.open = true"
        style="padding: 9px 18px; background-color: var(--color-danger-600); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
        Archive training
      </button>
    </div>

    <!-- Archive confirm modal -->
    <div x-show="archiveModal.open" x-cloak @click="archiveModal.open = false"
      style="position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1000; display: flex; align-items: center; justify-content: center;">
      <div @click.stop style="background: white; border-radius: var(--radius-lg); padding: 28px 32px; max-width: 380px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.2);">
        <p style="font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--color-neutral-800); margin: 0 0 6px;">Archive this training?</p>
        <p style="font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600); margin: 0 0 20px; line-height: 1.5;">It will no longer appear in the list and new completions will be prevented.</p>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
          <button @click="archiveModal.open = false"
            style="padding: 8px 16px; background: var(--color-neutral-100); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; color: var(--color-neutral-700);">
            Cancel
          </button>
          <button @click="doArchive()"
            style="padding: 8px 16px; background: var(--color-danger-600); color: white; border: none; border-radius: var(--radius-md); font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer;">
            Archive
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  // CKEditor
  var ckScript = document.createElement('script')
  ckScript.src = 'https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js'
  ckScript.onload = function() {
    ClassicEditor.create(document.getElementById('descriptionEditor'), {
      toolbar: ['heading', '|', 'bold', 'italic', 'link', '|', 'bulletedList', 'numberedList', '|', 'blockQuote', '|', 'undo', 'redo'],
    }).then(function(editor) {
      window._trainingEditor = editor
      var initial = document.getElementById('descriptionInput').value
      if (initial) editor.setData(initial)
    })
  }
  document.head.appendChild(ckScript)

  // Sync editor content to hidden input on submit
  document.getElementById('editForm').addEventListener('submit', function() {
    if (window._trainingEditor) {
      document.getElementById('descriptionInput').value = window._trainingEditor.getData()
    }
  })
</script>
