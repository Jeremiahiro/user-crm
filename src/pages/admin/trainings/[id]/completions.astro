---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin, getTeamLeadIds } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const trainingId = Astro.params.id ?? ''
const leadIds = admin ? new Set<string>() : await getTeamLeadIds(user.person_id ?? '')
if (!admin && leadIds.size === 0) return Astro.redirect('/admin/trainings')

const { data: training } = await supabaseAdmin.from('trainings').select('id, title').eq('id', trainingId).single()
if (!training) return Astro.redirect('/admin/trainings')

const res = await fetch(`${Astro.url.origin}/api/trainings/${trainingId}/completions`, {
  headers: { Cookie: Astro.request.headers.get('cookie') ?? '' },
})
const body = (await res.json()) as { data?: any[] }
const report: any[] = body.data ?? []

const total = report.length
const completed = report.filter((r: any) => r.status === 'complete').length
const overdue = report.filter((r: any) => r.status === 'overdue').length
const pending = report.filter((r: any) => r.status === 'pending').length

function fmt(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

const STATUS_CLASSES: Record<string, string> = {
  complete: 'bg-success-50 text-success-700 border border-success-100',
  pending: 'bg-neutral-100 text-neutral-600 border border-neutral-200',
  overdue: 'bg-danger-50 text-danger-700 border border-danger-100',
}

const t = training as any
---

<DashboardLayout title={`${t.title} — Completions`}>
  <div class="max-w-[960px]">
    <Breadcrumb crumbs={[
      { label: 'Trainings', href: '/admin/trainings' },
      { label: t.title, href: `/admin/trainings/${trainingId}` },
      { label: 'Completions' },
    ]} />

    <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-6">{t.title} — Completions</h1>

    <!-- Stat cards -->
    <div class="grid grid-cols-4 gap-4 mb-7">
      <div class="bg-white border border-success-100 rounded-lg py-[18px] px-5">
        <p class="font-body text-[11px] font-semibold text-success-700 uppercase tracking-[0.05em] mb-1">Completed</p>
        <p class="font-heading text-[28px] font-bold text-success-700 m-0">{completed}</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-lg py-[18px] px-5">
        <p class="font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.05em] mb-1">Pending</p>
        <p class="font-heading text-[28px] font-bold text-neutral-700 m-0">{pending}</p>
      </div>
      <div class="bg-white border border-danger-100 rounded-lg py-[18px] px-5">
        <p class="font-body text-[11px] font-semibold text-danger-700 uppercase tracking-[0.05em] mb-1">Overdue</p>
        <p class="font-heading text-[28px] font-bold text-danger-700 m-0">{overdue}</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-lg py-[18px] px-5">
        <p class="font-body text-[11px] font-semibold text-neutral-500 uppercase tracking-[0.05em] mb-1">Total assigned</p>
        <p class="font-heading text-[28px] font-bold text-neutral-800 m-0">{total}</p>
      </div>
    </div>

    <!-- Table -->
    <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
      {report.length === 0 ? (
        <div class="p-12 text-center">
          <p class="font-body text-sm text-neutral-400 m-0">No assignments found for this training.</p>
        </div>
      ) : (
        <table class="w-full border-collapse">
          <thead class="bg-neutral-50 border-b border-neutral-200">
            <tr>
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Name</th>
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Email</th>
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Teams</th>
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Status</th>
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Deadline</th>
              <th class="font-body text-xs font-semibold text-neutral-500 text-left px-4 py-2.5 uppercase tracking-[0.05em]">Days overdue</th>
            </tr>
          </thead>
          <tbody>
            {report.map((r: any, i: number) => {
              const daysOverdue = r.status === 'overdue' && r.deadline
                ? Math.floor((Date.now() - new Date(r.deadline).getTime()) / (1000 * 60 * 60 * 24))
                : null
              return (
                <tr class={i > 0 ? 'border-t border-neutral-100' : ''}>
                  <td class="px-4 py-3.5">
                    <a href={`/admin/members/${r.person_id}`}
                      class="font-body text-sm font-medium text-brand-navy no-underline">
                      {r.full_name ?? '—'}
                    </a>
                  </td>
                  <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600">{r.email ?? '—'}</td>
                  <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600">
                    {Array.isArray(r.teams) ? r.teams.join(', ') : (r.teams ?? '—')}
                  </td>
                  <td class="px-4 py-3.5">
                    <span
                      class={`inline-block py-0.5 px-2.5 rounded-full font-body text-xs font-semibold ${STATUS_CLASSES[r.status] ?? 'bg-neutral-100 text-neutral-700 border border-neutral-200'}`}>
                      {r.status.charAt(0).toUpperCase() + r.status.slice(1)}
                    </span>
                  </td>
                  <td class="px-4 py-3.5 font-body text-[13px] text-neutral-600">{fmt(r.deadline)}</td>
                  <td class="px-4 py-3.5 font-body text-[13px] text-danger-700 font-medium">
                    {daysOverdue !== null ? `${daysOverdue}d` : '—'}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      )}
    </div>
  </div>
</DashboardLayout>
