---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin, getTeamLeadIds } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const trainingId = Astro.params.id ?? ''
const leadIds = admin ? new Set<string>() : await getTeamLeadIds(user.person_id ?? '')
if (!admin && leadIds.size === 0) return Astro.redirect('/admin/trainings')

const { data: training } = await supabaseAdmin.from('trainings').select('id, title').eq('id', trainingId).single()
if (!training) return Astro.redirect('/admin/trainings')

const res = await fetch(`${Astro.url.origin}/api/trainings/${trainingId}/completions`, {
  headers: { Cookie: Astro.request.headers.get('cookie') ?? '' },
})
const body = (await res.json()) as { data?: any[] }
const report: any[] = body.data ?? []

const total = report.length
const completed = report.filter((r: any) => r.status === 'complete').length
const overdue = report.filter((r: any) => r.status === 'overdue').length
const pending = report.filter((r: any) => r.status === 'pending').length

function fmt(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

const STATUS_BG: Record<string, string> = {
  complete: 'var(--color-success-50)',
  pending: 'var(--color-neutral-100)',
  overdue: 'var(--color-danger-50)',
}
const STATUS_COLOR: Record<string, string> = {
  complete: 'var(--color-success-700)',
  pending: 'var(--color-neutral-600)',
  overdue: 'var(--color-danger-700)',
}
const STATUS_BORDER: Record<string, string> = {
  complete: 'var(--color-success-100)',
  pending: 'var(--color-neutral-200)',
  overdue: 'var(--color-danger-100)',
}

const t = training as any
---

<DashboardLayout title={`${t.title} — Completions`}>
  <div style="max-width: 960px;">
    <Breadcrumb crumbs={[
      { label: 'Trainings', href: '/admin/trainings' },
      { label: t.title, href: `/admin/trainings/${trainingId}` },
      { label: 'Completions' },
    ]} />

    <h1 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-brand-navy); margin: 0 0 24px;">{t.title} — Completions</h1>

    <!-- Stat cards -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px;">
      <div style="background: white; border: 1px solid var(--color-success-100); border-radius: var(--radius-lg); padding: 18px 20px;">
        <p style="font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-success-700); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 4px;">Completed</p>
        <p style="font-family: var(--font-heading); font-size: 28px; font-weight: 700; color: var(--color-success-700); margin: 0;">{completed}</p>
      </div>
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 18px 20px;">
        <p style="font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 4px;">Pending</p>
        <p style="font-family: var(--font-heading); font-size: 28px; font-weight: 700; color: var(--color-neutral-700); margin: 0;">{pending}</p>
      </div>
      <div style="background: white; border: 1px solid var(--color-danger-100); border-radius: var(--radius-lg); padding: 18px 20px;">
        <p style="font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-danger-700); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 4px;">Overdue</p>
        <p style="font-family: var(--font-heading); font-size: 28px; font-weight: 700; color: var(--color-danger-700); margin: 0;">{overdue}</p>
      </div>
      <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: 18px 20px;">
        <p style="font-family: var(--font-body); font-size: 11px; font-weight: 600; color: var(--color-neutral-500); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 4px;">Total assigned</p>
        <p style="font-family: var(--font-heading); font-size: 28px; font-weight: 700; color: var(--color-neutral-800); margin: 0;">{total}</p>
      </div>
    </div>

    <!-- Table -->
    <div style="background: white; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); overflow: hidden;">
      {report.length === 0 ? (
        <div style="padding: 48px; text-align: center;">
          <p style="font-family: var(--font-body); font-size: 14px; color: var(--color-neutral-400); margin: 0;">No assignments found for this training.</p>
        </div>
      ) : (
        <table style="width: 100%; border-collapse: collapse;">
          <thead style="background-color: var(--color-neutral-50); border-bottom: 1px solid var(--color-neutral-200);">
            <tr>
              <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: left; padding: 10px 16px; text-transform: uppercase; letter-spacing: 0.05em;">Name</th>
              <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: left; padding: 10px 16px; text-transform: uppercase; letter-spacing: 0.05em;">Email</th>
              <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: left; padding: 10px 16px; text-transform: uppercase; letter-spacing: 0.05em;">Teams</th>
              <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: left; padding: 10px 16px; text-transform: uppercase; letter-spacing: 0.05em;">Status</th>
              <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: left; padding: 10px 16px; text-transform: uppercase; letter-spacing: 0.05em;">Deadline</th>
              <th style="font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-neutral-500); text-align: left; padding: 10px 16px; text-transform: uppercase; letter-spacing: 0.05em;">Days overdue</th>
            </tr>
          </thead>
          <tbody>
            {report.map((r: any, i: number) => {
              const bg = STATUS_BG[r.status] ?? 'var(--color-neutral-100)'
              const color = STATUS_COLOR[r.status] ?? 'var(--color-neutral-700)'
              const border = STATUS_BORDER[r.status] ?? 'var(--color-neutral-200)'
              const daysOverdue = r.status === 'overdue' && r.deadline
                ? Math.floor((Date.now() - new Date(r.deadline).getTime()) / (1000 * 60 * 60 * 24))
                : null
              return (
                <tr style={i > 0 ? 'border-top: 1px solid var(--color-neutral-100);' : ''}>
                  <td style="padding: 14px 16px;">
                    <a href={`/admin/members/${r.person_id}`}
                      style="font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--color-brand-navy); text-decoration: none;">
                      {r.full_name ?? '—'}
                    </a>
                  </td>
                  <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600);">{r.email ?? '—'}</td>
                  <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600);">
                    {Array.isArray(r.teams) ? r.teams.join(', ') : (r.teams ?? '—')}
                  </td>
                  <td style="padding: 14px 16px;">
                    <span style={`display: inline-block; padding: 2px 10px; border-radius: var(--radius-full); font-family: var(--font-body); font-size: 12px; font-weight: 600; background-color: ${bg}; color: ${color}; border: 1px solid ${border};`}>
                      {r.status.charAt(0).toUpperCase() + r.status.slice(1)}
                    </span>
                  </td>
                  <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-neutral-600);">{fmt(r.deadline)}</td>
                  <td style="padding: 14px 16px; font-family: var(--font-body); font-size: 13px; color: var(--color-danger-700); font-weight: 500;">
                    {daysOverdue !== null ? `${daysOverdue}d` : '—'}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      )}
    </div>
  </div>
</DashboardLayout>
