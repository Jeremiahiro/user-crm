---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import Breadcrumb from '@/components/ui/Breadcrumb.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin, getTeamLeadIds } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
const admin = isAdmin(user)
const personId = user.person_id ?? ''
const trainingId = Astro.params.id ?? ''
const leadIds = admin ? new Set<string>() : await getTeamLeadIds(personId)
const isLead = admin || leadIds.size > 0

const { data: training } = await supabaseAdmin
  .from('trainings')
  .select('*, creator:people!created_by(full_name), expected_document_type:document_types(id, name, slug)')
  .eq('id', trainingId)
  .single()
if (!training) return Astro.redirect('/admin/trainings')

const { data: myCompletion } = personId
  ? await supabaseAdmin.from('training_completions').select('*').eq('training_id', trainingId).eq('person_id', personId).maybeSingle()
  : { data: null }

let assignments: any[] = []
if (isLead) {
  const { data } = await supabaseAdmin
    .from('training_assignments')
    .select('id, scope, team_id, person_id, deadline, team:teams(name), assignee:people!person_id(full_name)')
    .eq('training_id', trainingId)
  assignments = data ?? []
}

let teams: any[] = []
if (isLead) {
  let tq = supabaseAdmin.from('teams').select('id, name').eq('is_active', true).order('name')
  if (!admin && leadIds.size > 0) tq = tq.in('id', [...leadIds])
  const { data } = await tq
  teams = data ?? []
}

let completeError = ''
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = form.get('_action') as string
  if (action === 'complete') {
    const res = await fetch(`${Astro.url.origin}/api/trainings/${trainingId}/complete`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({ notes: null }),
    })
    if (res.ok) return Astro.redirect(`/admin/trainings/${trainingId}`)
    else { const b = await res.json() as any; completeError = b.error ?? 'Failed to mark complete.' }
  } else if (action === 'assign' && isLead) {
    const scope = form.get('scope') as string
    const team_id = form.get('team_id') as string | null
    const deadline = form.get('deadline') as string | null
    const res = await fetch(`${Astro.url.origin}/api/trainings/${trainingId}/assignments`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Cookie: Astro.request.headers.get('cookie') ?? '' },
      body: JSON.stringify({ scope, team_id: team_id || null, deadline: deadline || null }),
    })
    if (res.ok) return Astro.redirect(`/admin/trainings/${trainingId}`)
  }
}

function fmt(d: string | null) {
  if (!d) return '—'
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
}

const t = training as any
---

<style>
  [x-cloak] { display: none !important; }
</style>

<DashboardLayout title={t.title}>
  <div class="max-w-215" x-data={`{
    modal: { open: false, tid: '', aid: '', message: '' },
    async doDelete() {
      const res = await fetch('/api/trainings/' + this.modal.tid + '/assignments?assignment_id=' + this.modal.aid, { method: 'DELETE' })
      if (res.ok) window.location.reload()
      else alert('Failed to remove assignment.')
      this.modal.open = false
    }
  }`}>
    <Breadcrumb crumbs={[{ label: 'Trainings', href: '/admin/trainings' }, { label: t.title }]} />

    <!-- Header -->
    <div class="flex items-start justify-between gap-4 mb-6 flex-wrap">
      <div>
        <h1 class="font-heading text-[22px] font-bold text-brand-navy mb-1.5">{t.title}</h1>
        {t.requires_document && (
          <span class="inline-block py-0.5 px-2.5 rounded-full font-body text-xs font-medium bg-warning-50 text-warning-800 border border-warning-300">
            Requires document
          </span>
        )}
      </div>
      <div class="flex gap-2.5 flex-wrap">
        {t.external_url && (
          <a href={t.external_url} target="_blank" rel="noopener noreferrer"
            class="px-4 py-2 bg-white border border-brand-navy text-brand-navy rounded-md font-body text-[13px] font-semibold no-underline">
            Open resource &#8599;
          </a>
        )}
        {isLead && (
          <a href={`/admin/trainings/${trainingId}/edit`}
            class="px-4 py-2 bg-neutral-100 border border-neutral-200 text-neutral-700 rounded-md font-body text-[13px] font-medium no-underline">
            Edit
          </a>
        )}
        {isLead && (
          <a href={`/admin/trainings/${trainingId}/completions`}
            class="px-4 py-2 bg-neutral-100 border border-neutral-200 text-neutral-700 rounded-md font-body text-[13px] font-medium no-underline">
            View completions
          </a>
        )}
      </div>
    </div>

    <!-- Description -->
    {t.description && (
      <div class="bg-white border border-neutral-200 rounded-lg p-6 mb-6">
        <p class="font-body text-sm text-neutral-700 m-0 whitespace-pre-wrap leading-[1.7]">{t.description}</p>
      </div>
    )}

    <!-- My Progress -->
    <div class="bg-white border border-neutral-200 rounded-lg p-6 mb-6">
      <h2 class="font-heading text-[15px] font-bold text-neutral-800 mb-4">My Progress</h2>

      {myCompletion ? (
        <div class="bg-success-50 border border-success-100 rounded-md py-3.5 px-4">
          <p class="font-body text-sm font-semibold text-success-700 mb-1">Completed &#10003;</p>
          <p class="font-body text-xs text-success-700 mb-0.5 capitalize">Method: {(myCompletion as any).method?.replace('_', ' ')}</p>
          <p class="font-body text-xs text-success-700 m-0">{fmt((myCompletion as any).completed_at)}</p>
        </div>
      ) : !t.requires_document ? (
        <div>
          {completeError && (
            <div class="bg-danger-50 border border-danger-200 rounded-md py-2.5 px-3.5 mb-3 font-body text-[13px] text-danger-700">
              {completeError}
            </div>
          )}
          <form method="POST">
            <input type="hidden" name="_action" value="complete" />
            <button type="submit"
              class="py-2.5 px-5 bg-success-700 text-white border-0 rounded-md font-body text-sm font-semibold cursor-pointer">
              Mark as completed
            </button>
          </form>
        </div>
      ) : (
        <div class="bg-neutral-50 border border-neutral-200 rounded-md py-3.5 px-4 flex items-center justify-between gap-3 flex-wrap">
          <p class="font-body text-[13px] text-neutral-600 m-0">Upload a document to complete this training.</p>
          <a href={`/admin/documents/upload?training_id=${trainingId}`}
            class="px-4 py-2 bg-brand-navy text-white rounded-md font-body text-[13px] font-semibold no-underline whitespace-nowrap">
            Upload document
          </a>
        </div>
      )}
    </div>

    <!-- Assignments (admin/lead only) -->
    {isLead && (
      <div class="bg-white border border-neutral-200 rounded-lg p-6">
        <h2 class="font-heading text-[15px] font-bold text-neutral-800 mb-4">Assignments</h2>

        {assignments.length === 0 ? (
          <p class="font-body text-[13px] text-neutral-400 mb-5">No assignments yet.</p>
        ) : (
          <div class="mb-5 flex flex-col gap-2">
            {assignments.map((a: any) => (
              <div class="flex items-center justify-between py-2.5 px-3.5 bg-neutral-50 rounded-md border border-neutral-200">
                <div>
                  <span class="font-body text-[13px] font-medium text-neutral-800 capitalize">
                    {a.scope === 'team' ? `Team: ${(a.team as any)?.name ?? a.team_id}` : a.scope === 'person' ? `Person: ${(a.assignee as any)?.full_name ?? a.person_id}` : 'All members'}
                  </span>
                  {a.deadline && <span class="font-body text-xs text-neutral-500 ml-2.5">Deadline: {fmt(a.deadline)}</span>}
                </div>
                <button
                  @click={`modal.open = true; modal.tid = '${trainingId}'; modal.aid = '${a.id}'; modal.message = 'Remove this assignment?'`}
                  class="py-1 px-2.5 bg-neutral-100 border border-neutral-200 rounded-md font-body text-xs text-neutral-600 cursor-pointer">
                  Remove
                </button>
              </div>
            ))}
          </div>
        )}

        <!-- Add assignment form -->
        <form method="POST" x-data={`{ scope: '${admin ? 'all' : 'team'}' }`} class="flex flex-col gap-3 border-t border-neutral-100 pt-4">
          <input type="hidden" name="_action" value="assign" />
          <h3 class="font-heading text-[13px] font-semibold text-neutral-700 m-0">Add assignment</h3>
          <div class="grid grid-cols-[1fr_1fr_auto] gap-2.5 items-end">
            <div class="flex flex-col gap-1">
              <label class="font-body text-xs font-medium text-neutral-600">Scope</label>
              <select name="scope" x-model="scope"
                class="py-2 px-2.5 border border-neutral-300 rounded-md font-body text-[13px] bg-white">
                {admin && <option value="all">All members</option>}
                <option value="team">Team</option>
              </select>
            </div>
            <div class={`flex flex-col gap-1${admin ? ' hidden' : ''}`} x-show="scope === 'team'">
              <label class="font-body text-xs font-medium text-neutral-600">Team</label>
              <select name="team_id"
                class="py-2 px-2.5 border border-neutral-300 rounded-md font-body text-[13px] bg-white">
                <option value="">Select team</option>
                {teams.map((team: any) => <option value={team.id}>{team.name}</option>)}
              </select>
            </div>
            <div class="flex flex-col gap-1">
              <label class="font-body text-xs font-medium text-neutral-600">Deadline (optional)</label>
              <input name="deadline" type="date"
                class="py-2 px-2.5 border border-neutral-300 rounded-md font-body text-[13px]" />
            </div>
          </div>
          <div>
            <button type="submit"
              class="px-4 py-2 bg-brand-navy text-white border-0 rounded-md font-body text-[13px] font-semibold cursor-pointer">
              Assign
            </button>
          </div>
        </form>
      </div>
    )}

    <!-- Delete assignment confirm modal -->
    <div x-show="modal.open" x-cloak @click="modal.open = false"
      class="fixed inset-0 bg-black/45 z-[1000] flex items-center justify-center">
      <div @click.stop class="bg-white rounded-lg py-7 px-8 max-w-95 w-[90%] shadow-[0_20px_60px_rgba(0,0,0,0.2)]">
        <p class="font-body text-sm font-semibold text-neutral-800 mb-1.5">Remove assignment</p>
        <p x-text="modal.message" class="font-body text-[13px] text-neutral-600 mb-5 leading-normal"></p>
        <div class="flex gap-2.5 justify-end">
          <button @click="modal.open = false"
            class="px-4 py-2 bg-neutral-100 border border-neutral-200 rounded-md font-body text-[13px] font-medium cursor-pointer text-neutral-700">
            Cancel
          </button>
          <button @click="doDelete()"
            class="px-4 py-2 bg-danger-600 text-white border-0 rounded-md font-body text-[13px] font-semibold cursor-pointer">
            Remove
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
