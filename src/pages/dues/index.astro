---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin } from '@/lib/rbac'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')
if (isAdmin(user)) return Astro.redirect('/admin/dues')
if (!user.person_id) return Astro.redirect('/dashboard')

const pid = user.person_id
const currentYear = new Date().getFullYear()
const currentMonth = new Date().getMonth() + 1 // 1-based

// Fetch member's join date to determine visible years
const { data: memberData } = await supabaseAdmin
  .from('people')
  .select('date_joined, full_name')
  .eq('id', pid)
  .single()

const joinYear = memberData?.date_joined
  ? new Date(memberData.date_joined as string).getFullYear()
  : currentYear

// Build list of years from join year to current year
const years: number[] = []
for (let y = currentYear; y >= joinYear; y--) {
  years.push(y)
}

// Fetch confirmed dues
const { data: duesData } = await supabaseAdmin
  .from('dues')
  .select('year, month')
  .eq('person_id', pid)
  .in('year', years)

// Fetch submissions
const { data: submissionsData } = await supabaseAdmin
  .from('dues_submissions')
  .select('id, year, month, status')
  .eq('person_id', pid)
  .in('year', years)

type DueRow = { year: number; month: number }
type SubmissionRow = { id: string; year: number; month: number; status: string }

// Build lookup maps: `${year}-${month}` → status
const paidSet = new Set(((duesData ?? []) as DueRow[]).map(d => `${d.year}-${d.month}`))
const submissionMap = new Map(((submissionsData ?? []) as SubmissionRow[]).map(s => [`${s.year}-${s.month}`, s]))

const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
const MONTHS_FULL = ['January','February','March','April','May','June','July','August','September','October','November','December']

// Count pending submissions for a given year
function pendingCount(y: number): number {
  return ((submissionsData ?? []) as SubmissionRow[]).filter(s => s.year === y && s.status === 'pending').length
}
---

<DashboardLayout title="My Dues">
  <div class="max-w-275">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0 mb-1">My Dues</h1>
        <p class="font-body text-sm text-neutral-500 m-0">
          Check a month to submit your payment for admin approval.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 items-start">
    {years.map(y => {
      const joinedThisYear = joinYear === y
      const joinMonth = joinedThisYear && memberData?.date_joined
        ? new Date(memberData.date_joined as string).getMonth() + 1
        : 1
      const pending = pendingCount(y)

      return (
        <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
          <!-- Year header -->
          <div class="flex items-center justify-between py-3.5 px-5 border-b border-neutral-100 bg-neutral-50">
            <h2 class="font-heading text-[15px] font-bold text-brand-navy m-0">{y}</h2>
            {pending > 0 && (
              <span class="py-0.5 px-2.5 bg-warning-50 border border-warning-200 rounded-full font-body text-xs font-semibold text-warning-700">
                {pending} pending approval
              </span>
            )}
          </div>

          <!-- Month grid -->
          <div class="grid grid-cols-6 gap-2 py-4 px-5">
            {MONTHS.map((monthLabel, i) => {
              const month = i + 1
              const key = `${y}-${month}`
              const isPaid = paidSet.has(key)
              const submission = submissionMap.get(key)
              const isPending = submission?.status === 'pending'
              const isRejected = submission?.status === 'rejected'
              const isNA = joinedThisYear && month < joinMonth
              // Don't allow submitting future months
              const isFuture = y === currentYear && month > currentMonth

              let bg = 'var(--color-neutral-50)'
              let border = 'var(--color-neutral-200)'
              let textColor = 'var(--color-neutral-400)'
              let statusLabel = ''
              let cursor = 'pointer'

              if (isNA) {
                bg = 'var(--color-neutral-50)'; border = 'var(--color-neutral-100)'; textColor = 'var(--color-neutral-200)'; cursor = 'default'
              } else if (isPaid) {
                bg = 'var(--color-success-50)'; border = 'var(--color-success-300)'; textColor = 'var(--color-success-700)'; statusLabel = '✓ Paid'; cursor = 'default'
              } else if (isPending) {
                bg = '#fffbeb'; border = '#fcd34d'; textColor = '#92400e'; statusLabel = '⏳ Pending'; cursor = 'default'
              } else if (isRejected) {
                bg = 'var(--color-danger-50)'; border = 'var(--color-danger-200)'; textColor = 'var(--color-danger-600)'; statusLabel = '✕ Not approved'
              } else if (isFuture) {
                bg = 'var(--color-neutral-50)'; border = 'var(--color-neutral-100)'; textColor = 'var(--color-neutral-200)'; cursor = 'default'
              } else {
                statusLabel = 'Mark as paid'
              }

              const interactive = !isNA && !isPaid && !isPending && !isFuture

              return (
                <button
                  class={`${interactive ? 'dues-month-btn' : ''} w-full rounded-md pt-2.5 px-1 pb-2 text-center transition-opacity duration-150`}
                  data-year={y}
                  data-month={month}
                  data-submission-id={submission?.id ?? ''}
                  data-rejected={isRejected ? 'true' : 'false'}
                  disabled={!interactive}
                  title={interactive ? `Submit ${MONTHS_FULL[i]} ${y} dues` : undefined}
                  style={`border: 1px solid ${border}; background: ${bg}; cursor: ${cursor};`}>
                  <p class="font-body text-xs font-bold mb-1 uppercase tracking-wider" style={`color: ${textColor};`}>{monthLabel}</p>
                  <p class="font-body text-[10px] m-0 min-h-3.5 leading-[1.2]" style={`color: ${textColor};`}>
                    {isNA ? '—' : statusLabel}
                  </p>
                </button>
              )
            })}
          </div>

          <!-- Legend row -->
          <div class="flex gap-4 flex-wrap px-5 pb-3.5">
            <span class="font-body text-[11px] text-neutral-400">
              Click an unpaid month to submit for approval
            </span>
          </div>
        </div>
      )
    })}
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-6 right-6 px-5 py-3 rounded-md font-body text-sm font-medium text-white z-[9999] shadow-[0_4px_12px_rgba(0,0,0,0.15)]" style="display: none;"></div>

  <script is:inline>
    (function () {
      var toast = document.getElementById('toast')

      function showToast(msg, ok) {
        if (!toast) return
        toast.textContent = msg
        toast.style.background = ok ? 'var(--color-success-600)' : 'var(--color-danger-600)'
        toast.style.display = 'block'
        setTimeout(function() { toast.style.display = 'none' }, 3500)
      }

      document.querySelectorAll('.dues-month-btn').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          var year = parseInt(btn.dataset.year)
          var month = parseInt(btn.dataset.month)
          var isRejected = btn.dataset.rejected === 'true'

          btn.disabled = true
          btn.style.opacity = '0.6'

          try {
            var res = await fetch('/api/dues/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ year: year, month: month })
            })
            var data = await res.json()
            if (res.ok) {
              showToast('Submitted — awaiting admin approval', true)
              setTimeout(function() { window.location.reload() }, 1000)
            } else {
              showToast(data.error || 'Failed to submit', false)
              btn.disabled = false
              btn.style.opacity = '1'
            }
          } catch (e) {
            showToast('Network error', false)
            btn.disabled = false
            btn.style.opacity = '1'
          }
        })
      })
    })()
  </script>
</DashboardLayout>
