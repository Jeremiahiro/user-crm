---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong — 100BMOL</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-brand-navy font-body flex flex-col items-center justify-center px-6 py-8">
    <div class="bg-white rounded-4 px-12 py-14 max-w-120 w-full text-center shadow-[0_24px_64px_rgba(0,0,0,0.25)]">
      <div class="font-heading text-[80px] font-bold text-brand-navy leading-none mb-1">5<span class="text-brand-gold">0</span>0</div>
      <div class="w-12 h-0.75 bg-brand-gold rounded-0.5 mx-auto mb-7"></div>
      <p class="font-heading text-[22px] font-bold text-brand-navy mb-3">Something went wrong</p>
      <p class="text-[15px] text-neutral-500 leading-relaxed mb-9">
        An unexpected error occurred on our end. Try refreshing the page —
        if the problem persists, contact your administrator.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="javascript:location.reload()" class="bg-brand-navy text-white px-6 py-2.75 rounded-2 font-body text-sm font-semibold no-underline transition-opacity duration-150 hover:opacity-85">Refresh page</a>
        <a href="/dashboard" class="bg-neutral-100 text-neutral-700 px-6 py-2.75 rounded-2 font-body text-sm font-medium no-underline transition-colors duration-150 hover:bg-neutral-200">Go to Dashboard</a>
      </div>
    </div>
    <p class="font-heading text-[13px] font-bold text-neutral-300 mt-8 tracking-[0.03em]">100 Black Men of <span class="text-brand-gold">London</span></p>
  </body>
</html>
