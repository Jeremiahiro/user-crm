---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong — 100BMOL</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        background-color: var(--color-brand-navy);
        font-family: var(--font-body);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 24px;
      }
      .card {
        background: white;
        border-radius: 16px;
        padding: 56px 48px;
        max-width: 480px;
        width: 100%;
        text-align: center;
        box-shadow: 0 24px 64px rgba(0,0,0,0.25);
      }
      .code {
        font-family: var(--font-heading);
        font-size: 80px;
        font-weight: 700;
        color: var(--color-brand-navy);
        line-height: 1;
        margin-bottom: 4px;
      }
      .code span { color: var(--color-brand-gold); }
      .title {
        font-family: var(--font-heading);
        font-size: 22px;
        font-weight: 700;
        color: var(--color-brand-navy);
        margin-bottom: 12px;
      }
      .body {
        font-size: 15px;
        color: var(--color-neutral-500);
        line-height: 1.6;
        margin-bottom: 36px;
      }
      .actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn-primary {
        background-color: var(--color-brand-navy);
        color: white;
        padding: 11px 24px;
        border-radius: 8px;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.15s;
      }
      .btn-primary:hover { opacity: 0.85; }
      .btn-secondary {
        background-color: var(--color-neutral-100);
        color: var(--color-neutral-700);
        padding: 11px 24px;
        border-radius: 8px;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 0.15s;
      }
      .btn-secondary:hover { background-color: var(--color-neutral-200); }
      .divider {
        width: 48px;
        height: 3px;
        background-color: var(--color-brand-gold);
        border-radius: 2px;
        margin: 0 auto 28px;
      }
      .logo {
        font-family: var(--font-heading);
        font-size: 13px;
        font-weight: 700;
        color: var(--color-neutral-300);
        margin-top: 32px;
        letter-spacing: 0.03em;
      }
      .logo span { color: var(--color-brand-gold); }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="code">5<span>0</span>0</div>
      <div class="divider"></div>
      <p class="title">Something went wrong</p>
      <p class="body">
        An unexpected error occurred on our end. Try refreshing the page —
        if the problem persists, contact your administrator.
      </p>
      <div class="actions">
        <a href="javascript:location.reload()" class="btn-primary">Refresh page</a>
        <a href="/dashboard" class="btn-secondary">Go to Dashboard</a>
      </div>
    </div>
    <p class="logo">100 Black Men of <span>London</span></p>
  </body>
</html>
