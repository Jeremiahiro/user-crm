---
import PublicLayout from '@/layouts/PublicLayout.astro'

// Already logged in → go to dashboard
if (Astro.locals.user) {
  return Astro.redirect('/dashboard')
}

const callbackUrl = Astro.url.searchParams.get('callbackUrl') ?? '/dashboard'
const error = Astro.url.searchParams.get('error')
---

<PublicLayout title="Sign in — 100BMOL">
  <div
    style="
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--color-brand-navy);
      padding: 24px;
      box-sizing: border-box;
    "
  >
    <div
      style="
        width: 100%;
        max-width: 400px;
        background: white;
        border-radius: var(--radius-xl);
        padding: 48px 40px;
        box-shadow: var(--shadow-xl);
        text-align: center;
      "
    >
      <!-- Logo -->
      <p
        style="
          font-family: var(--font-heading);
          font-size: 28px;
          font-weight: 700;
          color: var(--color-brand-navy);
          margin: 0 0 8px;
          letter-spacing: -0.5px;
        "
      >
        100BM<span style="color: var(--color-brand-gold);">OL</span>
      </p>
      <p
        style="
          font-family: var(--font-body);
          font-size: 14px;
          color: var(--color-neutral-500);
          margin: 0 0 40px;
        "
      >
        Member Portal
      </p>

      <!-- Error state -->
      {
        error && (
          <div
            style="
              background-color: var(--color-danger-50);
              border: 1px solid var(--color-danger-200);
              border-radius: var(--radius-md);
              padding: 12px 16px;
              margin-bottom: 24px;
              font-size: 14px;
              color: var(--color-danger-700);
              font-family: var(--font-body);
              text-align: left;
            "
          >
            Sign-in failed. Please try again or contact an administrator.
          </div>
        )
      }

      <!-- Sign in button -->
      <a
        href={`/api/auth/google-signin?callbackUrl=${encodeURIComponent(callbackUrl)}`}
        style="
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 12px;
          width: 100%;
          padding: 14px 20px;
          background-color: var(--color-brand-navy);
          color: white;
          border-radius: var(--radius-md);
          text-decoration: none;
          font-family: var(--font-body);
          font-size: 15px;
          font-weight: 600;
          box-sizing: border-box;
          transition: opacity 0.15s;
        "
        onmouseover="this.style.opacity='0.9'"
        onmouseout="this.style.opacity='1'"
      >
        <!-- Google icon -->
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z" fill="#4285F4"/>
          <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18Z" fill="#34A853"/>
          <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332Z" fill="#FBBC05"/>
          <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58Z" fill="#EA4335"/>
        </svg>
        Sign in with Google
      </a>

      <p
        style="
          font-family: var(--font-body);
          font-size: 12px;
          color: var(--color-neutral-400);
          margin: 24px 0 0;
          line-height: 1.6;
        "
      >
        Access is restricted to authorised members and staff.<br />
        Contact your administrator if you need access.
      </p>
    </div>
  </div>
</PublicLayout>
