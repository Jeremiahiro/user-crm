---
import PublicLayout from '@/layouts/PublicLayout.astro'

// Already logged in → go to dashboard
if (Astro.locals.user) {
  return Astro.redirect('/dashboard')
}

const callbackUrl = Astro.url.searchParams.get('callbackUrl') ?? '/dashboard'
const error = Astro.url.searchParams.get('error')
---

<PublicLayout title="Sign in — 100BMOL">
  <div class="min-h-screen flex items-center justify-center bg-brand-navy p-6 box-border">
    <div class="w-full max-w-100 bg-white rounded-xl px-10 py-12 shadow-xl text-center">
      <!-- Logo -->
      <p class="font-heading text-[28px] font-bold text-brand-navy mb-2 tracking-[-0.5px]">
        100BM<span class="text-brand-gold">OL</span>
      </p>
      <p class="font-body text-sm text-neutral-500 mb-10">
        Member Portal
      </p>

      <!-- Error state -->
      {
        error && (
          <div class="bg-danger-50 border border-danger-200 rounded-md px-4 py-3 mb-6 text-sm text-danger-700 font-body text-left">
            Sign-in failed. Please try again or contact an administrator.
          </div>
        )
      }

      <!-- Sign in button -->
      <a
        href={`/api/auth/google-signin?callbackUrl=${encodeURIComponent(callbackUrl)}`}
        class="flex items-center justify-center gap-3 w-full px-5 py-3.5 bg-brand-navy text-white rounded-md no-underline font-body text-[15px] font-semibold box-border transition-opacity duration-150 hover:opacity-90"
      >
        <!-- Google icon -->
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z" fill="#4285F4"/>
          <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18Z" fill="#34A853"/>
          <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332Z" fill="#FBBC05"/>
          <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58Z" fill="#EA4335"/>
        </svg>
        Sign in with Google
      </a>

      <p class="font-body text-xs text-neutral-400 mt-6 leading-relaxed">
        Access is restricted to authorised members and staff.<br />
        Contact your administrator if you need access.
      </p>
    </div>
  </div>
</PublicLayout>
