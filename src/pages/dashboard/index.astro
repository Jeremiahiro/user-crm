---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'
import { isAdmin as checkIsAdmin, isMentor as checkIsMentor } from '@/lib/rbac'
import { summariseDbs } from '@/lib/compliance'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

const today = new Date()
const todayStr = today.toISOString().split('T')[0] as string
const sixtyDaysOut = new Date(today)
sixtyDaysOut.setDate(today.getDate() + 60)
const sixtyDaysStr = sixtyDaysOut.toISOString().split('T')[0] as string
const currentYear = today.getFullYear()
const currentMonth = today.getMonth() + 1

const userIsAdmin = checkIsAdmin(user)
const userIsMentor = checkIsMentor(user)

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' })
}
function formatTime(t: string | null) {
  if (!t) return ''
  const [h, m] = t.split(':')
  const hour = parseInt(h ?? '0')
  return `${hour % 12 || 12}:${m}${hour >= 12 ? 'pm' : 'am'}`
}
function timeAgo(d: string): string {
  const diff = Date.now() - new Date(d).getTime()
  const mins = Math.floor(diff / 60000)
  if (mins < 60) return `${mins}m ago`
  const hrs = Math.floor(mins / 60)
  if (hrs < 24) return `${hrs}h ago`
  const days = Math.floor(hrs / 24)
  return `${days}d ago`
}

// ── Admin dashboard data ──────────────────────────────────────────────────────
let membersCount = 0, activeMembersCount = 0, inactiveMembersCount = 0
let volunteersCount = 0, activeVolunteersCount = 0, inactiveVolunteersCount = 0, trusteesCount = 0
let dbsActive = 0, dbsExpiring = 0, dbsExpired = 0, dbsMissing = 0, duesCompliancePct = 0, membersPaidThisYear = 0, eligibleCount = 0

type Session = {
  id: string; title: string; session_date: string; session_time: string | null
  location: string | null; cmp_programme_years: { name: string } | null
}
type PraiseRow = {
  id: string; message: string; visibility: string; created_at: string
  'people!praise_recipient_id_fkey': { id: string; full_name: string } | null
  'people!praise_given_by_fkey': { id: string; full_name: string } | null
}
type ActivityRow = {
  id: string; action: string; target_table: string; created_at: string
  'people!audit_log_actor_id_fkey': { id: string; full_name: string } | null
}

let sessions: Session[] = []
let praiseRows: PraiseRow[] = []
let activityRows: ActivityRow[] = []

const TABLE_LABELS: Record<string, string> = {
  people: 'member', teams: 'team', pillars: 'pillar', roles: 'role',
  elected_position_tenures: 'position tenure', documents: 'document',
  dbs_records: 'DBS record', dues: 'dues', awards: 'award', praise: 'praise',
  mentees: 'mentee', cmp_sessions: 'CMP session', cmp_attendance: 'attendance',
  participation_events: 'participation event',
}
const ACTION_LABELS: Record<string, string> = {
  create: 'Created', update: 'Updated', archive: 'Archived',
  delete: 'Deleted', role_grant: 'Granted role', tenure_create: 'Assigned to position', tenure_end: 'Closed tenure',
}

if (userIsAdmin) {
  const [
    { count: mc },
    { count: amc },
    { count: imc },
    { count: vc },
    { count: avc },
    { count: ivc },
    { count: tc },
    { data: allPeopleForDbs },
    { data: allDbsRecords },
    { data: upcomingSessions },
    { data: recentPraise },
    { data: recentActivity },
  ] = await Promise.all([
    // Members
    supabaseAdmin.from('people').select('*', { count: 'exact', head: true }).contains('person_types', ['member']).eq('is_archived', false),
    supabaseAdmin.from('people').select('*', { count: 'exact', head: true }).contains('person_types', ['member']).eq('status', 'active').eq('is_archived', false),
    supabaseAdmin.from('people').select('*', { count: 'exact', head: true }).contains('person_types', ['member']).in('status', ['suspended', 'inactive']).eq('is_archived', false),
    // Volunteers
    supabaseAdmin.from('people').select('*', { count: 'exact', head: true }).contains('person_types', ['volunteer']).eq('is_archived', false),
    supabaseAdmin.from('people').select('*', { count: 'exact', head: true }).contains('person_types', ['volunteer']).eq('status', 'active').eq('is_archived', false),
    supabaseAdmin.from('people').select('*', { count: 'exact', head: true }).contains('person_types', ['volunteer']).in('status', ['suspended', 'inactive']).eq('is_archived', false),
    supabaseAdmin.from('people').select('*', { count: 'exact', head: true }).contains('person_types', ['trustee']).eq('is_archived', false),
    // DBS — fetch people + records to compute per-person latest, matching DBS page logic
    supabaseAdmin.from('people').select('id').eq('is_archived', false),
    supabaseAdmin.from('dbs_records').select('person_id, expiry_date'),
    supabaseAdmin.from('cmp_sessions')
      .select('id, title, session_date, session_time, location, cmp_programme_years(name)')
      .gte('session_date', todayStr)
      .eq('is_cancelled', false)
      .order('session_date', { ascending: true })
      .limit(5),
    supabaseAdmin.from('praise')
      .select('id, message, visibility, created_at, people!praise_recipient_id_fkey(id, full_name), people!praise_given_by_fkey(id, full_name)')
      .eq('is_archived', false)
      .order('created_at', { ascending: false })
      .limit(5),
    supabaseAdmin.from('audit_log')
      .select('id, action, target_table, created_at, people!audit_log_actor_id_fkey(id, full_name)')
      .order('created_at', { ascending: false })
      .limit(10),
  ])

  membersCount = mc ?? 0
  activeMembersCount = amc ?? 0
  inactiveMembersCount = imc ?? 0
  volunteersCount = vc ?? 0
  activeVolunteersCount = avc ?? 0
  inactiveVolunteersCount = ivc ?? 0
  trusteesCount = tc ?? 0

  // DBS — use same per-person latest-record logic as the DBS page
  const allIds = ((allPeopleForDbs ?? []) as { id: string }[]).map(p => p.id)
  const dbsRecordsList = ((allDbsRecords ?? []) as { person_id: string; expiry_date: string | null }[])
  const dbsSummary = summariseDbs(dbsRecordsList, allIds, today)
  dbsActive   = dbsSummary.valid
  dbsExpiring = dbsSummary.expiring_soon
  dbsExpired  = dbsSummary.expired
  dbsMissing  = dbsSummary.missing
  sessions = (upcomingSessions ?? []) as unknown as Session[]
  praiseRows = (recentPraise ?? []) as unknown as PraiseRow[]
  activityRows = (recentActivity ?? []) as unknown as ActivityRow[]

  // Dues compliance
  const { data: dueEligiblePeople } = await supabaseAdmin
    .from('people')
    .select('id, person_types')
    .eq('is_archived', false)
    .or('gender.is.null,gender.neq.female')
  const dueEligibleIds = new Set(
    ((dueEligiblePeople ?? []) as { id: string; person_types: string[] }[])
      .filter(p => !(p.person_types ?? []).every(t => t === 'volunteer'))
      .map(p => p.id)
  )
  eligibleCount = dueEligibleIds.size

  const { data: duesPaidRows } = await supabaseAdmin
    .from('dues')
    .select('person_id')
    .eq('year', currentYear)
  membersPaidThisYear = new Set(
    ((duesPaidRows ?? []) as { person_id: string }[])
      .map(d => d.person_id)
      .filter(id => dueEligibleIds.has(id))
  ).size
  duesCompliancePct = eligibleCount > 0 ? Math.round((membersPaidThisYear / eligibleCount) * 100) : 0
}

// ── Member dashboard data ─────────────────────────────────────────────────────
type DbsRecord = { clearance_date: string | null; expiry_date: string | null }
type AwardRow = { id: string; type: string; year: number; citation: string | null; created_at: string }
type MemberPraiseRow = { id: string; message: string; created_at: string; 'people!praise_given_by_fkey': { full_name: string } | null }
type TeamRow = { team_id: string; is_team_lead: boolean; joined_at: string; teams: { id: string; name: string; description: string | null } | null }
type BuddyRow = { id: string; person_id: string; buddy_id: string; assigned_at: string }
type PersonRow = { id: string; full_name: string; email: string; phone: string | null }

let myDbsRecord: DbsRecord | null = null
let myAwardsCount = 0
let myPraiseReceivedCount = 0
let myPraiseGivenCount = 0
let myRecentAwards: AwardRow[] = []
let myRecentPraise: MemberPraiseRow[] = []
let myUpcomingSessions: Session[] = []
let myTeams: TeamRow[] = []
let myBuddy: (BuddyRow & { buddyPerson?: PersonRow | null }) | null = null
let iAmBuddyTo: (BuddyRow & { primaryPerson?: PersonRow | null })[] = []
let myDuesPaid = 0
let myDuesPending = 0

let myDbsStatus = { label: 'No record', color: 'var(--color-neutral-500)' }

if (!userIsAdmin && user.person_id) {
  const pid = user.person_id

  const [
    { data: dbsRec },
    { count: awardsCount },
    { count: praiseRecCount },
    { count: praiseGivenCount },
    { data: recentAwards },
    { data: memberRecentPraise },
    { data: memberUpcomingSessions },
    { data: memberTeams },
    { data: buddyAsPersonId },
    { data: buddyAsBuddyId },
  ] = await Promise.all([
    supabaseAdmin
      .from('dbs_records')
      .select('clearance_date, expiry_date')
      .eq('person_id', pid)
      .order('clearance_date', { ascending: false })
      .limit(1)
      .maybeSingle(),
    supabaseAdmin
      .from('awards')
      .select('*', { count: 'exact', head: true })
      .eq('person_id', pid),
    supabaseAdmin
      .from('praise')
      .select('*', { count: 'exact', head: true })
      .eq('recipient_id', pid)
      .eq('is_archived', false),
    supabaseAdmin
      .from('praise')
      .select('*', { count: 'exact', head: true })
      .eq('given_by', pid)
      .eq('is_archived', false),
    supabaseAdmin
      .from('awards')
      .select('id, type, year, citation, created_at')
      .eq('person_id', pid)
      .order('created_at', { ascending: false })
      .limit(3),
    supabaseAdmin
      .from('praise')
      .select('id, message, created_at, people!praise_given_by_fkey(full_name)')
      .eq('recipient_id', pid)
      .eq('is_archived', false)
      .eq('visibility', 'public')
      .order('created_at', { ascending: false })
      .limit(3),
    supabaseAdmin
      .from('cmp_sessions')
      .select('id, title, session_date, session_time, location, cmp_programme_years(name)')
      .gte('session_date', todayStr)
      .eq('is_cancelled', false)
      .order('session_date', { ascending: true })
      .limit(3),
    supabaseAdmin
      .from('person_teams')
      .select('team_id, is_team_lead, joined_at, teams(id, name, description)')
      .eq('person_id', pid),
    supabaseAdmin
      .from('buddy_assignments')
      .select('id, person_id, buddy_id, assigned_at')
      .eq('person_id', pid)
      .is('ended_at', null)
      .maybeSingle(),
    supabaseAdmin
      .from('buddy_assignments')
      .select('id, person_id, buddy_id, assigned_at')
      .eq('buddy_id', pid)
      .is('ended_at', null),
  ])

  myDbsRecord = dbsRec as DbsRecord | null
  myAwardsCount = awardsCount ?? 0
  myPraiseReceivedCount = praiseRecCount ?? 0
  myPraiseGivenCount = praiseGivenCount ?? 0
  myRecentAwards = (recentAwards ?? []) as AwardRow[]
  myRecentPraise = (memberRecentPraise ?? []) as unknown as MemberPraiseRow[]
  myUpcomingSessions = (memberUpcomingSessions ?? []) as unknown as Session[]
  myTeams = (memberTeams ?? []) as unknown as TeamRow[]

  // DBS status
  if (myDbsRecord?.expiry_date) {
    const diff = new Date(myDbsRecord.expiry_date).getTime() - Date.now()
    const days = Math.floor(diff / 86_400_000)
    if (days < 0) myDbsStatus = { label: 'Expired', color: 'var(--color-danger-600)' }
    else if (days <= 90) myDbsStatus = { label: `Expires in ${days}d`, color: 'var(--color-warning-600)' }
    else myDbsStatus = { label: 'Valid', color: 'var(--color-success-600)' }
  }

  // Resolve buddy person info
  if (buddyAsPersonId) {
    const { data: bp } = await supabaseAdmin
      .from('people')
      .select('id, full_name, email, phone')
      .eq('id', (buddyAsPersonId as BuddyRow).buddy_id)
      .single()
    myBuddy = { ...(buddyAsPersonId as BuddyRow), buddyPerson: bp as PersonRow | null }
  }
  const buddyAsBuddyIdRows = (buddyAsBuddyId ?? []) as BuddyRow[]
  if (buddyAsBuddyIdRows.length > 0) {
    const personIds = buddyAsBuddyIdRows.map(r => r.person_id)
    const { data: buddiedPeople } = await supabaseAdmin
      .from('people')
      .select('id, full_name, email, phone')
      .in('id', personIds)
    const buddiedMap = new Map(((buddiedPeople ?? []) as PersonRow[]).map(p => [p.id, p]))
    iAmBuddyTo = buddyAsBuddyIdRows.map(r => ({ ...r, primaryPerson: buddiedMap.get(r.person_id) ?? null }))
  }

  // Dues summary for current year
  const thisYear = new Date().getFullYear()
  const [{ data: myDuesRows }, { data: mySubRows }] = await Promise.all([
    supabaseAdmin.from('dues').select('month').eq('person_id', pid).eq('year', thisYear),
    supabaseAdmin.from('dues_submissions').select('month, status').eq('person_id', pid).eq('year', thisYear).eq('status', 'pending'),
  ])
  myDuesPaid = (myDuesRows ?? []).length
  myDuesPending = (mySubRows ?? []).length
}

const AWARD_LABELS: Record<string, string> = {
  member_of_the_year: 'Member of the Year',
  volunteer_of_the_year: 'Volunteer of the Year',
  mentor_of_the_year: 'Mentor of the Year',
  rising_star: 'Rising Star',
  community_impact: 'Community Impact',
  leadership_excellence: 'Leadership Excellence',
  special_recognition: 'Special Recognition',
}
---

<DashboardLayout title="Dashboard">
  <!-- Header -->
  <div class="mb-7">
    <h1 class="font-heading text-2xl font-bold text-brand-navy m-0 mb-1">
      Welcome back, {user.name.split(' ')[0]}.
    </h1>
    <p class="font-body text-sm text-neutral-500 m-0">
      {today.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
    </p>
  </div>

  {userIsAdmin ? (
    <>
      <!-- Admin: Stat cards row 1 — members -->
      <div class="grid grid-cols-4 gap-4 mb-4">
        {[
          { label: 'Members', value: membersCount, href: '/admin/members', colour: 'var(--color-brand-navy)' },
          { label: 'Active members', value: activeMembersCount, href: '/admin/members?status=active', colour: 'var(--color-success-600)' },
          { label: 'Suspended / Inactive', value: inactiveMembersCount, href: '/admin/members?status=inactive', colour: 'var(--color-warning-600)' },
        ].map(stat => (
          <a href={stat.href} class="flex flex-col justify-between bg-white border border-neutral-200 rounded-lg py-5 px-6 no-underline min-h-24">
            <div class="flex justify-between items-start">
              <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0">{stat.label}</p>
              <span class="text-sm text-neutral-400">→</span>
            </div>
            <p class="font-heading text-[32px] font-bold m-0 mt-2 leading-none" style={`color: ${stat.colour};`}>{stat.value}</p>
          </a>
        ))}
        <!-- Dues compliance card -->
        <a href="/admin/dues" class="flex flex-col justify-between bg-white border border-neutral-200 rounded-lg py-5 px-6 no-underline min-h-24">
          <div class="flex justify-between items-start">
            <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0">Dues compliance {currentYear}</p>
            <span class="text-sm text-neutral-400">→</span>
          </div>
          <div>
            <div class="flex items-baseline gap-2 mt-2">
              <p class="font-heading text-[32px] font-bold text-brand-navy m-0 leading-none">{duesCompliancePct}%</p>
              <p class="font-body text-[13px] text-neutral-400 m-0">{membersPaidThisYear}/{eligibleCount}</p>
            </div>
            <div class="mt-2.5 h-1 bg-neutral-100 rounded-[2px] overflow-hidden">
              <div class="h-full bg-brand-navy rounded-[2px] transition-[width] duration-300" style={`width: ${duesCompliancePct}%;`}></div>
            </div>
          </div>
        </a>
      </div>

      <!-- Admin: Stat cards row 2 — volunteers -->
      <div class="grid grid-cols-4 gap-4 mb-4">
        {[
          { label: 'Volunteers', value: volunteersCount, href: '/admin/volunteers', colour: 'var(--color-brand-navy)' },
          { label: 'Active volunteers', value: activeVolunteersCount, href: '/admin/volunteers?status=active', colour: 'var(--color-success-600)' },
          { label: 'Suspended / Inactive', value: inactiveVolunteersCount, href: '/admin/volunteers?status=inactive', colour: 'var(--color-warning-600)' },
          { label: 'Board / Trustees', value: trusteesCount, href: '/admin/members?person_type=trustee', colour: 'var(--color-brand-navy)' },
        ].map(stat => (
          <a href={stat.href} class="flex flex-col justify-between bg-white border border-neutral-200 rounded-lg py-5 px-6 no-underline min-h-24">
            <div class="flex justify-between items-start">
              <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0">{stat.label}</p>
              <span class="text-sm text-neutral-400">→</span>
            </div>
            <p class="font-heading text-[32px] font-bold m-0 mt-2 leading-none" style={`color: ${stat.colour};`}>{stat.value}</p>
          </a>
        ))}
      </div>

      <!-- Admin: Stat cards row 3 — DBS -->
      <div class="grid grid-cols-4 gap-4 mb-7">
        {[
          { label: 'Active DBS', value: dbsActive, href: '/admin/dbs?status=valid', colour: 'var(--color-success-600)' },
          { label: 'DBS expiring (60d)', value: dbsExpiring, href: '/admin/dbs?status=expiring_soon', colour: dbsExpiring > 0 ? 'var(--color-warning-600)' : 'var(--color-success-600)' },
          { label: 'DBS expired', value: dbsExpired, href: '/admin/dbs?status=expired', colour: dbsExpired > 0 ? 'var(--color-danger-600)' : 'var(--color-success-600)' },
          { label: 'No DBS record', value: dbsMissing, href: '/admin/dbs?status=missing', colour: dbsMissing > 0 ? 'var(--color-warning-600)' : 'var(--color-success-600)' },
        ].map(stat => (
          <a href={stat.href} class="flex flex-col justify-between bg-white border border-neutral-200 rounded-lg py-5 px-6 no-underline min-h-24">
            <div class="flex justify-between items-start">
              <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0">{stat.label}</p>
              <span class="text-sm text-neutral-400">→</span>
            </div>
            <p class="font-heading text-[32px] font-bold m-0 mt-2 leading-none" style={`color: ${stat.colour};`}>{stat.value}</p>
          </a>
        ))}
      </div>

      <!-- Admin: Main content — 3-col layout -->
      <div class="grid [grid-template-columns:1fr_1fr_360px] gap-5">

        <!-- Activity feed -->
        <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
          <div class="py-4 px-5 border-b border-neutral-200">
            <h2 class="font-heading text-sm font-bold text-neutral-800 m-0">Recent activity</h2>
          </div>
          {activityRows.length === 0 ? (
            <p class="py-6 px-5 font-body text-[13px] text-neutral-400 m-0">No activity yet.</p>
          ) : (
            <div>
              {activityRows.map((a, i) => {
                const actor = a['people!audit_log_actor_id_fkey']
                const tableLabel = TABLE_LABELS[a.target_table] ?? a.target_table
                const actionLabel = ACTION_LABELS[a.action] ?? a.action
                return (
                  <div class={`py-3 px-5 flex items-start gap-2.5 ${i > 0 ? 'border-t border-neutral-100' : ''}`}>
                    <div class="w-1.5 h-1.5 rounded-full bg-brand-navy mt-1.5 shrink-0"></div>
                    <div class="flex-1 min-w-0">
                      <p class="font-body text-[13px] text-neutral-700 m-0 leading-[1.4]">
                        <span class="font-medium text-neutral-800">{actor?.full_name ?? 'System'}</span>
                        {' '}{actionLabel.toLowerCase()} a {tableLabel}
                      </p>
                      <p class="font-body text-[11px] text-neutral-400 m-0 mt-0.5">{timeAgo(a.created_at)}</p>
                    </div>
                  </div>
                )
              })}
              <div class="py-2.5 px-5 border-t border-neutral-100">
                <a href="/admin/audit" class="font-body text-xs text-brand-navy no-underline font-medium">View full audit log →</a>
              </div>
            </div>
          )}
        </div>

        <!-- Upcoming CMP sessions + Praise -->
        <div class="flex flex-col gap-5">
          <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
            <div class="py-4 px-5 border-b border-neutral-200 flex items-center justify-between">
              <h2 class="font-heading text-sm font-bold text-neutral-800 m-0">Upcoming CMP sessions</h2>
              <a href="/admin/cmp/years" class="font-body text-xs text-brand-navy no-underline">View all →</a>
            </div>
            {sessions.length === 0 ? (
              <p class="py-6 px-5 font-body text-[13px] text-neutral-400 m-0">No upcoming sessions.</p>
            ) : (
              <div>
                {sessions.map((s, i) => (
                  <a href={`/admin/cmp/sessions/${s.id}`}
                    class={`block py-3 px-5 no-underline ${i > 0 ? 'border-t border-neutral-100' : ''}`}>
                    <div class="flex items-start justify-between gap-2">
                      <div>
                        <p class="font-body text-[13px] font-medium text-brand-navy m-0 mb-0.5">{s.title}</p>
                        <p class="font-body text-xs text-neutral-400 m-0">
                          {s.cmp_programme_years?.name}
                          {s.location && <span> · {s.location}</span>}
                        </p>
                      </div>
                      <span class="font-body text-xs text-neutral-500 whitespace-nowrap shrink-0">
                        {formatDate(s.session_date)}
                        {s.session_time && <span class="ml-1">{formatTime(s.session_time)}</span>}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>

          <!-- Recent praise -->
          <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
            <div class="py-4 px-5 border-b border-neutral-200 flex items-center justify-between">
              <h2 class="font-heading text-sm font-bold text-neutral-800 m-0">Recent praise ⭐</h2>
              <a href="/admin/praise" class="font-body text-xs text-brand-navy no-underline">View all →</a>
            </div>
            {praiseRows.filter(p => p.visibility === 'public').length === 0 ? (
              <div class="p-5">
                <p class="font-body text-[13px] text-neutral-400 m-0 mb-2">No praise yet.</p>
                <a href="/admin/praise/new" class="font-body text-xs text-brand-navy no-underline font-medium">Give praise →</a>
              </div>
            ) : (
              <div>
                {praiseRows.filter(p => p.visibility === 'public').slice(0, 4).map((p, i) => {
                  const recipient = p['people!praise_recipient_id_fkey']
                  const giver = p['people!praise_given_by_fkey']
                  return (
                    <div class={`py-3 px-5 ${i > 0 ? 'border-t border-neutral-100' : ''}`}>
                      <p class="font-body text-xs text-neutral-500 m-0 mb-1">
                        {giver?.full_name ?? 'Admin'} → <span class="font-medium text-brand-navy">{recipient?.full_name ?? '—'}</span>
                        <span class="ml-1.5 text-neutral-400">{timeAgo(p.created_at)}</span>
                      </p>
                      <p class="font-body text-[13px] text-neutral-700 m-0 leading-normal border-l-2 border-brand-gold pl-2 line-clamp-2">
                        {p.message}
                      </p>
                    </div>
                  )
                })}
              </div>
            )}
          </div>
        </div>

        <!-- Quick actions sidebar -->
        <div class="flex flex-col gap-4">
          <div class="bg-white border border-neutral-200 rounded-lg p-5">
            <h2 class="font-heading text-[13px] font-bold text-neutral-500 uppercase tracking-[0.05em] m-0 mb-3.5">Quick actions</h2>
            <div class="flex flex-col gap-1.5">
              {[
                { label: '+ Add member', href: '/admin/members/new' },
                { label: '+ Add mentee', href: '/admin/mentees/new' },
                { label: '+ New CMP session', href: '/admin/cmp/sessions/new' },
                { label: '+ Give award', href: '/admin/awards/new' },
                { label: '+ Give praise', href: '/admin/praise/new' },
                { label: '+ Log participation', href: '/admin/participation/new' },
              ].map(link => (
                <a href={link.href}
                  class="block py-2 px-3 bg-neutral-50 border border-neutral-200 rounded-md font-body text-[13px] text-neutral-700 no-underline font-medium">
                  {link.label}
                </a>
              ))}
            </div>
          </div>

          <div class="bg-brand-navy rounded-lg p-5">
            <h2 class="font-heading text-[13px] font-bold text-white/60 uppercase tracking-[0.05em] m-0 mb-3.5">Admin areas</h2>
            <div class="flex flex-col gap-1">
              {[
                { label: 'Members', href: '/admin/members' },
                { label: 'Onboarding', href: '/admin/onboarding' },
                { label: 'Mentees', href: '/admin/mentees' },
                { label: 'Teams', href: '/admin/teams' },
                { label: 'Pillars', href: '/admin/pillars' },
                { label: 'Positions', href: '/admin/positions' },
                { label: 'Roles', href: '/admin/roles' },
                { label: 'Documents', href: '/admin/documents' },
                { label: 'Dues', href: '/admin/dues' },
                { label: 'CMP', href: '/admin/cmp/years' },
                { label: 'Awards', href: '/admin/awards' },
                { label: 'Email', href: '/admin/email' },
                { label: 'Audit log', href: '/admin/audit' },
              ].map(link => (
                <a href={link.href}
                  class="block py-1.5 px-2.5 rounded-sm font-body text-[13px] text-white/80 no-underline">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </>
  ) : (
    <>
      <!-- Member dashboard -->

      <!-- Stat cards -->
      <div class="grid grid-cols-4 gap-4 mb-6">
        <!-- DBS Status -->
        <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
          <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0 mb-1.5">My DBS</p>
          <p class="font-heading text-xl font-bold m-0 leading-[1.2]" style={`color: ${myDbsStatus.color};`}>{myDbsStatus.label}</p>
        </div>
        <!-- Awards -->
        <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
          <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0 mb-1.5">Awards</p>
          <p class="font-heading text-[32px] font-bold text-brand-gold m-0 leading-none">🏆 {myAwardsCount}</p>
        </div>
        <!-- Praise received -->
        <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
          <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0 mb-1.5">Praise received</p>
          <p class="font-heading text-[32px] font-bold text-brand-navy m-0 leading-none">⭐ {myPraiseReceivedCount}</p>
        </div>
        <!-- Praise given -->
        <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6">
          <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0 mb-1.5">Praise given</p>
          <p class="font-heading text-[32px] font-bold text-neutral-600 m-0 leading-none">⭐ {myPraiseGivenCount}</p>
        </div>
      </div>

      <!-- Dues summary widget -->
      {!userIsAdmin && (
        <div class="bg-white border border-neutral-200 rounded-lg py-5 px-6 mb-6 flex items-center justify-between gap-4">
          <div class="flex items-center gap-5">
            <span class="text-2xl">💰</span>
            <div>
              <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0 mb-1">Dues — {new Date().getFullYear()}</p>
              <p class="font-heading text-lg font-bold text-brand-navy m-0">
                {myDuesPaid} month{myDuesPaid !== 1 ? 's' : ''} paid
                {myDuesPending > 0 && (
                  <span class="text-[13px] font-medium text-[#92400e] ml-2">· {myDuesPending} pending approval</span>
                )}
              </p>
            </div>
          </div>
          <a href="/dues" class="py-2 px-[18px] bg-brand-navy text-white rounded-md font-body text-[13px] font-medium no-underline whitespace-nowrap">
            View dues
          </a>
        </div>
      )}

      <!-- Buddy cards row -->
      <div class="grid grid-cols-2 gap-4 mb-6">
        <!-- My Buddy -->
        <div class="buddy-card bg-white border border-neutral-200 rounded-lg py-5 px-6">
          <div class="flex items-center justify-between mb-2.5">
            <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0">🤝 My Buddy</p>
            {myBuddy?.buddyPerson && <button onclick="revealSection(this)" class="font-body text-[11px] font-medium text-brand-navy bg-transparent border border-neutral-300 rounded-sm py-0.5 px-2.5 cursor-pointer">Reveal details</button>}
          </div>
          {myBuddy?.buddyPerson ? (
            <div>
              <p class="font-heading text-base font-bold text-brand-navy m-0 mb-1.5">{myBuddy.buddyPerson.full_name}</p>
              {myBuddy.buddyPerson.email && (
                <a href={`mailto:${myBuddy.buddyPerson.email}`}
                   class="blurred-field font-body text-[13px] text-neutral-600 no-underline block blur-sm select-none transition-[filter] duration-200">{myBuddy.buddyPerson.email}</a>
              )}
              {myBuddy.buddyPerson.phone && (
                <a href={`tel:${myBuddy.buddyPerson.phone}`}
                   class="blurred-field font-body text-[13px] text-neutral-600 no-underline block mt-0.5 blur-sm select-none transition-[filter] duration-200">{myBuddy.buddyPerson.phone}</a>
              )}
            </div>
          ) : (
            <p class="font-body text-sm text-neutral-400 m-0">No buddy assigned yet.</p>
          )}
        </div>

        <!-- I am buddy to -->
        <div class="buddy-card bg-white border border-neutral-200 rounded-lg py-5 px-6">
          <div class="flex items-center justify-between mb-2.5">
            <p class="font-body text-xs font-medium text-neutral-500 uppercase tracking-[0.08em] m-0">🤝 I am buddy to</p>
            {iAmBuddyTo.length > 0 && <button onclick="revealSection(this)" class="font-body text-[11px] font-medium text-brand-navy bg-transparent border border-neutral-300 rounded-sm py-0.5 px-2.5 cursor-pointer">Reveal details</button>}
          </div>
          {iAmBuddyTo.length > 0 ? (
            <div class="grid grid-cols-2 gap-3">
              {iAmBuddyTo.map(entry => entry.primaryPerson && (
                <div>
                  <p class="font-heading text-sm font-bold text-brand-navy m-0 mb-1">{entry.primaryPerson.full_name}</p>
                  {entry.primaryPerson.email && (
                    <a href={`mailto:${entry.primaryPerson.email}`}
                       class="blurred-field font-body text-xs text-neutral-600 no-underline block blur-sm select-none transition-[filter] duration-200">{entry.primaryPerson.email}</a>
                  )}
                  {entry.primaryPerson.phone && (
                    <a href={`tel:${entry.primaryPerson.phone}`}
                       class="blurred-field font-body text-xs text-neutral-600 no-underline block mt-0.5 blur-sm select-none transition-[filter] duration-200">{entry.primaryPerson.phone}</a>
                  )}
                </div>
              ))}
            </div>
          ) : (
            <p class="font-body text-sm text-neutral-400 m-0">Not a buddy to anyone yet.</p>
          )}
        </div>
      </div>

      <!-- Main content grid -->
      <div class="grid [grid-template-columns:1fr_1fr_300px] gap-5">

        <!-- My Teams -->
        <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
          <div class="py-4 px-5 border-b border-neutral-200 flex items-center justify-between">
            <h2 class="font-heading text-sm font-bold text-neutral-800 m-0">My Teams</h2>
            <a href="/admin/teams" class="font-body text-xs text-brand-navy no-underline">Browse all →</a>
          </div>
          {myTeams.length === 0 ? (
            <div class="py-6 px-5">
              <p class="font-body text-[13px] text-neutral-400 m-0 mb-2">You're not in any teams yet.</p>
              <a href="/admin/teams" class="font-body text-xs text-brand-navy no-underline font-medium">Browse teams →</a>
            </div>
          ) : (
            <div>
              {myTeams.map((t, i) => (
                <a href={`/admin/teams/${t.teams?.id}`}
                   class={`block py-3 px-5 no-underline ${i > 0 ? 'border-t border-neutral-100' : ''}`}>
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="font-body text-[13px] font-medium text-brand-navy m-0">{t.teams?.name}</p>
                      {t.teams?.description && (
                        <p class="font-body text-xs text-neutral-400 m-0 mt-0.5">{t.teams.description}</p>
                      )}
                    </div>
                    {t.is_team_lead && (
                      <span class="py-0.5 px-2 bg-brand-gold text-brand-navy rounded-full font-body text-[11px] font-semibold whitespace-nowrap">Lead</span>
                    )}
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>

        <!-- Upcoming CMP sessions -->
        <div class="flex flex-col gap-5">
          <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
            <div class="py-4 px-5 border-b border-neutral-200 flex items-center justify-between">
              <h2 class="font-heading text-sm font-bold text-neutral-800 m-0">Upcoming CMP sessions</h2>
            </div>
            {myUpcomingSessions.length === 0 ? (
              <p class="py-6 px-5 font-body text-[13px] text-neutral-400 m-0">No upcoming sessions.</p>
            ) : (
              <div>
                {myUpcomingSessions.map((s, i) => (
                  <div class={`py-3 px-5 ${i > 0 ? 'border-t border-neutral-100' : ''}`}>
                    <p class="font-body text-[13px] font-medium text-brand-navy m-0 mb-0.5">{s.title}</p>
                    <p class="font-body text-xs text-neutral-400 m-0">
                      {formatDate(s.session_date)}
                      {s.session_time && <span class="ml-1">{formatTime(s.session_time)}</span>}
                      {s.location && <span> · {s.location}</span>}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Recent praise received -->
          <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
            <div class="py-4 px-5 border-b border-neutral-200">
              <h2 class="font-heading text-sm font-bold text-neutral-800 m-0">Recent praise ⭐</h2>
            </div>
            {myRecentPraise.length === 0 ? (
              <p class="py-6 px-5 font-body text-[13px] text-neutral-400 m-0">No praise yet.</p>
            ) : (
              <div>
                {myRecentPraise.map((p, i) => {
                  const giver = p['people!praise_given_by_fkey']
                  return (
                    <div class={`py-3 px-5 ${i > 0 ? 'border-t border-neutral-100' : ''}`}>
                      <p class="font-body text-xs text-neutral-500 m-0 mb-1">
                        From {giver?.full_name ?? 'Admin'}
                        <span class="ml-1.5 text-neutral-400">{timeAgo(p.created_at)}</span>
                      </p>
                      <p class="font-body text-[13px] text-neutral-700 m-0 leading-normal border-l-2 border-brand-gold pl-2">{p.message}</p>
                    </div>
                  )
                })}
              </div>
            )}
          </div>
        </div>

        <!-- Right column: My recent awards + Give praise button -->
        <div class="flex flex-col gap-4">
          <!-- Give praise CTA -->
          <a href="/admin/praise/new"
             class="block py-3.5 px-5 bg-brand-navy text-white rounded-lg font-heading text-[15px] font-bold no-underline text-center">
            ⭐ Give Praise
          </a>

          <!-- My recent awards -->
          <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
            <div class="py-4 px-5 border-b border-neutral-200">
              <h2 class="font-heading text-sm font-bold text-neutral-800 m-0">My Awards</h2>
            </div>
            {myRecentAwards.length === 0 ? (
              <p class="py-6 px-5 font-body text-[13px] text-neutral-400 m-0">No awards yet.</p>
            ) : (
              <div>
                {myRecentAwards.map((a, i) => (
                  <div class={`py-3 px-5 flex items-center gap-2.5 ${i > 0 ? 'border-t border-neutral-100' : ''}`}>
                    <span class="text-lg">🏆</span>
                    <div>
                      <p class="font-body text-[13px] font-semibold text-brand-gold m-0">{AWARD_LABELS[a.type] ?? a.type}</p>
                      <p class="font-body text-xs text-neutral-400 m-0">{a.year}</p>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </>
  )}
<script is:inline>
  function revealSection(btn) {
    var card = btn.closest('.buddy-card')
    if (!card) return
    card.querySelectorAll('.blurred-field').forEach(function(el) {
      el.style.filter = 'none'
      el.style.userSelect = 'auto'
    })
    btn.textContent = 'Shown'
    btn.disabled = true
    btn.style.opacity = '0.4'
  }
</script>
</DashboardLayout>
