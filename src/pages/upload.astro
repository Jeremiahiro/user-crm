---
/**
 * Public document upload page — no authentication required.
 * URL: /upload?training=<uuid>
 *
 * Resolves the submitter by email address (checks people.email).
 * If a training is specified, pre-selects its expected document type
 * and links the uploaded document to that training.
 */
import PublicLayout from '@/layouts/PublicLayout.astro'
import { supabaseAdmin } from '@/lib/supabase'

const trainingId = Astro.url.searchParams.get('training') ?? ''

// Load training context
let training: any = null
if (trainingId) {
  const { data } = await supabaseAdmin
    .from('trainings')
    .select('id, title, description, requires_document, expected_document_type_id, document_type:document_types(id, name)')
    .eq('id', trainingId)
    .eq('is_active', true)
    .maybeSingle()
  training = data ?? null
}

// Org logo + name
const { data: settingRows } = await supabaseAdmin
  .from('settings')
  .select('key, value')
  .in('key', ['logo_url', 'org_name'])
const settingsMap = Object.fromEntries(((settingRows ?? []) as any[]).map((r: any) => [r.key, r.value]))
const logoUrl = settingsMap.logo_url ?? null
const orgName = settingsMap.org_name ?? '100BMOL'

// Active document types for dropdown (only needed when training has no specific type)
const showDocTypeDropdown = !training?.expected_document_type_id
let docTypes: any[] = []
if (showDocTypeDropdown) {
  const { data } = await supabaseAdmin
    .from('document_types')
    .select('id, name')
    .eq('is_active', true)
    .order('sort_order')
    .order('name')
  docTypes = (data ?? []) as any[]
}

// ── POST handler ──────────────────────────────────────────────────────────────
let success = false
let submittedName = ''
let errors: Record<string, string> = {}
let globalError = ''
let formValues: Record<string, string> = {}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()

  const email      = ((form.get('email')            as string | null) ?? '').trim().toLowerCase()
  const title      = ((form.get('title')             as string | null) ?? '').trim()
  const docTypeId  = ((form.get('document_type_id')  as string | null) ?? '').trim()
  const file       = form.get('file') as File | null

  formValues = { email, title, document_type_id: docTypeId }

  const ALLOWED = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']

  if (!email) errors.email = 'Your email address is required.'
  if (!title) errors.title = 'Please give this document a name.'
  if (!docTypeId && showDocTypeDropdown) errors.document_type_id = 'Please select a document type.'
  if (!file || file.size === 0) {
    errors.file = 'Please choose a file.'
  } else if (file.size > 10 * 1024 * 1024) {
    errors.file = 'File must be under 10 MB.'
  } else if (!ALLOWED.includes(file.type)) {
    errors.file = 'Only PDF, JPEG, PNG, or WebP files are accepted.'
  }

  if (Object.keys(errors).length === 0) {
    // Resolve person by email
    const { data: person } = await supabaseAdmin
      .from('people')
      .select('id, full_name')
      .ilike('email', email)
      .maybeSingle()

    if (!person) {
      errors.email = "We couldn't find an account with that email address. Please contact your administrator if you think this is a mistake."
    } else {
      submittedName = person.full_name

      // Upload file to storage
      const ext = (file!.name.split('.').pop() ?? 'bin').toLowerCase()
      const storagePath = `${person.id}/${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`
      const buffer = await file!.arrayBuffer()

      const { error: storageErr } = await supabaseAdmin.storage
        .from('member-documents')
        .upload(storagePath, buffer, { contentType: file!.type })

      if (storageErr) {
        globalError = 'File upload failed. Please try again.'
      } else {
        const effectiveDocTypeId = training?.expected_document_type_id ?? docTypeId

        const { error: dbErr } = await supabaseAdmin
          .from('documents')
          .insert({
            person_id:         person.id,
            document_type_id:  effectiveDocTypeId,
            training_id:       trainingId || null,
            title,
            storage_path:      storagePath,
            file_name:         file!.name,
            file_type:         file!.type,
            file_size:         file!.size,
            status:            'pending',
          })

        if (dbErr) {
          // Roll back storage on DB failure
          await supabaseAdmin.storage.from('member-documents').remove([storagePath])
          globalError = 'Failed to save your document. Please try again.'
        } else {
          success = true
        }
      }
    }
  }
}

const hasErrors = Object.keys(errors).length > 0 || !!globalError
---

<PublicLayout title={training ? `${training.title} — Submit Document` : 'Submit a Document'}>
  <div class="min-h-screen flex items-start justify-center bg-brand-navy pt-12 px-6 pb-16 box-border">
    <div class="w-full max-w-130">

      <!-- Logo / org identity -->
      <div class="text-center mb-8">
        {logoUrl ? (
          <img
            src={logoUrl}
            alt={orgName}
            class="max-h-14 max-w-50 object-contain inline-block"
          />
        ) : (
          <p class="font-heading text-[26px] font-bold text-white m-0 tracking-[-0.5px]">{orgName}</p>
        )}
      </div>

      <!-- Card -->
      <div class="bg-white rounded-xl p-10 shadow-lg">

        {success ? (
          <div class="text-center py-4">
            <div class="w-16 h-16 bg-success-50 rounded-full flex items-center justify-center mx-auto mb-5 text-[28px]">✓</div>
            <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0 mb-2">Document submitted</h1>
            <p class="font-body text-sm text-neutral-500 m-0 mb-1.5 leading-[1.6]">
              Thanks{submittedName ? `, ${submittedName.split(' ')[0]}` : ''}. Your document is now awaiting review.
            </p>
            {training && (
              <p class="font-body text-[13px] text-neutral-500 m-0">
                Linked to: <strong class="text-brand-navy">{training.title}</strong>
              </p>
            )}
          </div>
        ) : (
          <div>
            <h1 class="font-heading text-[22px] font-bold text-brand-navy m-0 mb-1.5">Submit a document</h1>

            {training ? (
              <div class="inline-flex items-center gap-1.5 bg-neutral-100 rounded-full py-1 px-3.5 mb-7">
                <span class="text-[11px] text-neutral-500 font-body">For training:</span>
                <span class="text-[13px] font-semibold text-brand-navy font-body">{training.title}</span>
              </div>
            ) : (
              <p class="font-body text-sm text-neutral-500 m-0 mb-7">Fill in your details and attach your document below.</p>
            )}

            {globalError && (
              <div class="bg-danger-50 border border-[#fca5a5] rounded-md py-3 px-4 mb-5 font-body text-sm text-[#991b1b]">{globalError}</div>
            )}

            <form method="POST" enctype="multipart/form-data" class="flex flex-col gap-[18px]">

              <!-- Email -->
              <div class="flex flex-col gap-[5px]">
                <label for="emailInput" class="font-body text-[13px] font-medium text-neutral-700">Your email address *</label>
                <input
                  id="emailInput"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  value={formValues.email ?? ''}
                  placeholder="you@example.com"
                  class="px-3.5 py-2.5 rounded-md font-body text-sm text-neutral-900 outline-none w-full box-border"
                  style={`border: 1px solid ${errors.email ? '#f87171' : 'var(--color-neutral-300)'};`}
                />
                {errors.email && (
                  <p class="font-body text-xs text-[#dc2626] m-0">{errors.email}</p>
                )}
              </div>

              <!-- Document type (only when training doesn't fix it) -->
              {showDocTypeDropdown && (
                <div class="flex flex-col gap-[5px]">
                  <label for="docTypeSelect" class="font-body text-[13px] font-medium text-neutral-700">Document type *</label>
                  <select
                    id="docTypeSelect"
                    name="document_type_id"
                    required
                    class="px-3.5 py-2.5 rounded-md font-body text-sm text-neutral-900 bg-white w-full box-border"
                    style={`border: 1px solid ${errors.document_type_id ? '#f87171' : 'var(--color-neutral-300)'};`}
                  >
                    <option value="">Select a type…</option>
                    {docTypes.map((dt: any) => (
                      <option value={dt.id} selected={formValues.document_type_id === dt.id}>{dt.name}</option>
                    ))}
                  </select>
                  {errors.document_type_id && (
                    <p class="font-body text-xs text-[#dc2626] m-0">{errors.document_type_id}</p>
                  )}
                </div>
              )}

              <!-- Hidden doc type when pre-fixed by training -->
              {!showDocTypeDropdown && training?.expected_document_type_id && (
                <input type="hidden" name="document_type_id" value={training.expected_document_type_id} />
              )}

              <!-- Title -->
              <div class="flex flex-col gap-[5px]">
                <label for="titleInput" class="font-body text-[13px] font-medium text-neutral-700">Document name *</label>
                <input
                  id="titleInput"
                  name="title"
                  type="text"
                  required
                  value={formValues.title ?? ''}
                  placeholder={training?.document_type?.name ? `e.g. My ${training.document_type.name}` : 'e.g. Enhanced DBS Certificate'}
                  class="px-3.5 py-2.5 rounded-md font-body text-sm text-neutral-900 w-full box-border"
                  style={`border: 1px solid ${errors.title ? '#f87171' : 'var(--color-neutral-300)'};`}
                />
                {errors.title && (
                  <p class="font-body text-xs text-[#dc2626] m-0">{errors.title}</p>
                )}
              </div>

              <!-- File -->
              <div class="flex flex-col gap-[5px]">
                <label for="fileInput" class="font-body text-[13px] font-medium text-neutral-700">File *</label>

                <!-- Drop zone -->
                <label id="dropZone" for="fileInput" class="flex flex-col items-center justify-center gap-2 border-2 border-dashed border-neutral-300 rounded-md py-7 px-5 cursor-pointer transition-[border-color,background-color] duration-150 bg-neutral-50">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-neutral-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                  </svg>
                  <div class="text-center">
                    <p id="dropLabel" class="font-body text-sm font-medium text-neutral-700 m-0 mb-0.5">Click to choose a file</p>
                    <p class="font-body text-xs text-neutral-400 m-0">PDF, JPEG, PNG or WebP — max 10 MB</p>
                  </div>
                </label>

                <input
                  id="fileInput"
                  name="file"
                  type="file"
                  accept=".pdf,.jpg,.jpeg,.png,.webp"
                  required
                  class="hidden"
                />

                {errors.file && (
                  <p class="font-body text-xs text-[#dc2626] m-0">{errors.file}</p>
                )}
              </div>

              <!-- Submit -->
              <button
                type="submit"
                id="submitBtn"
                class="mt-1 py-3 px-5 bg-brand-navy text-white border-0 rounded-md font-body text-[15px] font-semibold cursor-pointer w-full transition-opacity duration-150 hover:opacity-[0.88]"
              >
                Submit document
              </button>
            </form>
          </div>
        )}
      </div>

      <!-- Footer -->
      <p class="text-center font-body text-xs text-white/40 mt-6 mb-0 mx-0">
        {orgName} · Secure document submission
      </p>
    </div>
  </div>
</PublicLayout>

<script is:inline>
  // File picker — update drop zone label when a file is chosen
  var fileInput = document.getElementById('fileInput')
  var dropLabel = document.getElementById('dropLabel')
  var dropZone  = document.getElementById('dropZone')

  if (fileInput) {
    fileInput.addEventListener('change', function() {
      var file = fileInput.files && fileInput.files[0]
      if (file && dropLabel) {
        dropLabel.textContent = file.name
        dropZone.style.borderColor = 'var(--color-brand-navy)'
        dropZone.style.backgroundColor = '#f0f4ff'
      }
    })
  }

  // Drag and drop
  if (dropZone && fileInput) {
    dropZone.addEventListener('dragover', function(e) {
      e.preventDefault()
      dropZone.style.borderColor = 'var(--color-brand-navy)'
      dropZone.style.backgroundColor = '#f0f4ff'
    })
    dropZone.addEventListener('dragleave', function() {
      dropZone.style.borderColor = 'var(--color-neutral-300)'
      dropZone.style.backgroundColor = 'var(--color-neutral-50)'
    })
    dropZone.addEventListener('drop', function(e) {
      e.preventDefault()
      var files = e.dataTransfer && e.dataTransfer.files
      if (files && files.length) {
        // Transfer dropped file to the real input via DataTransfer
        try {
          var dt = new DataTransfer()
          dt.items.add(files[0])
          fileInput.files = dt.files
          if (dropLabel) dropLabel.textContent = files[0].name
        } catch (_) {}
      }
    })
  }

  // Disable submit while uploading to prevent double-submit
  var form = document.querySelector('form')
  var submitBtn = document.getElementById('submitBtn')
  if (form && submitBtn) {
    form.addEventListener('submit', function() {
      submitBtn.disabled = true
      submitBtn.textContent = 'Submitting…'
    })
  }
</script>
