GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GMAIL_SENDER_ADDRESS=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=http://localhost:4321

# Optional — cloudflared tunnel hostname for local dev (no https://, no trailing slash)
# e.g. your-tunnel-name.trycloudflare.com
CLOUDFLARE_TUNNEL_HOST=

# Email intercept — set to "true" in local dev to redirect all outgoing emails
# to a single address instead of real recipients. Useful for testing broadcasts
# without spamming members.
DEV_EMAIL_INTERCEPT=false
DEV_EMAIL_INTERCEPT_TO=
